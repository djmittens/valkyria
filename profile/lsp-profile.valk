; profile/lsp-profile.valk - profile the valk-lsp load path via real neovim.
;
; Drives nvim --headless: writes a minimal init.lua that starts valk-lsp
; through build/lsp_proxy, opens a fixture .valk file, waits long enough
; for initial LSP traffic to settle, exits. Then parses the proxy log and
; prints a per-phase breakdown.
;
; Usage: build/valk profile/lsp-profile.valk
;
; Env overrides:
;   VALK_LSP_FIXTURE   file to open in nvim (default lsp/workspace.valk)
;   VALK_LSP_WAIT_MS   how long to wait in nvim after open (default 4000)
;   VALK_LSP_PROXY_LOG proxy log path (default /tmp/valk-lsp-proxy.log)

(module lspprof)

(fun {eprintln s} {stderr/write (str s "\n")})

(fun {env-or name default} {do
  (= {v} (env/get name))
  (if (or (== v nil) (== v "")) {default} {v})
})

(fun {require-file path hint} {
  (if (== (file/exists? path) 0)
    {do (eprintln (str "missing " path " -- " hint)) (exit 1)}
    {})
})

; --- init.lua generation ---

(fun {init-lua proxy server root} {
  (str/join (list
    "-- Minimal nvim config for LSP profiling (generated by profile/lsp-profile.valk)."
    "vim.filetype.add({ extension = { valk = \"valk\" } })"
    ""
    (str "local proxy  = \"" proxy "\"")
    (str "local server = \"" server "\"")
    (str "local root   = \"" root "\"")
    ""
    "vim.api.nvim_create_autocmd(\"FileType\", {"
    "  pattern = \"valk\","
    "  callback = function(args)"
    "    local ok, err = pcall(vim.lsp.start, {"
    "      name = \"valk-lsp\","
    "      cmd = { proxy, server },"
    "      root_dir = root,"
    "    })"
    "    if not ok then"
    "      io.stderr:write(\"vim.lsp.start failed: \" .. tostring(err) .. \"\\n\")"
    "    end"
    "  end,"
    "})"
    ""
    "local t0 = vim.uv.hrtime()"
    "local function mark(label)"
    "  io.stderr:write(string.format(\"[nvim] +%.1f ms %s\\n\","
    "    (vim.uv.hrtime() - t0) / 1e6, label))"
    "end"
    ""
    "vim.api.nvim_create_autocmd(\"LspAttach\", {"
    "  callback = function(args)"
    "    mark(\"LspAttach bufnr=\" .. args.buf)"
    "    local client = vim.lsp.get_client_by_id(args.data.client_id)"
    "    if client and client.server_capabilities"
    "       and client.server_capabilities.semanticTokensProvider then"
    "      mark(\"requesting semanticTokens/full\")"
    "      client:request(\"textDocument/semanticTokens/full\", {"
    "        textDocument = vim.lsp.util.make_text_document_params(args.buf),"
    "      }, function(err, result, ctx)"
    "        mark(\"semanticTokens/full reply (err=\" .. tostring(err) .."
    "             \", tokens=\" .. tostring(result and #(result.data or {}) or 0) .. \")\")"
    "      end, args.buf)"
    "    end"
    "  end,"
    "})"
    ""
    "mark(\"init.lua loaded\")")
    "\n")
})

; --- proxy log parsing ---
; Log lines: "<us>\t<dir>\t<bytes>\t<method-or-id>", `#` comments skipped.
; Events accumulate reversed; callers see chronological order.

(fun {parse-log path} {do
  (= {st} (dict/new))
  (dict/set! st "events" nil)
  (for-each-line path (\ {line} {
    (if (str/starts-with? line "#") {}
      {do
        (= {parts} (str/split line "\t"))
        (if (< (len parts) 4) {}
          {do
            (= {us} (str->num (nth 1 parts)))
            (if (error? us) {}
              {(dict/set! st "events"
                (cons (list us (nth 2 parts) (nth 3 parts) (nth 4 parts))
                      (dict/get st "events")))})})})
  }))
  (reverse (dict/get st "events"))
})

; --- formatting ---

(def {SPACES} "                                                  ")

(fun {pad-left s w} {do
  (= {s} (str s))
  (= {n} (- w (len s)))
  (if (< n 1) {s} {(str (str/slice SPACES 0 n) s)})
})

(fun {pad-right s w} {do
  (= {s} (str s))
  (= {n} (- w (len s)))
  (if (< n 1) {s} {(str s (str/slice SPACES 0 n))})
})

(fun {ms-str us} {
  (str (/ us 1000) "." (/ (mod us 1000) 100))
})

(fun {print-events events} {
  (if (nil? events) {}
    {do
      (= {e} (head events))
      (println (str (pad-left (ms-str (nth 1 e)) 10) "  "
                    (pad-right (nth 2 e) 4) "  "
                    (pad-left (nth 3 e) 7) "  "
                    (nth 4 e)))
      (print-events (tail events))})
})

; --- phase landmarks ---

; First C2S event whose method matches.
(fun {find-request events method} {
  (if (nil? events) {nil}
    {do
      (= {e} (head events))
      (if (and (== (nth 2 e) "C2S") (== (nth 4 e) method))
        {e}
        {(find-request (tail events) method)})})
})

; First S2C reply (method "id=...") strictly after time `us`.
(fun {find-reply-after events us} {
  (if (nil? events) {nil}
    {do
      (= {e} (head events))
      (if (and (> (nth 1 e) us)
               (and (== (nth 2 e) "S2C") (str/starts-with? (nth 4 e) "id=")))
        {e}
        {(find-reply-after (tail events) us)})})
})

(fun {print-phase label a b} {
  (if (or (nil? a) (nil? b))
    {(println (str "  " (pad-right label 36) "  (missing)"))}
    {(println (str "  " (pad-right label 36) "  "
                   (pad-left (ms-str (- (nth 1 b) (nth 1 a))) 8) " ms"))})
})

; --- main ---

(fun {main} {do
  (= {root} (realpath "."))
  (= {proxy} (str root "/build/lsp_proxy"))
  (= {server} (str root "/build/valk-lsp"))
  (= {fixture} (env-or "VALK_LSP_FIXTURE" "lsp/workspace.valk"))
  (= {wait-ms} (env-or "VALK_LSP_WAIT_MS" "4000"))
  (= {log} (env-or "VALK_LSP_PROXY_LOG" "/tmp/valk-lsp-proxy.log"))

  (require-file proxy "run: cmake --build build --target lsp_proxy")
  (require-file server (str "run: build/valk --build lsp/build-main.valk -o " server))
  (require-file fixture "fixture not found")

  (= {init} (str/trim (plist/get (exec "mktemp" "-t" "valk-lsp-init.XXXXXX.lua") :stdout)))
  (write-file init (init-lua proxy server root))
  (if (== (file/exists? log) 0) {} {(file/delete log)})

  (println "== profiling valk-lsp via nvim ==")
  (println (str "   fixture: " fixture))
  (println (str "   proxy log: " log))
  (println "")

  (= {r} (exec "nvim" "--headless" "-u" init
               "-c" (str "edit " fixture)
               "-c" (str "lua vim.wait(" wait-ms ")")
               "-c" "quitall!"))
  (map (\ {l} {(println (str "    " l))})
       (filter (\ {l} {(> (len l) 0)})
               (str/split (str (plist/get r :stdout) (plist/get r :stderr)) "\n")))
  (file/delete init)

  (println "")
  (println "== proxy log summary ==")
  (if (== (file/exists? log) 0)
    {do (println (str "no log at " log)) (exit 0)} {})
  (= {events} (parse-log log))
  (if (nil? events)
    {do (println "(log empty)") (exit 0)} {})

  (println (str (pad-left "elapsed_ms" 10) "  " (pad-right "dir" 4) "  "
                (pad-left "bytes" 7) "  method/id"))
  (println "------------------------------------------------------------")
  (print-events events)

  (println "")
  (println "-- key phase latencies --")
  (= {start} (head events))
  (= {init-req} (find-request events "initialize"))
  (= {init-resp} (if (nil? init-req) {nil}
    {(find-reply-after events (nth 1 init-req))}))
  (= {sem-req} (find-request events "textDocument/semanticTokens/full"))
  (= {sem-resp} (if (nil? sem-req) {nil}
    {(find-reply-after events (nth 1 sem-req))}))

  (print-phase "proxy_start -> initialize_sent" start init-req)
  (print-phase "initialize request -> response" init-req init-resp)
  (print-phase "initialize_resp -> semTokens_req" init-resp sem-req)
  (print-phase "semTokens_req -> response" sem-req sem-resp)
  (print-phase "TOTAL proxy_start -> sem_resp" start sem-resp)
})

(main)
