(load "src/prelude.valk")
(load "src/modules/test.valk")

(test/run (list

  (test "parse-self-closing"
    {do
    (= {doc} (xml/parse "<root/>"))
    (test/assert-eq "root" tag:doc "tag name")
    (test/assert-eq 0 (len children:doc) "no children")
    true
  })

  (test "parse-with-children"
    {do
    (= {doc} (xml/parse "<root><a/><b/></root>"))
    (= {children} children:doc)
    (test/assert-eq 2 (len children) "two children")
    (= {c1} (nth 1 children))
    (test/assert-eq "a" tag:c1 "first child")
    (= {c2} (nth 2 children))
    (test/assert-eq "b" tag:c2 "second child")
    true
  })

  (test "parse-attributes"
    {do
    (= {xml} "<item name=\"hello\" count=\"42\"/>")
    (= {doc} (xml/parse xml))
    (= {attrs} attrs:doc)
    (test/assert-eq "hello" name:attrs "string attr")
    (test/assert-eq "42" count:attrs "number-valued attr is string")
    true
  })

  (test "parse-text-content"
    {do
    (= {doc} (xml/parse "<msg>hello world</msg>"))
    (test/assert-eq "hello world" text:doc "text content")
    true
  })

  (test "parse-nested-structure"
    {do
    (= {xml} "<root><parent><child val=\"1\"/></parent></root>")
    (= {doc} (xml/parse xml))
    (= {parent} (head children:doc))
    (= {child} (head children:parent))
    (test/assert-eq "child" tag:child "nested tag")
    (= {a} attrs:child)
    (test/assert-eq "1" val:a "nested attr")
    true
  })

  (test "parse-no-attrs-gives-nil"
    {do
    (= {doc} (xml/parse "<bare/>"))
    (= {attrs} attrs:doc)
    (test/assert-eq 0 (len attrs) "no attrs is empty")
    true
  })

  (test "parse-cobertura-like"
    {do
    (= {xml} (str
      "<coverage line-rate=\"0.95\">"
        "<packages>"
          "<package name=\"src\">"
            "<classes>"
              "<class filename=\"src/foo.c\" line-rate=\"1.0\">"
                "<lines>"
                  "<line number=\"10\" hits=\"5\" branch=\"true\" condition-coverage=\"100% (2/2)\"/>"
                  "<line number=\"20\" hits=\"3\" branch=\"true\" condition-coverage=\"50% (1/2)\"/>"
                "</lines>"
              "</class>"
            "</classes>"
          "</package>"
        "</packages>"
      "</coverage>"))
    (= {doc} (xml/parse xml))
    (test/assert-eq "coverage" tag:doc "root tag")
    (= {pkgs} children:doc)
    (= {first-pkg} (head pkgs))
    (= {pkg} (head children:first-pkg))
    (= {first-child} (head children:pkg))
    (= {cls} (head children:first-child))
    (= {ca} attrs:cls)
    (test/assert-eq "src/foo.c" filename:ca "class filename")
    (= {lines-elem} (head children:cls))
    (= {lines} children:lines-elem)
    (test/assert-eq 2 (len lines) "two line elements")
    (= {line1} (nth 1 lines))
    (= {al1} attrs:line1)
    (test/assert-eq "10" number:al1 "line number")
    (test/assert-eq "5" hits:al1 "hit count")
    (= {line2} (nth 2 lines))
    (= {al2} attrs:line2)
    (test/assert-eq "50% (1/2)" condition-coverage:al2 "condition coverage")
    true
  })

  (test "parse-error-invalid-xml"
    {do
    (test/assert (error? (xml/parse "<unclosed>")) "unclosed tag should error")
    true
  })

  (test "parse-error-wrong-type"
    {do
    (test/assert (error? (xml/parse 42)) "number arg should error")
    true
  })

  (test "parse-ignores-whitespace-text"
    {do
    (= {xml} (str "<root>\n  <child/>\n</root>"))
    (= {doc} (xml/parse xml))
    (= {children} children:doc)
    (test/assert-eq 1 (len children) "whitespace-only text nodes ignored")
    (= {fc} (head children))
    (test/assert-eq "child" tag:fc "child tag")
    true
  })

  (test "parse-empty-string"
    {do
    (test/assert (error? (xml/parse "")) "empty string should error")
    true
  })

  (test "parse-malformed-xml"
    {do
    (test/assert (error? (xml/parse "<")) "bare angle bracket should error")
    (test/assert (error? (xml/parse "not xml at all")) "non-xml text should error")
    true
  })

  (test "parse-mismatched-tags"
    {do
    (test/assert (error? (xml/parse "<a></b>")) "mismatched tags should error")
    true
  })

) {:suite-name "XML Builtin Tests"})
