(load "src/prelude.valk")
(load "src/symdb.valk")
(load "src/lsp/analysis.valk")
(load "src/lsp/validate.valk")
(load "src/lsp/hints.valk")
(load "src/lsp/lsp.valk")
(load "src/modules/test.valk")

; --- Response capture stubs ---

(def {*captured-responses*} nil)
(def {*captured-errors*} nil)
(def {*captured-notifications*} nil)
(def {*aio-stopped*} 0)
(def {*aio-dispatched*} nil)

(fun {lsp/send-response id result} {do
  (def {*captured-responses*}
    (qcons (list :id id :result result) *captured-responses*))
  nil
})

(fun {lsp/send-error id code message} {do
  (def {*captured-errors*}
    (qcons (list :id id :code code :message message) *captured-errors*))
  nil
})

(fun {lsp/send-notification method params} {do
  (def {*captured-notifications*}
    (qcons (list :method method :params params) *captured-notifications*))
  nil
})

(fun {lsp/send-request id method params} {nil})
(fun {aio/stop sys} {def {*aio-stopped*} 1})
(fun {aio/dispatch sys fn arg cb} {do (= {r} (fn arg)) (cb r)})

(fun {reset-captures} {do
  (def {*captured-responses*} nil)
  (def {*captured-errors*} nil)
  (def {*captured-notifications*} nil)
  (def {*aio-stopped*} 0)
  (def {*aio-dispatched*} nil)
})

(fun {last-response} {
  if (nil? *captured-responses*) {nil}
  {head *captured-responses*}
})

(fun {last-error} {
  if (nil? *captured-errors*) {nil}
  {head *captured-errors*}
})

(fun {last-notification} {
  if (nil? *captured-notifications*) {nil}
  {head *captured-notifications*}
})

; --- State reset helper ---

(fun {reset-state} {do
  (def {lsp/documents} (dict/new))
  (def {lsp/db} nil)
  (def {lsp/root-path} nil)
  (def {lsp/known-set-cache} nil)
  (def {lsp/progress-token} 0)
  (def {lsp/doc-version} 0)
  (def {lsp/line-index-cache} (dict/new))
  (def {lsp/ast-cache} (dict/new))
  (reset-captures)
})

; --- In-memory symdb helper ---

(fun {make-test-db} {do
  (= {db} (sqlite/open ":memory:"))
  (sqlite/exec-script db symdb/schema-sql)
  (= {r} (sqlite/exec db "ALTER TABLE symbols ADD COLUMN sig TEXT"))
  db
})

(fun {setup-with-db} {do
  (reset-state)
  (def {lsp/db} (make-test-db))
  (def {lsp/root-path} "/test")
})

; --- Seed a document into symdb for testing ---

(fun {seed-doc uri text} {do
  (lsp/doc-store uri text)
  (if (nil? lsp/db) {}
    {symdb/sync-document lsp/db uri text})
})

(test/run (list

  ; =========================================================================
  ; Pure helper functions
  ; =========================================================================

  ; --- doc-store / doc-get ---

  (test "doc-store-and-get"
    {do
      (reset-state)
      (lsp/doc-store "file:///a.valk" "hello")
      (test/assert-eq "hello" (lsp/doc-get "file:///a.valk") "should retrieve stored doc")
    })

  (test "doc-get-missing"
    {do
      (reset-state)
      (test/assert (nil? (lsp/doc-get "file:///missing.valk")) "missing doc returns nil")
    })

  ; --- lsp/get-doc ---

  (test "get-doc-found"
    {do
      (reset-state)
      (lsp/doc-store "file:///x.valk" "content")
      (= {ctx} (lsp/get-doc (DocParams :textDocument (LspTextDoc :uri "file:///x.valk"))))
      (test/assert (not (nil? ctx)) "should return DocCtx")
      (test/assert-eq "file:///x.valk" ctx:uri "uri")
      (test/assert-eq "content" ctx:text "text")
    })

  (test "get-doc-missing"
    {do
      (reset-state)
      (= {result} (lsp/get-doc (DocParams :textDocument (LspTextDoc :uri "file:///nope"))))
      (test/assert (nil? result) "should return nil for missing doc")
    })

  ; --- lsp/get-text-pos ---

  (test "get-text-pos-found"
    {do
      (reset-state)
      (lsp/doc-store "file:///t.valk" "hello\nworld")
      (= {params} (TextDocPosParams :textDocument (LspTextDoc :uri "file:///t.valk") :position (LspPosition :line 1 :character 3)))
      (= {ctx} (lsp/get-text-pos params))
      (test/assert (not (nil? ctx)) "should return TextPosCtx")
      (test/assert-eq 1 ctx:line "line")
      (test/assert-eq 3 ctx:col "col")
    })

  (test "get-text-pos-missing"
    {do
      (reset-state)
      (= {params} (TextDocPosParams :textDocument (LspTextDoc :uri "file:///no") :position (LspPosition :line 0 :character 0)))
      (test/assert (nil? (lsp/get-text-pos params)) "should return nil")
    })

  ; --- lsp/get-word-ctx ---

  (test "get-word-ctx-found"
    {do
      (reset-state)
      (lsp/doc-store "file:///w.valk" "hello world")
      (= {params} (TextDocPosParams :textDocument (LspTextDoc :uri "file:///w.valk") :position (LspPosition :line 0 :character 6)))
      (= {ctx} (lsp/get-word-ctx params))
      (test/assert (not (nil? ctx)) "should return WordCtx")
      (test/assert-eq "world" ctx:word "word should be world")
    })

  (test "get-word-ctx-no-word"
    {do
      (reset-state)
      (lsp/doc-store "file:///w.valk" "  ")
      (= {params} (TextDocPosParams :textDocument (LspTextDoc :uri "file:///w.valk") :position (LspPosition :line 0 :character 0)))
      (= {result} (lsp/get-word-ctx params))
      (test/assert (nil? result) "no word at cursor -> nil")
    })

  ; --- make-lsp-diag ---

  (test "make-lsp-diag"
    {do
      (= {d} (list :line 5 :col 3 :end-col 10 :severity 1 :message "bad"))
      (= {lsp-d} (make-lsp-diag d))
      (= {range} lsp-d:range)
      (= {start} range:start)
      (= {end} range:end)
      (test/assert-eq 5 start:line "start line")
      (test/assert-eq 3 start:character "start char")
      (test/assert-eq 10 end:character "end char")
      (test/assert-eq 1 lsp-d:severity "severity")
      (test/assert-eq "valk" lsp-d:source "source")
      (test/assert-eq "bad" lsp-d:message "message")
    })

  ; --- lsp/invalidate-known-set / lsp/get-known-set ---

  (test "invalidate-known-set"
    {do
      (reset-state)
      (def {lsp/known-set-cache} (list "a" "b"))
      (lsp/invalidate-known-set)
      (test/assert (nil? lsp/known-set-cache) "cache should be nil after invalidate")
    })

  ; --- hover/format-markdown ---

  (test "hover-format-with-sig"
    {do
      (= {info} (SymInfo "add" 1 2 "Adds numbers" "-> Num Num Num" "/test/math.valk" 10 0 "(add a b)"))
      (= {md} (hover/format-markdown info "add"))
      (test/assert (str/starts-with? md "```valk") "should start with code block")
      (test/assert (not (== -1 (str/index-of md "-> Num Num Num"))) "should contain sig")
      (test/assert (not (== -1 (str/index-of md "Adds numbers"))) "should contain doc")
      (test/assert (not (== -1 (str/index-of md "math.valk:11"))) "should contain path:line")
    })

  (test "hover-format-minimal"
    {do
      (= {info} (SymInfo "x" 0 0 nil nil "/test.valk" 0 0 nil))
      (= {md} (hover/format-markdown info "x"))
      (test/assert (not (== -1 (str/index-of md "x"))) "should contain word")
    })

  (test "hover-format-formals-no-sig"
    {do
      (= {info} (SymInfo "f" 1 2 nil nil "/test.valk" 0 0 "(f a b)"))
      (= {md} (hover/format-markdown info "f"))
      (test/assert (not (== -1 (str/index-of md "(f a b)"))) "should show formals")
    })

  (test "hover-format-path-no-line"
    {do
      (= {info} (SymInfo "g" 0 0 nil nil "/a.valk" 0 0 nil))
      (= {md} (hover/format-markdown info "g"))
      (test/assert (not (== -1 (str/index-of md "/a.valk"))) "should contain path")
    })

  ; --- ref->lsp-location ---

  (test "ref-to-lsp-location"
    {do
      (= {r} (list :offset 6 :name "world"))
      (= {loc} (ref->lsp-location "file:///a.valk" "hello\nworld" r))
      (test/assert-eq "file:///a.valk" loc:uri "uri")
      (= {range} loc:range)
      (= {start} range:start)
      (test/assert-eq 1 start:line "line 1")
      (test/assert-eq 0 start:character "char 0")
    })

  ; --- make-snippet-item ---

  (test "make-snippet-item"
    {do
      (= {s} (FormSnippet :label "fun" :detail "(fun {name} {body})"
                    :snippet "fun {$1}" :sort "00"))
      (= {item} (make-snippet-item s))
      (test/assert-eq "fun" item:label "label")
      (test/assert-eq 15 item:kind "kind=15 snippet")
      (test/assert-eq 2 item:insertTextFormat "insertTextFormat=2")
      (test/assert-eq "00" item:sortText "sortText")
    })

  ; --- filter-snippets ---

  (test "filter-snippets-match"
    {do
      (= {result} (filter-snippets "fu" lsp/form-snippets))
      (test/assert (not (nil? result)) "should match 'fun'")
      (test/assert-eq "fun" (do (= {r} (head result)) r:label) "label should be fun")
    })

  (test "filter-snippets-no-match"
    {do
      (= {result} (filter-snippets "zzz" lsp/form-snippets))
      (test/assert (nil? result) "no snippet starts with zzz")
    })

  (test "filter-snippets-empty-returns-nil"
    {do
      (= {result} (filter-snippets "a" nil))
      (test/assert (nil? result) "empty list returns nil")
    })

  ; --- symkind->completion-kind ---

  (test "symkind-to-completion-kind"
    {do
      (test/assert-eq 3 (symkind->completion-kind SYMKIND_FUNCTION) "function=3")
      (test/assert-eq 6 (symkind->completion-kind SYMKIND_VARIABLE) "variable=6")
      (test/assert-eq 7 (symkind->completion-kind SYMKIND_TYPE) "type=7")
      (test/assert-eq 4 (symkind->completion-kind SYMKIND_CONSTRUCTOR) "constructor=4")
      (test/assert-eq 6 (symkind->completion-kind 999) "unknown=6 default")
    })

  ; --- make-sym-completion-item ---

  (test "make-sym-completion-item-with-sig"
    {do
      (= {s} (CompletionRow :name "add" :kind SYMKIND_FUNCTION :sig "-> Num Num" :doc nil))
      (= {item} (make-sym-completion-item s))
      (test/assert-eq "add" item:label "label")
      (test/assert-eq 3 item:kind "function kind")
      (test/assert-eq "-> Num Num" item:detail "detail is sig")
      (test/assert-eq "1-add" item:sortText "sortText")
    })

  (test "make-sym-completion-item-with-doc"
    {do
      (= {s} (CompletionRow :name "x" :kind SYMKIND_VARIABLE :sig nil :doc "some doc"))
      (= {item} (make-sym-completion-item s))
      (= {doc-obj} item:documentation)
      (test/assert (not (nil? doc-obj)) "should have documentation")
      (test/assert-eq "markdown" doc-obj:kind "doc kind")
      (test/assert-eq "some doc" doc-obj:value "doc value")
    })

  (test "make-sym-completion-item-no-sig-no-doc"
    {do
      (= {s} (CompletionRow :name "y" :kind SYMKIND_VARIABLE :sig nil :doc nil))
      (= {item} (make-sym-completion-item s))
      (test/assert-eq "" item:detail "no sig = empty detail")
      (test/assert (nil? item:documentation) "no doc field")
    })

  ; --- ref->lsp-edit ---

  (test "ref-to-lsp-edit"
    {do
      (= {r} (list :offset 0 :len 5))
      (= {edit} (ref->lsp-edit "hello world" r "goodbye"))
      (test/assert-eq "goodbye" edit:newText "newText")
      (= {range} edit:range)
      (= {end} range:end)
      (test/assert-eq 5 end:character "end char = offset + len")
    })

  ; --- db-ref->lsp-edit ---

  (test "db-ref-to-lsp-edit"
    {do
      (= {r} (list :line 3 :col 7))
      (= {edit} (db-ref->lsp-edit r 4 "newname"))
      (test/assert-eq "newname" edit:newText "newText")
      (= {re} edit:range)
      (= {start} re:start)
      (test/assert-eq 3 start:line "line")
      (test/assert-eq 7 start:character "col")
      (= {end} re:end)
      (test/assert-eq 11 end:character "col + word-len")
    })

  ; --- rename/group-by-uri ---

  (test "rename-group-by-uri"
    {do
      (= {locs} (list
        (list :uri "a" :edit (list :range 1))
        (list :uri "b" :edit (list :range 2))
        (list :uri "a" :edit (list :range 3))))
      (= {grouped} (rename/group-by-uri locs nil))
      (= {a-edits} (plist/get grouped "a"))
      (test/assert (not (nil? a-edits)) "should have edits for a")
      (= {b-edits} (plist/get grouped "b"))
      (test/assert (not (nil? b-edits)) "should have edits for b")
    })

  ; --- rename/make-doc-changes ---

  (test "rename-make-doc-changes"
    {do
      (= {grouped} (list "file:///a" (list (list :range 1 :newText "x"))))
      (= {changes} (rename/make-doc-changes grouped))
      (test/assert (not (nil? changes)) "should have changes")
      (= {first-change} (head changes))
      (= {td} first-change:textDocument)
      (test/assert-eq "file:///a" td:uri "uri")
    })

  ; --- ref->highlight ---

  (test "ref-to-highlight-def"
    {do
      (= {r} (list :offset 0 :name "hello" :is-def 1))
      (= {h} (ref->highlight "hello world" r))
      (test/assert-eq 3 h:kind "definition = kind 3")
    })

  (test "ref-to-highlight-ref"
    {do
      (= {r} (list :offset 0 :name "hello" :is-def 0))
      (= {h} (ref->highlight "hello world" r))
      (test/assert-eq 2 h:kind "reference = kind 2")
    })

  ; --- sig/scan-back ---

  (test "sig-scan-back-simple"
    {do
      (= {pos} (sig/scan-back "(hello x y" 9 0 0))
      (test/assert-eq 0 pos "should find opening paren at 0")
    })

  (test "sig-scan-back-nested"
    {do
      (= {pos} (sig/scan-back "(foo (bar x) y" 13 0 0))
      (test/assert-eq 0 pos "should find outer paren at 0")
    })

  (test "sig-scan-back-braces"
    {do
      (= {pos} (sig/scan-back "(f {a b} x" 9 0 0))
      (test/assert-eq 0 pos "should skip braces and find paren at 0")
    })

  (test "sig-scan-back-not-found"
    {do
      (= {pos} (sig/scan-back "hello" 4 0 0))
      (test/assert (nil? pos) "no paren -> nil")
    })

  ; --- sig/extract-name ---

  (test "sig-extract-name"
    {do
      (= {name} (sig/extract-name "(hello world)" 0))
      (test/assert-eq "hello" name "should extract function name")
    })

  (test "sig-extract-name-empty"
    {do
      (= {name} (sig/extract-name "( )" 0))
      (test/assert (nil? name) "empty call -> nil")
    })

  ; --- sig/count-args ---

  (test "sig-count-args-simple"
    {do
      (= {count} (sig/count-args "(f a b c)" 2 8 0 0 0 0))
      (test/assert-eq 3 count "three args: a b c")
    })

  (test "sig-count-args-nested"
    {do
      (= {count} (sig/count-args "(f (g x) b)" 2 10 0 0 0 0))
      (test/assert-eq 1 count "b is 1st word-arg seen at depth 0")
    })

  (test "sig-count-args-zero"
    {do
      (= {count} (sig/count-args "(f)" 2 2 0 0 0 0))
      (test/assert-eq 0 count "no args")
    })

  ; --- lsp/in-string? ---

  (test "in-string-outside"
    {do
      (test/assert-eq 0 (lsp/in-string? "hello world" 0 3) "not in string")
    })

  (test "in-string-inside"
    {do
      (test/assert-eq 1 (lsp/in-string? "(print \"hello\")" 0 9) "inside string")
    })

  (test "in-string-after-close"
    {do
      (test/assert-eq 0 (lsp/in-string? "(print \"hi\") x" 0 13) "after close = outside")
    })

  ; --- lsp/count-quotes ---

  (test "count-quotes-none"
    {do
      (test/assert-eq 0 (lsp/count-quotes "hello" 5 0 0) "0 quotes = even = false")
    })

  (test "count-quotes-one"
    {do
      (test/assert-eq 1 (lsp/count-quotes "a\"b" 3 0 0) "1 quote = odd = true")
    })

  (test "count-quotes-two"
    {do
      (test/assert-eq 0 (lsp/count-quotes "a\"b\"c" 5 0 0) "2 quotes = even = false")
    })

  (test "count-quotes-escaped"
    {do
      (test/assert-eq 0 (lsp/count-quotes "a\\\"b" 4 0 0) "escaped quote not counted")
    })

  ; --- lsp/skip-dir? ---

  (test "skip-dir-build"
    {do
      (test/assert-eq 1 (lsp/skip-dir? "build") "build should be skipped")
      (test/assert-eq 1 (lsp/skip-dir? "node_modules") "node_modules skipped")
      (test/assert-eq 1 (lsp/skip-dir? ".git") ".git skipped")
    })

  (test "skip-dir-allowed"
    {do
      (test/assert-eq 0 (lsp/skip-dir? "src") "src not skipped")
      (test/assert-eq 0 (lsp/skip-dir? "test") "test not skipped")
    })

  ; --- lsp/next-progress-token ---

  (test "next-progress-token"
    {do
      (reset-state)
      (= {t1} (lsp/next-progress-token))
      (= {t2} (lsp/next-progress-token))
      (test/assert-eq 1 t1 "first token = 1")
      (test/assert-eq 2 t2 "second token = 2")
    })

  ; --- fold/collect ---

  (test "fold-collect-fun"
    {do
      (= {text} "(fun {f x}\n  {+ x 1})")
      (= {ast} (parse text))
      (= {ranges} (fold/collect ast text))
      (test/assert (not (nil? ranges)) "should find foldable fun form")
      (= {r} (head ranges))
      (test/assert-eq 0 r:startLine "starts at line 0")
      (test/assert-eq "region" r:kind "kind is region")
    })

  (test "fold-collect-single-line"
    {do
      (= {text} "(fun {f} {1})")
      (= {ast} (parse text))
      (= {ranges} (fold/collect ast text))
      (test/assert (nil? ranges) "single-line fun should not fold")
    })

  ; --- link/collect-loads ---

  (test "link-collect-loads"
    {do
      (= {text} "(load \"src/prelude.valk\")\n(fun {f} {1})")
      (= {ast} (parse text))
      (= {links} (link/collect-loads ast text "/root"))
      (test/assert (not (nil? links)) "should find load link")
      (= {link} (head links))
      (= {target} link:target)
      (test/assert (not (== -1 (str/index-of target "prelude.valk"))) "target has filename")
    })

  (test "link-collect-no-loads"
    {do
      (= {text} "(fun {f} {1})")
      (= {ast} (parse text))
      (= {links} (link/collect-loads ast text "/root"))
      (test/assert (nil? links) "no loads = no links")
    })

  ; --- sel/find-ranges ---

  (test "sel-find-ranges"
    {do
      (= {text} "(fun {f x}\n  (+ x 1))")
      (= {positions} (list (list :line 1 :character 5)))
      (= {ranges} (sel/find-ranges text (parse text) positions))
      (test/assert (not (nil? ranges)) "should return ranges")
      (= {first-sel} (head ranges))
      (test/assert (not (nil? first-sel:range)) "should have range")
    })

  ; --- sel/build-nested ---

  (test "sel-build-nested-empty"
    {do
      (= {result} (sel/build-nested nil))
      (test/assert (not (nil? result:range)) "fallback range")
    })

  (test "sel-build-nested-single"
    {do
      (= {r} (list :start (list :line 0 :character 0) :end (list :line 0 :character 5)))
      (= {result} (sel/build-nested (list r)))
      (= {rng} result:range)
      (= {start-pos} rng:start)
      (test/assert-eq 0 start-pos:line "line 0")
      (test/assert (nil? result:parent) "no parent for single range")
    })

  (test "sel-build-nested-two"
    {do
      (= {r1} (list :start (list :line 0 :character 0) :end (list :line 0 :character 10)))
      (= {r2} (list :start (list :line 0 :character 2) :end (list :line 0 :character 5)))
      (= {result} (sel/build-nested (list r1 r2)))
      (test/assert (not (nil? result:parent)) "should have parent")
    })

  ; --- sem/filter-range ---

  (test "sem-filter-range-all-in"
    {do
      (= {tokens} (sem/parse-flat (list 0 5 3 1 0  1 2 4 0 0)))
      (= {filtered} (sem/filter-range tokens 0 10 0 nil))
      (test/assert-eq 2 (len filtered) "all 2 tokens in range")
    })

  (test "sem-filter-range-partial"
    {do
      (= {tokens} (sem/parse-flat (list 0 5 3 1 0  5 2 4 0 0  1 1 2 0 0)))
      (= {filtered} (sem/filter-range tokens 0 3 0 nil))
      (test/assert-eq 1 (len filtered) "only first token in range 0-3")
    })

  (test "sem-filter-range-empty"
    {do
      (= {tokens} (sem/parse-flat (list 10 5 3 1 0)))
      (= {filtered} (sem/filter-range tokens 0 3 0 nil))
      (test/assert (nil? filtered) "token beyond range -> empty")
    })

  ; --- ca/extract-name-from-msg ---

  (test "ca-extract-name"
    {do
      (test/assert-eq "foo" (ca/extract-name-from-msg "Symbol 'foo' is not defined")
        "should extract foo")
      (test/assert-eq "bar" (ca/extract-name-from-msg "Function 'bar' is not defined")
        "should extract bar")
    })

  (test "ca-extract-name-short-msg"
    {do
      (test/assert (nil? (ca/extract-name-from-msg "no quotes")) "no quotes -> nil")
    })

  ; --- ca/check-undefined ---

  (test "ca-check-undefined-symbol"
    {do
      (reset-state)
      (= {d} (list :message "Symbol 'xyz' is not defined" :range (list :start (list :line 0 :character 0))))
      (= {actions} (ca/check-undefined "Symbol 'xyz' is not defined" d "file:///a.valk"))
      (test/assert (nil? actions) "no db = no suggestions")
    })

  (test "ca-check-undefined-non-match"
    {do
      (= {actions} (ca/check-undefined "Some other error" nil "file:///a"))
      (test/assert (nil? actions) "non-matching message -> nil")
    })

  ; =========================================================================
  ; Handler tests (with response capture)
  ; =========================================================================

  ; --- handle-hover ---

  (test "handle-hover-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (handle-hover 1 (TextDocPosParams :textDocument (LspTextDoc :uri "file:///x") :position (LspPosition :line 0 :character 0)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (test/assert-eq 1 resp:id "id=1")
    })

