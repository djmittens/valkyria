  ; =========================================================================
  ; Tests with in-memory symdb
  ; =========================================================================

  (test "handle-document-symbols-with-db"
    {do
      (setup-with-db)
      (= {text} "(fun {my-func x} {+ x 1})\n(def {MY_VAR} 42)")
      (seed-doc "file:///test/ds.valk" text)
      (reset-captures)
      (handle-document-symbols 31
        (DocParams :textDocument (LspTextDoc :uri "file:///test/ds.valk")))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should have symbols")
    })

  (test "handle-workspace-symbols-with-db"
    {do
      (setup-with-db)
      (seed-doc "file:///test/ws.valk" "(fun {alpha x} {x})\n(fun {beta y} {y})")
      (reset-captures)
      (handle-workspace-symbols 32 (list :query "alp"))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should find alpha")
    })

  (test "handle-workspace-symbols-empty-query"
    {do
      (setup-with-db)
      (seed-doc "file:///test/ws2.valk" "(fun {gamma} {1})")
      (reset-captures)
      (handle-workspace-symbols 33 (list :query ""))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "empty query -> all symbols")
    })

  (test "handle-definition-with-db"
    {do
      (setup-with-db)
      (= {text} "(fun {target x} {x})\n(target 42)")
      (seed-doc "file:///test/def.valk" text)
      (lsp/doc-store "file:///test/def.valk" text)
      (reset-captures)
      (handle-definition 34
        (TextDocPosParams :textDocument (LspTextDoc :uri "file:///test/def.valk") :position (LspPosition :line 1 :character 1)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should respond")
    })

  (test "handle-code-lens-with-db"
    {do
      (setup-with-db)
      (= {text} "(fun {my-fn x} {x})\n(my-fn 42)")
      (seed-doc "file:///test/cl.valk" text)
      (reset-captures)
      (handle-code-lens 35
        (DocParams :textDocument (LspTextDoc :uri "file:///test/cl.valk")))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should have code lenses")
    })

  (test "lens-build-from-syms-empty"
    {do
      (test/assert (nil? (lens/build-from-syms nil nil)) "nil syms -> nil lenses")
    })

  (test "handle-completion-with-db"
    {do
      (setup-with-db)
      (= {text} "(fun {my-awesome-fn x} {x})")
      (seed-doc "file:///test/comp.valk" text)
      (lsp/doc-store "file:///test/comp.valk" "(my-awe")
      (reset-captures)
      (handle-completion 36
        (TextDocPosParams :textDocument (LspTextDoc :uri "file:///test/comp.valk") :position (LspPosition :line 0 :character 7)))
      (= {resp} (last-response))
      (= {result} resp:result)
      (= {items} result:items)
      (test/assert (not (nil? items)) "should have completion items from db")
    })

  (test "handle-code-action-with-db"
    {do
      (setup-with-db)
      (seed-doc "file:///test/ca.valk" "(fun {println x} {x})")
      (reset-captures)
      (handle-code-action 37
        (CodeActionParams :textDocument (LspTextDoc :uri "file:///test/ca.valk")
              :range (LspRange :start (LspPosition :line 0 :character 0) :end (LspPosition :line 0 :character 6))
              :context (CodeActionContext :diagnostics
                (list (list :message "Function 'printl' is not defined"
                            :range (list :start (list :line 0 :character 0)
                                         :end (list :line 0 :character 6)))))))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should suggest println")
    })

  ; --- handle-rename with scoped refs ---

  (test "handle-rename-scoped"
    {do
      (reset-state)
      (lsp/doc-store "file:///rn.valk" "(fun {f x}\n  (+ x 1))")
      (reset-captures)
      (handle-rename 38
        (RenameParams :textDocument (LspTextDoc :uri "file:///rn.valk")
              :position (LspPosition :line 1 :character 5)
              :newName "y"))
      (= {resp} (last-response))
      (= {result} resp:result)
      (= {changes} result:documentChanges)
      (test/assert (not (nil? changes)) "should have document changes")
    })

  ; --- lsp/publish-diagnostics ---

  (test "publish-diagnostics-with-errors"
    {do
      (reset-state)
      (reset-captures)
      (lsp/publish-diagnostics "file:///err.valk" "(undefined-symbol-xyz 42)")
      (= {notif} (last-notification))
      (test/assert-eq "textDocument/publishDiagnostics" notif:method "method")
      (= {params} notif:params)
      (= {diags} params:diagnostics)
      (test/assert (not (nil? diags)) "should have diagnostics for undefined symbol")
    })

  (test "publish-diagnostics-valid"
    {do
      (reset-state)
      (reset-captures)
      (lsp/publish-diagnostics "file:///ok.valk" "(+ 1 2)")
      (= {notif} (last-notification))
      (test/assert-eq "textDocument/publishDiagnostics" notif:method "method")
    })

  ; --- progress helpers ---

  (test "progress-begin"
    {do
      (reset-state)
      (reset-captures)
      (lsp/progress-begin 1 "Indexing" 10)
      (= {notif} (last-notification))
      (test/assert-eq "$/progress" notif:method "method")
      (= {p} notif:params)
      (= {value} p:value)
      (test/assert-eq "begin" value:kind "kind=begin")
    })

  (test "progress-report"
    {do
      (reset-state)
      (reset-captures)
      (lsp/progress-report 1 "50 files" 50)
      (= {notif} (last-notification))
      (= {p} notif:params)
      (= {value} p:value)
      (test/assert-eq "report" value:kind "kind=report")
      (test/assert-eq 50 value:percentage "percentage=50")
    })

  (test "progress-end"
    {do
      (reset-state)
      (reset-captures)
      (lsp/progress-end 1 "Done")
      (= {notif} (last-notification))
      (= {p} notif:params)
      (= {value} p:value)
      (test/assert-eq "end" value:kind "kind=end")
    })

  ; --- lsp/capabilities structure ---

  (test "capabilities-structure"
    {do
      (= {caps} lsp/capabilities:capabilities)
      (test/assert-eq :true caps:hoverProvider "hover")
      (test/assert-eq :true caps:definitionProvider "definition")
      (test/assert-eq :true caps:referencesProvider "references")
    })

) {:suite-name "LSP Handlers" :debug 0})
