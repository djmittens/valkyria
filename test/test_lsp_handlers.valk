  ; --- lsp/on-message dispatch ---

  (test "dispatch-nil-method"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\"}")
      (test/assert (nil? (last-response)) "no method -> no response")
      (test/assert (nil? (last-error)) "no method -> no error")
    })

  (test "dispatch-shutdown"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}")
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (test/assert-eq 1 (plist/get resp :id) "response id=1")
      (test/assert-eq 0 *aio-stopped* "shutdown should not stop, exit does")
    })

  (test "dispatch-exit"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
      (test/assert-eq 1 *aio-stopped* "exit should call aio/stop")
    })

  (test "dispatch-initialized"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}")
