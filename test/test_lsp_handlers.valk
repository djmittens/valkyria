  ; --- lsp/capabilities structure ---

  (test "capabilities-structure"
    {do
      (= {caps} (plist/get lsp/capabilities :capabilities))
      (test/assert-eq :true (plist/get caps :hoverProvider) "hover")
      (test/assert-eq :true (plist/get caps :definitionProvider) "definition")
      (test/assert-eq :true (plist/get caps :referencesProvider) "references")
    })

) {:suite-name "LSP Handlers" :debug 0})
