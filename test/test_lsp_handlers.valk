  ; --- handle-hover ---

  (test "handle-hover-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (handle-hover 1 (list :textDocument (list :uri "file:///x")
                             :position (list :line 0 :character 0)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (test/assert-eq 1 (plist/get resp :id) "id=1")
    })

  (test "handle-hover-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///h.valk" "hello world")
      (reset-captures)
      (handle-hover 2 (list :textDocument (list :uri "file:///h.valk")
                             :position (list :line 0 :character 0)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (= {result} (plist/get resp :result))
      (= {contents} (plist/get result :contents))
      (test/assert-eq "markdown" (plist/get contents :kind) "markdown kind")
      (test/assert (not (== -1 (str/index-of (plist/get contents :value) "hello")))
        "hover contains word")
    })

