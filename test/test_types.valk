; ADT type system integration tests

(load "src/prelude.valk")
(load "src/modules/test.valk")

; === Type declarations ===
(type {Color} {Red} {Green} {Blue})

(type {Person}
  {:name Str :age Num :email Str})

(type {Shape}
  {Circle :radius Num}
  {Rect :w Num :h Num})

(type {Option a}
  {None}
  {Some :value a})

(type {Result ok err}
  {Ok :value ok}
  {Err :error err})

; Parametric type definitions (must be top-level for type transform)
(type {Item} {:label Str :value Num})

(sig 'get-items {-> Num (List Item)})
(fun {get-items n} {
  list (Item :label "a" :value n) (Item :label "b" :value (+ n 1))
})

(test/run (list

  ; === Enum tests ===
  (test "enum-constructor-red"
    {do
      (= {c} (Red))
      (test/assert (== (head c) (head {Color::Red})) "Red should have tag Color::Red")
    })

  (test "enum-constructor-blue"
    {do
      (= {c} (Blue))
      (test/assert (== (head c) (head {Color::Blue})) "Blue should have tag Color::Blue")
    })

  (test "enum-match"
    {do
      (= {color-name} (\ {c} {
        match c
          {(Red)   "red"}
          {(Green) "green"}
          {(Blue)  "blue"}
      }))
      (test/assert (== (color-name (Red)) "red") "Red -> red")
      (test/assert (== (color-name (Green)) "green") "Green -> green")
      (test/assert (== (color-name (Blue)) "blue") "Blue -> blue")
    })

  ; === Product type tests ===
  (test "product-keyword-construction"
    {do
      (= {p} (Person :name "Alice" :age 30 :email "a@b.com"))
      (test/assert (== (head p) (head {Person})) "tag is Person")
      (test/assert (== (nth 2 p) "Alice") "name is Alice")
      (test/assert (== (nth 3 p) 30) "age is 30")
      (test/assert (== (nth 4 p) "a@b.com") "email is a@b.com")
    })

  (test "product-positional-construction"
    {do
      (= {p} (Person "Bob" 25 "b@b.com"))
      (test/assert (== (nth 2 p) "Bob") "name is Bob")
      (test/assert (== (nth 3 p) 25) "age is 25")
    })

  (test "product-accessor"
    {do
      (= {p} (Person :name "Alice" :age 30 :email "a@b.com"))
      (test/assert (== (Person:name p) "Alice") "Person:name works")
      (test/assert (== (Person:age p) 30) "Person:age works")
      (test/assert (== (Person:email p) "a@b.com") "Person:email works")
    })

  ; === Sum type tests ===
  (test "sum-keyword-construction"
    {do
      (= {s1} (Circle :radius 5))
      (= {s2} (Rect :w 10 :h 20))
      (test/assert (== (head s1) (head {Shape::Circle})) "Circle tag")
      (test/assert (== (nth 2 s1) 5) "Circle radius")
      (test/assert (== (head s2) (head {Shape::Rect})) "Rect tag")
      (test/assert (== (nth 2 s2) 10) "Rect width")
    })

  (test "sum-positional-construction"
    {do
      (= {s} (Circle 7))
      (test/assert (== (Circle:radius s) 7) "positional Circle:radius")
    })

  (test "sum-accessor"
    {do
      (= {s} (Rect :w 10 :h 20))
      (test/assert (== (Rect:w s) 10) "Rect:w works")
      (test/assert (== (Rect:h s) 20) "Rect:h works")
    })

  (test "sum-match-named"
    {do
      (= {area} (\ {s} {
        match s
          {(Circle :radius r) (* 3 (* r r))}
          {(Rect :w w :h h)   (* w h)}
      }))
      (test/assert (== (area (Circle 5)) 75) "Circle area")
      (test/assert (== (area (Rect 10 20)) 200) "Rect area")
    })

  (test "sum-match-positional"
    {do
      (= {area2} (\ {s} {
        match s
          {(Circle r) (* 3 (* r r))}
          {(Rect w h) (* w h)}
      }))
      (test/assert (== (area2 (Circle 4)) 48) "positional Circle area")
      (test/assert (== (area2 (Rect 3 5)) 15) "positional Rect area")
    })

  ; === Option type tests ===
  (test "option-some"
    {do
      (= {x} (Some :value 42))
      (test/assert (== (head x) (head {Option::Some})) "Some tag")
      (test/assert (== (Some:value x) 42) "Some:value")
    })

  (test "option-none"
    {do
      (= {y} (None))
      (test/assert (== (head y) (head {Option::None})) "None tag")
    })

  (test "option-match"
    {do
      (= {unwrap-or} (\ {opt default} {
        match opt
          {(Some :value v) v}
          {(None) default}
      }))
      (test/assert (== (unwrap-or (Some 42) 0) 42) "unwrap Some")
      (test/assert (== (unwrap-or (None) 0) 0) "unwrap None")
    })

  (test "match-wildcard"
    {do
      (= {is-some} (\ {opt} {
        match opt
          {(Some :value v) 1}
          {_ 0}
      }))
      (test/assert (== (is-some (Some 1)) 1) "wildcard Some")
      (test/assert (== (is-some (None)) 0) "wildcard None")
    })

  ; === Result type tests ===
  (test "result-ok"
    {do
      (= {r} (Ok :value 42))
      (test/assert (== (Ok:value r) 42) "Ok:value")
    })

  (test "result-err"
    {do
      (= {r} (Err :error "oops"))
      (test/assert (== (Err:error r) "oops") "Err:error")
    })

  (test "result-match"
    {do
      (= {result-or} (\ {r default} {
        match r
          {(Ok :value v) v}
          {(Err :error e) default}
      }))
      (test/assert (== (result-or (Ok 10) 0) 10) "result-or Ok")
      (test/assert (== (result-or (Err "bad") 0) 0) "result-or Err")
    })

  ; === Constructor in nested expressions ===
  (test "nested-constructor"
    {do
      (= {x} (Some (Some 42)))
      (test/assert (== (head x) (head {Option::Some})) "outer Some tag")
      (= {inner} (Some:value x))
      (test/assert (== (head inner) (head {Option::Some})) "inner Some tag")
      (test/assert (== (Some:value inner) 42) "inner value")
    })

  ; === var:field inference tests ===

  (test "field-access-product"
    {do
      (= {p} (Person :name "Alice" :age 30 :email "a@b.com"))
      (test/assert (== p:name "Alice") "name:p works")
      (test/assert (== p:age 30) "age:p works")
      (test/assert (== p:email "a@b.com") "email:p works")
    })

  (test "field-access-sum"
    {do
      (= {s} (Circle :radius 5))
      (test/assert (== s:radius 5) "radius:s works")
    })

  (test "field-access-sum-rect"
    {do
      (= {r} (Rect :w 10 :h 20))
      (test/assert (== r:w 10) "w:r works")
      (test/assert (== r:h 20) "h:r works")
    })

  (test "field-access-inline"
    {do
      (= {p} (Person :name "Bob" :age 25 :email "b@b.com"))
      (test/assert (== (str/join (list p:name "!") "") "Bob!") "field access inline in call")
    })

  (test "field-access-in-condition"
    {do
      (= {p} (Person :name "Alice" :age 30 :email "a@b.com"))
      (test/assert (if (> p:age 18) true false) "field access in condition")
    })

  (test "field-access-nested-do"
    {do
      (= {result}
        (do
          (= {p} (Person :name "Inner" :age 1 :email "x"))
          p:name))
      (test/assert (== result "Inner") "field access in nested do")
    })

  (test "field-access-multiple-bindings"
    {do
      (= {p1} (Person :name "Alice" :age 30 :email "a@a.com"))
      (= {p2} (Person :name "Bob" :age 25 :email "b@b.com"))
      (test/assert (== p1:name "Alice") "p1 name")
      (test/assert (== p2:name "Bob") "p2 name")
    })

  (test "field-access-option"
    {do
      (= {x} (Some :value 42))
      (test/assert (== x:value 42) "value:x works for Some")
    })

  (test "field-access-result"
    {do
      (= {r} (Ok :value 99))
      (test/assert (== r:value 99) "value:r works for Ok")
    })


  ; === sig-based type inference tests ===

  (test "sig-return-type-inference"
    {do
      (= {lookup-result} (Some :value 42))
      (test/assert (== lookup-result:value 42) "inferred from constructor binding")
    })

  (test "sig-param-inference"
    {do
      (= {check-name} (\ {p} {do (Person:name p)}))
      (test/assert (== (check-name (Person :name "Z" :age 1 :email "z")) "Z") "explicit accessor in lambda")
    })


  ; === parametric type inference ===

  (test "parametric-head-infers-type"
    {do
      (= {items} (get-items 10))
      (= {first} (head items))
      (test/assert-eq "a" first:label "head of (List Item) infers Item type")
      (test/assert-eq 10 first:value "field:var on head result")
    })

  (test "parametric-tail-preserves-type"
    {do
      (= {items} (get-items 10))
      (= {rest} (tail items))
      (= {second} (head rest))
      (test/assert-eq "b" second:label "head of tail of (List Item)")
      (test/assert-eq 11 second:value "field:var on head-of-tail")
    })

  (test "parametric-filter-preserves-type"
    {do
      (= {items} (get-items 10))
      (= {filtered} (filter (\ {x} {== (Item:label x) "b"}) items))
      (= {first} (head filtered))
      (test/assert-eq "b" first:label "head of filter result")
    })

  (test "parametric-reverse-preserves-type"
    {do
      (= {items} (get-items 10))
      (= {rev} (reverse items))
      (= {first} (head rev))
      (test/assert-eq "b" first:label "head of reverse result")
    })

  ; === record update (with) ===

  (test "with-single-field"
    {do
      (= {p} (Person :name "Alice" :age 30 :email "a@b"))
      (= {p2} (with p :age 31))
      (test/assert-eq "Alice" p2:name "unchanged field preserved")
      (test/assert-eq 31 p2:age "updated field changed")
      (test/assert-eq "a@b" p2:email "other unchanged field preserved")
    })

  (test "with-multiple-fields"
    {do
      (= {p} (Person :name "Bob" :age 25 :email "b@c"))
      (= {p2} (with p :name "Robert" :email "robert@c"))
      (test/assert-eq "Robert" p2:name "first override applied")
      (test/assert-eq 25 p2:age "non-overridden field preserved")
      (test/assert-eq "robert@c" p2:email "second override applied")
    })

  (test "with-preserves-type-inference"
    {do
      (= {p} (Person :name "Carol" :age 40 :email "c@d"))
      (= {p2} (with p :age 41))
      (= {p3} (with p2 :email "carol@d"))
      (test/assert-eq "Carol" p3:name "chained with preserves name")
      (test/assert-eq 41 p3:age "chained with preserves age update")
      (test/assert-eq "carol@d" p3:email "chained with applies email update")
    })

  (test "with-in-fun-body"
    {do
      (= {p} (Person :name "Dan" :age 20 :email "d@e"))
      (= {p2} (with p :age (+ p:age 1)))
      (test/assert-eq 21 p2:age "with in do block works")
      (test/assert-eq "Dan" p2:name "with preserves other fields")
    })

  ; === callable keywords ===

  (test "keyword-as-function"
    {do
      (= {pl} (list :name "Alice" :age 30))
      (test/assert-eq "Alice" (:name pl) "keyword call extracts value")
      (test/assert-eq 30 (:age pl) "keyword call extracts number")
    })

  (test "keyword-on-nil"
    {do
      (test/assert (nil? (:name nil)) "keyword on nil returns nil")
    })

  (test "keyword-missing-key"
    {do
      (= {pl} (list :name "Alice"))
      (test/assert (nil? (:age pl)) "missing key returns nil")
    })

  (test "keyword-nested-access"
    {do
      (= {outer} (list :inner (list :value 42)))
      (test/assert-eq 42 (:value (:inner outer)) "nested keyword access")
    })



  ; === Plist fallback tests ===
  (test "field-var-plist-fallback"
    {do
      (= {td} (list :uri "/test.valk" :text "hello"))
      (test/assert-eq "/test.valk" td:uri "field:var falls back to plist/get for untyped vars")
    })

  (test "field-var-plist-fallback-multiple"
    {do
      (= {info} (list :name "Alice" :age 30 :city "NYC"))
      (test/assert-eq "Alice" info:name "plist fallback name")
      (test/assert-eq 30 info:age "plist fallback age")
      (test/assert-eq "NYC" info:city "plist fallback city")
    })

  (test "field-var-plist-fallback-nil"
    {do
      (= {data} (list :x 1))
      (test/assert (nil? data:y) "plist fallback returns nil for missing key")
    })

  (test "field-var-typed-still-works"
    {do
      (= {p} (Person :name "Bob" :age 25 :email "bob@x.com"))
      (test/assert-eq "Bob" p:name "typed var:field still compiles to nth")
      (test/assert-eq 25 p:age "typed var:field age")
    })



  ; === Chaining tests ===
  (test "chain-plist-two-levels"
    {do
      (= {data} (list :user (list :name "Alice" :age 30)))
      (test/assert-eq "Alice" data:user:name "two-level chain")
      (test/assert-eq 30 data:user:age "two-level chain age")
    })

  (test "chain-plist-three-levels"
    {do
      (= {root} (list :a (list :b (list :c 42))))
      (test/assert-eq 42 root:a:b:c "three-level chain")
    })

  (test "chain-plist-nested-object"
    {do
      (= {data} (list :person (list :name "Bob" :age 25)))
      (test/assert-eq "Bob" data:person:name "plist nested object")
      (test/assert-eq 25 data:person:age "plist nested age")
    })

  (test "chain-nil-propagates"
    {do
      (= {data} (list :x (list :y 1)))
      (test/assert (nil? data:z:y) "missing first field returns nil, second is nil")
    })


))
