(load "src/prelude.valk")
(load "src/modules/test.valk")
(load "src/symdb.valk")
(load "src/lsp-analysis.valk")
(load "src/lsp-validate.valk")

(fun {make-test-db} {do
  (= {db} (sqlite/open ":memory:"))
  (sqlite/exec-script db symdb/schema-sql)
  (= {r} (sqlite/exec db "ALTER TABLE symbols ADD COLUMN sig TEXT"))
  db
})

(fun {find-ref-by-name refs name} {
  head (filter (\{r} {== name:r name}) refs)
})

(fun {refs-with-name refs name} {
  filter (\{r} {== name:r name}) refs
})

(fun {ref-count text} {
  len (ref/collect-refs text)
})

(fun {ref-names text} {
  map (\{r} {name:r}) (ref/collect-refs text)
})

(fun {ref-defs text} {
  filter (\{r} {== is-def:r 1}) (ref/collect-refs text)
})

(fun {ref-uses text} {
  filter (\{r} {== is-def:r 0}) (ref/collect-refs text)
})

(test/run (list

  ; --- Basic reference collection ---

  (test "empty-no-refs"
    {do
      (test/assert-eq 0 (ref-count "")
        "empty input should produce 0 refs")
      true
    })

  (test "single-symbol-ref"
    {do
      (test/assert-eq 1 (ref-count "foo")
        "single symbol should produce 1 ref")
      (= {refs} (ref/collect-refs "foo"))
      (= {r} (head refs))
      (test/assert-eq "foo" name:r "name should be foo")
      (test/assert-eq 0 is-def:r "should be use, not def")
      (test/assert-eq -1 scope-id:r "global scope = -1")
      true
    })

  (test "keywords-excluded"
    {do
      (test/assert-eq 0 (ref-count ":foo")
        "keyword :foo should not produce refs")
      true
    })

  (test "numbers-excluded"
    {do
      (test/assert-eq 0 (ref-count "42")
        "numbers should not produce refs")
      true
    })

  (test "strings-excluded"
    {do
      (test/assert-eq 0 (ref-count "\"hello\"")
        "strings should not produce refs")
      true
    })

  ; --- Function definitions ---

  (test "fun-records-name-as-def"
    {do
      (= {defs} (ref-defs "(fun {f x} {x})"))
      (= {names} (map (\{r} {name:r}) defs))
      (test/assert (member? "f" names) "f should be recorded as def")
      true
    })

  (test "fun-params-recorded-as-defs"
    {do
      (= {defs} (ref-defs "(fun {f a b} {+ a b})"))
      (= {names} (map (\{r} {name:r}) defs))
      (test/assert (member? "a" names) "param a should be def")
      (test/assert (member? "b" names) "param b should be def")
      true
    })

  (test "fun-name-is-global-scope"
    {do
      (= {defs} (ref-defs "(fun {f x} {x})"))
      (= {f-def} (head (filter (\{r} {== name:r "f"}) defs)))
      (test/assert-eq -1 scope-id:f-def
        "function name should be global scope (-1)")
      true
    })

  (test "fun-params-scoped-to-fun"
    {do
      (= {defs} (ref-defs "(fun {f x} {x})"))
      (= {x-def} (head (filter (\{r} {== name:r "x"}) defs)))
      (test/assert (!= -1 scope-id:x-def)
        "param should be scoped to fun, not global")
      true
    })

  ; --- Lambda ---

  (test "lambda-params-as-defs"
    {do
      (= {defs} (ref-defs "(\\ {a} {a})"))
      (= {names} (map (\{r} {name:r}) defs))
      (test/assert (member? "a" names) "lambda param should be def")
      true
    })

  (test "lambda-body-uses-scoped"
    {do
      (= {uses} (ref-uses "(\\ {x} {x})"))
      (= {x-use} (head (filter (\{r} {== name:r "x"}) uses)))
      (test/assert (not (nil? x-use)) "should have use of x in body")
      (test/assert (!= -1 scope-id:x-use)
        "body ref to x should be scoped to lambda")
      true
    })

  ; --- def / = bindings ---

  (test "def-records-global-defs"
    {do
      (= {defs} (ref-defs "(def {myvar} 42)"))
      (= {names} (map (\{r} {name:r}) defs))
      (test/assert (member? "myvar" names) "def should record myvar as def")
      (= {mv} (head (filter (\{r} {== name:r "myvar"}) defs)))
      (test/assert-eq -1 scope-id:mv "def should be global")
      true
    })

  (test "assign-records-local-defs"
    {do
      (= {refs} (ref/collect-refs "(fun {f} {do (= {x} 1) x})"))
      (= {defs} (filter (\{r} {== is-def:r 1}) refs))
      (= {x-def} (head (filter (\{r} {== name:r "x"}) defs)))
      (test/assert (not (nil? x-def)) "= should record x as def")
      true
    })

  ; --- do block scope threading ---

  (test "do-threads-assign-scope"
    {do
      (= {refs} (ref/collect-refs "(fun {f} {do (= {x} 1) x})"))
      (= {uses} (filter (\{r} {== is-def:r 0}) refs))
      (= {x-use} (head (filter (\{r} {== name:r "x"}) uses)))
      (test/assert (not (nil? x-use)) "x should have a use ref after = binding")
      (test/assert (!= -1 scope-id:x-use )
        "x use after = should be scoped")
      true
    })

  ; --- type ---

  (test "type-records-type-and-ctors"
    {do
      (= {defs} (ref-defs "(type {Color} {Red} {Green} {Blue})"))
      (= {names} (map (\{r} {name:r}) defs))
      (test/assert (member? "Color" names) "type name should be def")
      (test/assert (member? "Red" names) "constructor should be def")
      (test/assert (member? "Green" names) "constructor should be def")
      true
    })

  ; --- sig skipped ---

  (test "sig-produces-no-refs"
    {do
      (test/assert-eq 0 (ref-count "(sig 'foo {-> Num Num})")
        "sig should not produce any refs")
      true
    })

  ; --- Ampersand ---

  (test "ampersand-skipped"
    {do
      (= {defs} (ref-defs "(fun {f x & rest} {rest})"))
      (= {names} (map (\{r} {name:r}) defs))
      (test/assert (not (member? "&" names)) "& should not be a param def")
      (test/assert (member? "rest" names) "rest should be a param def")
      true
    })

  ; --- ref/find-at-offset ---

  (test "find-at-offset-hit"
    {do
      (= {refs} (ref/collect-refs "foo"))
      (= {r} (ref/find-at-offset refs 0))
      (test/assert (not (nil? r)) "should find ref at offset 0")
      (test/assert-eq "foo" name:r "should be foo")
      true
    })

  (test "find-at-offset-miss"
    {do
      (= {refs} (ref/collect-refs "foo"))
      (= {r} (ref/find-at-offset refs 100))
      (test/assert (nil? r) "should not find ref at offset 100")
      true
    })

  ; --- ref/matching-refs ---

  (test "matching-refs-by-scope"
    {do
      (= {refs} (ref/collect-refs "(fun {f x} {x})"))
      (= {x-ref} (head (filter (\{r} {== name:r "x"}) refs)))
      (= {scope} scope-id:x-ref)
      (= {matched} (ref/matching-refs refs "x" scope nil))
      (test/assert (>= (len matched) 2)
        "should match both def and use of x in same scope")
      true
    })

  ; --- line-col->offset ---

  (test "line-col-first-line"
    {do
      (test/assert-eq 3 (line-col->offset "abcdef" 0 3)
        "line 0, col 3 = offset 3")
      true
    })

  (test "line-col-second-line"
    {do
      (test/assert-eq 4 (line-col->offset "abc\ndef" 1 0)
        "line 1, col 0 = offset 4 (after abc\\n)")
      true
    })

  (test "line-col-second-line-with-col"
    {do
      (test/assert-eq 6 (line-col->offset "abc\ndef" 1 2)
        "line 1, col 2 = offset 6")
      true
    })

  ; --- ref/find-scoped-refs ---

  (test "scoped-refs-local"
    {do
      (= {text} "(fun {f x} {+ x x})")
      (= {refs} (ref/find-scoped-refs text 0 7))
      (test/assert (nil? refs) "scoped refs currently returns nil for params (known limitation)")
      true
    })

  (test "scoped-refs-global-returns-nil"
    {do
      (= {text} "(fun {f x} {x})")
      (= {refs} (ref/find-scoped-refs text 0 5))
      (test/assert (nil? refs) "global symbol f should return nil from scoped-refs")
      true
    })

  ; --- Parse error ---

  (test "parse-error-no-crash"
    {do
      (= {refs} (ref/collect-refs "(unclosed"))
      (test/assert (nil? refs) "parse error should return nil, not crash")
      true
    })

  ; =========================================================================
  ; symdb/extract-refs — position accuracy
  ; =========================================================================

  (test "extract-refs-single-line-positions"
    {do
      (= {refs} (symdb/extract-refs "(+ a b)"))
      (test/assert-eq 3 (len refs) "should extract 3 refs")
      (= {r-plus} (find-ref-by-name refs "+"))
      (= {r-a} (find-ref-by-name refs "a"))
      (= {r-b} (find-ref-by-name refs "b"))
      (test/assert-eq 0 line:r-plus "+ line")
      (test/assert-eq 1 col:r-plus "+ col")
      (test/assert-eq 0 line:r-a "a line")
      (test/assert-eq 3 col:r-a "a col")
      (test/assert-eq 0 line:r-b "b line")
      (test/assert-eq 5 col:r-b "b col")
      true
    })

  (test "extract-refs-multiline-positions"
    {do
      (= {refs} (symdb/extract-refs "(fun {f x}\n  {+ x 1})"))
      (= {r-fun} (find-ref-by-name refs "fun"))
      (= {r-f} (find-ref-by-name refs "f"))
      (= {r-plus} (find-ref-by-name refs "+"))
      (test/assert-eq 0 line:r-fun "fun on line 0")
      (test/assert-eq 1 col:r-fun "fun at col 1")
      (test/assert-eq 0 line:r-f "f on line 0")
      (test/assert-eq 6 col:r-f "f at col 6")
      (test/assert-eq 1 line:r-plus "+ on line 1")
      (test/assert-eq 3 col:r-plus "+ at col 3")
      (= {x-refs} (refs-with-name refs "x"))
      (test/assert-eq 2 (len x-refs) "x appears twice (param + body)")
      (= {x1} (head x-refs))
      (= {x2} (head (tail x-refs)))
      (test/assert-eq 0 line:x1 "first x on line 0")
      (test/assert-eq 8 col:x1 "first x at col 8")
      (test/assert-eq 1 line:x2 "second x on line 1")
      (test/assert-eq 5 col:x2 "second x at col 5")
      true
    })

  (test "extract-refs-nested-expr"
    {do
      (= {refs} (symdb/extract-refs "(if (> a 0) {a} {b})"))
      (= {names} (map (\{r} {name:r}) refs))
      (test/assert (member? "if" names) "should have if")
      (test/assert (member? ">" names) "should have >")
      (test/assert (member? "b" names) "should have b")
      (= {a-refs} (refs-with-name refs "a"))
      (test/assert-eq 2 (len a-refs) "a appears twice (condition + then)")
      (= {r-if} (find-ref-by-name refs "if"))
      (test/assert-eq 1 col:r-if "if at col 1")
      (= {r-gt} (find-ref-by-name refs ">"))
      (test/assert-eq 5 col:r-gt "> at col 5")
      (= {r-b} (find-ref-by-name refs "b"))
      (test/assert-eq 17 col:r-b "b at col 17")
      true
    })

  (test "extract-refs-fun-all-symbols"
    {do
      (= {refs} (symdb/extract-refs "(fun {f x y} {+ x y})"))
      (= {names} (map (\{r} {name:r}) refs))
      (test/assert (member? "fun" names) "should have fun")
      (test/assert (member? "f" names) "should have f")
      (test/assert (member? "x" names) "should have x")
      (test/assert (member? "y" names) "should have y")
      (test/assert (member? "+" names) "should have +")
      (= {x-refs} (refs-with-name refs "x"))
      (test/assert-eq 2 (len x-refs) "x appears twice (param + body)")
      (= {y-refs} (refs-with-name refs "y"))
      (test/assert-eq 2 (len y-refs) "y appears twice (param + body)")
      true
    })

  (test "extract-refs-skips-nil-false-otherwise"
    {do
      (= {refs1} (symdb/extract-refs "nil"))
      (test/assert-eq 0 (len refs1) "nil should produce 0 refs")
      (= {refs2} (symdb/extract-refs "false"))
      (test/assert-eq 0 (len refs2) "false should produce 0 refs")
      (= {refs3} (symdb/extract-refs "(match x {otherwise 0})"))
      (= {names} (map (\{r} {name:r}) refs3))
      (test/assert (not (member? "otherwise" names)) "otherwise excluded")
      (test/assert (member? "match" names) "match is a valid ref")
      (test/assert (member? "x" names) "x is a valid ref")
      true
    })

  (test "extract-refs-numbers-strings-not-extracted"
    {do
      (= {refs} (symdb/extract-refs "(+ 42 \"hello\")"))
      (test/assert-eq 1 (len refs) "only + should be extracted")
      (= {first-ref} (head refs))
      (test/assert-eq "+" name:first-ref "ref should be +")
      true
    })

  (test "extract-refs-empty-input"
    {do
      (= {refs} (symdb/extract-refs ""))
      (test/assert (nil? refs) "empty input produces nil")
      true
    })

  (test "extract-refs-def-form"
    {do
      (= {refs} (symdb/extract-refs "(def {val} 42)"))
      (= {names} (map (\{r} {name:r}) refs))
      (test/assert (member? "def" names) "def is extracted")
      (test/assert (member? "val" names) "val is extracted")
      (test/assert-eq 2 (len refs) "only def and val (42 is a number)")
      (= {r-val} (find-ref-by-name refs "val"))
      (test/assert-eq 0 line:r-val "val line 0")
      (test/assert-eq 6 col:r-val "val col 6")
      true
    })

  (test "extract-refs-type-form"
    {do
      (= {refs} (symdb/extract-refs "(type {Color} {Red} {Green})"))
      (= {names} (map (\{r} {name:r}) refs))
      (test/assert (member? "type" names) "type extracted")
      (test/assert (member? "Color" names) "Color extracted")
      (test/assert (member? "Red" names) "Red extracted")
      (test/assert (member? "Green" names) "Green extracted")
      true
    })

  (test "extract-refs-lambda"
    {do
      (= {refs} (symdb/extract-refs "(map (\\{x} {+ x 1}) items)"))
      (= {names} (map (\{r} {name:r}) refs))
      (test/assert (member? "map" names) "map extracted")
      (test/assert (member? "x" names) "x extracted")
      (test/assert (member? "+" names) "+ extracted")
      (test/assert (member? "items" names) "items extracted")
      true
    })

  ; =========================================================================
  ; symdb cross-file find-refs
  ; =========================================================================

  (test "find-refs-single-file-positions"
    {do
      (= {db} (make-test-db))
      (= {text} "(fun {helper x} {+ x 1})")
      (symdb/sync-document db "file:///a.valk" text)
      (= {refs} (symdb/find-refs db "helper"))
      (test/assert-eq 1 (len refs) "helper appears once in file")
      (= {r} (head refs))
      (test/assert-eq 0 line:r "helper line 0")
      (test/assert-eq 6 col:r "helper col 6")
      (test/assert-eq "/a.valk" path:r "path matches")
      (= {x-refs} (symdb/find-refs db "x"))
      (test/assert-eq 2 (len x-refs) "x appears twice (param + body)")
      (= {x1} (head x-refs))
      (= {x2} (head (tail x-refs)))
      (test/assert-eq 13 col:x1 "first x at col 13")
      (test/assert-eq 19 col:x2 "second x at col 19")
      (sqlite/close db)
      true
    })

  (test "find-refs-cross-file"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///a.valk" "(fun {helper x} {+ x 1})")
      (symdb/sync-document db "file:///b.valk" "(fun {main} {helper 42})")
      (= {refs} (symdb/find-refs db "helper"))
      (test/assert-eq 2 (len refs) "helper in 2 files")
      (= {paths} (map (\{r} {path:r}) refs))
      (test/assert (member? "/a.valk" paths) "found in a.valk")
      (test/assert (member? "/b.valk" paths) "found in b.valk")
      (= {r-a} (head (filter (\{r} {== path:r "/a.valk"}) refs)))
      (= {r-b} (head (filter (\{r} {== path:r "/b.valk"}) refs)))
      (test/assert-eq 6 col:r-a "helper def col in a.valk")
      (test/assert-eq 13 col:r-b "helper use col in b.valk")
      (sqlite/close db)
      true
    })

  (test "find-refs-cross-file-three-files"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///lib.valk" "(fun {add x y} {+ x y})")
      (symdb/sync-document db "file:///a.valk" "(= {r} (add 1 2))")
      (symdb/sync-document db "file:///b.valk" "(= {s} (add 3 4))")
      (= {refs} (symdb/find-refs db "add"))
      (test/assert-eq 3 (len refs) "add in 3 files")
      (= {paths} (map (\{r} {path:r}) refs))
      (test/assert (member? "/lib.valk" paths) "found in lib.valk")
      (test/assert (member? "/a.valk" paths) "found in a.valk")
      (test/assert (member? "/b.valk" paths) "found in b.valk")
      (sqlite/close db)
      true
    })

  (test "find-refs-resync-clears-old"
    {do
      (= {db} (make-test-db))
      (= {_} (symdb/sync-document db "file:///t.valk" "(fun {old-fn x} {+ x 1})"))
      (= {refs-before} (symdb/find-refs db "old-fn"))
      (test/assert-eq 1 (len refs-before) "old-fn should have 1 ref before resync")
      (= {_} (symdb/sync-document db "file:///t.valk" "(fun {new-fn y} {+ y 1 2})"))
      (= {refs-after} (symdb/find-refs db "old-fn"))
      (test/assert-eq 0 (len refs-after) "old-fn should have 0 refs after resync")
      (= {refs-new} (symdb/find-refs db "new-fn"))
      (test/assert-eq 1 (len refs-new) "new-fn should have 1 ref after resync")
      (= {_} (sqlite/close db))
      true
    })

  (test "find-refs-nonexistent-symbol"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(fun {f x} {x})")
      (= {refs} (symdb/find-refs db "nonexistent"))
      (test/assert-eq 0 (len refs) "nonexistent symbol has 0 refs")
      (sqlite/close db)
      true
    })

  (test "find-refs-ordering"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///b.valk" "(+ 1 2)")
      (symdb/sync-document db "file:///a.valk" "(+ 3 4)\n(+ 5 6)")
      (= {refs} (symdb/find-refs db "+"))
      (test/assert-eq 3 (len refs) "3 refs to +")
      (= {r1} (head refs))
      (= {r2} (head (tail refs)))
      (= {r3} (head (tail (tail refs))))
      (test/assert-eq "/a.valk" path:r1 "first ref from a.valk")
      (test/assert-eq "/a.valk" path:r2 "second ref from a.valk")
      (test/assert-eq "/b.valk" path:r3 "third ref from b.valk")
      (test/assert-eq 0 line:r1 "first + on line 0")
      (test/assert-eq 1 line:r2 "second + on line 1")
      (sqlite/close db)
      true
    })

  (test "find-refs-multiline-accuracy"
    {do
      (= {db} (make-test-db))
      (= {text} "(fun {calc x y}\n  {+ (* x y)\n     (- x y)})")
      (symdb/sync-document db "file:///t.valk" text)
      (= {x-refs} (symdb/find-refs db "x"))
      (test/assert-eq 3 (len x-refs) "x appears 3 times (param + 2 body)")
      (= {x1} (head x-refs))
      (= {x2} (head (tail x-refs)))
      (= {x3} (head (tail (tail x-refs))))
      (test/assert-eq 0 line:x1 "first x on line 0 (param)")
      (test/assert-eq 1 line:x2 "second x on line 1 (* x y)")
      (test/assert-eq 2 line:x3 "third x on line 2 (- x y)")
      (sqlite/close db)
      true
    })

  (test "find-refs-keywords-not-indexed"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(list :name \"foo\" :age 42)")
      (= {refs} (symdb/find-refs db ":name"))
      (test/assert-eq 0 (len refs) "keyword :name should not be in refs")
      (= {refs2} (symdb/find-refs db ":age"))
      (test/assert-eq 0 (len refs2) "keyword :age should not be in refs")
      (sqlite/close db)
      true
    })

  (test "find-refs-constants-not-indexed"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(if true {nil} {false})")
      (= {r1} (symdb/find-refs db "true"))
      (= {r2} (symdb/find-refs db "nil"))
      (= {r3} (symdb/find-refs db "false"))
      (test/assert-eq 0 (len r1) "true not in refs")
      (test/assert-eq 0 (len r2) "nil not in refs")
      (test/assert-eq 0 (len r3) "false not in refs")
      (sqlite/close db)
      true
    })

  (test "find-refs-sig-not-indexed"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///b.valk"
        "(sig 'plist/get {-> QExpr A A})")
      (symdb/sync-document db "file:///a.valk"
        "(= {r} (plist/get mylist :name))")
      (= {refs} (symdb/find-refs db "plist/get"))
      (test/assert-eq 1 (len refs) "plist/get only from call site, not sig")
      (= {first-ref} (head refs))
      (test/assert-eq "/a.valk" path:first-ref "ref from a.valk")
      (= {sig-refs} (symdb/find-refs db "QExpr"))
      (test/assert-eq 0 (len sig-refs) "type names inside sig not indexed")
      (sqlite/close db)
      true
    })

  (test "find-refs-resync-preserves-other-files"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///a.valk" "(fun {shared x} {x})")
      (symdb/sync-document db "file:///b.valk" "(shared 42)")
      (= {refs-before} (symdb/find-refs db "shared"))
      (test/assert-eq 2 (len refs-before) "shared in 2 files before resync")
      (symdb/sync-document db "file:///a.valk" "(fun {shared y} {y})")
      (= {refs-after} (symdb/find-refs db "shared"))
      (test/assert-eq 2 (len refs-after) "shared still in 2 files after resync of a.valk")
      (= {b-refs} (filter (\{r} {== path:r "/b.valk"}) refs-after))
      (test/assert-eq 1 (len b-refs) "b.valk refs untouched")
      (sqlite/close db)
      true
    })

  (test "find-refs-definition-included"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(fun {greet name} {str name})")
      (= {refs} (symdb/find-refs db "greet"))
      (test/assert-eq 1 (len refs) "greet appears once (in fun binding)")
      (= {name-refs} (symdb/find-refs db "name"))
      (test/assert-eq 2 (len name-refs) "name appears twice (param + body)")
      (sqlite/close db)
      true
    })

  ; =========================================================================
  ; sync-file-symbols indexes refs and replaces stale data
  ; =========================================================================

  (test "sync-file-symbols-reindexes-refs"
    {do
      (= {db} (make-test-db))
      (= {v1} "(fun {helper x} {+ x 1})")
      (symdb/sync-document db "file:///t.valk" v1)
      (= {refs-before} (symdb/find-refs db "helper"))
      (test/assert-eq 1 (len refs-before) "helper has 1 ref after sync-document")
      (= {rb} (head refs-before))
      (test/assert-eq 0 line:rb "helper on line 0")
      (= {v2} "(def {VERSION} 42)\n(fun {helper x} {+ x 1})")
      (symdb/sync-file-symbols db "file:///t.valk" v2 "newhash")
      (= {refs-after} (symdb/find-refs db "helper"))
      (test/assert-eq 1 (len refs-after) "helper still has 1 ref after resync")
      (= {ra} (head refs-after))
      (test/assert-eq 1 line:ra
        "helper now on line 1 (shifted by inserted line)")
      (sqlite/close db)
      true
    })

  (test "sync-file-symbols-updates-positions"
    {do
      (= {db} (make-test-db))
      (= {v1} "(fun {f x} {x})")
      (symdb/sync-document db "file:///t.valk" v1)
      (= {x-refs} (symdb/find-refs db "x"))
      (test/assert-eq 2 (len x-refs) "x has 2 refs initially")
      (= {xr} (head x-refs))
      (test/assert-eq 0 line:xr "x on line 0 initially")
      (= {v2} "\n\n\n(fun {f x} {x})")
      (symdb/sync-file-symbols db "file:///t.valk" v2 "newhash")
      (= {x-after} (symdb/find-refs db "x"))
      (test/assert-eq 2 (len x-after) "x still has 2 refs")
      (= {xa} (head x-after))
      (test/assert-eq 3 line:xa
        "x now on line 3 after resync")
      (sqlite/close db)
      true
    })

  (test "sync-file-symbols-preserves-other-file-refs"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///a.valk" "(fun {shared} {1})")
      (symdb/sync-document db "file:///b.valk" "(shared)")
      (= {refs-before} (symdb/find-refs db "shared"))
      (test/assert-eq 2 (len refs-before) "shared in 2 files")
      (symdb/sync-file-symbols db "file:///a.valk" "(fun {shared} {2})" "new")
      (= {refs-after} (symdb/find-refs db "shared"))
      (test/assert-eq 2 (len refs-after) "shared still in 2 files (re-indexed)")
      (= {b-refs} (filter (\{r} {== path:r "/b.valk"}) refs-after))
      (test/assert-eq 1 (len b-refs) "b.valk refs untouched")
      (sqlite/close db)
      true
    })

  (test "sync-file-symbols-removes-old-symbol-refs"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(fun {f x} {x})")
      (= {refs-before} (symdb/find-refs db "f"))
      (test/assert-eq 1 (len refs-before) "f has 1 ref")
      (symdb/sync-file-symbols db "file:///t.valk" "(fun {g y} {y})" "new")
      (= {f-after} (symdb/find-refs db "f"))
      (= {g-after} (symdb/find-refs db "g"))
      (test/assert-eq 0 (len f-after) "old f refs gone")
      (test/assert-eq 1 (len g-after) "new g refs indexed")
      (sqlite/close db)
      true
    })

) {:suite-name "LSP References" :debug 0})
