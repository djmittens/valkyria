(load "stdlib/prelude.valk")
(load "stdlib/test/test.valk")

(test/run (list
  (test "metrics/prometheus returns string"
    {do
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return a string")
    true
  })
  (test "counter with labels in prometheus output"
    {do
    (= {c} (metrics/counter "prom_test_requests" "test" "server" "api" "port" "8443"))
    (= {_} (metrics/counter-inc c))
    (= {_} (metrics/counter-inc c))
    (= {_} (metrics/counter-inc c))
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return string after counter-inc")
    (test/assert (> (len result) 0) "prometheus output should be non-empty after adding counters")
    true
  })
  (test "multiple label combinations"
    {do
    (= {c1} (metrics/counter "prom_test_multi_web" "test" "server" "web" "port" "8080"))
    (= {_} (metrics/counter-inc c1))
    (= {_} (metrics/counter-inc c1))
    (= {c2} (metrics/counter "prom_test_multi_api" "test" "server" "api" "port" "9000"))
    (= {_} (metrics/counter-inc c2))
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return string")
    (test/assert (> (len result) 0) "prometheus output should be non-empty")
    true
  })
  (test "counter without labels in prometheus"
    {do
    (= {c} (metrics/counter "prom_test_simple" "test"))
    (= {_} (metrics/counter-inc c))
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return string")
    true
  }))
  {:suite-name "Prometheus Metrics Format Tests"})
