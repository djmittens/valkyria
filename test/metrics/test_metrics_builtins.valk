(load "stdlib/prelude.valk")
(load "stdlib/test/test.valk")

(test/run (list
  (test/case "metrics/json returns string"
    {do
    (= {result} (metrics/json))
    (test/assert (str? result) "metrics/json should return a string")
    (test/assert (> (len result) 0) "metrics/json should return non-empty string")
    true
  })
  (test/case "metrics/prometheus returns string"
    {do
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return a string")
    (test/assert (>= (len result) 0) "metrics/prometheus should return a string (may be empty initially)")
    true
  })
  (test/case "metrics/counter-inc without labels"
    {do
    (= {c} (metrics/counter "test_counter_no_labels" "test"))
    (= {r} (metrics/counter-inc c))
    (= {json} (metrics/json))
    (test/assert (str? json) "metrics/json should still return string after counter-inc")
    true
  })
  (test/case "metrics/counter-inc with labels"
    {do
    (= {c} (metrics/counter "test_counter_labeled" "test" "server" "test" "port" "8080"))
    (= {r} (metrics/counter-inc c))
    (= {json} (metrics/json))
    (test/assert (str? json) "metrics/json should still return string after labeled counter-inc")
    true
  })
  (test/case "metrics/counter-inc multiple increments"
    {do
    (= {c} (metrics/counter "test_counter_multi" "test"))
    (= {r1} (metrics/counter-inc c))
    (= {r2} (metrics/counter-inc c))
    (= {r3} (metrics/counter-inc c))
    (= {json} (metrics/json))
    (test/assert (str? json) "metrics/json should work after multiple increments")
    true
  })
  (test/case "metrics/json and metrics/prometheus both work"
    {do
    (= {c} (metrics/counter "test_both_formats" "test"))
    (= {r} (metrics/counter-inc c))
    (= {json} (metrics/json))
    (= {prom} (metrics/prometheus))
    (test/assert (str? json) "metrics/json should return string")
    (test/assert (str? prom) "metrics/prometheus should return string")
    true
  }))
  {:suite-name "Metrics Builtins Tests"})
