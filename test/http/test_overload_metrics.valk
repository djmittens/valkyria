; Test: Metrics Verification for Overload
; Run with: ./build/valk test/test_overload_metrics.valk

(load "stdlib/prelude.valk")
(load "stdlib/test/test.valk")

; Test: metrics/prometheus output is valid string

; Test: metrics/json output is valid string

; Test: aio/start creates valid system

; Test: aio/metrics-prometheus works with aio system

; Test: aio/metrics-json works with aio system

(test/run (list
  (test/case "metrics/prometheus returns valid output"
    {do
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return a string")
    true
  })
  (test/case "metrics/json returns valid output"
    {do
    (= {result} (metrics/json))
    (test/assert (str? result) "metrics/json should return a string")
    (test/assert (> (len result) 0) "metrics/json should return non-empty string")
    true
  })
  (test/case "aio/start creates valid system"
    {do
    (= {aio} (aio/await (aio/start)))
    (test/assert (!= aio nil) "aio/start should return a system")
    true
  })
  (test/case "aio/metrics-prometheus returns valid output"
    {do
    (= {result} (metrics/prometheus))
    (test/assert (str? result) "metrics/prometheus should return a string")
    true
  })
  (test/case "aio/metrics-json returns valid output"
    {do
    (= {result} (metrics/json))
    (test/assert (str? result) "metrics/json should return a string")
    (test/assert (> (len result) 0) "metrics/json should return non-empty string")
    true
  }))
  {:suite-name "Overload Metrics Tests"})
