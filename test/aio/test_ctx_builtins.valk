; Context and Request Context Builtins Tests
; Run with: ./build/valk test/test_ctx_builtins.valk

(load "stdlib/test/test.valk")

(test/run (list
  ; These cases used to assert that both forms return nil, with the reason
  ; stated in the message: "body result consumed by continuation". That was
  ; a bug being recorded as a specification. The continuation frame that
  ; sequenced the body was the same one that parsed the timeout, so the
  ; body's value came back around and was re-read as a timeout and dropped.
  ; Both forms now evaluate to their last body expression.
  (test/case "ctx-with-deadline-basic"
    {do
    (= {result} (ctx/with-deadline 1000 42))
    (test/assert-eq 42 result "ctx/with-deadline returns its body value")
    true
  })
  (test/case "ctx-with-deadline-multiple-exprs"
    {do
    (= {result} (ctx/with-deadline 1000 10 15))
    (test/assert-eq 15 result "ctx/with-deadline returns the LAST body value")
    true
  })
  (test/case "ctx-with-deadline-empty-body"
    {do
    (= {result} (ctx/with-deadline 1000))
    (test/assert-eq nil result "ctx/with-deadline with no body is nil")
    true
  })
  (test/case "ctx-with-deadline-single-expr"
    {do
    (= {result} (ctx/with-deadline 1000 100))
    (test/assert-eq 100 result "ctx/with-deadline single expr returns it")
    true
  })
  (test/case "ctx-with-basic"
    {do
    (= {result} (ctx/with :mykey 42 (ctx/get :mykey)))
    (test/assert-eq 42 result "ctx/with body can read the local it bound")
    true
  })
  (test/case "ctx-with-empty-body"
    {do
    (= {result} (ctx/with :outer 1))
    (test/assert-eq nil result "ctx/with with no body is nil")
    true
  })
  (test/case "ctx-with-multiple-body-exprs"
    {do
    (= {result} (ctx/with :key 42
      (ctx/get :key)
      (+ 1 1)))
    (test/assert-eq 2 result "ctx/with returns the LAST body value")
    true
  })
  (test/case "ctx-with-restores-outer-context"
    {do
    (ctx/with :scoped "inner" (ctx/get :scoped))
    (test/assert (nil? (ctx/get :scoped)) "the local is gone after the form")
    true
  })
  (test/case "ctx-deadline-without-context"
    {do
    (= {deadline} (ctx/deadline))
    (test/assert (nil? deadline) "ctx/deadline outside request context is nil")
    true
  })
  (test/case "ctx-deadline-exceeded-without-context"
    {do
    (= {exceeded} (ctx/deadline-exceeded?))
    (test/assert (nil? exceeded) "ctx/deadline-exceeded? nil without context")
    true
  })
  (test/case "repeat-basic"
    {do
    (= {result} (repeat (\ {i} {i}) 5))
    (test/assert-eq 5 (len result) "repeat should return list of 5 elements")
    (test/assert-eq 0 (nth 1 result) "first element is 0")
    (test/assert-eq 4 (nth 5 result) "last element is 4")
    true
  })
  (test/case "repeat-zero"
    {do
    (= {result} (repeat (\ {i} {i}) 0))
    (test/assert-eq 0 (len result) "repeat 0 times returns empty list")
    true
  })
  (test/case "repeat-with-side-effect"
    {do
    (= {result} (repeat (\ {i} {i}) 3))
    (test/assert-eq 3 (len result) "repeat should execute function n times")
    (test/assert-eq 0 (nth 1 result) "first element is 0")
    (test/assert-eq 2 (nth 3 result) "last element is 2")
    true
  }))
  {:suite-name "Context Builtins Tests"})
