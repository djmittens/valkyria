(load "src/prelude.valk")
(load "src/modules/test.valk")

(test/run (list

  (test "dict-new-no-args"
    {do
      (= {d} (dict/new))
      (test/assert-eq 0 (dict/count d) "new dict should be empty")
      true
    })

  (test "dict-new-with-capacity-hint"
    {do
      (= {d} (dict/new 100))
      (test/assert-eq 0 (dict/count d) "new dict with capacity hint should be empty")
      true
    })

  (test "dict-put-string-key"
    {do
      (= {d} (dict/new))
      (dict/put! d "hello")
      (test/assert-eq 1 (dict/count d) "should have 1 element")
      (test/assert-eq 1 (dict/has? d "hello") "should contain hello")
      true
    })

  (test "dict-put-symbol-key"
    {do
      (= {d} (dict/new))
      (dict/put! d 'foo)
      (test/assert-eq 1 (dict/count d) "should have 1 element")
      (test/assert-eq 1 (dict/has? d 'foo) "should contain symbol foo")
      true
    })

  (test "dict-put-duplicate-key"
    {do
      (= {d} (dict/new))
      (dict/put! d "dup")
      (dict/put! d "dup")
      (test/assert-eq 1 (dict/count d) "duplicate put should not increase count")
      true
    })

  (test "dict-put-returns-dict"
    {do
      (= {d} (dict/new))
      (= {r} (dict/put! d "x"))
      (test/assert-eq 1 (dict/has? r "x") "put should return the dict")
      true
    })

  (test "dict-has-existing"
    {do
      (= {d} (dict/new))
      (dict/put! d "exists")
      (test/assert-eq 1 (dict/has? d "exists") "should find existing key")
      true
    })

  (test "dict-has-missing"
    {do
      (= {d} (dict/new))
      (test/assert-eq 0 (dict/has? d "missing") "should not find missing key")
      true
    })

  (test "dict-has-symbol"
    {do
      (= {d} (dict/new))
      (dict/put! d 'bar)
      (test/assert-eq 1 (dict/has? d 'bar) "should find symbol key")
      (test/assert-eq 0 (dict/has? d 'baz) "should not find missing symbol")
      true
    })

  (test "dict-from-keys-strings"
    {do
      (= {d} (dict/from-keys (list "a" "b" "c")))
      (test/assert-eq 3 (dict/count d) "should have 3 keys")
      (test/assert-eq 1 (dict/has? d "a") "should contain a")
      (test/assert-eq 1 (dict/has? d "b") "should contain b")
      (test/assert-eq 1 (dict/has? d "c") "should contain c")
      true
    })

  (test "dict-from-keys-symbols"
    {do
      (= {d} (dict/from-keys (list 'x 'y 'z)))
      (test/assert-eq 3 (dict/count d) "should have 3 keys")
      (test/assert-eq 1 (dict/has? d 'x) "should contain x")
      true
    })

  (test "dict-from-keys-duplicates"
    {do
      (= {d} (dict/from-keys (list "a" "b" "a")))
      (test/assert-eq 2 (dict/count d) "duplicates should be deduplicated")
      true
    })

  (test "dict-from-keys-empty"
    {do
      (= {d} (dict/from-keys (list)))
      (test/assert-eq 0 (dict/count d) "empty list should give empty dict")
      true
    })

  (test "dict-count-empty"
    {do
      (= {d} (dict/new))
      (test/assert-eq 0 (dict/count d) "empty dict count is 0")
      true
    })

  (test "dict-count-populated"
    {do
      (= {d} (dict/new))
      (dict/put! d "a")
      (dict/put! d "b")
      (dict/put! d "c")
      (test/assert-eq 3 (dict/count d) "should count 3 elements")
      true
    })

  (test "dict-keys-empty"
    {do
      (= {d} (dict/new))
      (= {k} (dict/keys d))
      (test/assert-eq 0 (len k) "empty dict should have no keys")
      true
    })

  (test "dict-keys-populated"
    {do
      (= {d} (dict/new))
      (dict/put! d "alpha")
      (dict/put! d "beta")
      (= {k} (dict/keys d))
      (test/assert-eq 2 (len k) "should return 2 keys")
      true
    })

  (test "dict-grow-many-elements"
    {do
      (= {d} (dict/new))
      (dict/put! d "k01")
      (dict/put! d "k02")
      (dict/put! d "k03")
      (dict/put! d "k04")
      (dict/put! d "k05")
      (dict/put! d "k06")
      (dict/put! d "k07")
      (dict/put! d "k08")
      (dict/put! d "k09")
      (dict/put! d "k10")
      (dict/put! d "k11")
      (dict/put! d "k12")
      (dict/put! d "k13")
      (test/assert-eq 13 (dict/count d) "should have 13 elements after growth")
      (test/assert-eq 1 (dict/has? d "k01") "first key still present")
      (test/assert-eq 1 (dict/has? d "k13") "last key still present")
      true
    })

  (test "dict-new-too-many-args"
    {do
      (= {r} (error? (dict/new 10 20)))
      (test/assert r "dict/new with 2 args should error")
      true
    })

  (test "dict-new-wrong-type"
    {do
      (= {r} (error? (dict/new "abc")))
      (test/assert r "dict/new with string arg should error")
      true
    })

  (test "dict-put-wrong-arg-count"
    {do
      (= {d} (dict/new))
      (= {r} (error? (dict/put! d)))
      (test/assert r "dict/put! with 1 arg should error")
      true
    })

  (test "dict-put-non-ref"
    {do
      (= {r} (error? (dict/put! 42 "key")))
      (test/assert r "dict/put! on non-ref should error")
      true
    })

  (test "dict-put-bad-key-type"
    {do
      (= {d} (dict/new))
      (= {r} (error? (dict/put! d 42)))
      (test/assert r "dict/put! with numeric key should error")
      true
    })

  (test "dict-has-wrong-arg-count"
    {do
      (= {d} (dict/new))
      (= {r} (error? (dict/has? d)))
      (test/assert r "dict/has? with 1 arg should error")
      true
    })

  (test "dict-has-non-ref"
    {do
      (= {r} (error? (dict/has? 42 "key")))
      (test/assert r "dict/has? on non-ref should error")
      true
    })

  (test "dict-has-bad-key-type"
    {do
      (= {d} (dict/new))
      (= {r} (error? (dict/has? d 42)))
      (test/assert r "dict/has? with numeric key should error")
      true
    })

  (test "dict-count-wrong-arg-count"
    {do
      (= {r} (error? (dict/count)))
      (test/assert r "dict/count with 0 args should error")
      true
    })

  (test "dict-count-non-ref"
    {do
      (= {r} (error? (dict/count 42)))
      (test/assert r "dict/count on non-ref should error")
      true
    })

  (test "dict-keys-wrong-arg-count"
    {do
      (= {r} (error? (dict/keys)))
      (test/assert r "dict/keys with 0 args should error")
      true
    })

  (test "dict-keys-non-ref"
    {do
      (= {r} (error? (dict/keys "not-a-dict")))
      (test/assert r "dict/keys on non-ref should error")
      true
    })

  (test "dict-from-keys-wrong-arg-count"
    {do
      (= {r} (error? (dict/from-keys)))
      (test/assert r "dict/from-keys with 0 args should error")
      true
    })

  (test "dict-from-keys-large-list"
    {do
      (= {d} (dict/from-keys (list "a" "b" "c" "d" "e" "f" "g" "h"
                                    "i" "j" "k" "l" "m" "n" "o" "p"
                                    "q" "r" "s" "t")))
      (test/assert-eq 20 (dict/count d) "should handle 20 keys with growth")
      (test/assert-eq 1 (dict/has? d "a") "first key present")
      (test/assert-eq 1 (dict/has? d "t") "last key present")
      true
    })

) {:suite-name "Dict Builtins"})
