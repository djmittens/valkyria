; Test aio/pmap - parallel map across event loop threads

(load "src/prelude.valk")
(load "src/modules/test.valk")

; Start with 4 event loop threads to test multi-threading
(def {aio} (aio/await (aio/start {:num-threads 4})))

(test/run (list

  (test "aio/pmap with empty list"
    {do
    (= {h} (aio/pmap aio (\ {x} {(+ x 1)}) ()))
    (= {result} (aio/await h))
    (== result ())
  })

  (test "aio/pmap with single element"
    {do
    (= {h} (aio/pmap aio (\ {x} {(* x 2)}) (list 5)))
    (= {result} (aio/await h))
    (== result (list 10))
  })

  (test "aio/pmap with multiple elements"
    {do
    (= {h} (aio/pmap aio (\ {x} {(+ x 10)}) (list 1 2 3 4 5)))
    (= {result} (aio/await h))
    (== result (list 11 12 13 14 15))
  })

  (test "aio/pmap preserves order"
    {do
    (= {h} (aio/pmap aio (\ {x} {(* x x)}) (list 1 2 3 4)))
    (= {result} (aio/await h))
    (== result (list 1 4 9 16))
  })

  (test "aio/pmap with string transformation"
    {do
    (= {h} (aio/pmap aio (\ {x} {(str/upper x)}) (list "hello" "world" "test")))
    (= {result} (aio/await h))
    (== result (list "HELLO" "WORLD" "TEST"))
  })

  (test "aio/pmap with larger list across threads"
    {do
    (= {items} (range 1 51))
    (= {h} (aio/pmap aio (\ {x} {(* x x)}) items))
    (= {result} (aio/await h))
    (= {expected} (map (\ {x} {(* x x)}) items))
    (== result expected)
  })

  (test "aio/pmap propagates error from lambda"
    {do
    (= {h} (aio/pmap aio (\ {x} {(if (== x 3) (error "bad value") (* x x))}) (list 1 2 3 4 5)))
    (= {result} (aio/await h))
    (error? result)
  })

  (test "aio/pmap error on single element"
    {do
    (= {h} (aio/pmap aio (\ {x} {(error "always fail")}) (list 42)))
    (= {result} (aio/await h))
    (error? result)
  })

  (test "aio/pmap as child of aio/all"
    {do
    (= {h1} (aio/pmap aio (\ {x} {(+ x 1)}) (list 1 2 3)))
    (= {h2} (aio/pmap aio (\ {x} {(* x 2)}) (list 10 20 30)))
    (= {all-h} (aio/all (list h1 h2)))
    (= {results} (aio/await all-h))
    (= {first} (nth 1 results))
    (= {second} (nth 2 results))
    (and (== first (list 2 3 4))
         (== second (list 20 40 60)))
  })

) {:suite-name "aio/pmap Tests"})

(aio/stop aio)
