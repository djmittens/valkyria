; Stress test: pmap with heavy string allocation per worker
; Mimics what coverage parsing does - lots of str/split, str/index-of, dict ops

(load "stdlib/test/test.valk")

(def {aio} (aio/await (aio/start {:num-threads 4})))

(fun {*heavy-string-work* n acc} {
  (if (<= n 0) {acc}
    {do
      (= {line} (str "        1:   " n ":  some_function(arg1, arg2, arg3);"))
      (= {colon1} (str/index-of line ":"))
      (= {after1} (str/slice line (+ colon1 1) (len line)))
      (= {colon2} (str/index-of after1 ":"))
      (= {count-str} (str/trim (str/slice line 0 colon1)))
      (= {lineno-str} (str/trim (str/slice after1 0 colon2)))
      (= {source} (str/slice after1 (+ colon2 1) (len after1)))
      (= {parts} (str/split line ":"))
      (= {d} (dict/new))
      (dict/set! d "count" count-str)
      (dict/set! d "lineno" lineno-str)
      (dict/set! d "source" source)
      (*heavy-string-work* (- n 1) (+ acc 1))})
})

(fun {*gcov-parse-simulation* n files} {
  (if (<= n 0) {(dict/count files)}
    {do
      (= {line} (str "        1:   " n ":  if (valk_lval_type(val) == LVAL_NUM) { return valk_lval_num(val->num + 1); }"))
      (= {colon1} (str/index-of line ":"))
      (= {after1} (str/slice line (+ colon1 1) (len line)))
      (= {colon2} (str/index-of after1 ":"))
      (= {count-str} (str/trim (str/slice line 0 colon1)))
      (= {lineno-str} (str/trim (str/slice after1 0 colon2)))
      (= {source} (str/slice after1 (+ colon2 1) (len after1)))
      (= {hit-count} (if (== count-str "-") {-1}
        {(if (== count-str "#####") {0}
          {(if (error? (str->num count-str)) {-1} {(str->num count-str)})})}))
      (= {lkey} (str n))
      (= {existing} (dict/get files lkey))
      (if (== existing nil)
        {do
          (= {lc} (dict/new))
          (dict/set! lc "hit" hit-count)
          (dict/set! lc "exprs" {})
          (dict/set! files lkey lc)}
        {do
          (= {old-hit} (dict/get existing "hit"))
          (if (> hit-count old-hit) {(dict/set! existing "hit" hit-count)} {})})
      (if (str/contains? source "if")
        {do
          (= {branch-parts} (filter (\ {p} {(!= p "")}) (str/split (str/trim line) " ")))
          (= {bkey} (str n ":0"))
          (dict/set! files bkey 1)}
        {})
      (*gcov-parse-simulation* (- n 1) files)})
})

(test/run (list

  (test/case "pmap heavy string work 200 iterations x 8 items"
    {do
    (= {items} (range 1 9))
    (= {h} (aio/pmap aio (\ {x} {(*heavy-string-work* 200 0)}) items))
    (= {result} (aio/await h))
    (== result (list 200 200 200 200 200 200 200 200))
  })

  (test/case "pmap heavy string work 500 iterations x 16 items"
    {do
    (= {items} (range 1 17))
    (= {h} (aio/pmap aio (\ {x} {(*heavy-string-work* 500 0)}) items))
    (= {result} (aio/await h))
    (== (len result) 16)
  })

  (test/case "pmap heavy dict work 500 iterations x 8 items"
    {do
    (fun {*fill-dict* d x n} {
      (if (<= n 0) {(dict/count d)}
        {do
          (dict/set! d (str "key-" n) (str "value-" n "-" x))
          (*fill-dict* d x (- n 1))})
    })
    (= {items} (range 1 9))
    (= {h} (aio/pmap aio (\ {x} {
      (*fill-dict* (dict/new) x 500)
    }) items))
    (= {result} (aio/await h))
    (== result (list 500 500 500 500 500 500 500 500))
  })

  (test/case "pmap gcov-like parsing 500 lines x 8 workers"
    {do
    (= {items} (range 1 9))
    (= {h} (aio/pmap aio (\ {x} {
      (*gcov-parse-simulation* 500 (dict/new))
    }) items))
    (= {result} (aio/await h))
    (== (len result) 8)
  })

  (test/case "pmap gcov-like parsing 1000 lines x 16 workers"
    {do
    (= {items} (range 1 17))
    (= {h} (aio/pmap aio (\ {x} {
      (*gcov-parse-simulation* 1000 (dict/new))
    }) items))
    (= {result} (aio/await h))
    (== (len result) 16)
  })

) {:suite-name "pmap Heavy Allocation Stress"})

(aio/stop aio)
