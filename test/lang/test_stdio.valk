(load "stdlib/prelude.valk")
(load "stdlib/test/test.valk")

(test/run (list

  (test/case "stdout-write-string"
    {do
      (= {r} (stdout/write "test-output"))
      (nil? r)
    })

  (test/case "stdout-write-returns-nil"
    {do
      (= {r} (stdout/write ""))
      (nil? r)
    })

  (test/case "stdout-flush-returns-nil"
    {do
      (= {r} (stdout/flush))
      (nil? r)
    })

  (test/case "stderr-write-string"
    {do
      (= {r} (stderr/write "test-stderr"))
      (nil? r)
    })

  (test/case "stderr-write-empty"
    {do
      (= {r} (stderr/write ""))
      (nil? r)
    })

  (test/case "stdin-has-data-returns-number"
    {do
      (= {r} (stdin/has-data))
      (test/assert (or (== r 0) (== r 1)) "stdin/has-data should return 0 or 1")
      true
    })

  (test/case "stdout-write-wrong-arg-count"
    {do
      (= {r} (error? (stdout/write)))
      (test/assert r "stdout/write with 0 args should error")
      true
    })

  (test/case "stdout-write-too-many-args"
    {do
      (= {r} (error? (stdout/write "a" "b")))
      (test/assert r "stdout/write with 2 args should error")
      true
    })

  (test/case "stdout-write-wrong-type"
    {do
      (= {r} (error? (stdout/write 42)))
      (test/assert r "stdout/write with number should error")
      true
    })

  (test/case "stdout-flush-wrong-arg-count"
    {do
      (= {r} (error? (stdout/flush 1)))
      (test/assert r "stdout/flush with args should error")
      true
    })

  (test/case "stderr-write-wrong-arg-count"
    {do
      (= {r} (error? (stderr/write)))
      (test/assert r "stderr/write with 0 args should error")
      true
    })

  (test/case "stderr-write-wrong-type"
    {do
      (= {r} (error? (stderr/write 42)))
      (test/assert r "stderr/write with number should error")
      true
    })

  (test/case "stdin-has-data-wrong-arg-count"
    {do
      (= {r} (error? (stdin/has-data 1)))
      (test/assert r "stdin/has-data with args should error")
      true
    })

  (test/case "stdin-read-line-wrong-arg-count"
    {do
      (= {r} (error? (stdin/read-line 1)))
      (test/assert r "stdin/read-line with args should error")
      true
    })

  (test/case "stdin-read-bytes-wrong-arg-count"
    {do
      (= {r} (error? (stdin/read-bytes)))
      (test/assert r "stdin/read-bytes with 0 args should error")
      true
    })

  (test/case "stdin-read-bytes-wrong-type"
    {do
      (= {r} (error? (stdin/read-bytes "abc")))
      (test/assert r "stdin/read-bytes with string should error")
      true
    })

  (test/case "stdin-read-bytes-zero"
    {do
      (= {r} (stdin/read-bytes 0))
      (test/assert-eq "" r "read-bytes 0 should return empty string")
      true
    })

  (test/case "stdin-read-bytes-negative"
    {do
      (= {r} (stdin/read-bytes -1))
      (test/assert-eq "" r "read-bytes negative should return empty string")
      true
    })

) {:suite-name "Stdio Builtins"})
