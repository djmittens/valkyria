(load "stdlib/test/test.valk")

(test/run (list
  (test/case "def-single-symbol"
    {do
    (def {test-env-x} 42)
    (test/assert-eq 42 test-env-x "def binds single symbol")
    true
  })
  (test/case "def-multiple-symbols"
    {do
    (def {test-env-a test-env-b} 10 20)
    (test/assert-eq 10 test-env-a "def binds first")
    (test/assert-eq 20 test-env-b "def binds second")
    true
  })
  (test/case "def-shorthand"
    {do
    (def {test-env-sh} 99)
    (test/assert-eq 99 test-env-sh "def shorthand binds")
    true
  })
  (test/case "put-local-binding"
    {do
    (= {local-a} 100)
    (test/assert-eq 100 local-a "= binds locally")
    true
  })
  (test/case "put-multiple-local"
    {do
    (= {la lb} 1 2)
    (test/assert-eq 1 la "= binds first local")
    (test/assert-eq 2 lb "= binds second local")
    true
  })
  (test/case "def-with-symbol-resolution"
    {do
    (def {test-env-src} 77)
    (def {test-env-dst} test-env-src)
    (test/assert-eq 77 test-env-dst "def resolves symbol value")
    true
  })
  (test/case "def-with-keyword"
    {do
    (def {test-env-kw} :hello)
    (test/assert-eq :hello test-env-kw "def with keyword preserves it")
    true
  })
  (test/case "lambda-basic"
    {do
    (= {f} (\ {x} {+ x 1}))
    (test/assert-eq 6 (f 5) "lambda adds 1")
    true
  })
  (test/case "penv-returns-list"
    {do
    (= {e} (penv))
    (test/assert (list? e) "penv returns a list")
    true
  })
  (test/case "select-basic"
    {do
    (= {x} 2)
    (= {result} (select
      {(== x 1) "one"}
      {(== x 2) "two"}
      {(== x 3) "three"}))
    (test/assert-eq "two" result "select picks correct branch")
    true
  })
  (test/case "select-no-match"
    {do
    (= {result} (select
      {0 "never"}))
    (test/assert (error? result) "select with no match returns error")
    true
  })
  (test/case "select-first-match"
    {do
    (= {result} (select
      {1 "first"}
      {1 "second"}))
    (test/assert-eq "first" result "select takes first matching clause")
    true
  })
  (test/case "do-returns-last"
    {do
    (= {result} (do 1 2 3))
    (test/assert-eq 3 result "do returns last expression")
    true
  })
  (test/case "do-empty"
    {do
    (= {result} (do))
    (test/assert-eq nil result "empty do returns nil")
    true
  })
  (test/case "def-various-types"
    {do
    (def {test-env-num} 42)
    (def {test-env-str} "hello")
    (def {test-env-lst} (list 1 2 3))
    (def {test-env-fn} (\ {x} {x}))
    (test/assert-eq 42 test-env-num "def with number")
    (test/assert-eq "hello" test-env-str "def with string")
    (test/assert-eq 3 (len test-env-lst) "def with list")
    (test/assert-eq 5 (test-env-fn 5) "def with function")
    true
  })
  (test/case "select-condition-error"
    {do
    (= {result} (select
      {(/ 1 0) "bad"}))
    (test/assert (error? result) "select propagates condition error")
    true
  })
  (test/case "select-empty"
    {do
    (= {result} (select))
    (test/assert (error? result) "empty select returns error")
    true
  })
  (test/case "lambda-with-type-annotation-arrow"
    {do
    (= {f} (\ {x :: Num -> Num} {+ x 1}))
    (test/assert-eq 6 (f 5) "lambda with :: and -> annotations works")
    true
  })
  (test/case "lambda-with-double-colon-annotation"
    {do
    (= {f} (\ {x :: Num} {x}))
    (test/assert-eq 42 (f 42) "lambda with :: annotation works")
    true
  })
  (test/case "lambda-with-arrow-return-type"
    {do
    (= {f} (\ {a b -> Num} {+ a b}))
    (test/assert-eq 7 (f 3 4) "lambda with -> return annotation works")
    true
  })
  (test/case "def-with-error-value"
    {do
    (= {result} (def test-env-errval (/ 1 0)))
    (test/assert (error? result) "def with error value propagates error")
    true
  })
  (test/case "put-with-symbol-resolution"
    {do
    (= {src-val} 55)
    (= {dst-val} src-val)
    (test/assert-eq 55 dst-val "= resolves symbol value")
    true
  })
  (test/case "lambda-multi-param-annotations"
    {do
    (= {f} (\ {x :: Num y :: Num -> Num} {+ x y}))
    (test/assert-eq 8 (f 3 5) "lambda with multi-param annotations")
    true
  })
) (test/context-new))
