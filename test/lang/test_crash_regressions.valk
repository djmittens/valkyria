; Crash Regression Test Suite
; Tests for bugs that previously caused crashes
; These are CRITICAL regressions that must never return

(load "stdlib/test/test.valk")

; ============================================================================
; Do Block with test/define Crashes
; ============================================================================

; Run all crash regression tests
(test/run (list
  (test/case "crash-regression-do-in-test-define"
    {do
    (def {result} true)
    (== result true)
  })
  (test/case "crash-regression-simple-do"
    {do
    (def {x} 5)
    (== x 5)
  })
  (test/case "crash-regression-multiple-do-expressions"
    {do
    (def {a} 1)
    (def {b} 2)
    (== (+ a b) 3)
  })
  (test/case "crash-regression-do-with-assignment"
    {do
    (= {x} 10)
    (= {y} 20)
    (== (+ x y) 30)
  })
  (test/case "crash-regression-nested-do-blocks"
    {do
    (def {outer} (do
      (def {inner} 42)
      inner))
    (== outer 42)
  }))
  {:suite-name "Crash Regression Tests"})
