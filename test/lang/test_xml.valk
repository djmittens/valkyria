(load "stdlib/test/test.valk")

(test/run (list

  (test/case "parse-self-closing"
    {do
    (= {doc} (xml/parse "<root/>"))
    (test/assert-eq "root" doc:tag "tag name")
    (test/assert-eq 0 (len doc:children) "no children")
    true
  })

  (test/case "parse-with-children"
    {do
    (= {doc} (xml/parse "<root><a/><b/></root>"))
    (= {children} doc:children)
    (test/assert-eq 2 (len children) "two children")
    (= {c1} (nth 1 children))
    (test/assert-eq "a" c1:tag "first child")
    (= {c2} (nth 2 children))
    (test/assert-eq "b" c2:tag "second child")
    true
  })

  (test/case "parse-attributes"
    {do
    (= {xml} "<item name=\"hello\" count=\"42\"/>")
    (= {doc} (xml/parse xml))
    (= {attrs} doc:attrs)
    (test/assert-eq "hello" attrs:name "string attr")
    (test/assert-eq "42" attrs:count "number-valued attr is string")
    true
  })

  (test/case "parse-text-content"
    {do
    (= {doc} (xml/parse "<msg>hello world</msg>"))
    (test/assert-eq "hello world" doc:text "text content")
    true
  })

  (test/case "parse-nested-structure"
    {do
    (= {xml} "<root><parent><child val=\"1\"/></parent></root>")
    (= {doc} (xml/parse xml))
    (= {parent} (head doc:children))
    (= {child} (head parent:children))
    (test/assert-eq "child" child:tag "nested tag")
    (= {a} child:attrs)
    (test/assert-eq "1" a:val "nested attr")
    true
  })

  (test/case "parse-no-attrs-gives-nil"
    {do
    (= {doc} (xml/parse "<bare/>"))
    (= {attrs} doc:attrs)
    (test/assert-eq 0 (len attrs) "no attrs is empty")
    true
  })

  (test/case "parse-cobertura-like"
    {do
    (= {xml} (str
      "<coverage line-rate=\"0.95\">"
        "<packages>"
          "<package name=\"src\">"
            "<classes>"
              "<class filename=\"src/foo.c\" line-rate=\"1.0\">"
                "<lines>"
                  "<line number=\"10\" hits=\"5\" branch=\"true\" condition-coverage=\"100% (2/2)\"/>"
                  "<line number=\"20\" hits=\"3\" branch=\"true\" condition-coverage=\"50% (1/2)\"/>"
                "</lines>"
              "</class>"
            "</classes>"
          "</package>"
        "</packages>"
      "</coverage>"))
    (= {doc} (xml/parse xml))
    (test/assert-eq "coverage" doc:tag "root tag")
    (= {pkgs} doc:children)
    (= {first-pkg} (head pkgs))
    (= {pkg} (head first-pkg:children))
    (= {first-child} (head pkg:children))
    (= {cls} (head first-child:children))
    (= {ca} cls:attrs)
    (test/assert-eq "src/foo.c" ca:filename "class filename")
    (= {lines-elem} (head cls:children))
    (= {lines} lines-elem:children)
    (test/assert-eq 2 (len lines) "two line elements")
    (= {line1} (nth 1 lines))
    (= {al1} line1:attrs)
    (test/assert-eq "10" al1:number "line number")
    (test/assert-eq "5" al1:hits "hit count")
    (= {line2} (nth 2 lines))
    (= {al2} line2:attrs)
    (test/assert-eq "50% (1/2)" al2:condition-coverage "condition coverage")
    true
  })

  (test/case "parse-error-invalid-xml"
    {do
    (test/assert (error? (xml/parse "<unclosed>")) "unclosed tag should error")
    true
  })

  (test/case "parse-error-wrong-type"
    {do
    (test/assert (error? (xml/parse 42)) "number arg should error")
    true
  })

  (test/case "parse-ignores-whitespace-text"
    {do
    (= {xml} (str "<root>\n  <child/>\n</root>"))
    (= {doc} (xml/parse xml))
    (= {children} doc:children)
    (test/assert-eq 1 (len children) "whitespace-only text nodes ignored")
    (= {fc} (head children))
    (test/assert-eq "child" fc:tag "child tag")
    true
  })

  (test/case "parse-empty-string"
    {do
    (test/assert (error? (xml/parse "")) "empty string should error")
    true
  })

  (test/case "parse-malformed-xml"
    {do
    (test/assert (error? (xml/parse "<")) "bare angle bracket should error")
    (test/assert (error? (xml/parse "not xml at all")) "non-xml text should error")
    true
  })

  (test/case "parse-mismatched-tags"
    {do
    (test/assert (error? (xml/parse "<a></b>")) "mismatched tags should error")
    true
  })

) {:suite-name "XML Builtin Tests"})
