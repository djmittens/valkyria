(load "stdlib/prelude.valk")
(load "stdlib/test/test.valk")

(test/run (list
  (test/case "sqlite-open-close"
    {do
    (= {db} (sqlite/open ":memory:"))
    (test/assert (ref? db) "sqlite/open should return a ref")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-create-table-and-insert"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    (= {changed} (sqlite/exec db "INSERT INTO t (name) VALUES (?)" "alice"))
    (test/assert-eq 1 changed "insert should change 1 row")
    (= {id} (sqlite/last-insert-id db))
    (test/assert-eq 1 id "first insert should have rowid 1")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-returns-plists"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
    (sqlite/exec db "INSERT INTO t (name, age) VALUES (?, ?)" "alice" 30)
    (sqlite/exec db "INSERT INTO t (name, age) VALUES (?, ?)" "bob" 25)
    (= {rows} (sqlite/query db "SELECT name, age FROM t ORDER BY name"))
    (test/assert-eq 2 (len rows) "should return 2 rows")
    (= {r1} (nth 1 rows))
    (test/assert-eq "alice" r1:name "first row name")
    (test/assert-eq 30 r1:age "first row age")
    (= {r2} (nth 2 rows))
    (test/assert-eq "bob" r2:name "second row name")
    (test/assert-eq 25 r2:age "second row age")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-with-params"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (?)" "one")
    (sqlite/exec db "INSERT INTO t (val) VALUES (?)" "two")
    (sqlite/exec db "INSERT INTO t (val) VALUES (?)" "three")
    (= {rows} (sqlite/query db "SELECT val FROM t WHERE id > ?" 1))
    (test/assert-eq 2 (len rows) "should filter to 2 rows")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-empty-result"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {rows} (sqlite/query db "SELECT * FROM t"))
    (test/assert-eq 0 (len rows) "empty table should return empty list")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-null-values"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (NULL)")
    (= {rows} (sqlite/query db "SELECT val FROM t"))
    (= {r1} (nth 1 rows))
    (test/assert-eq nil r1:val "NULL should map to nil")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-prepared-statements"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val INTEGER)")
    (= {stmt} (sqlite/prepare db "INSERT INTO t (val) VALUES (?)"))
    (sqlite/bind stmt 10)
    (sqlite/step stmt)
    (sqlite/bind stmt 20)
    (sqlite/step stmt)
    (sqlite/bind stmt 30)
    (sqlite/step stmt)
    (sqlite/finalize stmt)
    (= {rows} (sqlite/query db "SELECT val FROM t ORDER BY val"))
    (test/assert-eq 3 (len rows) "should have 3 rows from prepared inserts")
    (= {r1} (nth 1 rows))
    (test/assert-eq 10 r1:val "first value")
    (= {r3} (nth 3 rows))
    (test/assert-eq 30 r3:val "third value")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-prepared-select"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    (sqlite/exec db "INSERT INTO t (name) VALUES ('a')")
    (sqlite/exec db "INSERT INTO t (name) VALUES ('b')")
    (sqlite/exec db "INSERT INTO t (name) VALUES ('c')")
    (= {stmt} (sqlite/prepare db "SELECT name FROM t WHERE id = ?"))
    (sqlite/bind stmt 2)
    (= {row} (sqlite/step stmt))
    (test/assert-eq "b" row:name "prepared select should return row")
    (= {done} (sqlite/step stmt))
    (test/assert-eq nil done "second step should return nil (done)")
    (sqlite/finalize stmt)
    (sqlite/close db)
    true
  })
  (test/case "sqlite-exec-multiple-changes"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val INTEGER)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (1)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (2)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (3)")
    (= {changed} (sqlite/exec db "DELETE FROM t WHERE val > ?" 1))
    (test/assert-eq 2 changed "should delete 2 rows")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-transaction-pattern"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "BEGIN")
    (sqlite/exec db "INSERT INTO t (val) VALUES ('a')")
    (sqlite/exec db "INSERT INTO t (val) VALUES ('b')")
    (sqlite/exec db "COMMIT")
    (= {rows} (sqlite/query db "SELECT COUNT(*) as cnt FROM t"))
    (= {cr} (nth 1 rows))
    (test/assert-eq 2 cr:cnt "committed rows should persist")
    (sqlite/exec db "BEGIN")
    (sqlite/exec db "INSERT INTO t (val) VALUES ('c')")
    (sqlite/exec db "ROLLBACK")
    (= {rows2} (sqlite/query db "SELECT COUNT(*) as cnt FROM t"))
    (= {rr} (nth 1 rows2))
    (test/assert-eq 2 rr:cnt "rolled back rows should not persist")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-error-bad-sql"
    {do
    (= {db} (sqlite/open ":memory:"))
    (= {result} (sqlite/exec db "NOT VALID SQL"))
    (test/assert (error? result) "bad SQL should return error")
    (sqlite/close db)
    true
  })

  ; --- New convenience query tests ---

  (test/case "sqlite-query-row"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    (sqlite/exec db "INSERT INTO t (name) VALUES ('alice')")
    (= {row} (sqlite/query-row db "SELECT name FROM t WHERE id = ?" 1))
    (test/assert-eq "alice" row:name "query-row returns the row")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-row-errors-on-zero"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {result} (sqlite/query-row db "SELECT * FROM t"))
    (test/assert (error? result) "query-row should error on 0 rows")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-row-errors-on-multiple"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (sqlite/exec db "INSERT INTO t VALUES (1)")
    (sqlite/exec db "INSERT INTO t VALUES (2)")
    (= {result} (sqlite/query-row db "SELECT * FROM t"))
    (test/assert (error? result) "query-row should error on 2+ rows")
    (sqlite/close db)
    true
  })

  (test/case "sqlite-query-value"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t (val) VALUES ('x')")
    (sqlite/exec db "INSERT INTO t (val) VALUES ('y')")
    (= {cnt} (sqlite/query-value db "SELECT COUNT(*) FROM t"))
    (test/assert-eq 2 cnt "query-value returns the scalar")
    (= {name} (sqlite/query-value db "SELECT val FROM t WHERE id = ?" 1))
    (test/assert-eq "x" name "query-value with params")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-value-errors-on-zero-rows"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {result} (sqlite/query-value db "SELECT id FROM t"))
    (test/assert (error? result) "query-value should error on 0 rows")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-value-errors-on-multi-col"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (a INTEGER, b INTEGER)")
    (sqlite/exec db "INSERT INTO t VALUES (1, 2)")
    (= {result} (sqlite/query-value db "SELECT a, b FROM t"))
    (test/assert (error? result) "query-value should error on multiple columns")
    (sqlite/close db)
    true
  })

  (test/case "sqlite-query-maybe-returns-row"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
    (sqlite/exec db "INSERT INTO t (name) VALUES ('alice')")
    (= {row} (sqlite/query-maybe db "SELECT name FROM t WHERE id = ?" 1))
    (test/assert-eq "alice" row:name "query-maybe returns row when found")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-maybe-returns-nil"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {result} (sqlite/query-maybe db "SELECT * FROM t WHERE id = 999"))
    (test/assert-eq nil result "query-maybe returns nil when no rows")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-maybe-errors-on-multiple"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (sqlite/exec db "INSERT INTO t VALUES (1)")
    (sqlite/exec db "INSERT INTO t VALUES (2)")
    (= {result} (sqlite/query-maybe db "SELECT * FROM t"))
    (test/assert (error? result) "query-maybe should error on 2+ rows")
    (sqlite/close db)
    true
  })

  (test/case "sqlite-exec-script"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec-script db "
      CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);
      CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER, title TEXT);
      INSERT INTO users (name) VALUES ('alice');
      INSERT INTO posts (user_id, title) VALUES (1, 'hello');
    ")
    (= {cnt} (sqlite/query-value db "SELECT COUNT(*) FROM users"))
    (test/assert-eq 1 cnt "exec-script should execute all statements")
    (= {title} (sqlite/query-value db "SELECT title FROM posts"))
    (test/assert-eq "hello" title "data from exec-script should persist")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-exec-script-error"
    {do
    (= {db} (sqlite/open ":memory:"))
    (= {result} (sqlite/exec-script db "CREATE TABLE t (id INTEGER); GARBAGE;"))
    (test/assert (error? result) "exec-script should error on bad SQL")
    (sqlite/close db)
    true
  })

  (test/case "sqlite-changes"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val INTEGER)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (1)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (2)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (3)")
    (sqlite/exec db "UPDATE t SET val = val + 10 WHERE val > 1")
    (= {changed} (sqlite/changes db))
    (test/assert-eq 2 changed "changes should report last statement's changes")
    (sqlite/close db)
    true
  })

  (test/case "sqlite-busy-timeout"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/busy-timeout db 10000)
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (sqlite/exec db "INSERT INTO t VALUES (1)")
    (= {cnt} (sqlite/query-value db "SELECT COUNT(*) FROM t"))
    (test/assert-eq 1 cnt "db should work after busy-timeout change")
    (sqlite/close db)
    true
  })

  (test/case "sqlite-null-binding"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (?)" nil)
    (= {rows} (sqlite/query db "SELECT val FROM t"))
    (= {r1} (nth 1 rows))
    (test/assert-eq nil r1:val "nil binding inserts NULL")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-float-column"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val REAL)")
    (sqlite/exec db "INSERT INTO t (val) VALUES (3.14)")
    (= {rows} (sqlite/query db "SELECT val FROM t"))
    (= {r1} (nth 1 rows))
    (= {v} r1:val)
    (test/assert (num? v) "float column returns a number")
    true
  })
  (test/case "sqlite-null-column-via-query"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t (id) VALUES (1)")
    (= {row} (sqlite/query-row db "SELECT val FROM t WHERE id = 1"))
    (test/assert-eq nil row:val "unset column is nil")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-exec-on-closed-db"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/exec db "SELECT 1"))
    (test/assert (error? result) "exec on closed db errors")
    true
  })
  (test/case "sqlite-query-on-closed-db"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/query db "SELECT 1"))
    (test/assert (error? result) "query on closed db errors")
    true
  })
  (test/case "sqlite-query-value-null"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t (id) VALUES (1)")
    (= {v} (sqlite/query-value db "SELECT val FROM t"))
    (test/assert-eq nil v "query-value returns nil for NULL")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-value-errors-on-multiple-rows"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (sqlite/exec db "INSERT INTO t VALUES (1)")
    (sqlite/exec db "INSERT INTO t VALUES (2)")
    (= {result} (sqlite/query-value db "SELECT id FROM t"))
    (test/assert (error? result) "query-value errors on multiple rows")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-prepare-on-closed-db"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/prepare db "SELECT 1"))
    (test/assert (error? result) "prepare on closed db errors")
    true
  })
  (test/case "sqlite-prepare-bad-sql"
    {do
    (= {db} (sqlite/open ":memory:"))
    (= {result} (sqlite/prepare db "NOT VALID SQL"))
    (test/assert (error? result) "prepare with bad SQL errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-bind-after-finalize"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {stmt} (sqlite/prepare db "INSERT INTO t VALUES (?)"))
    (sqlite/finalize stmt)
    (= {result} (sqlite/bind stmt 1))
    (test/assert (error? result) "bind after finalize errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-step-after-finalize"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {stmt} (sqlite/prepare db "INSERT INTO t VALUES (?)"))
    (sqlite/finalize stmt)
    (= {result} (sqlite/step stmt))
    (test/assert (error? result) "step after finalize errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-last-insert-id-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/last-insert-id db))
    (test/assert (error? result) "last-insert-id on closed db errors")
    true
  })
  (test/case "sqlite-changes-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/changes db))
    (test/assert (error? result) "changes on closed db errors")
    true
  })
  (test/case "sqlite-busy-timeout-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/busy-timeout db 1000))
    (test/assert (error? result) "busy-timeout on closed db errors")
    true
  })
  (test/case "sqlite-exec-script-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/exec-script db "SELECT 1"))
    (test/assert (error? result) "exec-script on closed db errors")
    true
  })
  (test/case "sqlite-double-close"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (sqlite/close db)
    true
  })
  (test/case "sqlite-double-finalize"
    {do
    (= {db} (sqlite/open ":memory:"))
    (= {stmt} (sqlite/prepare db "SELECT 1"))
    (sqlite/finalize stmt)
    (sqlite/finalize stmt)
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-row-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/query-row db "SELECT 1"))
    (test/assert (error? result) "query-row on closed db errors")
    true
  })
  (test/case "sqlite-query-maybe-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/query-maybe db "SELECT 1"))
    (test/assert (error? result) "query-maybe on closed db errors")
    true
  })
  (test/case "sqlite-query-value-on-closed"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/close db)
    (= {result} (sqlite/query-value db "SELECT 1"))
    (test/assert (error? result) "query-value on closed db errors")
    true
  })
  (test/case "sqlite-type-assertions"
    {do
    (= {r1} (sqlite/exec 42 "SELECT 1"))
    (test/assert (error? r1) "exec with non-ref first arg errors")
    (= {r2} (sqlite/query 42 "SELECT 1"))
    (test/assert (error? r2) "query with non-ref first arg errors")
    (= {r3} (sqlite/close 42))
    (test/assert (error? r3) "close with non-ref arg errors")
    (= {r4} (sqlite/query-row 42 "SELECT 1"))
    (test/assert (error? r4) "query-row with non-ref errors")
    (= {r5} (sqlite/query-maybe 42 "SELECT 1"))
    (test/assert (error? r5) "query-maybe with non-ref errors")
    (= {r6} (sqlite/query-value 42 "SELECT 1"))
    (test/assert (error? r6) "query-value with non-ref errors")
    (= {r7} (sqlite/prepare 42 "SELECT 1"))
    (test/assert (error? r7) "prepare with non-ref errors")
    (= {r8} (sqlite/last-insert-id 42))
    (test/assert (error? r8) "last-insert-id with non-ref errors")
    (= {r9} (sqlite/changes 42))
    (test/assert (error? r9) "changes with non-ref errors")
    (= {r10} (sqlite/busy-timeout 42 100))
    (test/assert (error? r10) "busy-timeout with non-ref errors")
    (= {r11} (sqlite/exec-script 42 "SELECT 1"))
    (test/assert (error? r11) "exec-script with non-ref errors")
    true
  })
  (test/case "sqlite-bind-with-null"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, a TEXT, b INTEGER)")
    (= {stmt} (sqlite/prepare db "INSERT INTO t (a, b) VALUES (?, ?)"))
    (sqlite/bind stmt nil 42)
    (sqlite/step stmt)
    (sqlite/finalize stmt)
    (= {row} (sqlite/query-row db "SELECT a, b FROM t WHERE id = 1"))
    (test/assert-eq nil row:a "null bound for text column")
    (test/assert-eq 42 row:b "integer bound correctly")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-bind-type-assertion"
    {do
    (= {r1} (sqlite/bind 42 1))
    (test/assert (error? r1) "bind with non-stmt errors")
    true
  })
  (test/case "sqlite-step-type-assertion"
    {do
    (= {r1} (sqlite/step 42))
    (test/assert (error? r1) "step with non-stmt errors")
    true
  })
  (test/case "sqlite-finalize-type-assertion"
    {do
    (= {r1} (sqlite/finalize 42))
    (test/assert (error? r1) "finalize with non-stmt errors")
    true
  })
  (test/case "sqlite-exec-unsupported-bind-type"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {result} (sqlite/exec db "INSERT INTO t VALUES (?)" (list 1 2)))
    (test/assert (error? result) "exec with list binding errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-unsupported-bind-type"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {result} (sqlite/query db "SELECT * FROM t WHERE id = ?" (list 1 2)))
    (test/assert (error? result) "query with list binding errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-exec-step-error"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY UNIQUE)")
    (sqlite/exec db "INSERT INTO t VALUES (1)")
    (= {result} (sqlite/exec db "INSERT INTO t VALUES (1)"))
    (test/assert (error? result) "duplicate insert errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-query-bad-sql"
    {do
    (= {db} (sqlite/open ":memory:"))
    (= {result} (sqlite/query db "NOT VALID SQL"))
    (test/assert (error? result) "query with bad SQL errors")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-exec-returning-rows"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY, val TEXT)")
    (sqlite/exec db "INSERT INTO t VALUES (1, 'a')")
    (sqlite/exec db "INSERT INTO t VALUES (2, 'b')")
    (= {changed} (sqlite/exec db "SELECT * FROM t"))
    (test/assert (>= changed 0) "exec on SELECT returns 0 changes")
    (sqlite/close db)
    true
  })
  (test/case "sqlite-bind-unsupported-type"
    {do
    (= {db} (sqlite/open ":memory:"))
    (sqlite/exec db "CREATE TABLE t (id INTEGER PRIMARY KEY)")
    (= {stmt} (sqlite/prepare db "INSERT INTO t VALUES (?)"))
    (= {result} (sqlite/bind stmt (list 1 2)))
    (test/assert (error? result) "bind with list type errors")
    (sqlite/finalize stmt)
    (sqlite/close db)
    true
  })
) (test/context-new))
