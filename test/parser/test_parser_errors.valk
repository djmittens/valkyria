; Parser Error Path Tests
; Run with: ./build/valk test/test_parser_errors.valk

(load "stdlib/test/test.valk")

(test/run (list
  (test/case "empty-list-eval"
    {do
    (= {result} (eval {}))
    (test/assert (== result nil) "empty list evals to nil")
    true
  })
  (test/case "quote-wrong-args"
    {do
    (= {result} (error? (eval (read "(quote)"))))
    (test/assert result "quote with 0 args errors")
    true
  })
  (test/case "quote-is-not-special-form"
    {do
    (= {result} (error? (eval (read "(quote a b)"))))
    (test/assert result "quote is not a builtin and errors")
    true
  })
  (test/case "quasiquote-wrong-args"
    {do
    (= {result} (error? (eval (read "(quasiquote)"))))
    (test/assert result "quasiquote with 0 args errors")
    true
  })
  (test/case "if-too-few-args"
    {do
    (= {result} (if true))
    (test/assert (error? result) "if with 1 arg errors")
    true
  })
  (test/case "if-too-many-args"
    {do
    (= {result} (error? (eval (read "(if true 1 2 3 4)"))))
    (test/assert result "if with too many args errors")
    true
  })
  (test/case "ctx-with-deadline-too-few-args"
    {do
    (= {result} (ctx/with-deadline 100))
    (test/assert (not (error? result)) "ctx/with-deadline with 1 arg returns nil body")
    true
  })
  (test/case "ctx-with-deadline-non-number"
    {do
    (= {result} (ctx/with-deadline "not-a-number" 42))
    (test/assert (error? result) "ctx/with-deadline with non-number errors")
    true
  })
  (test/case "ctx-with-too-few-args"
    {do
    (= {result} (error? (eval (read "(ctx/with :key)"))))
    (test/assert result "ctx/with with 2 args errors")
    true
  })
  (test/case "unquote-outside-quasiquote"
    {do
    (= {result} (error? (unquote 42)))
    (test/assert result "unquote outside quasiquote errors")
    true
  })
  (test/case "unquote-splicing-arg-error"
    {do
    (= {result} (error? (eval (read "`{a ,@(+ 1 2) b}"))))
    (test/assert result "unquote-splicing non-list errors")
    true
  })
  (test/case "do-with-error-propagates"
    {do
    (= {result} (do (error "test error")))
    (test/assert (error? result) "do propagates errors")
    true
  })
  (test/case "single-elem-list-eval"
    {do
    (= {f} (\ {} {42}))
    (= {result} (f))
    (test/assert-eq 42 result "single elem list eval")
    true
  })
  (test/case "lambda-no-body-error"
    {do
    (= {result} (error? (eval (read "(\\)"))))
    (test/assert result "lambda with no args errors")
    true
  })
  (test/case "def-odd-args-error"
    {do
    (= {result} (error? (eval (read "(def {x} 1 2)"))))
    (test/assert result "def with extra args errors")
    true
  })
  (test/case "head-empty-list-error"
    {do
    (= {result} (head {}))
    (test/assert (error? result) "head of empty list errors")
    true
  })
  (test/case "tail-empty-list-error"
    {do
    (= {result} (tail {}))
    (test/assert (error? result) "tail of empty list errors")
    true
  })
  (test/case "nth-out-of-bounds"
    {do
    (= {result} (nth 10 {1 2 3}))
    (test/assert (error? result) "nth out of bounds errors")
    true
  })
  (test/case "divide-by-zero"
    {do
    (= {result} (/ 1 0))
    (test/assert (error? result) "divide by zero errors")
    true
  })
  (test/case "join-non-list-error"
    {do
    (= {result} (join 123 {1 2}))
    (test/assert (error? result) "join non-list errors")
    true
  })
  (test/case "init-empty-list"
    {do
    (= {result} (init {}))
    (test/assert (error? result) "init of empty list errors")
    true
  })
  (test/case "str-split-wrong-types"
    {do
    (= {result} (str/split 123 "x"))
    (test/assert (error? result) "str/split non-string errors")
    true
  })
  (test/case "str-replace-wrong-types"
    {do
    (= {result} (str/replace 123 "a" "b"))
    (test/assert (error? result) "str/replace non-string errors")
    true
  })
  (test/case "read-invalid-syntax"
    {do
    (= {result} (read "(unclosed"))
    (test/assert (error? result) "read invalid syntax errors")
    true
  })
  (test/case "load-nonexistent-file"
    {do
    (= {result} (load "/nonexistent/path.valk"))
    (test/assert (error? result) "load nonexistent file errors")
    true
  })
  (test/case "range-wrong-type-first-arg"
    {do
    (= {result} (range "a" 5))
    (test/assert (error? result) "range with string first arg errors")
    true
  })
  (test/case "range-wrong-type-second-arg"
    {do
    (= {result} (range 0 "b"))
    (test/assert (error? result) "range with string second arg errors")
    true
  })
  (test/case "range-wrong-arg-count"
    {do
    (= {result} (range 1))
    (test/assert (error? result) "range with 1 arg errors")
    true
  })
  (test/case "error-wrong-type"
    {do
    (= {result} (error 123))
    (test/assert (error? result) "error with number errors")
    true
  })
  (test/case "list-predicate-wrong-arg-count"
    {do
    (= {result} (list?))
    (test/assert (error? result) "list? with 0 args errors")
    true
  })
  (test/case "ref-predicate-wrong-arg-count"
    {do
    (= {result} (ref?))
    (test/assert (error? result) "ref? with 0 args errors")
    true
  })
  (test/case "error-predicate-wrong-arg-count"
    {do
    (= {result} (error?))
    (test/assert (error? result) "error? with 0 args errors")
    true
  })
  (test/case "arena-size-wrong-arg-count"
    {do
    (= {result} (arena-size 1))
    (test/assert (error? result) "arena-size with args errors")
    true
  })
  (test/case "arena-usage-wrong-arg-count"
    {do
    (= {result} (arena-usage 1))
    (test/assert (error? result) "arena-usage with args errors")
    true
  })
  (test/case "arena-high-water-wrong-arg-count"
    {do
    (= {result} (arena-high-water 1))
    (test/assert (error? result) "arena-high-water with args errors")
    true
  }))
  {:suite-name "Parser Error Path Tests"})
