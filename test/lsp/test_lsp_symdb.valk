(load "stdlib/test/test.valk")
(load "stdlib/diag/symdb.valk")
(load "scripts/lsp/analysis.valk")
(load "stdlib/diag/validate.valk")

(fun {make-test-db} {do
  (= {db} (sqlite/open ":memory:"))
  (sqlite/exec-script db symdb/schema-sql)
  db
})

(fun {index-text db text} {do
  (= {ast} (parse text))
  (sqlite/exec db
    "INSERT INTO files (path, hash) VALUES ('test', 'h') ON CONFLICT(path) DO UPDATE SET hash='h'")
  (= {fid} (sqlite/query-value db "SELECT id FROM files WHERE path='test'"))
  (lsp/index-ast db fid ast text)
  fid
})

(fun {get-symbols db fid} {
  sqlite/query db
    "SELECT name, kind, arity, doc, sig FROM symbols WHERE file_id=?1 ORDER BY line, col"
    fid
})

(fun {get-refs db fid} {
  sqlite/query db
    "SELECT name, line, col FROM refs WHERE file_id=?1 ORDER BY line, col"
    fid
})

(test/run (list

  ; --- Schema / lifecycle ---

  (test/case "symdb-init-close"
    {do
      (= {db} (symdb/init ":memory:"))
      (test/assert (ref? db) "init should return a ref")
      (symdb/close db)
      true
    })

  ; --- Symbol extraction ---

  (test/case "extract-fun-symbol"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(fun {add x y} {+ x y})"))
      (= {syms} (get-symbols db fid))
      (test/assert (>= (len syms) 1) "should extract at least 1 symbol")
      (= {s} (head syms))
      (test/assert-eq "add" s:name "name should be add")
      (test/assert-eq symdb/SYMKIND_FUNCTION s:kind "kind should be function")
      (test/assert-eq 2 s:arity "arity should be 2")
      (sqlite/close db)
      true
    })

  (test/case "extract-def-symbol"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(def {MY_CONST} 42)"))
      (= {syms} (get-symbols db fid))
      (test/assert-eq 1 (len syms) "should extract 1 symbol")
      (= {s} (head syms))
      (test/assert-eq "MY_CONST" s:name "name should be MY_CONST")
      (test/assert-eq symdb/SYMKIND_VARIABLE s:kind "kind should be variable")
      (sqlite/close db)
      true
    })

  (test/case "extract-type-and-ctors"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(type {Color} {Red} {Green} {Blue})"))
      (= {syms} (get-symbols db fid))
      (= {names} (map (\{s} {s:name}) syms))
      (test/assert (member? "Color" names) "should have Color")
      (sqlite/close db)
      true
    })

  (test/case "extract-type-ctor-arity"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(type {Point} {:x Num :y Num})"))
      (= {syms} (get-symbols db fid))
      (= {ctors} (filter (\{s} {== s:kind symdb/SYMKIND_CONSTRUCTOR}) syms))
      (test/assert (>= (len ctors) 1) "should have constructor")
      (= {ctor} (head ctors))
      (test/assert-eq "Point" ctor:name "ctor name should be Point")
      (test/assert-eq 2 ctor:arity "ctor arity should be 2")
      (sqlite/close db)
      true
    })

  (test/case "extract-sig"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(sig 'my-fn {-> Num Num Num})"))
      (= {syms} (get-symbols db fid))
      (test/assert-eq 1 (len syms) "should extract 1 sig symbol")
      (= {s} (head syms))
      (test/assert-eq "my-fn" s:name "name should be my-fn")
      (sqlite/close db)
      true
    })

  (test/case "extract-empty-input"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db ""))
      (= {syms} (get-symbols db fid))
      (test/assert-eq 0 (len syms) "empty input should produce 0 symbols")
      (sqlite/close db)
      true
    })

  (test/case "extract-only-numbers"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "42"))
      (= {syms} (get-symbols db fid))
      (test/assert-eq 0 (len syms) "number literal should produce 0 symbols")
      (sqlite/close db)
      true
    })

  (test/case "extract-fun-with-varargs"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(fun {f x & rest} {rest})"))
      (= {syms} (get-symbols db fid))
      (= {s} (head syms))
      (test/assert-eq 1 s:arity "arity should stop at &")
      (sqlite/close db)
      true
    })

  (test/case "extract-fun-with-type-ann"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(fun {f x :: Num -> Num} {x})"))
      (= {syms} (get-symbols db fid))
      (= {s} (head syms))
      (test/assert-eq 1 s:arity "arity should stop at ::")
      (sqlite/close db)
      true
    })

  ; --- Reference extraction ---

  (test/case "extract-refs"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(+ foo bar)"))
      (= {refs} (get-refs db fid))
      (test/assert (>= (len refs) 3) "should extract refs for +, foo, bar")
      (= {names} (map (\{r} {r:name}) refs))
      (test/assert (member? "+" names) "should have +")
      (test/assert (member? "foo" names) "should have foo")
      (test/assert (member? "bar" names) "should have bar")
      (sqlite/close db)
      true
    })

  (test/case "extract-refs-skips-keywords"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db ":foo"))
      (= {refs} (get-refs db fid))
      (test/assert-eq 0 (len refs) "keyword :foo should not produce refs")
      (sqlite/close db)
      true
    })

  (test/case "extract-refs-keywords-not-in-refs"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db ":foo"))
      (= {refs} (get-refs db fid))
      (test/assert-eq 0 (len refs) ":keyword should not produce refs")
      (sqlite/close db)
      true
    })

  ; --- Database sync and query ---

  (test/case "sync-and-find-definition"
    {do
      (= {db} (make-test-db))
      (= {text} "(fun {greet name} {str \"Hello \" name})")
      (symdb/sync-document db "file:///test.valk" text)
      (= {def} (symdb/find-definition db "greet"))
      (test/assert (not (nil? def)) "should find definition")
      (test/assert-eq "greet" def:name "name should be greet")
      (test/assert-eq "/test.valk" def:path "path should match")
      (sqlite/close db)
      true
    })

  (test/case "sync-and-find-refs"
    {do
      (= {db} (make-test-db))
      (= {text} "(fun {f x} {+ x x})")
      (symdb/sync-document db "file:///t.valk" text)
      (= {refs} (symdb/find-refs db "+"))
      (test/assert (>= (len refs) 1) "should find at least 1 global ref to +")
      (sqlite/close db)
      true
    })

  (test/case "sync-and-search"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(fun {my-func x} {x})")
      (= {results} (symdb/search-symbols db "my"))
      (test/assert (>= (len results) 1) "should find my-func by prefix")
      (= {first-result} (head results))
      (test/assert-eq "my-func" first-result:name "name should match")
      (sqlite/close db)
      true
    })

  (test/case "sync-and-completion"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(fun {hello-world} {42})")
      (= {results} (symdb/completion-symbols db "hello"))
      (test/assert (>= (len results) 1) "should complete hello prefix")
      (sqlite/close db)
      true
    })

  (test/case "sync-and-file-symbols"
    {do
      (= {db} (make-test-db))
      (= {text} "(fun {a} {1})\n(fun {b} {2})\n(def {c} 3)")
      (symdb/sync-document db "file:///multi.valk" text)
      (= {syms} (symdb/file-symbols db "/multi.valk"))
      (test/assert-eq 3 (len syms) "should find 3 symbols in file")
      (sqlite/close db)
      true
    })

  (test/case "sync-updates-on-change"
    {do
      (= {db} (make-test-db))
      (= {_} (symdb/sync-document db "file:///t.valk" "(fun {old-fn} {1})"))
      (= {_} (symdb/sync-document db "file:///t.valk" "(fun {new-fn a} {a})"))
      (= {old} (symdb/find-definition db "old-fn"))
      (= {new} (symdb/find-definition db "new-fn"))
      (test/assert (nil? old) "old-fn should be gone after resync")
      (test/assert (not (nil? new)) "new-fn should exist after resync")
      (= {_} (sqlite/close db))
      true
    })

  (test/case "all-symbol-names"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "(fun {alpha} {1})\n(def {beta} 2)")
      (= {names} (symdb/all-symbol-names db))
      (test/assert-eq 2 (len names) "should have 2 distinct names")
      (sqlite/close db)
      true
    })

  ; --- sig merges with existing fun ---

  (test/case "sig-merge-with-fun"
    {do
      (= {db} (make-test-db))
      (= {text} "(fun {add x y} {+ x y})\n(sig 'add {-> Num Num Num})")
      (symdb/sync-document db "file:///t.valk" text)
      (= {sig-row} (sqlite/query-maybe db
        "SELECT sig FROM symbols WHERE name='add' AND sig LIKE '{->%'"))
      (test/assert (not (nil? sig-row)) "should have sig from sig declaration")
      (test/assert-eq "{-> Num Num Num}" sig-row:sig "sig should match")
      (sqlite/close db)
      true
    })

  ; --- Doc comment extraction ---

  (test/case "doc-comment-extracted"
    {do
      (= {db} (make-test-db))
      (= {text} "; Add two numbers\n(fun {add x y} {+ x y})")
      (= {fid} (index-text db text))
      (= {syms} (get-symbols db fid))
      (= {s} (head syms))
      (= {doc} s:doc)
      (test/assert (not (nil? doc)) "should extract doc comment")
      (test/assert-eq "Add two numbers" doc "doc should match comment text")
      (sqlite/close db)
      true
    })

  (test/case "no-doc-when-no-comment"
    {do
      (= {db} (make-test-db))
      (= {fid} (index-text db "(fun {f} {1})"))
      (= {syms} (get-symbols db fid))
      (= {s} (head syms))
      (test/assert (nil? s:doc) "no comment = nil doc")
      (sqlite/close db)
      true
    })

  ; --- Hover ---

  (test/case "hover-with-definition"
    {do
      (= {db} (make-test-db))
      (symdb/sync-document db "file:///t.valk" "; Add nums\n(fun {add x y} {+ x y})")
      (= {row} (sqlite/query-maybe db
        "SELECT name, doc FROM symbols WHERE name='add'"))
      (test/assert (not (nil? row)) "should find symbol")
      (test/assert-eq "add" row:name "name should match")
      (test/assert (not (nil? row:doc)) "should have doc")
      (test/assert-eq "Add nums" row:doc "doc should match")
      (sqlite/close db)
      true
    })

  (test/case "hover-missing-symbol"
    {do
      (= {db} (make-test-db))
      (= {h} (symdb/symbol-hover db "nonexistent"))
      (test/assert (nil? h) "hover for missing symbol should be nil")
      (sqlite/close db)
      true
    })

  ; --- Regression: sync-document with non-existent file path ---

  (test/case "sync-nonexistent-path-still-inserts"
    {do
      (= {db} (make-test-db))
      (= {text} "(sig '+ {-> & Num Num})\n(sig '== {-> A B Num})\n(fun {f x} {x})")
      (symdb/sync-document db "file:///nonexistent/fake.valk" text)
      (= {count} (sqlite/query-value db "SELECT COUNT(*) FROM symbols"))
      (test/assert-eq 3 count "should insert all 3 symbols despite fake path")
      (= {plus} (symdb/find-definition db "+"))
      (test/assert (not (nil? plus)) "should find + definition")
      (sqlite/close db)
      true
    })

  (test/case "sync-builtins-real-file"
    {do
      (= {db} (make-test-db))
      (= {text} (read-file "stdlib/builtins.valk"))
      (symdb/sync-document db "file:///src/builtins.valk" text)
      (= {count} (sqlite/query-value db "SELECT COUNT(*) FROM symbols"))
      (test/assert (> count 200) (str "builtins should have >200 symbols, got " count))
      (= {plus} (symdb/find-definition db "+"))
      (test/assert (not (nil? plus)) "should find + from builtins")
      (= {eq} (symdb/find-definition db "=="))
      (test/assert (not (nil? eq)) "should find == from builtins")
      (= {head-def} (symdb/find-definition db "head"))
      (test/assert (not (nil? head-def)) "should find head from builtins")
      (sqlite/close db)
      true
    })

  (test/case "sync-multiple-sigs-all-inserted"
    {do
      (= {db} (make-test-db))
      (= {text} "(sig '+ {-> & Num Num})\n(sig '- {-> Num Num Num})\n(sig '* {-> & Num Num})\n(sig '/ {-> Num Num Num})\n(sig '< {-> Num Num Num})")
      (symdb/sync-document db "file:///fake.valk" text)
      (= {count} (sqlite/query-value db "SELECT COUNT(*) FROM symbols"))
      (test/assert-eq 5 count "all 5 sigs should be in db")
      (sqlite/close db)
      true
    })

  ; --- Utility: uri->path ---

  (test/case "uri-to-path"
    {do
      (test/assert-eq "/home/user/file.valk" (symdb/uri->path "file:///home/user/file.valk")
        "should strip file:// prefix")
      true
    })

  (test/case "uri-to-path-short"
    {do
      (test/assert-eq "short" (symdb/uri->path "short")
        "short string returned as-is")
      true
    })

  ; --- Utility: symkind->lsp-kind ---

  (test/case "symkind-to-lsp-kind"
    {do
      (test/assert-eq symdb/LSP_SK_FUNCTION (symdb/symkind->lsp-kind symdb/SYMKIND_FUNCTION) "function")
      (test/assert-eq symdb/LSP_SK_VARIABLE (symdb/symkind->lsp-kind symdb/SYMKIND_VARIABLE) "variable")
      (test/assert-eq symdb/LSP_SK_CLASS (symdb/symkind->lsp-kind symdb/SYMKIND_TYPE) "type -> class")
      (test/assert-eq symdb/LSP_SK_CONSTRUCTOR (symdb/symkind->lsp-kind symdb/SYMKIND_CONSTRUCTOR) "constructor")
      true
    })

) {:suite-name "LSP SymDB" :debug 0})
