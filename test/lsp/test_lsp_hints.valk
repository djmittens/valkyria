(load "stdlib/test/test.valk")
(load "stdlib/diag/symdb.valk")
(load "scripts/lsp/analysis.valk")
(load "stdlib/diag/validate.valk")
(load "scripts/lsp/hints.valk")
(load "scripts/lsp/hints-fields.valk")

; --- Helpers ---

(fun {hint-labels text} {do
  (= {hints} (hint/collect text nil nil))
  (map (\ {h} {h:label}) hints)
})

(fun {hint-at-line text target-line} {do
  (= {hints} (hint/collect text nil nil))
  (filter (\ {h} {do (= {pos} h:position) (== pos:line target-line)}) hints)
})

(fun {hint-count text} {
  len (hint/collect text nil nil)
})

(fun {make-sig-db} {do
  (= {db} (sqlite/open ":memory:"))
  (sqlite/exec-script db symdb/schema-sql)
  db
})

(fun {seed-sig db name sig-str} {do
  (sqlite/exec db "INSERT OR IGNORE INTO files (path, hash) VALUES ('test.valk', 'h1')")
  (sqlite/exec db
    "INSERT INTO symbols (name, file_id, line, col, kind, sig) VALUES (?1, 1, 0, 0, 1, ?2)"
    name sig-str)
})

(fun {extract-fun-params text} {do
  (= {ast} (parse text))
  (= {formals} (head (tail (head ast))))
  (tail formals)
})

(test/run (list

  ; --- Basic cases ---

  (test/case "no-hints-empty"
    {do
      (test/assert-eq 0 (hint-count "") "empty input")
      true
    })

  (test/case "no-hints-number"
    {do
      (test/assert-eq 0 (hint-count "42") "number literal")
      true
    })

  (test/case "no-hints-operators"
    {do
      (test/assert-eq 0 (hint-count "(+ 1 2)") "operators excluded")
      (test/assert-eq 0 (hint-count "(- 10 3)") "minus excluded")
      (test/assert-eq 0 (hint-count "(== a b)") "equality excluded")
      true
    })

  (test/case "no-hints-special-forms"
    {do
      (test/assert-eq 0 (hint-count "(if 1 {2} {3})") "if excluded")
      (test/assert-eq 1 (hint-count "(def {x} 1)") "def has type hint")
      (test/assert-eq 1 (hint-count "(= {x} 1)") "= has type hint")
      true
    })

  ; --- Local function parameter hints ---

  (test/case "local-fun-two-params"
    {do
      (= {text} "(fun {add a b} {+ a b}) (add 1 2)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "should produce 2 hints")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? "a:" labels) "should have a: hint")
      (test/assert (member? "b:" labels) "should have b: hint")
      true
    })

  (test/case "local-fun-three-params"
    {do
      (= {text} "(fun {make-point x y z} {list x y z}) (make-point 1 2 3)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 3 (len hints) "should produce 3 hints")
      true
    })

  (test/case "single-arg-no-hint"
    {do
      (= {text} "(fun {negate x} {- 0 x}) (negate 5)")
      (test/assert-eq 0 (hint-count text) "single-arg calls get no hints")
      true
    })

  ; --- Hint filtering ---

  (test/case "skip-matching-arg-name"
    {do
      (= {text} "(fun {greet name age} {list name age}) (greet name 25)")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (not (member? "name:" labels)) "skip when arg matches param")
      (test/assert (member? "age:" labels) "non-matching arg gets hint")
      true
    })

  (test/case "skip-keyword-arg"
    {do
      (= {text} "(fun {make a b} {list a b}) (make :foo :bar)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 0 (len hints) "keywords already name themselves")
      true
    })

  ; --- Type annotation handling ---

  (test/case "params-with-annotations"
    {do
      (= {text} "(fun {calc x :: Num y :: Num} {+ x y}) (calc 1 2)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "annotations stripped from params")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? "x:" labels) "x param found")
      (test/assert (member? "y:" labels) "y param found")
      true
    })

  (test/case "return-type-annotation"
    {do
      (= {text} "(fun {add a b -> Num} {+ a b}) (add 1 2)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "return annotation excluded")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? "a:" labels) "a param found")
      (test/assert (member? "b:" labels) "b param found")
      true
    })

  ; --- Rest params ---

  (test/case "rest-params-stop"
    {do
      (= {text} "(fun {foo a b & rest} {list a b rest}) (foo 1 2 3 4)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "rest params stop hint collection")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? "a:" labels) "a before rest")
      (test/assert (member? "b:" labels) "b before rest")
      true
    })

  ; --- Nested calls ---

  (test/case "nested-calls"
    {do
      (= {text} "(fun {add a b} {+ a b}) (add (add 1 2) 3)")
      (= {hints} (hint/collect text nil nil))
      (test/assert (>= (len hints) 4) "hints for both outer and inner calls")
      true
    })

  ; --- Hints inside special forms ---

  (test/case "call-inside-do"
    {do
      (= {text} "(fun {foo a b} {list a b}) (do (foo 1 2))")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "calls inside do get hints")
      true
    })

  (test/case "call-inside-if"
    {do
      (= {text} "(fun {foo a b} {list a b}) (if 1 {foo 1 2} {foo 3 4})")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 4 (len hints) "calls in both if branches")
      true
    })

  (test/case "fun-body-gets-hints"
    {do
      (= {text} "(fun {bar x y} {list x y}) (fun {baz} {bar 1 2})")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "calls inside fun body get hints")
      true
    })

  ; --- sig parsing ---

  (test/case "parse-sig-simple"
    {do
      (= {params} (hint/parse-sig-params "(fun {foo a b c} ...)"))
      (test/assert-eq 3 (len params) "3 params from sig")
      (test/assert-eq "a" (nth 1 params) "first param")
      (test/assert-eq "b" (nth 2 params) "second param")
      (test/assert-eq "c" (nth 3 params) "third param")
      true
    })

  (test/case "parse-sig-with-annotations"
    {do
      (= {params} (hint/parse-sig-params "(fun {calc x :: Num y :: Str} ...)"))
      (test/assert-eq 2 (len params) "annotations stripped")
      (test/assert-eq "x" (nth 1 params) "first param")
      (test/assert-eq "y" (nth 2 params) "second param")
      true
    })

  (test/case "parse-sig-with-rest"
    {do
      (= {params} (hint/parse-sig-params "(fun {foo a & rest} ...)"))
      (test/assert-eq 1 (len params) "stop at &")
      (test/assert-eq "a" (nth 1 params) "param before rest")
      true
    })

  (test/case "parse-sig-no-params"
    {do
      (= {params} (hint/parse-sig-params "(fun {foo} ...)"))
      (test/assert (nil? params) "no params")
      true
    })

  (test/case "parse-sig-nil"
    {do
      (= {params} (hint/parse-sig-params nil))
      (test/assert (nil? params) "nil sig")
      true
    })

  ; --- sig type parsing / typed params ---

  (test/case "parse-sig-types-simple"
    {do
      (= {types} (hint/parse-sig-types "{-> Num Str Num}"))
      (test/assert-eq 3 (len types) "3 types")
      (test/assert-eq "Num" (nth 1 types) "first type")
      (test/assert-eq "Str" (nth 2 types) "second type")
      true
    })

  (test/case "parse-sig-types-compound"
    {do
      (= {types} (hint/parse-sig-types "{-> {-> a b} {List a} {List b}}"))
      (test/assert-eq 3 (len types) "3 types")
      (test/assert-eq "{-> a b}" (nth 1 types) "fn type intact")
      (test/assert-eq "{List a}" (nth 2 types) "list type intact")
      (test/assert-eq "{List b}" (nth 3 types) "return type intact")
      true
    })

  (test/case "parse-sig-types-not-arrow"
    {do
      (test/assert (nil? (hint/parse-sig-types "(fun {f x} ...)")) "non-arrow sig")
      (test/assert (nil? (hint/parse-sig-types nil)) "nil sig")
      true
    })

  (test/case "sig-typed-params-zip"
    {do
      (= {pairs} (hint/sig-typed-params (list "x" "y") "{-> Num Str Num}"))
      (test/assert-eq 2 (len pairs) "2 pairs")
      (test/assert-eq "x :: Num" (nth 1 pairs) "first pair")
      (test/assert-eq "y :: Str" (nth 2 pairs) "second pair")
      true
    })

  (test/case "sig-typed-params-arity-mismatch"
    {do
      (test/assert (nil? (hint/sig-typed-params (list "x") "{-> Num Str Num}"))
        "too few params")
      (test/assert (nil? (hint/sig-typed-params (list "x" "y" "z") "{-> Num Str Num}"))
        "too many params")
      (test/assert (nil? (hint/sig-typed-params nil "{-> Num}")) "no params")
      true
    })

  (test/case "typed-sig-str-combined"
    {do
      (= {s} (hint/typed-sig-str "add" (list "x" "y") "{-> Num Num Num}"))
      (test/assert-eq "(fun {add x :: Num y :: Num -> Num})" s "combined sig")
      (= {s2} (hint/typed-sig-str "map2" (list "f" "xs") "{-> {-> a b} {List a} {List b}}"))
      (test/assert-eq "(fun {map2 f :: {-> a b} xs :: {List a} -> {List b}})" s2
        "combined compound sig")
      true
    })

  (test/case "parse-sig-type-only"
    {do
      (= {params} (hint/parse-sig-params "{-> Num Num Num}"))
      (test/assert (not (nil? params)) "type sig returns types as params")
      true
    })

  ; --- Range filtering ---

  (test/case "range-filter"
    {do
      (= {text} "(fun {foo a b} {list a b})\n\n\n(foo 1 2)")
      (= {range} (list :start (list :line 3 :character 0)
                       :end (list :line 3 :character 100)))
      (= {hints} (hint/collect text nil range))
      (test/assert-eq 2 (len hints) "only hints on line 3")
      true
    })

  (test/case "range-excludes-other-lines"
    {do
      (= {text} "(fun {foo a b} {list a b})\n(foo 1 2)\n(foo 3 4)")
      (= {range} (list :start (list :line 1 :character 0)
                       :end (list :line 1 :character 100)))
      (= {hints} (hint/collect text nil range))
      (test/assert-eq 2 (len hints) "only line 1 hints")
      true
    })

  ; --- Position correctness ---

  (test/case "hint-kind-is-parameter"
    {do
      (= {text} "(fun {foo a b} {list a b}) (foo 1 2)")
      (= {hints} (hint/collect text nil nil))
      (= {kinds} (map (\ {h} {h:kind}) hints))
      (test/assert (member? 2 kinds) "kind should be 2 (Parameter)")
      true
    })

  (test/case "hint-has-padding-right"
    {do
      (= {text} "(fun {foo a b} {list a b}) (foo 1 2)")
      (= {hints} (hint/collect text nil nil))
      (= {h} (head hints))
      (test/assert (not (nil? h:paddingRight)) "paddingRight set")
      true
    })

  ; --- Unknown function ---

  (test/case "unknown-fun-no-hints"
    {do
      (= {text} "(unknown-fn 1 2 3)")
      (test/assert-eq 0 (hint-count text) "unknown function gets no hints")
      true
    })

  ; --- Multiple calls same function ---

  (test/case "multiple-calls"
    {do
      (= {text} "(fun {foo a b} {list a b}) (foo 1 2) (foo 3 4)")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 4 (len hints) "4 hints for 2 calls x 2 params")
      true
    })

  ; --- Lambda body ---

  (test/case "call-inside-lambda"
    {do
      (= {text} "(fun {foo a b} {list a b}) (\\ {x} {foo x 1})")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 2 (len hints) "calls inside lambda get hints")
      true
    })

  ; --- Type hint: parse-prefix-sig ---

  (test/case "prefix-sig-simple"
    {do
      (= {types} (hint/parse-prefix-sig "{-> Num Num Num}"))
      (test/assert-eq 3 (len types) "3 types")
      (test/assert-eq "Num" (nth 1 types) "first type")
      (test/assert-eq "Num" (nth 3 types) "last (return) type")
      true
    })

  (test/case "prefix-sig-compound"
    {do
      (= {types} (hint/parse-prefix-sig "{-> (List A) A}"))
      (test/assert-eq 2 (len types) "2 types")
      (test/assert-eq "(List A)" (nth 1 types) "compound type grouped")
      (test/assert-eq "A" (nth 2 types) "return type")
      true
    })

  (test/case "prefix-sig-higher-order"
    {do
      (= {types} (hint/parse-prefix-sig "{-> (-> A B) (List A) (List B)}"))
      (test/assert-eq 3 (len types) "3 types")
      (test/assert-eq "(-> A B)" (nth 1 types) "arrow type grouped")
      (test/assert-eq "(List A)" (nth 2 types) "compound param")
      (test/assert-eq "(List B)" (nth 3 types) "compound return")
      true
    })

  (test/case "prefix-sig-nil-input"
    {do
      (test/assert (nil? (hint/parse-prefix-sig nil)) "nil returns nil")
      true
    })

  (test/case "prefix-sig-no-arrow"
    {do
      (test/assert (nil? (hint/parse-prefix-sig "{Num}")) "no arrow returns nil")
      true
    })

  (test/case "prefix-sig-zero-arg"
    {do
      (= {r} (hint/parse-prefix-sig "{-> Num}"))
      (test/assert (not (nil? r)) "zero-arg sig should parse")
      (test/assert-eq 1 (len r) "should have 1 element (return type)")
      (test/assert-eq "Num" (head r) "return type is Num")
      true
    })

  ; --- Type hint: infer-val-type (tested via hint/collect through def/= path) ---

  (test/case "infer-num"
    {do
      (= {ast} (parse "(= {x} 42)"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "Num" (hint/infer-val-type val nil) "number")
      true
    })

  (test/case "infer-str"
    {do
      (= {ast} (parse "(= {x} \"hello\")"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "Str" (hint/infer-val-type val nil) "string")
      true
    })

  (test/case "infer-list"
    {do
      (= {ast} (parse "(= {x} (list 1 2 3))"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "List" (hint/infer-val-type val nil) "list call")
      true
    })

  (test/case "infer-dict"
    {do
      (= {ast} (parse "(= {x} (dict/new))"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "Dict" (hint/infer-val-type val nil) "dict/new")
      true
    })

  (test/case "infer-option-none"
    {do
      (= {ast} (parse "(= {x} (None))"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "Option" (hint/infer-val-type val nil) "None")
      true
    })

  (test/case "infer-option-some"
    {do
      (= {ast} (parse "(= {x} (Some 42))"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "Option" (hint/infer-val-type val nil) "Some")
      true
    })

  (test/case "infer-lambda"
    {do
      (= {ast} (parse "(= {x} (\\ {y} {+ y 1}))"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert-eq "Fn" (hint/infer-val-type val nil) "lambda")
      true
    })

  (test/case "infer-unknown-nil"
    {do
      (= {ast} (parse "(= {x} (foo 1))"))
      (= {val} (head (tail (tail (head ast)))))
      (test/assert (nil? (hint/infer-val-type val nil)) "unknown without db")
      true
    })

  ; --- Type hint: def bindings ---

  (test/case "type-hint-def-num"
    {do
      (= {text} "(def {x} 42)")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Num" labels) "def num gets type hint")
      true
    })

  (test/case "type-hint-assign-str"
    {do
      (= {text} "(= {s} \"hello\")")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Str" labels) "assign str gets type hint")
      true
    })

  (test/case "type-hint-def-list"
    {do
      (= {text} "(= {items} (list 1 2 3))")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: List" labels) "list gets type hint")
      true
    })

  (test/case "type-hint-def-dict"
    {do
      (= {text} "(= {m} (dict/new))")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Dict" labels) "dict gets type hint")
      true
    })

  (test/case "type-hint-def-lambda"
    {do
      (= {text} "(= {f} (\\ {x} {+ x 1}))")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Fn" labels) "lambda gets type hint")
      true
    })

  (test/case "type-hint-def-option"
    {do
      (= {text} "(= {result} (None))")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Option" labels) "None gets Option type hint")
      true
    })

  (test/case "type-hint-kind-is-type"
    {do
      (= {text} "(def {x} 42)")
      (= {hints} (hint/collect text nil nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (test/assert (> (len type-hints) 0) "type hints have kind 1")
      true
    })

  (test/case "type-hint-has-padding-right"
    {do
      (= {text} "(def {x} 42)")
      (= {hints} (hint/collect text nil nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {h} (head type-hints))
      (test/assert (not (nil? h:paddingRight)) "type hint has paddingRight")
      true
    })

  (test/case "type-hint-no-unknown-binding"
    {do
      (= {text} "(= {x} (unknown-fn 1))")
      (= {hints} (hint/collect text nil nil))
      (test/assert-eq 0 (len hints) "unknown fn without db gives no type hint")
      true
    })

  (test/case "type-hint-nested-in-do"
    {do
      (= {text} "(do (= {x} 42) (= {s} \"hello\"))")
      (= {hints} (hint/collect text nil nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Num" labels) "x gets Num inside do")
      (test/assert (member? ":: Str" labels) "s gets Str inside do")
      true
    })

  ; --- collect-local-params ---

  (test/case "local-params-basic"
    {do
      (= {params} (hint/collect-local-params
        (parse "(fun {add a b} {+ a b}) (fun {mul x y} {* x y})")))
      (= {add-p} (plist/get params "add"))
      (= {mul-p} (plist/get params "mul"))
      (test/assert (not (nil? add-p)) "add params found")
      (test/assert (not (nil? mul-p)) "mul params found")
      (test/assert-eq 2 (len add-p) "add has 2 params")
      (test/assert-eq 2 (len mul-p) "mul has 2 params")
      true
    })

  (test/case "local-params-inside-do"
    {do
      (= {params} (hint/collect-local-params
        (parse "(do (fun {helper a b} {+ a b}))")))
      (= {p} (plist/get params "helper"))
      (test/assert (not (nil? p)) "fun inside do block collected")
      (test/assert-eq 2 (len p) "helper has 2 params")
      true
    })

  ; --- Parameter type hints on function definitions ---

  (test/case "param-type-direct-simple"
    {do
      (= {params} (extract-fun-params "(fun {add a b} {+ a b})"))
      (= {sig-types} (list "Num" "Num" "Num"))
      (= {hints} (hint/emit-def-type-hints params sig-types 0 nil))
      (test/assert-eq 2 (len hints) "2 param type hints")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Num" labels) "param gets :: Num")
      true
    })

  (test/case "param-type-direct-mixed"
    {do
      (= {params} (extract-fun-params "(fun {greet name age} {list name age})"))
      (= {sig-types} (list "Str" "Num" "Str"))
      (= {hints} (hint/emit-def-type-hints params sig-types 0 nil))
      (test/assert-eq 2 (len hints) "2 param type hints")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Str" labels) "name gets :: Str")
      (test/assert (member? ":: Num" labels) "age gets :: Num")
      true
    })

  (test/case "param-type-direct-rest-stops"
    {do
      (= {params} (extract-fun-params "(fun {foo a & rest} {list a rest})"))
      (= {sig-types} (list "Num" "List" "List"))
      (= {hints} (hint/emit-def-type-hints params sig-types 0 nil))
      (test/assert-eq 1 (len hints) "stops at &")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: Num" labels) "a before & gets hint")
      true
    })

  (test/case "param-type-direct-kind"
    {do
      (= {params} (extract-fun-params "(fun {add a b} {+ a b})"))
      (= {sig-types} (list "Num" "Num" "Num"))
      (= {hints} (hint/emit-def-type-hints params sig-types 0 nil))
      (= {kinds} (map (\ {h} {h:kind}) hints))
      (test/assert (member? 1 kinds) "kind should be 1 (Type)")
      true
    })

  (test/case "param-type-direct-compound"
    {do
      (= {params} (extract-fun-params "(fun {mymap f xs} {list f xs})"))
      (= {sig-types} (list "(-> A B)" "(List A)" "(List B)"))
      (= {hints} (hint/emit-def-type-hints params sig-types 0 nil))
      (test/assert-eq 2 (len hints) "2 compound type hints")
      (= {labels} (map (\ {h} {h:label}) hints))
      (test/assert (member? ":: (-> A B)" labels) "f gets arrow type")
      (test/assert (member? ":: (List A)" labels) "xs gets list type")
      true
    })

  (test/case "param-type-direct-nil-params"
    {do
      (= {hints} (hint/emit-def-type-hints nil (list "Num") 0 nil))
      (test/assert-eq 0 (len hints) "nil params no hints")
      true
    })

  (test/case "param-type-pipeline-with-db"
    {do
      (= {db} (make-sig-db))
      (seed-sig db "add" "{-> Num Num Num}")
      (= {text} "(fun {add a b} {+ a b})")
      (= {hints} (hint/collect text db nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (sqlite/close db)
      (test/assert (member? ":: Num" labels) "param gets :: Num from db")
      true
    })

  (test/case "param-type-pipeline-no-sig"
    {do
      (= {db} (make-sig-db))
      (= {text} "(fun {add a b} {+ a b})")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (sqlite/close db)
      (test/assert-eq 0 (len type-hints) "no sig no type hints")
      true
    })

  (test/case "param-type-pipeline-padding-left"
    {do
      (= {db} (make-sig-db))
      (seed-sig db "add" "{-> Num Num Num}")
      (= {text} "(fun {add a b} {+ a b})")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {param-hints} (filter (\ {h} {str/starts-with? h:label "::"}) type-hints))
      (= {h} (head param-hints))
      (sqlite/close db)
      (test/assert (not (nil? h)) "param type hint exists")
      (test/assert (not (nil? h:paddingLeft)) "paddingLeft set on param type hint")
      true
    })

  (test/case "param-type-pipeline-return-type"
    {do
      (= {db} (make-sig-db))
      (seed-sig db "add" "{-> Num Num Num}")
      (= {text} "(fun {add a b} {+ a b})")
      (= {hints} (hint/collect text db nil))
      (= {labels} (map (\ {h} {h:label}) hints))
      (sqlite/close db)
      (test/assert (member? "-> Num" labels) "return type hint emitted")
      true
    })


  ; --- Field-access type hints ---

  (test/case "field-access-hint-from-sig"
    {do
      (= {db} (make-sig-db))
      (seed-sig db "get-info" "{-> Str SymInfo}")
      (= {text} "(type {SymInfo} {:name Str :kind Num :doc Any})\n(sig 'get-info {-> Str SymInfo})\n(fun {get-info x} {do\n  (= {info} (SymInfo x 1 nil))\n  info})\n(sig 'use-info {-> SymInfo Str})\n(fun {use-info info} {do\n  (= {n} info:name)\n  n})")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {labels} (map (\ {h} {h:label}) type-hints))
      (sqlite/close db)
      (test/assert (member? ":: Str" labels) "field access should show field type")
      true
    })

  (test/case "field-access-hint-from-ctor"
    {do
      (= {db} (make-sig-db))
      (seed-sig db "dist" "{-> Point Num}")
      (= {text} "(type {Point} {:x Num :y Num})\n(fun {dist p} {do\n  (= {px} p:x)\n  px})")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {labels} (map (\ {h} {h:label}) type-hints))
      (sqlite/close db)
      (test/assert (member? ":: Num" labels) "ctor field should show Num")
      true
    })

  (test/case "field-access-no-hint-untyped"
    {do
      (= {text} "(fun {foo x} {do\n  (= {n} x:name)\n  n})")
      (= {hints} (hint/collect text nil nil))
      (= {fa-hints} (filter (\ {h} {do (== h:kind 1) }) hints))
      (= {labels} (map (\ {h} {h:label}) fa-hints))
      (test/assert (not (member? ":: Str" labels)) "untyped var should not get field hint")
      true
    })

  (test/case "field-access-cross-file-via-db"
    {do
      (= {db} (make-sig-db))
      (sqlite/exec db
        "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('SymInfo', 1, 0, 0, 4, 3, ':name Str :kind Num :doc Str')")
      (seed-sig db "get-info" "{-> Str SymInfo}")
      (= {text} "(sig 'get-info {-> Str SymInfo})\n(fun {use-it x} {do\n  (= {info} (get-info x))\n  (= {n} info:name)\n  n})")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {labels} (map (\ {h} {h:label}) type-hints))
      (sqlite/close db)
      (test/assert (member? ":: Str" labels) "cross-file field should resolve via db")
      true
    })

  (test/case "field-access-from-function-return-type"
    {do
      (= {db} (make-sig-db))
      (= {text} "(type {Point} {:x Num :y Num})\n(sig 'make-pt {-> Num Num Point})\n(fun {use-pt a b} {do\n  (= {p} (make-pt a b))\n  (= {px} p:x)\n  px})")
      (seed-sig db "make-pt" "{-> Num Num Point}")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {labels} (map (\ {h} {h:label}) type-hints))
      (sqlite/close db)
      (test/assert (member? ":: Num" labels) "return type inferred field should show Num")
      true
    })

  (test/case "field-access-suppresses-any"
    {do
      (= {db} (make-sig-db))
      (seed-sig db "get-thing" "{-> Str ThingInfo}")
      (sqlite/exec db
        "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('ThingInfo', 1, 0, 0, 4, 2, ':name Str :data Any')")
      (= {text} "(sig 'get-thing {-> Str ThingInfo})\n(fun {use-it x} {do\n  (= {info} (get-thing x))\n  (= {d} info:data)\n  d})")
      (= {hints} (hint/collect text db nil))
      (= {type-hints} (filter (\ {h} {== h:kind 1}) hints))
      (= {labels} (map (\ {h} {h:label}) type-hints))
      (sqlite/close db)
      (test/assert (not (member? ":: Any" labels)) "Any field type should be suppressed")
      true
    })


))
