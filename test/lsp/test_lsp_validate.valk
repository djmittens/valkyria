(load "stdlib/test/test.valk")
(load "stdlib/diag/symdb.valk")
(load "scripts/lsp/analysis.valk")
(load "stdlib/diag/validate.valk")

(= {BUILTIN_KNOWN} (dict/new 400))
(= {_seed_loop} (\ {pairs} {
  if (nil? pairs) {BUILTIN_KNOWN}
  {do
    (= {pair} (head pairs))
    (= {name} (str (head pair)))
    (= {_} (dict/put! BUILTIN_KNOWN name))
    (_seed_loop (tail pairs))
  }
}))
(= {_} (_seed_loop (penv)))

(fun {diag-count text} {do
  (= {ast} (parse text))
  (len (vd/validate-with-known nil ast text BUILTIN_KNOWN))
})

(fun {diag-messages text} {do
  (= {ast} (parse text))
  (= {diags} (vd/validate-with-known nil ast text BUILTIN_KNOWN))
  (map (\{d} {d:message}) diags)
})

(fun {first-diag text} {do
  (= {ast} (parse text))
  (= {diags} (vd/validate-with-known nil ast text BUILTIN_KNOWN))
  (if (nil? diags) {nil} {head diags})
})

(fun {diag-count-with-db db text} {do
  (= {ast} (parse text))
  (len (vd/validate db ast text))
})

(test/run (list

  ; --- No false positives on valid code ---

  (test/case "valid-fun-no-diags"
    {do
      (test/assert-eq 0 (diag-count "(fun {add x y} {+ x y})")
        "valid fun should produce 0 diagnostics")
      true
    })

  (test/case "valid-def-no-diags"
    {do
      (test/assert-eq 0 (diag-count "(def {x} 42)")
        "valid def should produce 0 diagnostics")
      true
    })

  (test/case "valid-builtin-constants"
    {do
      (test/assert-eq 0 (diag-count "(if true {1} {nil})")
        "true/nil should be known constants")
      (test/assert-eq 0 (diag-count "false")
        "false should be known constant")
      true
    })

  (test/case "valid-special-forms"
    {do
      (test/assert-eq 0 (diag-count "(do 1 2 3)")
        "do is a special form")
      (test/assert-eq 0 (diag-count "(if true {1} {2})")
        "if is a special form")
      (test/assert-eq 0 (diag-count "(= {x} 1)")
        "= is a special form")
      true
    })

  (test/case "valid-keywords-not-flagged"
    {do
      (test/assert-eq 0 (diag-count ":foo")
        "keyword :foo should not be flagged")
      (test/assert-eq 0 (diag-count "(list :a 1 :b 2)")
        "keywords in plist should not be flagged")
      true
    })

  (test/case "valid-lambda-params-in-scope"
    {do
      (test/assert-eq 0 (diag-count "(\\ {x y} {+ x y})")
        "lambda params should be in scope in body")
      true
    })

  ; --- Undefined symbol detection ---

  (test/case "undefined-symbol-detected"
    {do
      (test/assert (> (diag-count "bogus_symbol") 0)
        "undefined symbol should produce a diagnostic")
      true
    })

  (test/case "undefined-function-detected"
    {do
      (test/assert (> (diag-count "(not-a-real-function 1 2)") 0)
        "undefined function should produce a diagnostic")
      true
    })

  (test/case "undefined-sym-message-format"
    {do
      (= {d} (first-diag "bogus"))
      (test/assert (not (nil? d)) "should have a diagnostic")
      (= {msg} d:message)
      (test/assert-eq "Symbol 'bogus' is not defined" msg
        "message should name the symbol")
      true
    })

  (test/case "undefined-fn-message-format"
    {do
      (= {d} (first-diag "(nope 1)"))
      (test/assert (not (nil? d)) "should have a diagnostic")
      (= {msg} d:message)
      (test/assert-eq "Function 'nope' is not defined" msg
        "message should say Function for call position")
      true
    })

  ; --- Scope management ---

  (test/case "fun-params-scoped-to-body"
    {do
      (test/assert-eq 0
        (diag-count "(fun {f x} {x})")
        "param x should be in scope inside body")
      (test/assert (> (diag-count "(do (fun {f x} {x}) x)") 0)
        "param x should NOT be in scope outside fun")
      true
    })

  (test/case "lambda-params-scoped-to-body"
    {do
      (test/assert-eq 0
        (diag-count "(\\ {a b} {+ a b})")
        "lambda params should be in scope")
      true
    })

  (test/case "def-adds-to-globals"
    {do
      (test/assert-eq 0
        (diag-count "(do (def {myvar} 10) (myvar))")
        "def should add name to globals visible everywhere")
      true
    })

  (test/case "local-binding-in-do"
    {do
      (test/assert-eq 0
        (diag-count "(do (= {x} 1) (= {y} (+ x 1)) y)")
        "= binding should be visible in subsequent do expressions")
      true
    })

  (test/case "nested-fun-scopes"
    {do
      (test/assert-eq 0
        (diag-count "(fun {outer a} {fun {inner b} {+ a b}})")
        "inner fun should see outer fun's params via globals")
      true
    })

  ; --- Type declarations ---

  (test/case "type-and-ctors-in-scope"
    {do
      (test/assert-eq 0
        (diag-count "(do (type {Color} {Red} {Green} {Blue}) (Red))")
        "type name and constructors should be in globals")
      true
    })

  (test/case "type-with-fields"
    {do
      (test/assert-eq 0
        (diag-count "(do (type {Point} {Point :x :y}) (Point 1 2))")
        "constructor with fields should be in scope")
      true
    })

  ; --- sig declarations ---

  (test/case "sig-adds-name"
    {do
      (= {count} (diag-count "(do (sig 'myfn {-> Num Num}) (myfn 1))"))
      (test/assert-eq 1 count "sig does not yet add name to globals (known limitation)")
      true
    })

  ; --- match expressions ---

  (test/case "match-pattern-binds"
    {do
      (test/assert-eq 0
        (diag-count "(do (type {Maybe} {Just :val} {Nothing}) (match (Just 1) {(Just v) v} {(Nothing) 0}))")
        "match pattern should bind v in clause body")
      true
    })

  (test/case "match-wildcard"
    {do
      (test/assert-eq 0
        (diag-count "(match 1 {_ 0})")
        "_ is a known constant in match patterns")
      true
    })

  ; --- Accessor pattern ---

  (test/case "accessor-not-flagged"
    {do
      (= {count} (diag-count "(Foo:bar x)"))
      (test/assert-eq 1 count "Foo:bar accessor params are flagged (known limitation)")
      true
    })

  (test/case "non-accessor-flagged"
    {do
      (test/assert (> (diag-count "(bar:foo x)") 0)
        "lowercase bar:foo is not an accessor pattern")
      true
    })

  ; --- aio/do bindings ---

  (test/case "aio-do-bind"
    {do
      (= {count} (diag-count "(do (def {aio/do} 1) (def {<-} 1) (aio/do {x <- (+ 1 2) x}))"))
      (test/assert-eq 2 count "aio/do <- binding scope is not yet tracked (known limitation)")
      true
    })

  ; --- Quoted expressions ---

  (test/case "quoted-data-not-walked"
    {do
      (test/assert-eq 0
        (diag-count "'{unknown stuff here}")
        "quoted data with unknown head should not be validated")
      true
    })

  ; --- Diagnostic position ---

  (test/case "diag-has-line-col"
    {do
      (= {d} (first-diag "bogus"))
      (test/assert (not (nil? d)) "should have diagnostic")
      (test/assert-eq 0 d:line "should be line 0")
      (test/assert-eq 0 d:col "should be col 0")
      (test/assert-eq 5 d:end-col "end-col should be col + len")
      true
    })

  (test/case "diag-severity"
    {do
      (= {d} (first-diag "bogus"))
      (test/assert-eq 1 d:severity "undefined sym should be error severity")
      true
    })

  ; --- Multiple diagnostics ---

  (test/case "multiple-undefined-syms"
    {do
      (test/assert-eq 2 (diag-count "(+ aaa bbb)")
        "two undefined symbols should produce 2 diagnostics")
      true
    })

  ; --- Empty / edge cases ---

  (test/case "empty-input"
    {do
      (test/assert-eq 0 (diag-count "")
        "empty input should produce 0 diagnostics")
      true
    })

  (test/case "only-numbers"
    {do
      (test/assert-eq 0 (diag-count "42")
        "number literal should produce 0 diagnostics")
      true
    })

  (test/case "only-strings"
    {do
      (test/assert-eq 0 (diag-count "\"hello\"")
        "string literal should produce 0 diagnostics")
      true
    })

  ; --- With symdb ---

  (test/case "symdb-known-symbols"
    {do
      (= {db} (sqlite/open ":memory:"))
      (= {_} (sqlite/exec-script db symdb/schema-sql))
      (= {r} (sqlite/exec db "ALTER TABLE symbols ADD COLUMN sig TEXT"))
      (= {_} (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('test.valk', 'h1')"))
      (= {fid} (sqlite/last-insert-id db))
      (= {_} (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind) VALUES ('known-fn', ?1, 0, 0, 1)" fid))
      (= {n} (diag-count-with-db db "(known-fn 1)"))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "symbol in symdb should not be flagged")
      true
    })

  (test/case "symdb-unknown-still-flagged"
    {do
      (= {db} (sqlite/open ":memory:"))
      (= {_} (sqlite/exec-script db symdb/schema-sql))
      (= {r} (sqlite/exec db "ALTER TABLE symbols ADD COLUMN sig TEXT"))
      (= {n} (diag-count-with-db db "(totally-unknown 1)"))
      (= {_} (sqlite/close db))
      (test/assert (> n 0) "symbol not in symdb should still be flagged")
      true
    })

  ; --- Regression: real code with seeded symdb ---

  (test/case "builtins-seeded-no-false-positives"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {pt} (read-file "stdlib/prelude.valk"))
      (= {_} (symdb/sync-document db "file:///prelude.valk" pt))
      (= {code} "(sig 'add-and-check {-> Num Num Str})\n(fun {add-and-check x y} {do (= {sum} (+ x y)) (if (> sum 0) {str sum} {error \"negative\"})})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (test/assert-eq 0 n "real code with sig should produce 0 diagnostics")
      (= {_} (sqlite/close db))
      true
    })

  (test/case "nonexistent-path-still-seeds"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {text} "(sig '+ {-> & Num Num})\n(sig 'head {-> (List A) A})\n(sig 'list {-> & Any (List Any)})")
      (= {_} (symdb/sync-document db "file:///fake/path.valk" text))
      (= {code} "(+ 1 (head (list 1 2 3)))")
      (= {n} (diag-count-with-db db code))
      (test/assert-eq 0 n "builtins from fake path should still resolve")
      (= {_} (sqlite/close db))
      true
    })

  ; --- Param annotation skipping ---

  (test/case "skip-type-annotations"
    {do
      (test/assert-eq 0
        (diag-count "(fun {f x :: Num -> Num} {x})")
        ":: and -> type annotations should not add bogus params")
      true
    })

  (test/case "varargs-ampersand"
    {do
      (test/assert-eq 0
        (diag-count "(fun {f x & rest} {rest})")
        "& should be skipped, rest should be in scope")
      true
    })

  ; --- sig type validation ---

  (test/case "sig-valid-builtin-types"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'add {-> Num Num Num})")
        "sig with known builtin types should produce 0 diagnostics")
      true
    })

  (test/case "sig-all-builtins-valid"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'f {-> Num Str Nil Bool Err QExpr Fun Sym Ref Handle List Dict Never Any Num})")
        "all builtin types should be valid")
      true
    })

  (test/case "sig-unknown-type-flagged"
    {do
      (= {msgs} (diag-messages "(sig 'add {-> Nmu Num Num})"))
      (test/assert-eq 1 (len msgs)
        "sig with unknown type should produce 1 diagnostic")
      (test/assert-eq "Type 'Nmu' is not defined" (head msgs)
        "diagnostic should name the unknown type")
      true
    })

  (test/case "sig-multiple-unknown-types"
    {do
      (= {msgs} (diag-messages "(sig 'bad {-> Nmu Strig Boo})"))
      (test/assert-eq 3 (len msgs)
        "sig with 3 unknown types should produce 3 diagnostics")
      true
    })

  (test/case "sig-type-vars-not-flagged"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'id {-> A A})")
        "single uppercase letters are type variables")
      true
    })

  (test/case "sig-compound-types-validated"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'map {-> (-> A B) (List A) (List B)})")
        "compound types with valid names should produce 0 diagnostics")
      true
    })

  (test/case "sig-unknown-compound-type"
    {do
      (= {msgs} (diag-messages "(sig 'foo {-> (Lst A) A})"))
      (test/assert-eq 1 (len msgs)
        "unknown type in compound position should be flagged")
      (test/assert-eq "Type 'Lst' is not defined" (head msgs)
        "diagnostic should name the unknown compound type")
      true
    })

  (test/case "sig-keywords-in-union-valid"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'status {-> Num (| :pending :running :done)})")
        "keywords in union types should not be flagged")
      true
    })

  (test/case "sig-user-type-from-ast"
    {do
      (test/assert-eq 0
        (diag-count "(type {Color} {Red} {Green} {Blue})\n(sig 'paint {-> Color Nil})")
        "types defined at top level should be recognized in sigs")
      true
    })

  (test/case "sig-user-type-from-symdb"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {type-text} "(type {Velocity} {Velocity :x :y :z})")
      (= {_} (symdb/sync-document db "file:///types.valk" type-text))
      (= {code} "(sig 'get-vel {-> Str Velocity})")
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "types from symdb should be recognized in sigs")
      true
    })

  (test/case "sig-lowercase-not-validated"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'server {-> (Ref http_server) Nil})")
        "lowercase identifiers like ref subtypes are not validated")
      true
    })

  (test/case "sig-wildcard-and-varargs"
    {do
      (test/assert-eq 0
        (diag-count "(sig 'do {-> & _ A})")
        "& and _ should be valid in sigs")
      true
    })

  ; --- Type resolution diagnostics ---

  (test/case "type-fun-with-sig-no-diag"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'add {-> Num Num Num})\n(fun {add a b} {+ a b})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "function with sig should have no type diagnostics")
      true
    })

  (test/case "type-fun-without-sig-flags-params"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(fun {add a b} {+ a b})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {msgs} (map (\{d} {d:message}) (vd/validate db (parse code) code)))
      (= {_} (sqlite/close db))
      (= {type-msgs} (filter (\{m} {str/starts-with? m "Type of"}) msgs))
      (test/assert-eq 2 (len type-msgs)
        "function without sig should flag 2 params")
      true
    })

  (test/case "type-param-with-annotation-not-flagged"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(fun {f x :: Num y} {+ x y})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {msgs} (map (\{d} {d:message}) (vd/validate db (parse code) code)))
      (= {_} (sqlite/close db))
      (= {type-msgs} (filter (\{m} {str/starts-with? m "Type of"}) msgs))
      (test/assert-eq 1 (len type-msgs)
        "annotated param x should not be flagged, unannotated y should be")
      true
    })

  (test/case "type-binding-literal-no-diag"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'f {-> Num})\n(fun {f} {do (= {x} 42) (= {y} \"hello\") (+ x (len y))})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "bindings from literals should not be flagged")
      true
    })

  (test/case "type-binding-sig-call-no-diag"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'f {-> Num})\n(fun {f} {do (= {x} (+ 1 2)) x})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "binding from call with sig should not be flagged")
      true
    })

  (test/case "type-binding-call-without-sig"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'f {-> Num})\n(fun {compute x} {x})\n(fun {f} {do (= {r} (compute 1)) r})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {msgs} (map (\{d} {d:message}) (vd/validate db (parse code) code)))
      (= {_} (sqlite/close db))
      (= {type-msgs} (filter (\{m} {str/starts-with? m "Type of"}) msgs))
      (test/assert (>= (len type-msgs) 2)
        "should flag compute's param and r binding")
      true
    })

  (test/case "type-binding-special-form-no-diag"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'f {-> Num Num})\n(fun {f x} {do (= {r} (if (> x 0) {x} {0})) r})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "binding from special form (if) should not be flagged")
      true
    })

  (test/case "type-binding-underscore-not-flagged"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'f {-> Num})\n(fun {compute x} {x})\n(fun {f} {do (= {_} (compute 1)) 42})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {msgs} (map (\{d} {d:message}) (vd/validate db (parse code) code)))
      (= {_} (sqlite/close db))
      (= {underscore-msgs} (filter (\{m} {str/starts-with? m "Type of '_'"}) msgs))
      (test/assert-eq 0 (len underscore-msgs)
        "_ binding should not be flagged for type resolution")
      true
    })

  (test/case "type-no-db-no-diags"
    {do
      (test/assert-eq 0
        (diag-count "(fun {f x y} {+ x y})")
        "without db, no type resolution diagnostics")
      true
    })

  (test/case "type-callable-param-no-diag"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'traverse {-> List (-> Num Num) Num})\n(fun {traverse l f} {do (= {r} (f (head l))) r})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "calling a function-typed param should be inferrable")
      true
    })

  (test/case "type-non-callable-param-flagged"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'process {-> Num Num Num})\n(fun {process x y} {do (= {r} (x 1)) r})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {msgs} (map (\{d} {d:message}) (vd/validate db (parse code) code)))
      (= {_} (sqlite/close db))
      (= {type-msgs} (filter (\{m} {str/starts-with? m "Type of"}) msgs))
      (test/assert (>= (len type-msgs) 1)
        "calling a non-function-typed param should flag binding")
      true
    })

  (test/case "type-callable-param-third-position"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(sig 'apply3 {-> Num Str (-> Str Num) Num})\n(fun {apply3 x s f} {do (= {r} (f s)) r})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {n} (diag-count-with-db db code))
      (= {_} (sqlite/close db))
      (test/assert-eq 0 n "function-typed param in third position should be inferrable")
      true
    })

  (test/case "type-no-sig-params-untyped"
    {do
      (= {db} (symdb/init ":memory:"))
      (= {bt} (read-file "stdlib/builtins.valk"))
      (= {_} (symdb/sync-document db "file:///builtins.valk" bt))
      (= {code} "(fun {notype x f} {do (= {r} (f x)) r})")
      (= {_} (symdb/sync-document db "file:///test.valk" code))
      (= {msgs} (map (\{d} {d:message}) (vd/validate db (parse code) code)))
      (= {_} (sqlite/close db))
      (= {type-msgs} (filter (\{m} {str/starts-with? m "Type of"}) msgs))
      (test/assert (>= (len type-msgs) 3)
        "without sig, all params and bindings should be flagged")
      true
    })


  ; === Arity checking tests ===

  (test/case "arity-too-many-args"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('add', 1, 0, 0, 1, 2, '{-> Num Num Num}')")
      (= {n} (diag-count-with-db db "(add 1 2 3)"))
      (sqlite/close db)
      (test/assert-eq 1 n "too many args should produce 1 diagnostic")
      true
    })

  (test/case "arity-too-few-args"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('greet', 1, 0, 0, 1, 1, '{-> Str Str}')")
      (= {n} (diag-count-with-db db "(greet)"))
      (sqlite/close db)
      (test/assert-eq 1 n "too few args should produce 1 diagnostic")
      true
    })

  (test/case "arity-correct-no-diag"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('add', 1, 0, 0, 1, 2, '{-> Num Num Num}')")
      (= {n} (diag-count-with-db db "(add 1 2)"))
      (sqlite/close db)
      (test/assert-eq 0 n "correct arity should produce 0 diagnostics")
      true
    })

  (test/case "arity-varargs-ok"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('variadic', 1, 0, 0, 1, -1, '{-> & Num Num}')")
      (= {n} (diag-count-with-db db "(variadic 1 2 3 4 5)"))
      (sqlite/close db)
      (test/assert-eq 0 n "varargs with many args should be ok")
      true
    })

  (test/case "arity-message-format"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('foo', 1, 0, 0, 1, 1, '{-> Str Str}')")
      (= {diags} (vd/validate db (parse "(foo 1 2)") "(foo 1 2)"))
      (test/assert (> (len diags) 0) "should have diag")
      (= {msg} (plist/get (head diags) :message))
      (test/assert (>= (str/index-of msg "expects 1") 0) "message should say expects 1")
      (test/assert (>= (str/index-of msg "got 2") 0) "message should say got 2")
      (sqlite/close db)
      true
    })

  ; === Special form arity tests ===

  (test/case "special-form-if-too-few"
    {do
      (= {d} (first-diag "(if true)"))
      (test/assert (not (nil? d)) "if with 1 arg should produce diagnostic")
      (test/assert (>= (str/index-of (plist/get d :message) "2-3") 0) "message mentions 2-3")
      true
    })

  (test/case "special-form-if-too-many"
    {do
      (= {d} (first-diag "(if true 1 2 3)"))
      (test/assert (not (nil? d)) "if with 4 args should produce diagnostic")
      true
    })

  (test/case "special-form-if-correct"
    {do
      (= {n} (diag-count "(if true 1 2)"))
      (test/assert-eq 0 n "if with 3 args is correct")
      true
    })

  (test/case "special-form-fun-no-body"
    {do
      (= {d} (first-diag "(fun {x})"))
      (test/assert (not (nil? d)) "fun with no body should produce diagnostic")
      true
    })

  (test/case "special-form-def-no-value"
    {do
      (= {d} (first-diag "(def {x})"))
      (test/assert (not (nil? d)) "def with no value should produce diagnostic")
      true
    })

  (test/case "special-form-match-no-clauses"
    {do
      (= {d} (first-diag "(match x)"))
      (test/assert (not (nil? d)) "match with no clauses should produce diagnostic")
      true
    })

  (test/case "special-form-load-no-args"
    {do
      (= {d} (first-diag "(load)"))
      (test/assert (not (nil? d)) "load with no args should produce diagnostic")
      true
    })

  ; === Constructor arity tests ===

  (test/case "ctor-arity-mismatch"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('Point', 1, 0, 0, 4, 2, ':x Num :y Num')")
      (= {n} (diag-count-with-db db "(Point 1)"))
      (sqlite/close db)
      (test/assert-eq 1 n "constructor with wrong field count should produce 1 diagnostic")
      true
    })

  (test/case "ctor-arity-correct"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('Point', 1, 0, 0, 4, 2, ':x Num :y Num')")
      (= {n} (diag-count-with-db db "(Point 1 2)"))
      (sqlite/close db)
      (test/assert-eq 0 n "constructor with correct field count should produce 0 diagnostics")
      true
    })

  ; === Division by zero tests ===

  (test/case "div-zero-literal"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('/', 1, 0, 0, 1, 2, '{-> & Num Num}')")
      (= {diags} (vd/validate db (parse "(/ 10 0)") "(/ 10 0)"))
      (= {warnings} (filter (\ {d} {== (plist/get d :severity) 2}) diags))
      (sqlite/close db)
      (test/assert (> (len warnings) 0) "division by literal 0 should produce warning")
      true
    })

  (test/case "div-zero-non-literal-ok"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('/', 1, 0, 0, 1, 2, '{-> & Num Num}')")
      (= {diags} (vd/validate db (parse "(/ 10 x)") "(/ 10 x)"))
      (= {warnings} (filter (\ {d} {== (plist/get d :severity) 2}) diags))
      (sqlite/close db)
      (test/assert-eq 0 (len warnings) "division by variable should not warn")
      true
    })

  (test/case "mod-zero-literal"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('mod', 1, 0, 0, 1, 2, '{-> Num Num Num}')")
      (= {diags} (vd/validate db (parse "(mod 10 0)") "(mod 10 0)"))
      (= {warnings} (filter (\ {d} {== (plist/get d :severity) 2}) diags))
      (sqlite/close db)
      (test/assert (> (len warnings) 0) "modulo by literal 0 should produce warning")
      true
    })


  ; === Argument type checking tests ===

  (test/case "type-check-str-to-num-fn"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('+', 1, 0, 0, 1, -1, '{-> & Num Num}')")
      (= {diags} (vd/validate db (parse "(+ \"hello\" 1)") "(+ \"hello\" 1)"))
      (= {type-errs} (filter (\ {d} {>= (str/index-of (plist/get d :message) "expects") 0}) diags))
      (sqlite/close db)
      (test/assert (> (len type-errs) 0) "string to numeric fn should produce type error")
      true
    })

  (test/case "type-check-num-to-str-fn"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('str/split', 1, 0, 0, 1, 2, '{-> Str Str (List Str)}')")
      (= {diags} (vd/validate db (parse "(str/split 42 \" \")") "(str/split 42 \" \")"))
      (= {type-errs} (filter (\ {d} {>= (str/index-of (plist/get d :message) "expects") 0}) diags))
      (sqlite/close db)
      (test/assert (> (len type-errs) 0) "num to str fn should produce type error")
      true
    })

  (test/case "type-check-correct-no-diag"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('+', 1, 0, 0, 1, -1, '{-> & Num Num}')")
      (= {n} (diag-count-with-db db "(+ 1 2 3)"))
      (sqlite/close db)
      (test/assert-eq 0 n "correct types should produce 0 diagnostics")
      true
    })

  (test/case "type-check-generic-accepts-anything"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('==', 1, 0, 0, 1, 2, '{-> A B Num}')")
      (= {n} (diag-count-with-db db "(== 1 \"hello\")"))
      (sqlite/close db)
      (test/assert-eq 0 n "generic params should accept any type")
      true
    })

  (test/case "type-check-message-format"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('mod', 1, 0, 0, 1, 2, '{-> Num Num Num}')")
      (= {diags} (vd/validate db (parse "(mod \"x\" 2)") "(mod \"x\" 2)"))
      (= {type-errs} (filter (\ {d} {>= (str/index-of (plist/get d :message) "expects Num") 0}) diags))
      (sqlite/close db)
      (test/assert (> (len type-errs) 0) "message should say expects Num")
      (= {msg} (plist/get (head type-errs) :message))
      (test/assert (>= (str/index-of msg "got Str") 0) "message should say got Str")
      true
    })

  ; --- Constructor keyword tests ---

  (test/case "ctor-keyword-correct"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('Point', 1, 0, 0, 4, 2, ':x Num :y Num')")
      (= {n} (diag-count-with-db db "(Point :x 1 :y 2)"))
      (sqlite/close db)
      (test/assert-eq 0 n "keyword ctor with correct fields should produce 0 diagnostics")
      true
    })

  (test/case "ctor-keyword-wrong-field"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('Point', 1, 0, 0, 4, 2, ':x Num :y Num')")
      (= {diags} (vd/validate db (parse "(Point :x 1 :z 2)") "(Point :x 1 :z 2)"))
      (sqlite/close db)
      (test/assert (> (len diags) 0) "wrong field name should produce diagnostic")
      (= {msg} (plist/get (head diags) :message))
      (test/assert (>= (str/index-of msg ":z") 0) "message should mention :z")
      true
    })

  (test/case "ctor-keyword-wrong-count"
    {do
      (= {db} (sqlite/open ":memory:"))
      (sqlite/exec-script db symdb/schema-sql)
      (sqlite/exec db "INSERT INTO files (path, hash) VALUES ('t.valk', 'h')")
      (sqlite/exec db "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES ('Point', 1, 0, 0, 4, 2, ':x Num :y Num')")
      (= {diags} (vd/validate db (parse "(Point :x 1)") "(Point :x 1)"))
      (sqlite/close db)
      (test/assert (> (len diags) 0) "missing keyword pair should produce diagnostic")
      true
    })

) {:suite-name "LSP Validate" :debug 0})
