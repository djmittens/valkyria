; valk-check — workspace diagnostics
;
; Usage: build/valk scripts/valk-check.valk -- [dir]
;        make check [DIR=path]
;
; Runs the full LSP validator on all tracked .valk files:
;   - Parse errors
;   - Undefined symbols/functions
;   - Arity mismatches (special forms + user functions)
;   - Argument type mismatches vs sig
;   - Constructor field validation
;   - Type accessor validation
;   - Unknown types in sig declarations
;   - Match pattern field count
;   - Division by literal zero

(load "stdlib/diag/symdb.valk")
(load "stdlib/diag/validate.valk")

(fun {eprintln s} {stderr/write (str s "\n")})

; === Module prefix derivation ===
; Mirrors the compiler's extract_module_prefix: basename without extension.
; Files loaded by the C runtime (prelude, builtins) get no prefix.

(def {check/NO_PREFIX_FILES}
  (dict/from-keys {"stdlib/prelude.valk" "stdlib/builtins.valk"}))

(fun {check/basename-stem path} {do
  (= {parts} (str/split path "/"))
  (= {filename} (last parts))
  (= {dot} (str/index-of filename "."))
  (if (< dot 1) {filename}
    {str/slice filename 0 dot})
})

(fun {check/module-prefix path} {
  if (dict/has? check/NO_PREFIX_FILES path) {""}
    {check/basename-stem path}
})

; === Find .valk files via git ===

(fun {check/find-files dir} {do
  (= {r} (exec "git" "ls-files" "--full-name" "*.valk" "**/*.valk"))
  (if (!= r:exit-code 0)
    {do (eprintln (str "valk-check: git ls-files failed: " r:stderr))
        nil}
    {do
      (= {all} (filter (\ {f} {> (len f) 0}) (str/split r:stdout "\n")))
      (if (== dir ".")
        {all}
        {filter (\ {f} {str/starts-with? f dir}) all})})
})

; === Ignore list ===

(fun {check/load-ignore-list} {do
  (= {text} (read-file ".valkcheckignore"))
  (if (error? text) {(dict/new)}
    {dict/from-keys
      (filter (\ {l} {if (> (len l) 0) {not (== (str/slice l 0 1) "#")} {0}})
        (str/split text "\n"))})
})

(def {check/IGNORED} (check/load-ignore-list))

(fun {check/ignored? path} {dict/has? check/IGNORED path})

; === Diagnostic formatting ===

(fun {check/severity-str sev} {
  if (== sev 1) {"error"}
  {if (== sev 2) {"warning"}
    {"info"}}
})

(fun {check/print-diag path d} {
  eprintln (str path ":" d:line ":" d:col ": "
    (check/severity-str d:severity) ": " d:message)
})

(fun {check/print-diags path diags} {
  if (nil? diags) {nil}
  {do (check/print-diag path (head diags))
      (check/print-diags path (tail diags))}
})

(fun {check/count-severity diags sev} {
  if (nil? diags) {0}
  {if (error? diags) {0}
    {do
      (= {d} (head diags))
      (= {s} (if (error? d) {-1} {d:severity}))
      (= {s} (if (error? s) {-1} {s}))
      (+ (if (== s sev) {1} {0})
         (check/count-severity (tail diags) sev))}}
})

; === Phase 1: Sync all files into symdb (using compiler pipeline) ===

(fun {check/sync-light db uri text ast} {do
  (= {path} (symdb/uri->path uri))
  (= {hash} (str "check:" (len text)))
  (sqlite/exec db
    "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
    path hash)
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (not (nil? file-id)) {lsp/index-ast db file-id ast text 1} {})
})

(fun {check/sync-all db files} {
  if (nil? files) {nil}
  {do
    (= {path} (head files))
    (= {text} (read-file path))
    (if (not (error? text))
      {do
        (= {prefix} (check/module-prefix path))
        (= {ast} (compile/process text prefix))
        (if (error? ast) {nil}
          {do
            (sqlite/exec db "BEGIN")
            (check/sync-light db (str "file://" path) text ast)
            (sqlite/exec db "COMMIT")})}
      {nil})
    (check/sync-all db (tail files))}
})

; === Phase 2: Validate all files ===

(fun {check/validate-all db files with-types} {do
  ; Preload db-derived caches once; reuse across all files.
  ; Without this, known-set (~26s) and arity-cache (~6s) re-query the symdb
  ; for every file — the bulk of phase-2 wall time on large workspaces.
  (= {cache} (vd/preload-caches db))
  (check/validate-walk db files with-types cache 0 0 0)
})

; Collect HM type inference errors for a single file as warnings.
; The HM engine stores source positions as byte offsets; convert them to
; line/column using the source text before reporting.
(fun {check/hm-errors text ast} {do
  (= {result} (type/infer-file ast))
  (= {errors} (plist/get result :errors))
  (check/hm-errors-to-diags text errors)
})

(fun {check/hm-errors-to-diags text errors} {
  if (nil? errors) {nil}
  {do
    (= {e} (head errors))
    (= {offset} (plist/get e :line))
    (= {msg} (plist/get e :message))
    (= {pos} (if (or (nil? offset) (error? offset)) {list 0 0}
                {offset->line-col text offset}))
    (qcons (list :severity 2
                 :line (head pos)
                 :col (head (tail pos))
                 :message (str "type: " msg))
      (check/hm-errors-to-diags text (tail errors)))}
})

(fun {check/merge-diags a b} {
  if (nil? a) {b}
  {if (nil? b) {a}
    {join a b}}
})

(fun {check/validate-walk db files with-types cache total-lines total-errors total-warnings} {
  if (nil? files) {list :lines total-lines :errors total-errors
                        :warnings total-warnings}
  {do
    (= {path} (head files))
    (if (check/ignored? path)
      {check/validate-walk db (tail files) with-types cache total-lines total-errors total-warnings}
      {do
        (= {text} (read-file path))
        (if (error? text)
          {check/validate-walk db (tail files) with-types cache total-lines total-errors total-warnings}
          {do
            (= {lines} (+ 1 (len (str/split text "\n"))))
            (= {ast} (parse text))
            (if (error? ast)
              {do (eprintln (str path ":1:1: error: " ast))
                  (check/validate-walk db (tail files) with-types cache (+ total-lines lines)
                    (+ total-errors 1) total-warnings)}
              {do
                (= {vd-diags} (vd/validate-cached db ast text cache))
                (= {hm-diags} (if with-types {check/hm-errors text ast} {nil}))
                (= {diags} (if (error? vd-diags) {hm-diags}
                               {check/merge-diags vd-diags hm-diags}))
                (if (error? diags)
                  {do (eprintln (str path ": internal error: " diags))
                      (check/validate-walk db (tail files) with-types cache (+ total-lines lines)
                        (+ total-errors 1) total-warnings)}
                  {do
                    (= {errs} (check/count-severity diags 1))
                    (= {warns} (check/count-severity diags 2))
                    (if (> (len diags) 0) {check/print-diags path diags} {nil})
                    (check/validate-walk db (tail files) with-types cache (+ total-lines lines)
                      (+ total-errors errs) (+ total-warnings warns))})})})})}
})

; === Arg parsing ===
;
; Args after `--`: [--types] [dir]
;   --types  Also surface Hindley-Milner type inference warnings (opt-in;
;            HM currently has many false positives, so this is off by default)
;   dir      Directory to check (defaults to ".")

(fun {check/has-flag args flag} {
  if (nil? args) {0}
  {if (== (head args) flag) {1}
    {check/has-flag (tail args) flag}}
})

(fun {check/find-dir args} {
  if (nil? args) {"."}
  {if (== (head args) "--")
    {check/skip-flags (tail args)}
    {check/find-dir (tail args)}}
})

(fun {check/skip-flags args} {
  if (nil? args) {"."}
  {if (str/starts-with? (head args) "--")
    {check/skip-flags (tail args)}
    {head args}}
})

; === Main ===

(fun {check/main} {do
  (= {dir} (check/find-dir sys/argv))
  (= {with-types} (check/has-flag sys/argv "--types"))
  (= {files} (check/find-files dir))

  (if (nil? files)
    {do (eprintln "valk-check: no .valk files found") (exit 0)} {nil})

  (= {n} (len files))

  ; Phase 1: index workspace into symdb (for cross-file resolution)
  (= {db-path} ".valk/check.sqlite")
  (= {db} (symdb/init db-path))
  (eprintln (str "valk-check: indexing " n " files"))
  (check/sync-all db files)

  ; Phase 2: validate each file using full LSP checks
  (eprintln (str "valk-check: validating " n " files"
    (if with-types {" (with HM type warnings)"} {""})))
  (= {report} (check/validate-all db files with-types))

  (symdb/close db)

  (eprintln "")
  (if (== report:errors 0)
    {if (== report:warnings 0)
      {eprintln (str "valk-check: " n " files, " report:lines " lines -- all clear")}
      {eprintln (str "valk-check: " n " files, " report:lines " lines, "
        report:warnings " warnings")}}
    {do
      (eprintln (str "valk-check: " n " files, " report:lines " lines, "
        report:errors " errors"
        (if (> report:warnings 0) {str ", " report:warnings " warnings"} {""})))
      (exit 1)})
})

(check/main)
