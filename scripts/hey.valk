; hey.valk - HTTP/2 Load Testing Tool for Valkyria
;
; Usage: ./build/valk tools/hey.valk
; First start: ./build/valk tools/test_server.valk
;
; Edit cfg-* values below to configure


; ============================================================================
; Configuration - Edit these values
; ============================================================================
(def {cfg-host} "localhost")
(def {cfg-port} 18443)
(def {cfg-path} "/")
(def {cfg-total} 200)

; ============================================================================
; Implementation
; ============================================================================
(def {aio} (aio/await (aio/start)))

; Counters (mutable globals)
(def {completed} 0)
(def {successes} 0)
(def {errors} 0)
(def {start-time} (time-us))

; Header
(println "hey.valk - HTTP/2 Load Tester")
(printf "Target: https://%s:%d%s\n" cfg-host cfg-port cfg-path)
(printf "Requests: %d\n\n" cfg-total)
(println "Running...")

; Fire all requests concurrently
(map (\ {_} {
  (= {t0} (time-us))
  (aio/then (http2/client-request aio cfg-host cfg-port cfg-path) (\ {resp} {
    (def {completed} (+ completed 1))

    (if (error? resp)
      {(def {errors} (+ errors 1))}
      {(def {successes} (+ successes 1))})

    (if (>= completed cfg-total)
      {(= {end-t} (time-us))
       (= {dur} (/ (- end-t start-time) 1000))

       (println "")
       (println "Summary:")
       (printf "  Completed: %d/%d\n" completed cfg-total)
       (printf "  Success:   %d\n" successes)
       (printf "  Errors:    %d\n" errors)
       (printf "  Duration:  %d ms\n" dur)
       (if (> dur 0)
         {(printf "  RPS:       %d\n" (/ (* completed 1000) dur))}
         {1})
       (if (> completed 0)
         {(printf "  Error %%:   %d%%\n" (/ (* errors 100) completed))}
         {1})

       (aio/stop aio)}
      {1})
  }))
}) (range 0 cfg-total))

(aio/run aio)
