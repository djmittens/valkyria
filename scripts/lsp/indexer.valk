; LSP indexer operation — plugs into ast/walk to produce symbols + refs.

(module indexer)

(sig 'idx/make-op {-> Ref Num Str Ref List})
(fun {idx/make-op db file-id text ref-stmt} {
  list
    :on-fun (\ {name arity pos} {do
      (= {lc} (offset->line-col text pos))
      (sqlite/exec db
        "INSERT INTO symbols (name, file_id, line, col, kind, arity) VALUES (?1,?2,?3,?4,?5,?6)"
        name file-id (head lc) (+ (head (tail lc)) 6) 1 arity)})

    :on-def (\ {name pos is-global} {
      if is-global {do
        (= {lc} (offset->line-col text pos))
        (sqlite/exec db
          "INSERT INTO symbols (name, file_id, line, col, kind, arity) VALUES (?1,?2,?3,?4,?5,?6)"
          name file-id (head lc) (head (tail lc)) 2 -1)} {}})

    :on-type (\ {tname arity pos} {do
      (= {lc} (offset->line-col text pos))
      (= {line} (head lc))
      (= {col} (head (tail lc)))
      (sqlite/exec db
        "INSERT INTO symbols (name, file_id, line, col, kind, arity) VALUES (?1,?2,?3,?4,?5,?6)"
        tname file-id line col 3 -1)
      (sqlite/exec db
        "INSERT INTO symbols (name, file_id, line, col, kind, arity) VALUES (?1,?2,?3,?4,?5,?6)"
        tname file-id line col 4 arity)})

    :on-sig (\ {sname sig-body pos} {do
      (= {existing} (sqlite/query-maybe db
        "SELECT id FROM symbols WHERE file_id=?1 AND name=?2"
        file-id sname))
      (if (nil? existing) {do
        (= {lc} (offset->line-col text pos))
        (sqlite/exec db
          "INSERT INTO symbols (name, file_id, line, col, kind, arity, sig) VALUES (?1,?2,?3,?4,?5,?6,?7)"
          sname file-id (head lc) (head (tail lc)) 1 -1 "(sig)")}
        {sqlite/exec db "UPDATE symbols SET sig='(sig)' WHERE id=?1"
          existing:id})})

    :on-ref (\ {name pos slen scope-pos} {
      if (and (>= pos 0) (not (str/starts-with? name ":")))
      {do
        (= {lc} (offset->line-col text pos))
        (sqlite/bind ref-stmt name file-id (head lc) (head (tail lc)))
        (sqlite/step ref-stmt)} {}})
})

(sig 'idx/count-params {-> List Num Num})
(fun {idx/count-params params n} {
  if (nil? params) {n}
  {do
    (= {p} (head params))
    (if (and (== (ast/node-type p) "sym") (== (ast/node-name p) "&")) {n}
      {idx/count-params (tail params) (+ n 1)})}
})

(sig 'idx/index-file-fast {-> Ref Num List Str Nil})
(fun {idx/index-file-fast db file-id ast text} {do
  (sqlite/exec db "DELETE FROM symbols WHERE file_id=?1" file-id)
  (sqlite/exec db "DELETE FROM refs WHERE file_id=?1" file-id)
  (= {ref-stmt} (sqlite/prepare db
    "INSERT INTO refs (name, file_id, line, col) VALUES (?1,?2,?3,?4)"))
  (ast/walk ast (list (idx/make-op db file-id text ref-stmt)) text)
  (sqlite/finalize ref-stmt)
})
