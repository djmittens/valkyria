; LSP Inlay Hints — field-access type hints + public API
;
; Show types for (= {var} info:name) bindings.
; Three passes:
; 1. Collect type definitions from (type ...) forms → ctor → field → type
; 2. Collect variable types from sigs and constructor bindings → func → var → type
; 3. Walk AST and emit hints where var:field resolves to a known field type

(load "scripts/lsp/hints.valk")

(module hints-fields)

; ---------------------------------------------------------------------------
; Public API — combines parameter hints, type hints, and field-access hints
; ---------------------------------------------------------------------------

(sig 'hint/collect {-> Str Ref List List})
(fun {hint/collect text db range} {
  hint/collect-from-ast (parse text) text db range
})

(sig 'hint/collect-from-ast {-> List Str Ref List List})
(fun {hint/collect-from-ast ast text db range} {
  if (error? ast) {nil}
  {do
    (hint/set-module-from-ast ast)
    (= {local-params} (hint/collect-local-params ast))
    (= {ctx} (list :local local-params :db db))
    (= {raw-hints} (hint/walk-exprs ast ctx nil))
    (= {type-hints} (hint/collect-type-hints ast db))
    (= {field-hints} (hint/collect-field-hints ast db))
    ; BYOL: any pass returning an error (e.g. field-hints walker hitting
    ; an untyped binding) should degrade to "no hints from that pass"
    ; rather than propagate up.
    (= {raw-hints}   (if (error? raw-hints)   {nil} {raw-hints}))
    (= {type-hints}  (if (error? type-hints)  {nil} {type-hints}))
    (= {field-hints} (if (error? field-hints) {nil} {field-hints}))
    (hint/format-hints (join raw-hints (join type-hints field-hints)) text range)}
})

; --- Pass 1: Collect type definitions ---

(sig 'hint/td-field-pairs {-> List List List})
(fun {hint/td-field-pairs fields acc} {
  if (nil? fields) {acc}
  {if (< (len fields) 2) {acc}
  {do
    (= {f} (str (head fields)))
    (= {t} (str (nth 2 fields)))
    (hint/td-field-pairs (tail (tail fields))
      (qcons (list :field f :type t) acc))}}
})

(sig 'hint/td-parse-ctor {-> List List List})
(fun {hint/td-parse-ctor ctor defs} {
  if (not (list? ctor)) {defs}
  {if (nil? ctor) {defs}
  {do
    (= {cname} (str (head ctor)))
    (= {pairs} (hint/td-field-pairs (tail ctor) nil))
    (qcons (list :ctor cname :fields pairs) defs)}}
})

(sig 'hint/td-parse-body {-> Str List List List})
(fun {hint/td-parse-body type-name body defs} {
  if (nil? body) {defs}
  {do
    (= {fs} (ast/head-name body))
    (if (> (len fs) 0)
      {if (== (str/slice fs 0 1) ":")
        {do
          (= {pairs} (hint/td-field-pairs body nil))
          (qcons (list :ctor type-name :fields pairs) defs)}
        {defs}}
      {if (list? (head body))
        {hint/td-parse-ctors body defs}
        {defs}})}
})

(sig 'hint/td-parse-ctors {-> List List List})
(fun {hint/td-parse-ctors ctors defs} {
  if (nil? ctors) {defs}
  {hint/td-parse-ctors (tail ctors)
    (hint/td-parse-ctor (head ctors) defs)}
})

(sig 'hint/td-one {-> Any List List})
(fun {hint/td-one expr defs} {
  if (not (list? expr)) {defs}
  {if (< (len expr) 3) {defs}
  {do
    (= {hname} (ast/head-name expr))
    (if (== hname "") {defs}
    {if (not (== hname "type")) {defs}
    {do
    (= {name-list} (nth 2 expr))
    (if (not (list? name-list)) {defs}
    {if (nil? name-list) {defs}
    {hint/td-parse-body (str (head name-list)) (nth 3 expr) defs}})}})}}
})

(sig 'hint/collect-type-defs {-> List List})
(fun {hint/collect-type-defs ast} {
  if (nil? ast) {nil}
  {hint/collect-type-defs-loop ast nil}
})

(sig 'hint/collect-type-defs-loop {-> List List List})
(fun {hint/collect-type-defs-loop exprs defs} {
  if (nil? exprs) {defs}
  {hint/collect-type-defs-loop (tail exprs)
    (hint/td-one (head exprs) defs)}
})

; --- Pass 2: Collect variable types (from inferred types + constructor bindings) ---

(sig 'hint/query-inferred-type {-> Ref Str Str})
(fun {hint/query-inferred-type db name} {
  if (nil? db) {nil}
  {do
    (= {row} (sqlite/query-maybe db
      "SELECT inferred_type FROM symbols WHERE name=?1 AND inferred_type IS NOT NULL LIMIT 1"
      name))
    (if (nil? row) {nil} {row:inferred_type})}
})

(sig 'hint/parse-fn-return-type {-> Str Str})
(fun {hint/parse-fn-return-type type-str} {
  if (nil? type-str) {nil}
  {do
    (= {parts} (hint/split-type-parts type-str))
    (if (nil? parts) {nil}
      {last parts})}
})

(sig 'hint/split-type-parts {-> Str List})
(fun {hint/split-type-parts type-str} {
  if (nil? type-str) {nil}
  {if (< (len type-str) 5) {nil}
  {do
    (= {prefix} (str/slice type-str 0 4))
    (if (not (== prefix "(-> ")) {nil}
    {do
      (= {inner} (str/slice type-str 4 (- (len type-str) 1)))
      (str/split inner " ")})}}
})

(sig 'hint/vt-correlate-inferred {-> List Str Ref List List})
(fun {hint/vt-correlate-inferred params fname db acc} {
  if (nil? params) {acc}
  {do
    (= {inferred} (hint/query-inferred-type db fname))
    (= {parts} (hint/split-type-parts inferred))
    (if (nil? parts) {acc}
      {hint/vt-correlate-parts params parts 0 acc})}
})

(sig 'hint/vt-correlate-parts {-> List List Num List List})
(fun {hint/vt-correlate-parts params parts idx acc} {
  if (nil? params) {acc}
  {if (>= idx (- (len parts) 1)) {acc}
  {do
    (= {t} (nth (+ idx 1) parts))
    (= {pname} (if (sym? (head params)) {str (head params)} {nil}))
    (= {acc2} (if (nil? pname) {acc}
      {qcons (list :var pname :type t) acc}))
    (hint/vt-correlate-parts (tail params) parts (+ idx 1) acc2)}}
})

(sig 'hint/vt-scan-body {-> Any Ref List List})
(fun {hint/vt-scan-body expr db acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {do
    (= {n} (ast/head-name expr))
    (if (== n "") {acc}
    {if (== n "=") {hint/vt-scan-binding (tail expr) db acc}
    {if (== n "do") {hint/vt-scan-list (tail expr) db acc}
    {if (== n "if") {hint/vt-scan-list (tail expr) db acc}
    {if (== n "let") {hint/vt-scan-list (tail expr) db acc}
    {if (== n "match") {hint/vt-scan-list (tail expr) db acc}
    {acc}}}}}})}}
})

(sig 'hint/vt-scan-list {-> List Ref List List})
(fun {hint/vt-scan-list exprs db acc} {
  if (nil? exprs) {acc}
  {hint/vt-scan-list (tail exprs) db
    (hint/vt-scan-body (head exprs) db acc)}
})

(sig 'hint/vt-scan-binding {-> List Ref List List})
(fun {hint/vt-scan-binding tl db acc} {
  if (< (len tl) 2) {acc}
  {do
    (= {formals} (head tl))
    (= {val} (nth 2 tl))
    (if (not (list? formals)) {acc}
    {if (nil? formals) {acc}
    {do
      (= {var-name} (str (head formals)))
      (= {inferred} (if (error? val) {nil}
        {if (not (list? val)) {nil}
        {if (nil? val) {nil}
        {do
          (= {hn} (ast/head-name val))
          (if (== hn "") {nil}
          {if (hint/is-ctor-name hn) {hn}
          {do
            (= {ret} (hint/query-inferred-ret db hn))
            (if (nil? ret) {hint/infer-call-return-type hn db} {ret})}})}}}))
      (if (nil? inferred) {acc}
        {qcons (list :var var-name :type inferred) acc})}})}
})

(sig 'hint/query-inferred-ret {-> Ref Str Str})
(fun {hint/query-inferred-ret db name} {
  if (nil? db) {nil}
  {do
    (= {t} (hint/query-inferred-type db name))
    (hint/parse-fn-return-type t)}
})

(sig 'hint/vt-from-fun {-> List Ref List List})
(fun {hint/vt-from-fun tl db result} {
  if (< (len tl) 2) {result}
  {do
    (= {formals} (head tl))
    (= {body} (head (tail tl)))
    (if (not (list? formals)) {result}
    {if (nil? formals) {result}
    {do
      (= {fname} (str (head formals)))
      (= {params} (tail formals))
      (= {param-vars} (hint/vt-correlate-inferred params fname db nil))
      (= {param-vars} (if (nil? param-vars)
        {do
          (= {sig-types} (hint/query-sig-types db fname))
          (if (nil? sig-types) {nil}
            {hint/vt-correlate-parts params sig-types 0 nil})}
        {param-vars}))
      (= {body-vars} (hint/vt-scan-body body db nil))
      (= {all-vars} (if (nil? param-vars) {body-vars}
        {join param-vars body-vars}))
      (if (nil? all-vars) {result}
        {qcons (list :func fname :vars all-vars) result})}})}
})

(sig 'hint/collect-var-types {-> List Ref List})
(fun {hint/collect-var-types ast db} {
  if (nil? ast) {nil}
  {hint/vt-walk ast db nil}
})

(sig 'hint/vt-walk {-> List Ref List List})
(fun {hint/vt-walk exprs db result} {
  if (nil? exprs) {result}
  {do
    (= {expr} (head exprs))
    (= {result2} (if (not (list? expr)) {result}
      {if (nil? expr) {result}
      {if (== (ast/head-name expr) "fun")
        {hint/vt-from-fun (tail expr) db result}
        {result}}}))
    (hint/vt-walk (tail exprs) db result2)}
})

; --- Pass 3: Walk AST and emit field-access hints ---

(sig 'hint/fa-lookup-var {-> Str Str List Any})
(fun {hint/fa-lookup-var var-name func-name var-types} {
  if (nil? var-types) {nil}
  {do
    (= {entry} (head var-types))
    (if (== entry:func func-name)
      {hint/fa-find-in-vars var-name entry:vars}
      {hint/fa-lookup-var var-name func-name (tail var-types)})}
})

(sig 'hint/fa-find-in-vars {-> Str List Any})
(fun {hint/fa-find-in-vars var-name vars} {
  if (nil? vars) {nil}
  {do
    (= {v} (head vars))
    (if (== v:var var-name) {v:type}
      {hint/fa-find-in-vars var-name (tail vars)})}
})

(sig 'hint/fa-lookup-field {-> Str Str List Any})
(fun {hint/fa-lookup-field ctor-name field-name type-defs} {
  if (nil? type-defs) {nil}
  {do
    (= {td} (head type-defs))
    (if (== td:ctor ctor-name)
      {hint/fa-find-field field-name td:fields}
      {hint/fa-lookup-field ctor-name field-name (tail type-defs)})}
})

(sig 'hint/fa-find-field {-> Str List Any})
(fun {hint/fa-find-field field-name fields} {
  if (nil? fields) {nil}
  {do
    (= {f} (head fields))
    (if (== f:field field-name) {f:type}
      {hint/fa-find-field field-name (tail fields)})}
})

(sig 'hint/fa-resolve {-> Str Str List List Any})
(fun {hint/fa-resolve sym-str func-name var-types type-defs} {do
  (= {colon} (str/index-of sym-str ":"))
  (if (< colon 1) {nil}
  {do
    (= {var-name} (str/slice sym-str 0 colon))
    (= {field-name} (str ":" (str/slice sym-str (+ colon 1) (len sym-str))))
    (= {var-type} (hint/fa-lookup-var var-name func-name var-types))
    (if (nil? var-type) {nil}
      {hint/fa-lookup-field var-type field-name type-defs})})
})

(sig 'hint/fa-emit-field-hint {-> List Any List List})
(fun {hint/fa-emit-field-hint tl field-type acc} {
  if (nil? field-type) {acc}
  {if (== field-type "Any") {acc}
  {do
    (= {formals} (head tl))
    (if (not (list? formals)) {acc}
    {if (nil? formals) {acc}
    {do
      (= {pos} (src-pos (head formals)))
      (= {ns} (str (head formals)))
      (if (< pos 0) {acc}
        {qcons (list :offset (+ pos (len ns))
                     :label (str ":: " field-type) :kind 1) acc})}})}}
})

; fields list is in reverse definition order (qcons-accumulated).
; idx is 0-based original order.
(sig 'hint/fa-get-field-by-idx {-> Num List Any})
(fun {hint/fa-get-field-by-idx idx fields} {
  (= {n} (len fields))
  (if (< idx 0) {nil}
  {if (>= idx n) {nil}
  {do
    (= {f} (nth (- n idx) fields))
    (if (nil? f) {nil} {f:type})}})
})

(sig 'hint/fa-lookup-field-by-idx {-> Str Num List Any})
(fun {hint/fa-lookup-field-by-idx ctor-name idx type-defs} {
  if (nil? type-defs) {nil}
  {do
    (= {td} (head type-defs))
    (if (== td:ctor ctor-name)
      {hint/fa-get-field-by-idx idx td:fields}
      {hint/fa-lookup-field-by-idx ctor-name idx (tail type-defs)})}
})

(sig 'hint/fa-binding {-> List Str Str List List List List})
(fun {hint/fa-binding tl val-str func-name var-types type-defs acc} {
  hint/fa-emit-field-hint tl
    (hint/fa-resolve val-str func-name var-types type-defs)
    acc
})

(sig 'hint/fa-one {-> Any Str List List List List})
(fun {hint/fa-one expr func-name var-types type-defs acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {do
    (= {n} (ast/head-name expr))
    (= {tl} (tail expr))
    (if (== n "fun") {hint/fa-fun tl var-types type-defs acc}
    {if (== n "=")
      {hint/fa-try-binding expr tl func-name var-types type-defs acc}
    {if (or (== n "do") (or (== n "if") (or (== n "let") (== n "match"))))
      {hint/fa-walk tl func-name var-types type-defs acc}
      {acc}}})}}
})

(sig 'hint/fa-try-binding {-> List List Str List List List List})
(fun {hint/fa-try-binding expr tl func-name var-types type-defs acc} {
  if (< (len tl) 2) {acc}
  {do
    (= {rhs-name} (ast/nth-name 3 expr))
    (if (not (== rhs-name ""))
      {hint/fa-binding tl rhs-name func-name var-types type-defs acc}
    {do
      ; RHS is a type-transformed field access: (plist/get var :field) or (nth N var)
      (= {rhs} (nth 2 tl))
      (if (error? rhs) {acc}
      {if (not (list? rhs)) {acc}
      {do
        (= {rhs-head} (ast/head-name rhs))
        (if (== rhs-head "plist/get")
          {do
            ; Unknown-type: (plist/get var :field) -> reconstruct "var:field"
            (= {var-nm} (ast/nth-name 2 rhs))
            (= {field-key} (ast/nth-name 3 rhs))
            (if (== var-nm "") {acc}
            {if (== field-key "") {acc}
            {if (not (== (str/slice field-key 0 1) ":")) {acc}
            {hint/fa-binding tl
              (str var-nm (str/slice field-key 1 (len field-key)))
              func-name var-types type-defs acc}}})}
        {if (== rhs-head "nth")
          {do
            ; Known-type: (nth N var) -> look up field by index
            (= {var-nm} (ast/nth-name 3 rhs))
            (= {nth-idx} (nth 2 rhs))
            (if (== var-nm "") {acc}
            {if (error? nth-idx) {acc}
            {if (not (num? nth-idx)) {acc}
            {do
              (= {vt} (hint/fa-lookup-var var-nm func-name var-types))
              (if (nil? vt) {acc}
              {hint/fa-emit-field-hint tl
                (hint/fa-lookup-field-by-idx vt (- nth-idx 2) type-defs)
                acc})}}})}
        {acc}})}})})}
})

(sig 'hint/fa-fun {-> List List List List List})
(fun {hint/fa-fun tl var-types type-defs acc} {
  if (< (len tl) 2) {acc}
  {do
    (= {formals} (head tl))
    (= {body} (head (tail tl)))
    (if (not (list? formals)) {acc}
    {if (nil? formals) {acc}
    {do
      (= {fname} (str (head formals)))
      (hint/fa-one body fname var-types type-defs acc)}})}
})

(sig 'hint/fa-walk {-> List Str List List List List})
(fun {hint/fa-walk exprs func-name var-types type-defs acc} {
  if (nil? exprs) {acc}
  {hint/fa-walk (tail exprs) func-name var-types type-defs
    (hint/fa-one (head exprs) func-name var-types type-defs acc)}
})

(sig 'hint/parse-field-sig {-> Str List})
(fun {hint/parse-field-sig sig-str} {
  if (nil? sig-str) {nil}
  {do
    (= {parts} (str/split sig-str " "))
    (hint/parse-field-parts parts nil)}
})

(sig 'hint/parse-field-parts {-> List List List})
(fun {hint/parse-field-parts parts acc} {
  if (nil? parts) {acc}
  {if (< (len parts) 2) {acc}
  {do
    (= {f} (head parts))
    (= {t} (nth 2 parts))
    (hint/parse-field-parts (tail (tail parts))
      (qcons (list :field f :type t) acc))}}
})

(sig 'hint/query-db-type-defs {-> Ref List})
(fun {hint/query-db-type-defs db} {
  if (nil? db) {nil}
  {do
    (= {rows} (sqlite/query db
      "SELECT name, sig FROM symbols WHERE kind=4 AND sig IS NOT NULL AND sig != ''"
      ))
    (hint/build-db-type-defs rows nil)}
})

(sig 'hint/build-db-type-defs {-> List List List})
(fun {hint/build-db-type-defs rows acc} {
  if (nil? rows) {acc}
  {do
    (= {row} (head rows))
    (= {fields} (hint/parse-field-sig row:sig))
    (= {acc2} (if (nil? fields) {acc}
      {qcons (list :ctor row:name :fields fields) acc}))
    (hint/build-db-type-defs (tail rows) acc2)}
})

(sig 'hint/merge-type-defs {-> List List List})
(fun {hint/merge-type-defs local db-defs} {
  if (nil? local) {db-defs}
  {if (nil? db-defs) {local}
  {join local db-defs}}
})

(sig 'hint/collect-field-hints {-> List Ref List})
(fun {hint/collect-field-hints ast db} {do
  (= {local-defs} (hint/collect-type-defs ast))
  (= {db-defs} (hint/query-db-type-defs db))
  (= {type-defs} (hint/merge-type-defs local-defs db-defs))
  (= {var-types} (hint/collect-var-types ast db))
  (if (or (nil? type-defs) (nil? var-types)) {nil}
    {hint/fa-walk ast "" var-types type-defs nil})
})
