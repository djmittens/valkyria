; Valkyria LSP Server — diagnostics, document sync, workspace indexing, notification handlers
;
; === Indexing architecture ===
;
; ONE function indexes a file: lsp/index-file-full
;   1. Sync symbols + refs to DB (symdb/sync-file-symbols)
;   2. Run C indexer for semantic tokens + scoped refs (lsp/index-ast)
;   3. Compute inlay hints (lsp/precompute-file-data)
;   Returns 1 if file changed, 0 if cached.
;
; Callers:
;   - lsp/sync-doc:       called by did-open/did-change/did-save (text from editor)
;   - lsp/seed-from-disk: called by workspace scan (text from disk)

(module workspace)

; ---------------------------------------------------------------------------
; Transaction helper
; ---------------------------------------------------------------------------
;
; Wraps a thunk in BEGIN/COMMIT, with ROLLBACK on error. The thunk MUST be
; fully synchronous — no aio/dispatch, no aio/await, no callback registration.
; Holding a transaction across an async boundary races with other handlers
; on the main loop and causes nested-BEGIN errors.
;
; Use this instead of bare (sqlite/exec db "BEGIN") / (sqlite/exec db "COMMIT")
; pairs so error handling is uniform across the codebase.

(sig 'lsp/with-tx {-> Ref Fun Any})
(fun {lsp/with-tx db thunk} {do
  (sqlite/exec db "BEGIN")
  (= {r} (thunk))
  (if (error? r)
    {do (sqlite/exec db "ROLLBACK") r}
    {do (sqlite/exec db "COMMIT") r})
})

; ---------------------------------------------------------------------------
; Core indexing — single function, does everything
; ---------------------------------------------------------------------------

(sig 'lsp/index-file-full {-> Ref Str Str Str Num})
(fun {lsp/index-file-full db uri text hash} {do
  (= {path} (symdb/uri->path uri))
  (= {existing} (sqlite/query-maybe db
    "SELECT hash FROM files WHERE path=?1" path))
  (if (if (not (nil? existing)) {== existing:hash hash} {0}) {0}
    {do
      ; Single-parse path: get-ast hits the ast-cache for open documents,
      ; falls back to parse otherwise. Then sync-file-with-ast does
      ; strip-errors + file-insert + index-ast in one shot. Previously
      ; this function parsed twice and called index-ast twice — kept the
      ; main loop busy during workspace scan.
      (= {ast} (lsp/get-ast uri text))
      (if (error? ast) {0}
        {do (symdb/sync-file-with-ast db uri text hash ast) 1})})
})

(sig 'lsp/index-file-with-hints {-> Ref Str Str Str Num})
(fun {lsp/index-file-with-hints db uri text hash} {do
  (= {changed} (lsp/index-file-full db uri text hash))
  (if (> changed 0)
    {do
      (= {ast} (lsp/get-ast uri text))
      (if (not (error? ast))
        {lsp/precompute-file-data db uri ast text}
        {})}
    {})
  changed
})

; ---------------------------------------------------------------------------
; Disk seeding (workspace scan at startup)
; ---------------------------------------------------------------------------

(sig 'lsp/seed-from-disk {-> Ref Str Num})
(fun {lsp/seed-from-disk db path} {do
  (= {fp} (file/fingerprint path))
  (if (error? fp) {0}
    {do
      (= {text} (read-file path))
      (if (error? text) {0}
        {lsp/with-tx db
          (\ {} {lsp/index-file-full db (str "file://" path) text fp})})})
})

(sig 'lsp/seed-builtins {-> Ref Str Nil})
(fun {lsp/seed-builtins db root} {do
  (= {builtins-path} (str root "/stdlib/builtins.valk"))
  (= {prelude-path} (str root "/stdlib/prelude.valk"))
  (= {b} (lsp/seed-from-disk db builtins-path))
  (= {p} (lsp/seed-from-disk db prelude-path))
  (if (== (+ b p) 0)
    {stderr/write "[valk-lsp] builtins + prelude cached\n"}
    {stderr/write "[valk-lsp] seeded builtins + prelude\n"})})

(sig 'lsp/precompute-file-data {-> Ref Str List Str Nil})
(fun {lsp/precompute-file-data db uri ast text} {do
  (= {path} (symdb/uri->path uri))
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (nil? file-id) {}
    {do
      (lsp/index-ast db file-id ast text)
      (= {local-params} (hint/collect-local-params ast))
      (= {hctx} (HintCtx local-params db))
      (= {raw-hints} (hint/walk-exprs ast hctx nil))
      (= {type-hints} (hint/collect-type-hints ast db))
      (= {field-hints} (hint/collect-field-hints ast db))
      (symdb/insert-hint-batch db file-id (join raw-hints (join type-hints field-hints)))})
})

; ---------------------------------------------------------------------------
; Diagnostic publishing
; ---------------------------------------------------------------------------

(sig 'make-lsp-diag {-> List List})
(fun {make-lsp-diag d}
  {list :range
    (list :start (list :line d:line
                       :character d:col)
          :end   (list :line d:line
                       :character d:end-col))
    :severity d:severity
    :source "valk"
    :message d:message})

(sig 'lsp/ensure-loads-indexed {-> Ref List Nil})
(fun {lsp/ensure-loads-indexed db ast} {
  if (nil? db) {}
  {lsp/ensure-loads-walk db ast}
})

(sig 'lsp/ensure-loads-walk {-> Ref List Nil})
(fun {lsp/ensure-loads-walk db exprs} {
  if (nil? exprs) {}
  {do
    (= {e} (head exprs))
    (if (list? e)
      {if (nil? e) {}
        {do
          (= {form} (str (head e)))
          (if (== form "load")
            {if (nil? (tail e)) {}
              {do
                (= {path} (str (head (tail e))))
                (lsp/seed-from-disk db (if (str/starts-with? path "/") {path}
                  {str lsp/root-path "/" path}))}}
            {})}}
      {})
    (lsp/ensure-loads-walk db (tail exprs))}
})

(sig 'lsp/republish-all-diagnostics {-> Nil})
(fun {lsp/republish-all-diagnostics} {do
  (= {uris} (dict/keys lsp/documents))
  (lsp/republish-loop uris)
})

(sig 'lsp/republish-loop {-> List Nil})
(fun {lsp/republish-loop uris} {
  if (nil? uris) {}
  {do
    (= {uri} (head uris))
    (= {text} (lsp/doc-get uri))
    (if (nil? text) {}
      {lsp/publish-diagnostics lsp/db uri text})
    (lsp/republish-loop (tail uris))}
})

; Extract the byte offset from a parse error message of the form
; "[offset: N] ...". Returns 0 if no offset is found.
(sig 'lsp/parse-error-offset {-> Any Num})
(fun {lsp/parse-error-offset err} {do
  (= {msg} (str err))
  (= {start} (str/index-of msg "[offset: "))
  (if (< start 0) {0}
    {do
      (= {after} (str/slice msg (+ start 9) (len msg)))
      (= {end} (str/index-of after "]"))
      (if (< end 0) {0}
        {do (= {n-str} (str/slice after 0 end))
            ; Use parse to convert digit string to number
            (= {parsed} (parse n-str))
            (if (and (list? parsed) (and (> (len parsed) 0) (num? (head parsed))))
              {head parsed} {0})})})})

; Convert a parse error to an LSP Diagnostic, using the embedded byte offset
; to compute the line/column.
(sig 'lsp/parse-error->diag {-> Any Str List})
(fun {lsp/parse-error->diag err text} {do
  (= {offset} (lsp/parse-error-offset err))
  (= {pos} (offset->line-col text offset))
  (= {line} (head pos))
  (= {col} (head (tail pos)))
  (list :range
    (list :start (list :line line :character col)
          :end   (list :line line :character (+ col 1)))
    :severity 1
    :source "valk"
    :message (str err))
})

; Takes db as an arg so callers can route the DB work to lsp/idx-db on
; lsp/idx-sys (keeping lsp/sys loop-0 free to flush pipe writes). Parses
; text directly rather than consulting lsp/ast-cache because the cache
; is written by concurrent lsp/sys workers.
(sig 'lsp/publish-diagnostics {-> Ref Str Str Nil})
(fun {lsp/publish-diagnostics db uri text} {do
  (= {ast} (parse text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (lsp/parse-error->diag (str parse-err) text)))}
    {do
      (lsp/ensure-loads-indexed db ast)
      (= {known} (vd/load-known-set db))
      (= {diags} (vd/validate-with-known db ast text known))
      (= {lsp-diags} (if (error? diags)
        {do (stderr/write (str "[lsp] validate error: " diags "\n")) nil}
        {map make-lsp-diag diags}))
      (lsp/send-notification "textDocument/publishDiagnostics"
        (list :uri uri :diagnostics (if (error? lsp-diags)
          {do (stderr/write (str "[lsp] diag map error: " lsp-diags "\n")) nil}
          {lsp-diags})))})})

(sig 'lsp/publish-diagnostics-fast {-> Str Str Nil})
(fun {lsp/publish-diagnostics-fast uri text} {do
  (= {ast} (lsp/get-ast uri text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (lsp/parse-error->diag (str parse-err) text)))}
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics nil)})})

; ---------------------------------------------------------------------------
; Pull-based diagnostics (textDocument/diagnostic, LSP 3.17)
; ---------------------------------------------------------------------------

(sig 'lsp/compute-diagnostics {-> Str Str List})
(fun {lsp/compute-diagnostics uri text} {do
  (= {ast} (lsp/get-ast uri text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {list (lsp/parse-error->diag (str parse-err) text)}
    {do
      (lsp/ensure-loads-indexed lsp/db ast)
      (= {diags} (vd/validate-with-known lsp/db ast text (lsp/get-known-set)))
      (if (error? diags)
        {do (stderr/write (str "[lsp] validate error: " diags "\n"))
            nil}
        {do
          (= {mapped} (map make-lsp-diag diags))
          (if (error? mapped)
            {do (stderr/write (str "[lsp] diag map error: " mapped "\n")) nil}
            {mapped})})})})

(sig 'handle-pull-diagnostics {-> Num DocParams Nil})
(fun {handle-pull-diagnostics id params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} (lsp/doc-get uri))
  (if (nil? text)
    {lsp/send-response id (list :kind "full" :items nil)}
    {do
      (= {items} (lsp/compute-diagnostics uri text))
      (lsp/send-response id (list :kind "full" :items
        (if (error? items) {nil} {items})))})})

; ---------------------------------------------------------------------------
; Sync document to symdb
; ---------------------------------------------------------------------------

; Takes an explicit db ref so callers can choose lsp/db (main connection,
; used on loop 0) or lsp/idx-db (secondary connection, used by dispatched
; workers). Routing DB writes through lsp/idx-db on lsp/idx-sys keeps
; lsp/sys loop-0 free to flush pipe/writes promptly after a didOpen, so
; semantic-tokens responses don't queue behind a long index transaction.
; Parses text directly (native ~5ms) instead of relying on lsp/ast-cache,
; because the cache is written by a concurrent lsp/sys worker and racy
; to read from idx-sys.
(sig 'lsp/sync-doc {-> Ref Str Str Nil})
(fun {lsp/sync-doc db uri text} {do
  (if (nil? db) {}
    {do
      (= {hash} (str "mem:" (len text)))
      (= {path} (symdb/uri->path uri))
      (= {existing} (sqlite/query-maybe db
        "SELECT hash FROM files WHERE path=?1" path))
      (if (if (not (nil? existing)) {== existing:hash hash} {0}) {}
        {do
          (= {ast} (parse text))
          ; `parse` returns a list of top-level forms and appends parse
          ; errors as LVAL_ERR elements, so `(error? ast)` is always
          ; false; scan the list for any error element instead. Skipping
          ; the symdb write on broken parses keeps highlighting/inlays
          ; stable on the last-good snapshot while the user is mid-edit,
          ; rather than flickering between partial new data and stale
          ; old data.
          (if (lsp/ast-has-error ast) {}
            {lsp/with-tx db
              (\ {} {do
                (symdb/sync-file-with-ast db uri text hash ast)
                (lsp/precompute-file-data db uri ast text)})})})})})



; ---------------------------------------------------------------------------
; Workspace scanning — incremental background indexing
; ---------------------------------------------------------------------------

(def {lsp/skip-dirs} (list "build" "vendor" "node_modules" "coverage-report"
                           "test-report" ".valk" ".git"))

(sig 'lsp/skip-dir? {-> Str Num})
(fun {lsp/skip-dir? name} {
  if (nil? lsp/skip-dirs) {0}
    {lsp/skip-dir-check name lsp/skip-dirs}
})

(sig 'lsp/skip-dir-check {-> Str List Num})
(fun {lsp/skip-dir-check name dirs} {
  if (nil? dirs) {0}
    {if (== name (head dirs)) {1}
      {lsp/skip-dir-check name (tail dirs)}}
})

(sig 'lsp/scan-dir {-> Str List List})
(fun {lsp/scan-dir root acc} {do
  (= {entries} (list-dir root))
  (if (error? entries) {acc}
    {lsp/scan-entries root entries acc})
})

(sig 'lsp/scan-entries {-> Str List List List})
(fun {lsp/scan-entries root entries acc} {
  if (nil? entries) {acc}
    {do
      (= {entry} (head entries))
      (= {name} entry:name)
      (= {type} entry:type)
      (= {full} (str root "/" name))
      (= {acc} (if (== type "dir")
        {if (lsp/skip-dir? name) {acc}
          {lsp/scan-dir full acc}}
        {if (str/ends-with? name ".valk")
          {qcons full acc}
          {acc}}))
      (lsp/scan-entries root (tail entries) acc)}
})

(sig 'lsp/index-file {-> Ref Str Num})
(fun {lsp/index-file db path} {
  lsp/seed-from-disk db path
})

(sig 'lsp/collect-workspace-files {-> Str List})
(fun {lsp/collect-workspace-files root} {do
  (stderr/write (str "[valk-lsp] collecting workspace files: " root "\n"))
  (= {files} (lsp/scan-dir root nil))
  (stderr/write (str "[valk-lsp] found " (len files) " .valk files\n"))
  files})

; Prepare file for indexing (runs on worker thread).
; Returns nil if unchanged or unreadable, otherwise a plist of extracted data.
(sig 'lsp/prepare-file {-> Str List})
(fun {lsp/prepare-file path} {do
  (= {fp} (file/fingerprint path))
  (if (error? fp) {nil}
    {lsp/prepare-file-read path fp})
})

(sig 'lsp/prepare-file-read {-> Str Str List})
(fun {lsp/prepare-file-read path fp} {do
  (= {text} (read-file path))
  (= {ast} (if (error? text) {nil} {parse text}))
  (if (or (error? text) (or (nil? ast) (error? ast))) {nil}
    {list :path path :text text :fp fp :ast ast})
})

; Commit file data to SQLite.
; lsp/index-ast (C) does a single-pass walk producing:
;   symbols, refs, nodes, semantic tokens, scoped refs, scopes, hints
(sig 'lsp/commit-prepared {-> Ref List Num})
(fun {lsp/commit-prepared db prep} {
  if (nil? prep) {0}
  {do
    (= {path} (plist/get prep :path))
    (= {fp} (plist/get prep :fp))
    (= {fpath} (symdb/uri->path (str "file://" path)))
    (= {existing} (sqlite/query-maybe db
      "SELECT hash FROM files WHERE path=?1" fpath))
    (if (and (not (nil? existing)) (and (not (error? existing)) (== existing:hash fp)))
      {0}
      {do
        (= {text} (plist/get prep :text))
        (= {ast} (plist/get prep :ast))
        (sqlite/exec db
          "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
          fpath fp)
    (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" fpath))
    (if (not (nil? file-id)) {lsp/index-ast db file-id ast text} {})
    1})}
})

; Fast index — symbols + refs only (for initial workspace scan)
(sig 'lsp/commit-prepared-fast {-> Ref List Num})
(fun {lsp/commit-prepared-fast db prep} {
  if (nil? prep) {0}
  {do
    (= {path} (plist/get prep :path))
    (= {fp} (plist/get prep :fp))
    (= {fpath} (symdb/uri->path (str "file://" path)))
    (= {existing} (sqlite/query-maybe db
      "SELECT hash FROM files WHERE path=?1" fpath))
    (if (and (not (nil? existing)) (and (not (error? existing)) (== existing:hash fp)))
      {0}
      {do
        (= {text} (plist/get prep :text))
        (= {ast} (plist/get prep :ast))
        (sqlite/exec db
          "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
          fpath fp)
     (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" fpath))
    (if (not (nil? file-id))
      {do (idx/index-file-fast db file-id ast text)
          (lsp/index-ast db file-id ast text)
          (lsp/precompute-file-data db (str "file://" path) ast text)}
      {})
    1})}
})

; ---------------------------------------------------------------------------
; Stale file cleanup
; ---------------------------------------------------------------------------

(sig 'lsp/cleanup-stale-files {-> Nil})
(fun {lsp/cleanup-stale-files} {
  if (nil? lsp/db) {}
  {do
    (= {indexed} (symdb/all-indexed-paths lsp/db))
    (= {removed} (lsp/check-stale-files indexed 0))
    (if (> removed 0)
      {do (lsp/invalidate-known-set)
          (stderr/write (str "[valk-lsp] removed " removed " stale files\n"))}
      {})}
})

(sig 'lsp/check-stale-files {-> List Num Num})
(fun {lsp/check-stale-files files count} {
  if (nil? files) {count}
  {do
    (= {f} (head files))
    (= {path} f:path)
    (= {file-id} f:id)
    (= {fp} (file/fingerprint path))
    (if (error? fp)
      {do (symdb/remove-file lsp/db file-id)
          (lsp/check-stale-files (tail files) (+ count 1))}
      {lsp/check-stale-files (tail files) count})}
})

; ---------------------------------------------------------------------------
; Progress support
; ---------------------------------------------------------------------------

(def {lsp/progress-token} 0)

(sig 'lsp/next-progress-token {-> Num})
(fun {lsp/next-progress-token} {do
  (def {lsp/progress-token} (+ lsp/progress-token 1))
  lsp/progress-token
})

(sig 'lsp/send-request {-> Num Str List Nil})
(fun {lsp/send-request id method params}
  {lsp/write-message
    (list :jsonrpc "2.0" :id id :method method :params params)})

(sig 'lsp/progress-begin {-> Num Str Num Nil})
(fun {lsp/progress-begin token title total} {do
  (lsp/send-request (+ 100000 token) "window/workDoneProgress/create"
    (list :token token))
  (lsp/send-notification "$/progress"
    (list :token token
          :value (list :kind "begin"
                       :title title
                       :percentage 0)))
})

(sig 'lsp/progress-report {-> Num Str Num Nil})
(fun {lsp/progress-report token message pct} {do
  (lsp/send-notification "$/progress"
    (list :token token
          :value (list :kind "report"
                       :message message
                       :percentage pct)))
})

(sig 'lsp/progress-end {-> Num Str Nil})
(fun {lsp/progress-end token message} {do
  (lsp/send-notification "$/progress"
    (list :token token
          :value (list :kind "end"
                       :message message)))
})

; Pre-filter: check fingerprints on main thread, only return files that changed
(sig 'lsp/filter-changed {-> Ref List List})
(fun {lsp/filter-changed db files} {
  if (nil? files) {nil}
  {do
    (= {path} (head files))
    (= {fp} (file/fingerprint path))
    (= {rest} (lsp/filter-changed db (tail files)))
    (if (error? fp) {rest}
      {do
        (= {fpath} (symdb/uri->path (str "file://" path)))
        (= {existing} (sqlite/query-maybe db
          "SELECT hash FROM files WHERE path=?1" fpath))
        (if (and (not (nil? existing)) (== existing:hash fp))
          {rest}
          {qcons path rest})})}
})

; ---------------------------------------------------------------------------
; Dependency-ordered workspace scan
; Phase 1: dispatch all files to workers for read+parse+extract (parallel)
; Phase 2: collect results, topo-sort by (load ...) deps, commit in order
;          so hints can see dependency symbols in DB
; ---------------------------------------------------------------------------

; Extract (load "path") dependencies from file text (cheap string scan)
(sig 'lsp/extract-loads {-> Str Str List})
(fun {lsp/extract-loads text root} {
  lsp/extract-loads-walk (str/split text "\n") root nil
})

(sig 'lsp/extract-loads-walk {-> List Str List List})
(fun {lsp/extract-loads-walk lines root acc} {
  if (nil? lines) {acc}
  {lsp/extract-loads-walk (tail lines) root
    (lsp/extract-load-line (head lines) root acc)}
})

(sig 'lsp/extract-load-line {-> Str Str List List})
(fun {lsp/extract-load-line line root acc} {do
  (= {idx} (str/index-of line "(load \""))
  (if (< idx 0) {acc}
    {do
      (= {start} (+ idx 7))
      (= {end} (str/index-of (str/slice line start (len line)) "\""))
      (if (< end 0) {acc}
        {do
          (= {path} (str/slice line start (+ start end)))
          (= {full} (if (str/starts-with? path "/") {path}
            {str root "/" path}))
          (qcons full acc)})})
})

; Topological sort: repeatedly extract files with no unresolved deps
(sig 'lsp/topo-sort {-> List Dict List})
(fun {lsp/topo-sort files dep-map} {
  lsp/topo-pass files dep-map nil (dict/new) 0
})

(sig 'lsp/topo-pass {-> List Dict List Dict Num List})
(fun {lsp/topo-pass remaining dep-map sorted emitted depth} {
  if (nil? remaining) {sorted}
  {if (> depth (len remaining)) {join sorted remaining}
  {do
    (= {ready} (filter (\ {f} {lsp/deps-satisfied f dep-map emitted}) remaining))
    (if (nil? ready) {join sorted remaining}
      {do
        (map (\ {f} {dict/put! emitted f}) ready)
        (lsp/topo-pass
          (filter (\ {f} {not (dict/has? emitted f)}) remaining)
          dep-map
          (join sorted ready)
          emitted
          (+ depth 1))})}}
})

(sig 'lsp/deps-satisfied {-> Str Dict Dict Num})
(fun {lsp/deps-satisfied path dep-map emitted} {do
  (= {deps} (dict/get dep-map path))
  (if (nil? deps) {1}
    {lsp/all-emitted deps emitted})
})

(sig 'lsp/all-emitted {-> List Dict Num})
(fun {lsp/all-emitted deps emitted} {
  if (nil? deps) {1}
  {if (dict/has? emitted (head deps)) {lsp/all-emitted (tail deps) emitted}
    {0}}
})

; Build dep map: path -> list of dependency paths
(sig 'lsp/build-dep-map {-> List Str Dict})
(fun {lsp/build-dep-map files root} {do
  (= {d} (dict/new))
  (lsp/build-dep-map-walk files root d)
  d
})

(sig 'lsp/build-dep-map-walk {-> List Str Dict Nil})
(fun {lsp/build-dep-map-walk files root d} {
  if (nil? files) {}
  {do
    (= {path} (head files))
    (= {text} (read-file path))
    (if (error? text) {}
      {do
        (= {deps} (lsp/extract-loads text root))
        (if (not (nil? deps)) {dict/set! d path deps} {})})
    (lsp/build-dep-map-walk (tail files) root d)}
})

; Main scan entry point
(sig 'lsp/scan-all {-> Ref List Num Nil})
(fun {lsp/scan-all db files tok} {do
  (= {changed} (lsp/filter-changed db files))
  (= {skipped} (- (len files) (len changed)))
  (if (> skipped 0)
    {stderr/write (str "[valk-lsp] " skipped " files unchanged, " (len changed) " to index\n")}
    {})
  (if (nil? changed)
    {do
      (lsp/progress-end tok "up to date")
      (stderr/write "[valk-lsp] scan complete: 0 indexed\n")
      ; Bounce to lsp/sys loop 0 — see comment in scan-handle-result.
      (aio/dispatch lsp/sys
        (\ {_} nil)
        nil
        (\ {_} {lsp/cleanup-stale-files}))}
     {do
      (= {total} (len changed))
      (= {state} (dict/new))
      (dict/set! state :indexed 0)
      (dict/set! state :done 0)
      (dict/set! state :total total)
      ; Note: NO outer transaction here. Each callback wraps its own
      ; index-file-full call in a self-contained transaction. Holding a
      ; transaction across aio/dispatch would race with handle-did-open
      ; (also runs on the main loop) and cause nested-BEGIN errors.
      (lsp/dispatch-all db changed state tok)})
})

; Max number of file-scans in-flight concurrently. Kept small so main-loop
; handling of didOpen/didChange/etc. isn't starved by a flood of indexing
; done-callbacks (which do SQLite writes sequentially on loop 0).
(def {lsp/scan-concurrency} 4)

; Sliding-window dispatch: start up to lsp/scan-concurrency scans; each
; done-cb pulls the next file from the queue. Keeps at most K done-cbs
; queued on the main loop at any moment, so incoming LSP messages can
; interleave with indexing instead of waiting behind N done-cbs.
(sig 'lsp/dispatch-all {-> Ref List Dict Num Nil})
(fun {lsp/dispatch-all db files state tok} {do
  (dict/set! state :queue files)
  (dict/set! state :db db)
  (dict/set! state :tok tok)
  (lsp/scan-start-workers state lsp/scan-concurrency)})

(sig 'lsp/scan-start-workers {-> Dict Num Nil})
(fun {lsp/scan-start-workers state n} {
  if (<= n 0) {}
  {do
    (lsp/scan-try-dispatch state)
    (lsp/scan-start-workers state (- n 1))}
})

(sig 'lsp/scan-try-dispatch {-> Dict Nil})
(fun {lsp/scan-try-dispatch state} {do
  (= {queue} (dict/get state :queue))
  (if (nil? queue) {}
    {do
      (= {path} (head queue))
      (dict/set! state :queue (tail queue))
      ; Dispatch on lsp/idx-sys — parse on one of idx-sys's worker loops,
      ; done-cb (sqlite write + queue advance) on idx-sys loop 0. lsp/sys
      ; loop 0 never sees any of this.
      (aio/dispatch lsp/idx-sys
        (\ {_} {lsp/prepare-file path})
        nil
        (\ {result} {lsp/scan-handle-result state result}))})})

(sig 'lsp/scan-handle-result {-> Dict Any Nil})
(fun {lsp/scan-handle-result state result} {do
  (= {db} (dict/get state :db))
  (= {tok} (dict/get state :tok))
  ; Each callback wraps its own writes in a self-contained transaction.
  ; This avoids holding a tx across async dispatch boundaries, which
  ; would race with concurrent handle-did-open / handle-did-change.
  ;
  ; Pre-parsed AST comes from prepare-file (worker thread). Calling
  ; sync-file-with-ast directly — rather than routing through
  ; lsp/index-file-full — skips the redundant hash re-check
  ; (filter-changed already did it) and avoids any re-parse on the main
  ; loop. Single index-ast call per file.
  (= {did-raw} (if (nil? result) {0}
    {lsp/with-tx db
      (\ {} {do
        (symdb/sync-file-with-ast db (str "file://" result:path)
                                  result:text result:fp result:ast)
        1})}))
  (= {did} (if (num? did-raw) {did-raw} {0}))
  (dict/set! state :indexed (+ (dict/get state :indexed) did))
  (dict/set! state :done (+ (dict/get state :done) 1))
  (= {done-count} (dict/get state :done))
  (= {total} (dict/get state :total))
  (if (or (== (mod done-count 10) 0) (== done-count total))
    {lsp/progress-report tok (str done-count " / " total " files")
      (/ (* done-count 100) total)}
    {})
  (if (== done-count total)
    {do
      (= {indexed} (dict/get state :indexed))
      (lsp/progress-end tok (if (== indexed 0) {"up to date"} {str "indexed " indexed " files"}))
      (stderr/write (str "[valk-lsp] scan complete: " indexed " indexed\n"))
      ; invalidate-known-set / cleanup-stale-files / republish-all-diagnostics
      ; all touch in-memory valk state (dict caches) and send LSP
      ; notifications via pipe/write. They must run on lsp/sys loop 0 to
      ; stay coherent with interactive handlers (hover/completion) that
      ; read the same caches. Bounce via aio/dispatch with a noop worker
      ; so the done-cb fires on lsp/sys loop 0.
      (aio/dispatch lsp/sys
        (\ {_} nil)
        nil
        (\ {_} {do
          (lsp/invalidate-known-set)
          (lsp/cleanup-stale-files)
          (lsp/republish-all-diagnostics)}))}
    {(lsp/scan-try-dispatch state)})})

; ---------------------------------------------------------------------------
; Method handlers — notifications
; ---------------------------------------------------------------------------

(sig 'handle-initialize {-> Num InitParams Nil})
(fun {handle-initialize id params} {do
  (= {root-uri} params:rootUri)
  (stderr/write (str "[valk-lsp] root: " root-uri "\n"))
  (if (not (nil? root-uri))
    {do
      (def {lsp/root-path} (symdb/uri->path root-uri))
      (= {db-dir} (str lsp/root-path "/.valk"))
      (= {db-path} (str db-dir "/symdb.sqlite"))
      (= {result} (symdb/init db-path))
      (if (error? result)
        {do (stderr/write (str "[valk-lsp] symdb file init failed, using :memory:\n"))
            (def {lsp/db} (symdb/init ":memory:"))
            ; :memory: can't be shared across connections; reuse the same
            ; handle and mark it NOT owned by the idx slot.
            (def {lsp/idx-db} lsp/db)
            (def {lsp/idx-db-own} 0)}
        {do (def {lsp/db} result)
            ; Separate sqlite handle for the indexing system. WAL mode
            ; (set in symdb/schema-sql) + per-connection tx state means
            ; idx-sys can run BEGIN/COMMIT without racing lsp/sys's own
            ; writes. Both point at the same on-disk file.
            (def {lsp/idx-db} (symdb/init db-path))
            (def {lsp/idx-db-own} 1)
            (lsp/seed-builtins lsp/db lsp/root-path)})}
    {do
      (def {lsp/root-path} "")
      (def {lsp/db} (symdb/init ":memory:"))
      (def {lsp/idx-db} lsp/db)
      (def {lsp/idx-db-own} 0)})
  (lsp/send-response id lsp/capabilities)})

(def {lsp/noop-cb} (\ {_} {}))

; Dispatches:
;   - lsp/sys worker: lsp/cache-ast to populate the in-process AST cache
;     (used by semantic-tokens workers on lsp/sys)
;   - lsp/idx-sys worker: lsp/sync-doc to write to the DB via lsp/idx-db,
;     off lsp/sys loop-0. Keeping the DB write off loop-0 lets pipe/write
;     responses (semantic tokens, diagnostics) flush promptly — the old
;     layout's 1-2s loop-0 index transaction was the single largest source
;     of latency on file open. lsp/idx-db is a separate sqlite connection
;     from lsp/db so there's no nested-BEGIN conflict.
;   - lsp/sys worker: publish-diagnostics (on a done-cb). This still reads
;     lsp/db from loop-0; worth investigating moving too.
;
; Known-set cache freshness: we invalidate synchronously here on loop-0
; before dispatching, so any subsequent get-known-set call reloads from
; the current DB state.
(sig 'handle-did-open {-> OpenParams Nil})
(fun {handle-did-open params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} td:text)
  (lsp/doc-store uri text)
  (dict/remove! lsp/ast-cache uri)
  (dict/remove! lsp/line-index-cache uri)
  (lsp/invalidate-known-set)
  (def {lsp/doc-version} (+ lsp/doc-version 1))
  (= {v} lsp/doc-version)
  (aio/dispatch lsp/sys
    (\ {_} {if (not (== lsp/doc-version v)) {nil}
      {do (lsp/cache-ast uri text) nil}})
    nil
    (\ {_} {if (not (== lsp/doc-version v)) {}
      ; AST is now cached. Tell the client to re-request so the initial
      ; lex/token paint upgrades to full AST-based tokens immediately —
      ; DB-backed tokens will land on a later refresh once sync-doc
      ; commits.
      {lsp/refresh-semantic-tokens}}))
  (aio/dispatch lsp/idx-sys
    (\ {_} {if (not (== lsp/doc-version v)) {nil}
      {do (lsp/sync-doc lsp/idx-db uri text) nil}})
    nil
    (\ {_} {if (not (== lsp/doc-version v)) {}
      {lsp/refresh-semantic-tokens}}))
  (def {lsp/diag-version} (+ lsp/diag-version 1))
  (= {dv} lsp/diag-version)
  (aio/dispatch lsp/idx-sys
    (\ {_} {if (not (== lsp/diag-version dv)) {nil}
      {do (lsp/publish-diagnostics lsp/idx-db uri text) nil}})
    nil
    lsp/noop-cb)})

(sig 'handle-did-change {-> ChangeParams Nil})
(fun {handle-did-change params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {changes} params:contentChanges)
  (if (nil? changes) {}
    {do
      (= {old-text} (lsp/doc-get uri))
      (= {text} (if (nil? old-text)
        {plist/get (head changes) :text}
        {lsp/apply-changes old-text changes}))
      (lsp/doc-store uri text)
      (dict/remove! lsp/ast-cache uri)
      (dict/remove! lsp/line-index-cache uri)
      (lsp/invalidate-known-set)
      (def {lsp/doc-version} (+ lsp/doc-version 1))
      (= {v} lsp/doc-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/cache-ast uri text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/sync-doc lsp/idx-db uri text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (def {lsp/diag-version} (+ lsp/diag-version 1))
      (= {dv} lsp/diag-version)
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/diag-version dv)) {nil}
          {do (lsp/publish-diagnostics lsp/idx-db uri text) nil}})
        nil
        lsp/noop-cb)})})

(sig 'handle-did-close {-> DocParams Nil})
(fun {handle-did-close params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (dict/remove! lsp/documents uri)
  (dict/remove! lsp/ast-cache uri)
  (dict/remove! lsp/line-index-cache uri)
  (def {lsp/doc-version} (+ lsp/doc-version 1))
  (lsp/send-notification "textDocument/publishDiagnostics"
    (list :uri uri :diagnostics nil))})

(sig 'handle-did-save {-> SaveParams Nil})
(fun {handle-did-save params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} params:text)
  (= {save-text} (if (nil? text) {lsp/doc-get uri} {text}))
  (if (nil? save-text) {}
    {do
      (lsp/doc-store uri save-text)
      (dict/remove! lsp/line-index-cache uri)
      (lsp/invalidate-known-set)
      (def {lsp/doc-version} (+ lsp/doc-version 1))
      (= {v} lsp/doc-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/cache-ast uri save-text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/sync-doc lsp/idx-db uri save-text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (def {lsp/diag-version} (+ lsp/diag-version 1))
      (= {dv} lsp/diag-version)
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/diag-version dv)) {nil}
          {do (lsp/publish-diagnostics lsp/idx-db uri save-text) nil}})
        nil
        lsp/noop-cb)})})

