; Valkyria LSP Server — diagnostics, document sync, workspace indexing, notification handlers
;
; === Indexing architecture ===
;
; ONE function indexes a file: lsp/index-file-full
;   1. Sync symbols + refs to DB (symdb/sync-file-symbols)
;   2. Run C indexer for semantic tokens + scoped refs (lsp/index-ast)
;   3. Compute inlay hints (lsp/precompute-file-data)
;   Returns 1 if file changed, 0 if cached.
;
; Callers:
;   - lsp/sync-doc:       called by did-open/did-change/did-save (text from editor)
;   - lsp/seed-from-disk: called by workspace scan (text from disk)

(module workspace)

; ---------------------------------------------------------------------------
; Transaction helper
; ---------------------------------------------------------------------------
;
; Wraps a thunk in BEGIN/COMMIT, with ROLLBACK on error. The thunk MUST be
; fully synchronous — no aio/dispatch, no aio/await, no callback registration.
; Holding a transaction across an async boundary races with other handlers
; on the main loop and causes nested-BEGIN errors.
;
; Use this instead of bare (sqlite/exec db "BEGIN") / (sqlite/exec db "COMMIT")
; pairs so error handling is uniform across the codebase.

(sig 'lsp/with-tx {-> Ref Fun Any})
(fun {lsp/with-tx db thunk} {do
  (sqlite/exec db "BEGIN")
  (= {r} (thunk))
  (if (error? r)
    {do (sqlite/exec db "ROLLBACK") r}
    {do (sqlite/exec db "COMMIT") r})
})

; ---------------------------------------------------------------------------
; Core indexing — single function, does everything
; ---------------------------------------------------------------------------

(sig 'lsp/index-file-full {-> Ref Str Str Str Num})
(fun {lsp/index-file-full db uri text hash} {do
  (= {path} (symdb/uri->path uri))
  (= {existing} (sqlite/query-maybe db
    "SELECT hash FROM files WHERE path=?1" path))
  (if (if (not (nil? existing)) {== existing:hash hash} {0}) {0}
    {do
      ; Single-parse path: get-ast hits the ast-cache for open documents,
      ; falls back to parse otherwise. Then sync-file-with-ast does
      ; strip-errors + file-insert + index-ast in one shot. Previously
      ; this function parsed twice and called index-ast twice — kept the
      ; main loop busy during workspace scan.
      (= {ast} (lsp/get-ast uri text))
      (if (error? ast) {0}
        {do (symdb/sync-file-with-ast db uri text hash ast) 1})})
})

(sig 'lsp/index-file-with-hints {-> Ref Str Str Str Num})
(fun {lsp/index-file-with-hints db uri text hash} {do
  (= {changed} (lsp/index-file-full db uri text hash))
  (if (> changed 0)
    {do
      (= {ast} (lsp/get-ast uri text))
      (if (not (error? ast))
        {lsp/precompute-file-data db uri ast text}
        {})}
    {})
  changed
})

; ---------------------------------------------------------------------------
; Disk seeding (workspace scan at startup)
; ---------------------------------------------------------------------------

(sig 'lsp/seed-from-disk {-> Ref Str Num})
(fun {lsp/seed-from-disk db path} {do
  (= {fp} (file/fingerprint path))
  (if (error? fp) {0}
    {do
      (= {text} (read-file path))
      (if (error? text) {0}
        {lsp/with-tx db
          (\ {} {lsp/index-file-full db (str "file://" path) text fp})})})
})

; Best-effort: index stdlib so go-to-def / hover on a builtin lands in
; source. This only finds files when the workspace IS the valkyria repo;
; for an arbitrary project the files are absent and we skip silently. The
; validator does NOT depend on this — it recognizes builtins/operators via
; (penv) in vd/load-known-set, so `+` etc. are never falsely flagged even
; when stdlib is not on disk.
(sig 'lsp/seed-builtins {-> Ref Str Nil})
(fun {lsp/seed-builtins db root} {do
  (= {builtins-path} (str root "/stdlib/builtins.valk"))
  (= {prelude-path} (str root "/stdlib/prelude.valk"))
  (= {b} (lsp/seed-from-disk db builtins-path))
  (= {p} (lsp/seed-from-disk db prelude-path))
  (if (== (+ b p) 0)
    {stderr/write "[valk-lsp] builtins + prelude not on disk (using env)\n"}
    {stderr/write "[valk-lsp] seeded builtins + prelude\n"})})

(sig 'lsp/precompute-file-data {-> Ref Str List Str Nil})
(fun {lsp/precompute-file-data db uri ast text} {do
  (= {path} (symdb/uri->path uri))
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (nil? file-id) {}
    {do
      (lsp/index-ast db file-id ast text)
      (= {local-params} (hint/collect-local-params ast))
      (= {hctx} (HintCtx local-params db))
      (= {raw-hints} (hint/walk-exprs ast hctx nil))
      (= {type-hints} (hint/collect-type-hints ast db))
      (= {field-hints} (hint/collect-field-hints ast db))
      (symdb/insert-hint-batch db file-id (join raw-hints (join type-hints field-hints)))})
})

; ---------------------------------------------------------------------------
; Diagnostic publishing
; ---------------------------------------------------------------------------

(sig 'make-lsp-diag {-> List List})
(fun {make-lsp-diag d}
  {list :range
    (list :start (list :line d:line
                       :character d:col)
          :end   (list :line d:line
                       :character d:end-col))
    :severity d:severity
    :source "valk"
    :message d:message})

(sig 'lsp/ensure-loads-indexed {-> Ref List Nil})
(fun {lsp/ensure-loads-indexed db ast} {
  if (nil? db) {}
  {lsp/ensure-loads-walk db ast}
})

(sig 'lsp/ensure-loads-walk {-> Ref List Nil})
(fun {lsp/ensure-loads-walk db exprs} {
  if (nil? exprs) {}
  {do
    (= {e} (head exprs))
    (if (list? e)
      {if (nil? e) {}
        {do
          (= {form} (str (head e)))
          (if (== form "load")
            {if (nil? (tail e)) {}
              {do
                (= {path} (str (head (tail e))))
                (lsp/seed-from-disk db (if (str/starts-with? path "/") {path}
                  {str lsp/root-path "/" path}))}}
            {})}}
      {})
    (lsp/ensure-loads-walk db (tail exprs))}
})

(sig 'lsp/republish-all-diagnostics {-> Nil})
(fun {lsp/republish-all-diagnostics} {do
  (= {uris} (dict/keys lsp/documents))
  (lsp/republish-loop uris)
})

(sig 'lsp/republish-loop {-> List Nil})
(fun {lsp/republish-loop uris} {
  if (nil? uris) {}
  {do
    (= {uri} (head uris))
    (= {text} (lsp/doc-get uri))
    (if (nil? text) {}
      {lsp/publish-diagnostics lsp/db uri text})
    (lsp/republish-loop (tail uris))}
})

; Extract the byte offset from a parse error message of the form
; "[offset: N] ...". Returns 0 if no offset is found.
(sig 'lsp/parse-error-offset {-> Any Num})
(fun {lsp/parse-error-offset err} {do
  (= {msg} (str err))
  (= {start} (str/index-of msg "[offset: "))
  (if (< start 0) {0}
    {do
      (= {after} (str/slice msg (+ start 9) (len msg)))
      (= {end} (str/index-of after "]"))
      (if (< end 0) {0}
        {do (= {n-str} (str/slice after 0 end))
            ; Use parse to convert digit string to number
            (= {parsed} (parse n-str))
            (if (and (list? parsed) (and (> (len parsed) 0) (num? (head parsed))))
              {head parsed} {0})})})})

; Convert a parse error to an LSP Diagnostic, using the embedded byte offset
; to compute the line/column.
(sig 'lsp/parse-error->diag {-> Any Str List})
(fun {lsp/parse-error->diag err text} {do
  (= {offset} (lsp/parse-error-offset err))
  (= {pos} (offset->line-col text offset))
  (= {line} (head pos))
  (= {col} (head (tail pos)))
  (list :range
    (list :start (list :line line :character col)
          :end   (list :line line :character (+ col 1)))
    :severity 1
    :source "valk"
    :message (str err))
})

; Takes db as an arg so callers can route the DB work to lsp/idx-db on
; lsp/idx-sys (keeping lsp/sys loop-0 free to flush pipe writes). Parses
; text directly rather than consulting lsp/ast-cache because the cache
; is written by concurrent lsp/sys workers.
(sig 'lsp/publish-diagnostics {-> Ref Str Str Nil})
(fun {lsp/publish-diagnostics db uri text} {do
  (= {ast} (parse text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (lsp/parse-error->diag (str parse-err) text)))}
    {do
      (lsp/ensure-loads-indexed db ast)
      (= {known} (vd/load-known-set db))
      (= {diags} (vd/validate-with-known db ast text known))
      (= {lsp-diags} (if (error? diags)
        {do (stderr/write (str "[lsp] validate error: " diags "\n")) nil}
        {map make-lsp-diag diags}))
      (lsp/send-notification "textDocument/publishDiagnostics"
        (list :uri uri :diagnostics (if (error? lsp-diags)
          {do (stderr/write (str "[lsp] diag map error: " lsp-diags "\n")) nil}
          {lsp-diags})))})})

(sig 'lsp/publish-diagnostics-fast {-> Str Str Nil})
(fun {lsp/publish-diagnostics-fast uri text} {do
  (= {ast} (lsp/get-ast uri text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (lsp/parse-error->diag (str parse-err) text)))}
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics nil)})})

; ---------------------------------------------------------------------------
; Pull-based diagnostics (textDocument/diagnostic, LSP 3.17)
; ---------------------------------------------------------------------------

(sig 'lsp/compute-diagnostics {-> Str Str List})
(fun {lsp/compute-diagnostics uri text} {do
  (= {ast} (lsp/get-ast uri text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {list (lsp/parse-error->diag (str parse-err) text)}
    {do
      (lsp/ensure-loads-indexed lsp/db ast)
      (= {diags} (vd/validate-with-known lsp/db ast text (lsp/get-known-set)))
      (if (error? diags)
        {do (stderr/write (str "[lsp] validate error: " diags "\n"))
            nil}
        {do
          (= {mapped} (map make-lsp-diag diags))
          (if (error? mapped)
            {do (stderr/write (str "[lsp] diag map error: " mapped "\n")) nil}
            {mapped})})})})

(sig 'handle-pull-diagnostics {-> Num DocParams Nil})
(fun {handle-pull-diagnostics id params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} (lsp/doc-get uri))
  (if (nil? text)
    {lsp/send-response id (list :kind "full" :items nil)}
    {do
      (= {items} (lsp/compute-diagnostics uri text))
      (lsp/send-response id (list :kind "full" :items
        (if (error? items) {nil} {items})))})})

; ---------------------------------------------------------------------------
; Sync document to symdb
; ---------------------------------------------------------------------------

; Takes an explicit db ref so callers can choose lsp/db (main connection,
; used on loop 0) or lsp/idx-db (secondary connection, used by dispatched
; workers). Routing DB writes through lsp/idx-db on lsp/idx-sys keeps
; lsp/sys loop-0 free to flush pipe/writes promptly after a didOpen, so
; semantic-tokens responses don't queue behind a long index transaction.
; Parses text directly (native ~5ms) instead of relying on lsp/ast-cache,
; because the cache is written by a concurrent lsp/sys worker and racy
; to read from idx-sys.
(sig 'lsp/sync-doc {-> Ref Str Str Nil})
(fun {lsp/sync-doc db uri text} {do
  (if (nil? db) {}
    {do
      (= {hash} (str "mem:" (len text)))
      (= {path} (symdb/uri->path uri))
      (= {existing} (sqlite/query-maybe db
        "SELECT hash FROM files WHERE path=?1" path))
      (if (if (not (nil? existing)) {== existing:hash hash} {0}) {}
        {do
          (= {ast} (parse text))
          ; `parse` returns a list of top-level forms and appends parse
          ; errors as LVAL_ERR elements, so `(error? ast)` is always
          ; false; scan the list for any error element instead. Skipping
          ; the symdb write on broken parses keeps highlighting/inlays
          ; stable on the last-good snapshot while the user is mid-edit,
          ; rather than flickering between partial new data and stale
          ; old data.
          (if (lsp/ast-has-error ast) {}
            {lsp/with-tx db
              (\ {} {do
                (symdb/sync-file-with-ast db uri text hash ast)
                (lsp/precompute-file-data db uri ast text)})})})})})



; ---------------------------------------------------------------------------
; Method handlers — notifications
; ---------------------------------------------------------------------------

(sig 'handle-initialize {-> Num InitParams Nil})
(fun {handle-initialize id params} {do
  (= {root-uri} params:rootUri)
  (stderr/write (str "[valk-lsp] root: " root-uri "\n"))
  (if (not (nil? root-uri))
    {do
      (def {lsp/root-path} (symdb/uri->path root-uri))
      (= {db-dir} (str lsp/root-path "/.valk"))
      (= {db-path} (str db-dir "/symdb.sqlite"))
      ; Ensure .valk/ exists before sqlite tries to open the file —
      ; otherwise sqlite/open fails and we silently fall back to
      ; :memory: which loses all stdlib seeding.
      (mkdir-p db-dir)
      (def {lsp/db-path} db-path)
      (= {result} (symdb/init db-path))
      (if (error? result)
        {do (stderr/write (str "[valk-lsp] symdb file init failed, using :memory:\n"))
            (def {lsp/db} (symdb/init ":memory:"))
            (def {lsp/db-path} ":memory:")}
        {do (def {lsp/db} result)})
      ; lsp/db is read on lsp/sys by interactive features (hover/go-to-def);
      ; index stdlib into it here (same thread) for richer builtin navigation.
      ; Builtin *recognition* for diagnostics comes from (penv), not this.
      (lsp/seed-builtins lsp/db lsp/root-path)}
    {do
      (def {lsp/root-path} "")
      (def {lsp/db} (symdb/init ":memory:"))
      (def {lsp/db-path} ":memory:")
      (lsp/seed-builtins lsp/db lsp/root-path)})
  (lsp/send-response id lsp/capabilities)})

(def {lsp/noop-cb} (\ {_} {}))

; Dispatches:
;   - lsp/sys worker: lsp/cache-ast to populate the in-process AST cache
;     (used by semantic-tokens workers on lsp/sys)
;   - lsp/idx-sys worker: lsp/sync-doc to write to the DB via lsp/idx-db,
;     off lsp/sys loop-0. Keeping the DB write off loop-0 lets pipe/write
;     responses (semantic tokens, diagnostics) flush promptly — the old
;     layout's 1-2s loop-0 index transaction was the single largest source
;     of latency on file open. lsp/idx-db is a separate sqlite connection
;     from lsp/db so there's no nested-BEGIN conflict.
;   - lsp/sys worker: publish-diagnostics (on a done-cb). This still reads
;     lsp/db from loop-0; worth investigating moving too.
;
; Known-set cache freshness: we invalidate synchronously here on loop-0
; before dispatching, so any subsequent get-known-set call reloads from
; the current DB state.
(sig 'handle-did-open {-> OpenParams Nil})
(fun {handle-did-open params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} td:text)
  (lsp/doc-store uri text)
  (dict/remove! lsp/ast-cache uri)
  (lsp/invalidate-known-set)
  (def {lsp/doc-version} (+ lsp/doc-version 1))
  (= {v} lsp/doc-version)
  ; No semanticTokens/refresh on didOpen: notifications and requests share
  ; one FIFO worker, so cache-ast completes before the client's own token
  ; request for the new buffer is processed — there is no stale initial
  ; paint left to upgrade. Refreshing here made every didOpen fan out into
  ; token re-requests for EVERY attached buffer; a 30-buffer open/close
  ; churn in a long session flooded the worker and queued hovers behind
  ; ~700ms of redundant token traffic. didChange/didSave still refresh.
  (aio/dispatch lsp/sys
    (\ {_} {if (not (== lsp/doc-version v)) {nil}
      {do (lsp/cache-ast uri text) nil}})
    nil
    lsp/noop-cb)
  (aio/dispatch lsp/idx-sys
    (\ {_} {if (not (== lsp/doc-version v)) {nil}
      {do (lsp/sync-doc lsp/idx-db uri text) nil}})
    nil
    lsp/noop-cb)
  (def {lsp/diag-version} (+ lsp/diag-version 1))
  (= {dv} lsp/diag-version)
  (aio/dispatch lsp/idx-sys
    (\ {_} {if (not (== lsp/diag-version dv)) {nil}
      {do (lsp/publish-diagnostics lsp/idx-db uri text) nil}})
    nil
    lsp/noop-cb)})

; Coalesce dispatches via "pending" flags. While a dispatched task is
; queued/running, suppress new dispatches of the same kind. The
; inflight task reads lsp/doc-get on entry so it always processes the
; latest text, even if many didChanges arrived after it was queued.
;
; Without this, every keystroke queues 3 tasks (cache-ast, sync-doc,
; publish-diagnostics). Even though version-gating makes earlier tasks
; return nil quickly, each queued task pays for closure evacuation,
; queue insertion / pop, and GC pressure. After ~100 keystrokes the
; worker loops have seconds of pending work to drain, and synchronous
; hover/completion requests queue behind it. Coalescing collapses 100
; keystrokes' worth of dispatches into a handful of actual runs,
; restoring sub-100ms p99 latency under typing load.
;
; Synchronization: the pending flag must be written from a single loop
; only (Valk globals across loops are a data race). cache-ast dispatches
; to lsp/sys, whose completion fires on lsp/sys loop 0 — the same loop
; as handle-did-change. For sync-doc / publish-diagnostics, the body
; runs on lsp/idx-sys but we want flag-clear on lsp/sys loop 0, so the
; lsp/idx-sys completion does a tiny bounce-back dispatch to lsp/sys
; whose completion clears the flag. One extra dispatch per coalesced
; batch is negligible vs the queue depth it saves.
(def {lsp/cache-ast-pending} 0)
(def {lsp/sync-doc-pending} 0)
(def {lsp/publish-diag-pending} 0)

; Bounce a flag-clear back to lsp/sys loop 0 via a no-op dispatch.
; Used as the completion callback of an lsp/idx-sys dispatch when we
; need to safely write to a single-loop-owned global from a different
; aio system.
(sig 'lsp/clear-sync-doc-pending {-> Nil})
(fun {lsp/clear-sync-doc-pending} {
  aio/dispatch lsp/sys (\ {_} {}) nil
    (\ {_} {def {lsp/sync-doc-pending} 0})
})

(sig 'lsp/clear-publish-diag-pending {-> Nil})
(fun {lsp/clear-publish-diag-pending} {
  aio/dispatch lsp/sys (\ {_} {}) nil
    (\ {_} {def {lsp/publish-diag-pending} 0})
})

(sig 'handle-did-change {-> ChangeParams Nil})
(fun {handle-did-change params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {changes} params:contentChanges)
  (if (nil? changes) {}
    {do
      (= {old-text} (lsp/doc-get uri))
      (= {text} (if (nil? old-text)
        {plist/get (head changes) :text}
        {lsp/apply-changes old-text changes}))
      (lsp/doc-store uri text)
      (dict/remove! lsp/ast-cache uri)
      ; Full-document replacement (e.g. paste-over-all) makes cached
      ; offsets in the last-good token/hint arrays meaningless. Drop
      ; the fallbacks rather than serve stale spans pointing past EOL.
      (if (== (lsp/changes-include-full-replace changes) 1)
        {do (dict/remove! lsp/last-good-ast-cache uri)
            (dict/remove! lsp/last-good-tokens-cache uri)
            (dict/remove! lsp/last-good-hints-cache uri)}
        {})
      (lsp/invalidate-known-set)
      (def {lsp/doc-version} (+ lsp/doc-version 1))
      (if (== lsp/cache-ast-pending 0)
        {do
          (def {lsp/cache-ast-pending} 1)
          (aio/dispatch lsp/sys
            (\ {_} {do
              (= {latest} (lsp/doc-get uri))
              (if (nil? latest) {nil} {do (lsp/cache-ast uri latest) nil})})
            nil
            (\ {_} {do (def {lsp/cache-ast-pending} 0)
                       (lsp/refresh-semantic-tokens)}))}
        {})
      (if (== lsp/sync-doc-pending 0)
        {do
          (def {lsp/sync-doc-pending} 1)
          (aio/dispatch lsp/idx-sys
            (\ {_} {do
              (= {latest} (lsp/doc-get uri))
              (if (nil? latest) {nil} {do (lsp/sync-doc lsp/idx-db uri latest) nil})})
            nil
            (\ {_} {lsp/clear-sync-doc-pending}))}
        {})
      (def {lsp/diag-version} (+ lsp/diag-version 1))
      (if (== lsp/publish-diag-pending 0)
        {do
          (def {lsp/publish-diag-pending} 1)
          (aio/dispatch lsp/idx-sys
            (\ {_} {do
              (= {latest} (lsp/doc-get uri))
              (if (nil? latest) {nil} {do (lsp/publish-diagnostics lsp/idx-db uri latest) nil})})
            nil
            (\ {_} {lsp/clear-publish-diag-pending}))}
        {})})})

(sig 'handle-did-close {-> DocParams Nil})
(fun {handle-did-close params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (dict/remove! lsp/documents uri)
  (dict/remove! lsp/ast-cache uri)
  ; Per-URI fallback caches grow unbounded across long-running editor
  ; sessions if not explicitly evicted on close.
  (dict/remove! lsp/last-good-ast-cache uri)
  (dict/remove! lsp/last-good-tokens-cache uri)
  (dict/remove! lsp/last-good-hints-cache uri)
  (def {lsp/doc-version} (+ lsp/doc-version 1))
  (lsp/send-notification "textDocument/publishDiagnostics"
    (list :uri uri :diagnostics nil))})

(sig 'handle-did-save {-> SaveParams Nil})
(fun {handle-did-save params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} params:text)
  (= {save-text} (if (nil? text) {lsp/doc-get uri} {text}))
  (if (nil? save-text) {}
    {do
      (lsp/doc-store uri save-text)
      (lsp/invalidate-known-set)
      (def {lsp/doc-version} (+ lsp/doc-version 1))
      (= {v} lsp/doc-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/cache-ast uri save-text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/sync-doc lsp/idx-db uri save-text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (def {lsp/diag-version} (+ lsp/diag-version 1))
      (= {dv} lsp/diag-version)
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/diag-version dv)) {nil}
          {do (lsp/publish-diagnostics lsp/idx-db uri save-text) nil}})
        nil
        lsp/noop-cb)})})

