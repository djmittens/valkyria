; LSP Analysis — semantic tokens, AST walking
;
; IMPORTANT: AST nodes (parsed S-expressions) must NEVER be stored via = or def
; because those builtins call valk_resolve_symbol which resolves symbol values.
; Instead, pass AST nodes through function arguments (lambda binding is safe).
;
; Provides: sem/tokenize text -> flat integer list (LSP delta-encoded)

; ---------------------------------------------------------------------------
; Token type indices (must match legend in lsp.valk capabilities)
; ---------------------------------------------------------------------------
(def {SEM_KEYWORD}   0)
(def {SEM_FUNCTION}  1)
(def {SEM_PARAMETER} 2)
(def {SEM_VARIABLE}  3)
(def {SEM_NUMBER}    4)
(def {SEM_STRING}    5)
(def {SEM_TYPE}      6)
(def {SEM_OPERATOR}  7)
(def {SEM_PROPERTY}  8)

(def {MOD_NONE}        0)
(def {MOD_DECLARATION} 1)

; ---------------------------------------------------------------------------
; Classification helpers
; ---------------------------------------------------------------------------

(def {SEM_KEYWORD_SET}
  (dict/from-keys {"fun" "\\" "def" "=" "if" "match" "select" "case"
   "do" "let" "type" "sig" "load" "and" "or" "not"
   "quote" "quasiquote" "unquote" "unquote-splicing"}))

(def {SEM_OPERATOR_SET}
  (dict/from-keys {"+" "-" "*" "/" ">" "<" ">=" "<=" "==" "!=" "%" "ord"}))

; ---------------------------------------------------------------------------
; Token accumulation — flat list built with qcons (reversed)
; Each token: 4 values (offset, length, type, modifiers)
; ---------------------------------------------------------------------------

(sig 'sem/emit {-> Num Num Num Num List List})
(fun {sem/emit offset length tok-type mods acc} {
  qcons mods (qcons tok-type (qcons length (qcons offset acc)))
})

; ---------------------------------------------------------------------------
; Walk a list of expressions as code
; ---------------------------------------------------------------------------

(sig 'sem/walk-each {-> List List List List})
(fun {sem/walk-each exprs scope acc} {
  if (nil? exprs) {acc}
  {sem/walk-each (tail exprs) scope
    (sem/walk-code (head exprs) scope acc)}
})

; ---------------------------------------------------------------------------
; Core walker — walks an expression as code
; Dispatches on type. For lists, delegates to sem/walk-list.
; AST nodes are passed as function args to avoid = resolution.
; ---------------------------------------------------------------------------

(sig 'sem/walk-code {-> Any List List List})
(fun {sem/walk-code expr scope acc} {
  if (nil? expr) {acc}
  {if (num? expr)
    {sem/emit (src-pos expr) (len (str expr)) SEM_NUMBER MOD_NONE acc}
  {if (str? expr)
    {acc}
  {if (sym? expr)
    {sem/classify-sym expr scope acc}
  {if (list? expr)
    {sem/walk-list expr scope acc}
  {acc}}}}}
})

; Classify a standalone symbol
(sig 'sem/classify-sym {-> Any List List List})
(fun {sem/classify-sym expr scope acc} {
  sem/classify-sym-str expr (str expr) scope acc
})

(sig 'sem/classify-sym-str {-> Any Str List List List})
(fun {sem/classify-sym-str expr name scope acc} {
  if (<= (len name) 0) {acc}
  {if (== (str/slice name 0 1) ":")
    {sem/emit (src-pos expr) (len name) SEM_PROPERTY MOD_NONE acc}
  {if (member? name scope)
    {sem/emit (src-pos expr) (len name) SEM_PARAMETER MOD_NONE acc}
  {sem/emit (src-pos expr) (len name) SEM_VARIABLE MOD_NONE acc}}}
})

; ---------------------------------------------------------------------------
; List dispatch — uses ast/head-name to avoid resolving head symbol
; ---------------------------------------------------------------------------

(sig 'sem/walk-list {-> List List List List})
(fun {sem/walk-list expr scope acc} {
  if (nil? (tail expr))
    {sem/walk-code (head expr) scope acc}
  {do
    (= {name} (ast/head-name expr))
    (if (== name "")
      {sem/walk-each expr scope acc}
      {sem/dispatch-sym-head (head expr) name (tail expr) scope acc})}
})

(sig 'sem/source-len {-> Str Num})
(fun {sem/source-len name} {
  if (== name "quote") {1}
  {if (== name "quasiquote") {1}
  {if (== name "unquote") {1}
  {if (== name "unquote-splicing") {2}
  {len name}}}}
})

(sig 'sem/dispatch-sym-head {-> Any Str List List List List})
(fun {sem/dispatch-sym-head hd name tl scope acc} {
  if (dict/has? SEM_KEYWORD_SET name)
    {sem/walk-keyword name hd tl scope acc}
  {if (dict/has? SEM_OPERATOR_SET name)
    {do
      (sem/walk-each tl scope
        (sem/emit (src-pos hd) (sem/source-len name) SEM_OPERATOR MOD_NONE acc))}
  {do
    (sem/walk-each tl scope
      (sem/emit (src-pos hd) (sem/source-len name) SEM_FUNCTION MOD_NONE acc))}}
})

; ---------------------------------------------------------------------------
; Keyword dispatch
; ---------------------------------------------------------------------------

(sig 'sem/walk-keyword {-> Str Any List List List List})
(fun {sem/walk-keyword name hd tl scope acc} {
  if (== name "fun")  {sem/walk-fun hd tl scope acc}
  {if (== name "\\") {sem/walk-lambda hd tl scope acc}
  {if (== name "def") {sem/walk-binding hd tl scope acc}
  {if (== name "=")   {sem/walk-binding hd tl scope acc}
  {if (== name "type") {sem/walk-type hd tl scope acc}
  {do
    (sem/walk-each tl scope
      (sem/emit (src-pos hd) (sem/source-len name) SEM_KEYWORD MOD_NONE acc))}}}}}
})

; ---------------------------------------------------------------------------
; (fun {name params...} {body})
; ---------------------------------------------------------------------------

(sig 'sem/walk-fun {-> Any List List List List})
(fun {sem/walk-fun kw args scope acc} {do
  (sem/walk-fun-with-kw kw args scope
    (sem/emit (src-pos kw) 3 SEM_KEYWORD MOD_NONE acc))
})

(sig 'sem/walk-fun-with-kw {-> Any List List List List})
(fun {sem/walk-fun-with-kw kw args scope acc} {
  if (< (len args) 2) {sem/walk-each args scope acc}
  {sem/walk-fun-formals (head args) (head (tail args)) scope acc}
})

(sig 'sem/walk-fun-formals {-> Any Any List List List})
(fun {sem/walk-fun-formals formals body scope acc} {
  if (nil? formals) {sem/walk-code body scope acc}
  {sem/walk-fun-name (head formals) (tail formals) body scope acc}
})

; Emit function name, then params, then walk body with new scope
(sig 'sem/walk-fun-name {-> Any List List List List List})
(fun {sem/walk-fun-name fname params body scope acc} {
  if (sym? fname)
    {sem/walk-fun-params params body scope
      (sem/collect-param-names params)
      (sem/emit (src-pos fname) (len (str fname)) SEM_FUNCTION MOD_DECLARATION acc)}
    {sem/walk-fun-params params body scope
      (sem/collect-param-names params) acc}
})

(sig 'sem/walk-fun-params {-> List List List List List List})
(fun {sem/walk-fun-params params body scope param-names acc} {
  sem/walk-code body (join scope param-names)
    (sem/emit-param-decls params acc)
})

; ---------------------------------------------------------------------------
; (\ {params...} {body})
; ---------------------------------------------------------------------------

(sig 'sem/walk-lambda {-> Any List List List List})
(fun {sem/walk-lambda kw args scope acc} {do
  (sem/walk-lambda-inner args scope
    (sem/emit (src-pos kw) 1 SEM_KEYWORD MOD_NONE acc))
})

(sig 'sem/walk-lambda-inner {-> List List List List})
(fun {sem/walk-lambda-inner args scope acc} {
  if (< (len args) 2) {sem/walk-each args scope acc}
  {sem/walk-lambda-body (head args) (head (tail args)) scope acc}
})

(sig 'sem/walk-lambda-body {-> List List List List List})
(fun {sem/walk-lambda-body formals body scope acc} {
  sem/walk-code body (join scope (sem/collect-param-names formals))
    (sem/emit-param-decls formals acc)
})

; ---------------------------------------------------------------------------
; (def {vars...} vals...) and (= {vars...} vals...)
; ---------------------------------------------------------------------------

(sig 'sem/walk-binding {-> Any List List List List})
(fun {sem/walk-binding kw args scope acc} {
  if (nil? args) {sem/emit (src-pos kw) (len (str kw)) SEM_KEYWORD MOD_NONE acc}
  {sem/walk-binding-inner (head args) (tail args) scope
    (sem/emit (src-pos kw) (len (str kw)) SEM_KEYWORD MOD_NONE acc)}
})

(sig 'sem/walk-binding-inner {-> List List List List List})
(fun {sem/walk-binding-inner vars vals scope acc} {
  sem/walk-each vals scope
    (sem/emit-var-decls vars acc)
})

; ---------------------------------------------------------------------------
; (type (TypeName (Ctor :field Type) ...))
; ---------------------------------------------------------------------------

(sig 'sem/walk-type {-> Any List List List List})
(fun {sem/walk-type kw args scope acc} {
  sem/walk-type-variants args
    (sem/emit (src-pos kw) 4 SEM_KEYWORD MOD_NONE acc)
})

(sig 'sem/walk-type-variants {-> List List List})
(fun {sem/walk-type-variants variants acc} {
  if (nil? variants) {acc}
  {sem/walk-type-variants (tail variants)
    (sem/walk-type-one (head variants) acc)}
})

(sig 'sem/walk-type-one {-> Any List List})
(fun {sem/walk-type-one variant acc} {
  if (list? variant)
    {sem/walk-type-inner variant acc}
  {if (sym? variant)
    {sem/emit (src-pos variant) (len (str variant)) SEM_TYPE MOD_DECLARATION acc}
  {acc}}
})

(sig 'sem/walk-type-inner {-> List List List})
(fun {sem/walk-type-inner variant acc} {
  if (nil? variant) {acc}
  {sem/walk-type-head variant (tail variant) acc}
})

(sig 'sem/walk-type-head {-> List List List List})
(fun {sem/walk-type-head variant rest acc} {do
  (= {hname} (ast/head-name variant))
  (if (== hname "")
    {sem/walk-type-fields rest acc}
    {sem/walk-type-fields rest
      (sem/emit (src-pos (head variant)) (len hname) SEM_TYPE MOD_DECLARATION acc)})
})

(sig 'sem/walk-type-fields {-> List List List})
(fun {sem/walk-type-fields fields acc} {
  if (nil? fields) {acc}
  {sem/walk-type-fields (tail fields)
    (sem/walk-type-field (head fields) acc)}
})

(sig 'sem/walk-type-field {-> Any List List})
(fun {sem/walk-type-field f acc} {
  if (sym? f)
    {sem/walk-type-field-sym f (str f) acc}
  {if (list? f)
    {sem/walk-type-inner f acc}
    {acc}}
})

(sig 'sem/walk-type-field-sym {-> Any Str List List})
(fun {sem/walk-type-field-sym f name acc} {
  if (== (str/slice name 0 1) ":")
    {sem/emit (src-pos f) (len name) SEM_PROPERTY MOD_NONE acc}
    {sem/emit (src-pos f) (len name) SEM_TYPE MOD_NONE acc}
})

; ---------------------------------------------------------------------------
; Param/var emission helpers — walk formals lists
; ---------------------------------------------------------------------------

(sig 'sem/emit-param-decls {-> List List List})
(fun {sem/emit-param-decls params acc} {
  if (nil? params) {acc}
  {sem/emit-param-decls (tail params)
    (sem/emit-one-param (head params) acc)}
})

(sig 'sem/emit-one-param {-> Any List List})
(fun {sem/emit-one-param p acc} {
  if (sym? p)
    {sem/emit-one-param-str p (str p) acc}
    {acc}
})

(sig 'sem/emit-one-param-str {-> Any Str List List})
(fun {sem/emit-one-param-str p name acc} {
  if (== name "&") {acc}
  {sem/emit (src-pos p) (len name) SEM_PARAMETER MOD_DECLARATION acc}
})

(sig 'sem/collect-param-names {-> List List})
(fun {sem/collect-param-names params} {
  if (nil? params) {nil}
  {sem/collect-one-param (head params) (tail params)}
})

(sig 'sem/collect-one-param {-> Any List List})
(fun {sem/collect-one-param p rest} {
  if (sym? p)
    {sem/collect-one-param-str (str p) rest}
    {sem/collect-param-names rest}
})

(sig 'sem/collect-one-param-str {-> Str List List})
(fun {sem/collect-one-param-str name rest} {
  if (== name "&") {sem/collect-param-names rest}
  {qcons name (sem/collect-param-names rest)}
})

(sig 'sem/emit-var-decls {-> List List List})
(fun {sem/emit-var-decls vars acc} {
  if (nil? vars) {acc}
  {if (list? vars)
    {sem/emit-var-decls-inner vars acc}
    {acc}}
})

(sig 'sem/emit-var-decls-inner {-> List List List})
(fun {sem/emit-var-decls-inner vars acc} {
  if (nil? vars) {acc}
  {sem/emit-var-decls-inner (tail vars)
    (sem/emit-one-var (head vars) acc)}
})

(sig 'sem/emit-one-var {-> Any List List})
(fun {sem/emit-one-var v acc} {
  if (sym? v)
    {sem/emit (src-pos v) (len (str v)) SEM_VARIABLE MOD_DECLARATION acc}
    {acc}
})

; ---------------------------------------------------------------------------
; Delta encoding — provided by C builtin sem/encode-deltas
; Takes (text tokens) where tokens is list of 4-tuples (offset len type mods)
; Returns flat list of 5-tuples (deltaLine deltaCol len type mods)
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; Public API
; ---------------------------------------------------------------------------

(sig 'sem/tokenize {-> Str List})
(fun {sem/tokenize text} {do
  (sem/tokenize-ast (parse text) text)
})

(sig 'sem/tokenize-ast {-> List Str List})
(fun {sem/tokenize-ast ast text} {do
  (sem/encode-deltas text
    (list/group 4 (reverse (sem/walk-each ast nil nil))))
})

; ---------------------------------------------------------------------------
; Lexer-based fallback for semantic tokens.
;
; When the parser can't produce an AST (broken file mid-edit and no
; last-known-good cache), walk the text character-by-character and emit
; tokens for things we can identify lexically: comments, strings, numbers,
; keywords, properties (:foo), and other symbols.
;
; This loses scope/binding awareness but preserves syntax-level highlighting,
; which is much better UX than the editor falling back to orange-text default.
; ---------------------------------------------------------------------------

(sig 'sem/lex-tokenize {-> Str List})
(fun {sem/lex-tokenize text} {do
  (sem/encode-deltas text
    (list/group 4 (reverse (sem/lex-walk text 0 (len text) nil))))
})

(fun {sem/lex-is-ws ch} {
  or (== ch " ") (or (== ch "\t") (or (== ch "\n") (== ch "\r")))
})

(fun {sem/lex-is-paren ch} {
  or (== ch "(") (or (== ch ")") (or (== ch "{") (== ch "}")))
})

(fun {sem/lex-is-digit ch} {
  if (== (len ch) 0) {0}
  {>= (str/index-of "0123456789" ch) 0}
})

(fun {sem/lex-is-sym-char ch} {
  if (== (len ch) 0) {0}
  {if (sem/lex-is-ws ch) {0}
  {if (sem/lex-is-paren ch) {0}
  {if (== ch ";") {0}
  {if (== ch "\"") {0} {1}}}}}
})

(fun {sem/lex-walk text pos end acc} {
  if (>= pos end) {acc}
  {do
    (= {ch} (str/slice text pos (+ pos 1)))
    (if (sem/lex-is-ws ch)    {sem/lex-walk text (+ pos 1) end acc}
    {if (sem/lex-is-paren ch) {sem/lex-walk text (+ pos 1) end acc}
    {if (== ch ";")           {sem/lex-eat-comment text pos end acc}
    {if (== ch "\"")          {sem/lex-eat-string text pos end acc}
    {if (sem/lex-is-digit ch) {sem/lex-eat-number text pos end acc}
    {sem/lex-eat-symbol text pos end acc}}}}})}
})

; Comment: from `;` to end of line
(fun {sem/lex-eat-comment text pos end acc} {do
  (= {endpos} (sem/lex-find-newline text pos end))
  (sem/lex-walk text endpos end
    (sem/emit pos (- endpos pos) SEM_KEYWORD MOD_NONE acc))
})

(fun {sem/lex-find-newline text pos end} {
  if (>= pos end) {pos}
  {if (== (str/slice text pos (+ pos 1)) "\n") {pos}
    {sem/lex-find-newline text (+ pos 1) end}}
})

; String: from `"` to matching `"`, with `\"` escapes
(fun {sem/lex-eat-string text pos end acc} {do
  (= {endpos} (sem/lex-find-string-end text (+ pos 1) end))
  (sem/lex-walk text endpos end
    (sem/emit pos (- endpos pos) SEM_STRING MOD_NONE acc))
})

(fun {sem/lex-find-string-end text pos end} {
  if (>= pos end) {pos}
  {do
    (= {ch} (str/slice text pos (+ pos 1)))
    (if (== ch "\"") {+ pos 1}
    {if (== ch "\\")
      {if (>= (+ pos 1) end) {+ pos 1}
        {sem/lex-find-string-end text (+ pos 2) end}}
      {sem/lex-find-string-end text (+ pos 1) end}})}
})

; Number: digits, optional `.` and trailing digits
(fun {sem/lex-eat-number text pos end acc} {do
  (= {endpos} (sem/lex-find-num-end text pos end))
  (sem/lex-walk text endpos end
    (sem/emit pos (- endpos pos) SEM_NUMBER MOD_NONE acc))
})

(fun {sem/lex-find-num-end text pos end} {
  if (>= pos end) {pos}
  {do
    (= {ch} (str/slice text pos (+ pos 1)))
    (if (or (sem/lex-is-digit ch) (== ch ".")) {sem/lex-find-num-end text (+ pos 1) end}
      {pos})}
})

; Symbol: any non-whitespace, non-paren, non-quote, non-semicolon run
(fun {sem/lex-eat-symbol text pos end acc} {do
  (= {endpos} (sem/lex-find-sym-end text pos end))
  (= {name} (str/slice text pos endpos))
  (= {ttype} (sem/lex-classify name))
  (sem/lex-walk text endpos end
    (sem/emit pos (- endpos pos) ttype MOD_NONE acc))
})

(fun {sem/lex-find-sym-end text pos end} {
  if (>= pos end) {pos}
  {if (sem/lex-is-sym-char (str/slice text pos (+ pos 1)))
    {sem/lex-find-sym-end text (+ pos 1) end}
    {pos}}
})

(fun {sem/lex-classify name} {
  if (== (len name) 0) {SEM_VARIABLE}
  {if (== (str/slice name 0 1) ":") {SEM_PROPERTY}
  {if (dict/has? SEM_KEYWORD_SET name) {SEM_KEYWORD}
  {if (dict/has? SEM_OPERATOR_SET name) {SEM_OPERATOR}
  {SEM_VARIABLE}}}}
})

; ---------------------------------------------------------------------------
; Typed semantic token representation
; ---------------------------------------------------------------------------
; The C builtin sem/encode-deltas returns a flat integer list for the LSP wire
; format. These helpers convert between that flat encoding and typed records.

(type {SemToken}
  {:dl Num :dc Num :len Num :ttype Num :mods Num})

(sig 'sem/parse-flat {-> List List})
(fun {sem/parse-flat tokens} {
  if (nil? tokens) {nil}
  {if (< (len tokens) 5) {nil}
  {qcons (SemToken :dl    (nth 1 tokens)
                   :dc    (nth 2 tokens)
                   :len   (nth 3 tokens)
                   :ttype (nth 4 tokens)
                   :mods  (nth 5 tokens))
         (sem/parse-flat (drop 5 tokens))}}
})

(sig 'sem/flatten {-> List List})
(fun {sem/flatten tokens} {
  if (nil? tokens) {nil}
   {do
    (= {t} (head tokens))
    (qcons t:dl (qcons t:dc (qcons t:len (qcons t:ttype
      (qcons t:mods (sem/flatten (tail tokens)))))))}
})

; ---------------------------------------------------------------------------
; Line/column to byte offset conversion
; ---------------------------------------------------------------------------

(sig 'line-col->offset {-> Str Num Num Num})
(fun {line-col->offset text line col} {
  lc-offset-walk (str/split text "\n") line col 0 0
})

(sig 'lc-offset-walk {-> (List Str) Num Num Num Num Num})
(fun {lc-offset-walk lines target-line target-col current-line offset} {
  if (>= current-line target-line) {+ offset target-col}
  {if (nil? lines) {offset}
    {lc-offset-walk (tail lines) target-line target-col
      (+ current-line 1)
      (+ offset (len (head lines)) 1)}}
})

