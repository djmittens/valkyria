
; --- CLI argument parsing ---

(fun {parse-args argv} {
  (= {opts} {:build-dir "build" :filter "" :no-stress 0
             :stress-only 0 :only "" :examples 0 :sanitizer ""
             :lsan-suppressions "" :junit-dir ""})
  (= {i} 1)
  (= {argc} (len argv))
  (*parse-args-loop* opts argv i argc)
})

(fun {*parse-args-loop* opts argv i argc} {
  (if (> i argc)
    {opts}
    {do
      (= {arg} (nth i argv))
      (= {next-i} (+ i 1))
      (= {has-next} (<= next-i argc))
      (select
        {(or (== arg "-f") (== arg "--filter"))
         (if has-next
           {(*parse-args-loop* (plist/set opts :filter (nth next-i argv)) argv (+ i 2) argc)}
           {opts})}
        {(== arg "--build-dir")
         (if has-next
           {(*parse-args-loop* (plist/set opts :build-dir (nth next-i argv)) argv (+ i 2) argc)}
           {opts})}
        {(== arg "--junit-dir")
         (if has-next
           {(*parse-args-loop* (plist/set opts :junit-dir (nth next-i argv)) argv (+ i 2) argc)}
           {opts})}
        {(== arg "--no-stress")
         (*parse-args-loop* (plist/set opts :no-stress 1) argv next-i argc)}
        {(== arg "--stress-only")
         (*parse-args-loop* (plist/set opts :stress-only 1) argv next-i argc)}
        {(== arg "--examples")
         (*parse-args-loop* (plist/set opts :examples 1) argv next-i argc)}
        {(== arg "--only")
         (if has-next
           {(*parse-args-loop* (plist/set opts :only (nth next-i argv)) argv (+ i 2) argc)}
           {opts})}
        {(== arg "--sanitizer")
         (if has-next
           {(*parse-args-loop* (plist/set opts :sanitizer (nth next-i argv)) argv (+ i 2) argc)}
           {opts})}
        {(== arg "--lsan-suppressions")
         (if has-next
           {(*parse-args-loop* (plist/set opts :lsan-suppressions (nth next-i argv)) argv (+ i 2) argc)}
           {opts})}
        {true
         (do
           (if (and (str/starts-with? arg "-") (!= arg "--"))
             {(stderr/write (str "warning: unknown option '" arg "'\n"))}
             {})
           (*parse-args-loop* opts argv next-i argc))})})
})

; --- Test discovery ---

(fun {discover-c-tests build-dir} {
  (= {entries} (list-dir build-dir))
  (= {is-test} (\ {entry} {
    (= {name} (plist/get entry :name))
    (= {type} (plist/get entry :type))
    (if (not (== type "file")) {false}
      {(if (not (str/starts-with? name "test_")) {false}
        {(if (== name "test_demo_server") {false}
          {(if (str/contains? name ".") {false}
            {true})})})})
  }))
  (= {filtered} (filter is-test entries))
  (= {to-suite} (\ {entry} {
    (= {name} (plist/get entry :name))
    (list :name name :cmd (list (str build-dir "/" name)) :kind "c")
  }))
  (map to-suite filtered)
})

(fun {discover-valk-in-dir valk dir prefix} {
  (= {entries} (list-dir dir))
  (if (error? entries) {nil}
    {do
      (= {tests} (filter (\ {e} {
        (= {n} (plist/get e :name))
        (if (not (str/starts-with? n "test_")) {false}
          {if (not (str/ends-with? n ".valk")) {false}
            {(== (plist/get e :type) "file")}})
      }) entries))
      (map (\ {e} {
        (= {n} (plist/get e :name))
        (= {stem} (str/slice n 0 (- (len n) 5)))
        (= {display} (if (== prefix "") {stem} {str prefix "/" stem}))
        (list :name display :cmd (list valk (str dir "/" n)) :kind "valk")
      }) tests)})
})

(fun {discover-valk-tests build-dir include-stress} {
  (= {valk} (str build-dir "/valk"))
  (= {subdirs} (filter (\ {e} {
    (= {n} (plist/get e :name))
      (if (== (plist/get e :type) "dir") {
      if (== n "fixtures") {false}
        {if (== n "unit") {false}
          {if (== n "stress") {false}
            {true}}}} {false})
  }) (list-dir "runtime/test")))

  (= {suites} {})
  (= {suites} (foldl (\ {acc sub} {
    (= {name} (plist/get sub :name))
    (join acc (discover-valk-in-dir valk (str "runtime/test/" name) name))
  }) suites subdirs))

  (= {suites} (join suites (discover-valk-in-dir valk "lsp/test" "lsp")))

  (if (== include-stress 1)
    {if (file/exists? "runtime/test/stress")
      {(= {suites} (join suites (discover-valk-in-dir valk "runtime/test/stress" "stress")))}
      {nil}}
    {nil})

  suites
})

(fun {discover-examples build-dir} {
  (= {valk} (str build-dir "/valk"))
  (if (not (file/exists? "examples"))
    {{}}
    {do
      (= {entries} (list-dir "examples"))
      (= {examples} (filter (\ {e} {
        (= {n} (plist/get e :name))
        (if (not (str/contains? n ".valk")) {false}
          {(if (== n "webserver_demo.valk") {false}
            {(== (plist/get e :type) "file")})})
      }) entries))
      (map (\ {e} {
        (= {n} (plist/get e :name))
        (= {stem} (str/slice n 0 (- (len n) 5)))
        (list :name (str "example/" stem) :cmd (list valk (str "examples/" n)) :kind "example")
      }) examples)})
})

; Neovim-driven LSP acceptance scenarios. Each file under
; lsp/test/uat/scenarios/ becomes one suite, running in its own nvim +
; valk-lsp + fixture workspace, so UAT schedules through the same pmap,
; filter, JUnit tree and summary as every other suite. Scenarios flagged
; `_latency = true` assert percentile budgets and are marked :exclusive —
; a p99 measured while the rest of the suite saturates the box describes
; the scheduler, not the editor experience.
;
; Absent nvim or an unbuilt server is a skip, not a failure: UAT needs
; tools a plain `make build` does not produce. Set VALK_UAT_STRICT=1 (CI)
; to make it fatal instead.
; --only names one kind: c, valk, uat, example. Empty means all of them.
(fun {want-kind? only kind} {(or (== only "") (== only kind))})

; "" when UAT can run, otherwise the reason it cannot. Reported by the
; caller so the skip stays a plain value instead of mutated global state.
(fun {uat-blocked-reason build-dir} {
  (= {lsp-bin} (str build-dir "/valk-lsp"))
  (select
    {(not (file/exists? "lsp/test/uat/scenarios")) "no scenarios directory"}
    {(not (file/exists? lsp-bin)) (str "no LSP binary at " lsp-bin " (run 'make lsp')")}
    {(!= (plist/get (exec "nvim" "--version") :exit-code) 0) "nvim not found on PATH"}
    {true ""})
})

(fun {uat-suites build-dir blocked} {
  (if (== blocked "")
    {(discover-uat-tests build-dir)}
    {if (== (env/get "VALK_UAT_STRICT") nil)
      {do (stderr/write (str "note: skipping UAT — " blocked "\n")) {}}
      {do (stderr/write (str "error: UAT unavailable — " blocked "\n")) (shutdown 1)}})
})

(fun {discover-uat-tests build-dir} {
  (= {dir} "lsp/test/uat/scenarios")
  (= {runner} (realpath "lsp/test/uat/runner.lua"))
  (= {lsp-abs} (realpath (str build-dir "/valk-lsp")))
  (= {files} (filter (\ {e} {
    (if (not (== (plist/get e :type) "file")) {false}
      {(str/ends-with? (plist/get e :name) ".lua")})
  }) (list-dir dir)))
  (map (\ {e} {
    (= {n} (plist/get e :name))
    (= {stem} (str/slice n 0 (- (len n) 4)))
    (= {latency} (if (str/contains? (read-file (str dir "/" n)) "_latency = true")
                   {1} {0}))
    ; `env` carries the per-suite variables because exec has no env
    ; parameter and env/set is process-global — which would race across
    ; pmap workers.
    (list :name (str "uat/" stem) :kind "uat" :exclusive latency
          :cmd (list "env" (str "VALK_LSP_BIN=" lsp-abs)
                     (str "VALK_UAT_SCENARIO=" stem)
                     "nvim" "--headless" "-l" runner))
  }) files)
})

(fun {filter-suites suites pattern} {
  (if (== pattern "")
    {suites}
    {do
      (= {p} (str/lower pattern))
      (filter (\ {s} {(str/contains? (str/lower (plist/get s :name)) p)}) suites)})
})

; --- XML escaping ---

(fun {xml-escape s} {
  (= {s} (str/replace s "&" "&amp;"))
  (= {s} (str/replace s "<" "&lt;"))
  (= {s} (str/replace s ">" "&gt;"))
  (= {s} (str/replace s "\"" "&quot;"))
  s
})

; --- Run one suite ---

(fun {run-one-suite suite} {
  (= {name} (plist/get suite :name))
  (= {cmd} (plist/get suite :cmd))
  (= {kind} (plist/get suite :kind))

  (= {start-us} (time-us {}))
  (= {result} (eval (cons exec cmd)))
  (= {end-us} (time-us {}))
  (= {wall-us} (- end-us start-us))

  (= {exit-code} (plist/get result :exit-code))
  (= {stdout} (plist/get result :stdout))
  (= {stderr} (plist/get result :stderr))

  (= {tests} (parse-jsonl-tests stdout))
  (= {n-passed} (len (filter (\ {t} {(= {s} (plist/get t :status)) (or (== s "pass") (== s "xfail"))}) tests)))
  (= {n-failed} (len (filter (\ {t} {
    (= {s} (plist/get t :status))
    (or (== s "fail") (or (== s "crash") (or (== s "timeout") (== s "undefined"))))
  }) tests)))
  (= {n-skipped} (len (filter (\ {t} {(== (plist/get t :status) "skip")}) tests)))

  (list :name name :kind kind :passed (== exit-code 0)
   :exit-code exit-code :wall-us wall-us
   :test-count (len tests) :test-passed n-passed
   :test-failed n-failed :test-skipped n-skipped
   :tests tests :stdout stdout :stderr stderr)
})

(fun {parse-jsonl-tests output} {
  (= {lines} (str/split output "\n"))
  (= {parsed} (filter (\ {line} {
    (if (== (len line) 0) {false}
      {(str/starts-with? line "{")})
  }) lines))
  (map (\ {line} {
    (= {obj} (json/parse line))
    (if (error? obj)
      {{:test "parse-error" :status "fail" :us 0}}
      {obj})
  }) parsed)
})

; --- JUnit XML generation ---

(fun {write-junit suite-result junit-dir} {
  (= {name} (plist/get suite-result :name))
  (= {tests} (plist/get suite-result :tests))
  (= {exit-code} (plist/get suite-result :exit-code))
  (= {wall-s} (/ (plist/get suite-result :wall-us) 1000000))
  (= {n-failures} 0)
  (= {n-errors} 0)
  (= {n-skipped} 0)

  (= {testcases} "")
  (= {tc-data} (foldl (\ {acc t} {
    (= {tname} (xml-escape (plist/get t :test)))
    (= {status} (plist/get t :status))
    (= {us} (plist/get t :us))
    (= {time-s} (/ us 1000000))
    (= {time-frac} (mod (/ us 1000) 1000))
    (= {tc-xml} (str "    <testcase classname=\"" (xml-escape name) "\" name=\"" tname
                      "\" time=\"" time-s "." (if (< time-frac 100) {(if (< time-frac 10) {"00"} {"0"})} {""}) time-frac "\""  ))
    (select
      {(or (== status "pass") (== status "xfail"))
       (= {tc-xml} (str tc-xml "/>\n"))}
      {(== status "skip")
       (do (= {tc-xml} (str tc-xml "><skipped/></testcase>\n"))
           (= {acc} (plist/set acc :skipped (+ (plist/get acc :skipped) 1))))}
      {(== status "fail")
       (do (= {tc-xml} (str tc-xml "><failure message=\"test failed\"/></testcase>\n"))
           (= {acc} (plist/set acc :failures (+ (plist/get acc :failures) 1))))}
      {(== status "crash")
       (do (= {tc-xml} (str tc-xml "><error message=\"crashed\"/></testcase>\n"))
           (= {acc} (plist/set acc :errors (+ (plist/get acc :errors) 1))))}
      {(== status "timeout")
       (do (= {tc-xml} (str tc-xml "><error message=\"timed out\"/></testcase>\n"))
           (= {acc} (plist/set acc :errors (+ (plist/get acc :errors) 1))))}
      {true
       (do (= {tc-xml} (str tc-xml "><error message=\"unknown status\"/></testcase>\n"))
           (= {acc} (plist/set acc :errors (+ (plist/get acc :errors) 1))))})
    (plist/set acc :xml (str (plist/get acc :xml) tc-xml))
  }) {:xml "" :failures 0 :errors 0 :skipped 0} tests))

  (if (and (== exit-code 0) (== (len tests) 0))
    {true}
    {(if (and (!= exit-code 0) (== (len tests) 0))
      {do
        (= {tc-data} (plist/set tc-data :errors (+ (plist/get tc-data :errors) 1)))
        (= {tc-data} (plist/set tc-data :xml (str (plist/get tc-data :xml)
          "    <testcase classname=\"" (xml-escape name) "\" name=\"" (xml-escape name)
          "\" time=\"" wall-s "\"><error message=\"exited with code " exit-code "\"/></testcase>\n")))}
      {true})})

  (= {n-tests} (if (== (len tests) 0) {1} {(len tests)}))
  (= {xml} (str "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
    "<testsuites>\n"
    "  <testsuite name=\"" (xml-escape name)
    "\" tests=\"" n-tests
    "\" failures=\"" (plist/get tc-data :failures)
    "\" errors=\"" (plist/get tc-data :errors)
    "\" skipped=\"" (plist/get tc-data :skipped)
    "\" time=\"" wall-s "\">\n"
    (plist/get tc-data :xml)
    "  </testsuite>\n"
    "</testsuites>\n"))

  (= {safe-name} (str/replace name "/" "_"))
  (write-file (str junit-dir "/" safe-name ".xml") xml)
})

(fun {name-listed? name names} {
  (> (len (filter (\ {n} {(== n name)}) names)) 0)
})

; --- Summary printing ---

(fun {print-summary results wall-us junit-dir} {
  (= {total} (len results))
  (= {failed-suites} (filter (\ {r} {(not (plist/get r :passed))}) results))
  (= {total-tests} (foldl (\ {acc r} {(+ acc (plist/get r :test-count))}) 0 results))
  (= {total-passed} (foldl (\ {acc r} {(+ acc (plist/get r :test-passed))}) 0 results))
  (= {total-failed} (foldl (\ {acc r} {(+ acc (plist/get r :test-failed))}) 0 results))
  (= {total-skipped} (foldl (\ {acc r} {(+ acc (plist/get r :test-skipped))}) 0 results))
  (= {crashed-no-output} (len (filter (\ {r} {
    (and (not (plist/get r :passed)) (== (plist/get r :test-count) 0))
  }) results)))
  (= {total-tests} (+ total-tests crashed-no-output))
  (= {total-failed} (+ total-failed crashed-no-output))
  (= {wall-s-whole} (/ wall-us 1000000))
  (= {wall-s-frac} (/ (mod wall-us 1000000) 100000))

  ; Suites that exited 0 while their own JSONL says a test failed. The two
  ; should never disagree, but when they do it is the exit code that is
  ; wrong, and trusting it alone lets a suite go green while printing its
  ; own failures. Computed before the banner so the banner cannot claim
  ; ALL PASSED on a run that is about to exit 1.
  (= {silent-failures} (filter (\ {r} {
    (and (plist/get r :passed) (> (plist/get r :test-failed) 0))
  }) results))

  ; Suites that exited 0 having run NOTHING. A .valk suite whose file fails
  ; to parse prints the reader error and still exits 0, so it lands here as
  ; a pass with zero tests — test/aio/test_aio_config.valk hid a missing
  ; paren and 10 dead test cases this way, and test/http/test_shutdown.valk
  ; called `shutdown` before test/run and so never reported.
  ;
  ; Examples are exempt (demo scripts, checked only for a clean exit), as
  ; are the suites named below: they assert by running to completion rather
  ; than by registering cases. Listing them here keeps that decision visible
  ; instead of letting "no results" mean "fine" for everyone. A stale entry
  ; is harmless — the exemption only applies while a suite reports nothing,
  ; so one that later grows real cases is checked normally.
  (= {smoke-suites} {
    "test_gc_aio_hang"                  ; bare regression program: alarm(5) + exit code
    "lang/test_test_framework_empty"    ; exercises the framework's own empty-registry path
    "lang/test_printf_closure_bug"      ; closure repro, verified by not crashing
    "http/test_lisp_50mb_handler"       ; large-payload smoke
    "http/test_large_response_handler"  ; large-payload smoke
    "stress/test_large_response"        ; throughput smoke
    "stress/test_large_download_stress" ; throughput smoke
    "stress/test_checkpoint_timer_stress"
  })
  (= {empty-suites} (filter (\ {r} {
    (and (plist/get r :passed)
         (and (== (plist/get r :test-count) 0)
              (and (!= (plist/get r :kind) "example")
                   (not (name-listed? (plist/get r :name) smoke-suites)))))
  }) results))

  (print "")
  (printf "======================================================================\n")
  (if (and (== (len failed-suites) 0)
           (and (== (len silent-failures) 0) (== (len empty-suites) 0)))
    {printf "  ALL PASSED: %ld suites, %ld tests in %ld.%lds\n" total total-tests wall-s-whole wall-s-frac}
    {printf "  FAILED: %ld/%ld suites, %ld test failures in %ld.%lds\n"
            (len failed-suites) total total-failed wall-s-whole wall-s-frac})
  (printf "  Tests: %ld passed, %ld failed, %ld skipped\n" total-passed total-failed total-skipped)
  (printf "  JUnit: %s/\n" junit-dir)
  (printf "======================================================================\n")

  (if (> (len silent-failures) 0)
    {do
      (printf "\nSUITES REPORTING FAILURES BUT EXITING 0:\n\n")
      (map (\ {r} {
        (printf "  [%s] %s - %ld failed test(s) but exit 0\n"
          (plist/get r :kind) (plist/get r :name) (plist/get r :test-failed))
      }) silent-failures)}
    {true})

  (if (> (len empty-suites) 0)
    {do
      (printf "\nSUITES THAT RAN NO TESTS (exit 0, zero results):\n\n")
      (map (\ {r} {
        (printf "  [%s] %s\n" (plist/get r :kind) (plist/get r :name))
        (*print-capture* "stdout" (plist/get r :stdout))
        (*print-capture* "stderr" (plist/get r :stderr))
      }) empty-suites)}
    {true})

  (if (> (len failed-suites) 0)
    {do
      (printf "\nFAILED SUITES:\n\n")
      (map (\ {r} {
        (= {wall-s} (/ (plist/get r :wall-us) 1000000))
        (= {wall-frac} (/ (mod (plist/get r :wall-us) 1000000) 100000))
        (printf "  [%s] %s - exit %ld (%ld.%lds)\n"
          (plist/get r :kind) (plist/get r :name) (plist/get r :exit-code) wall-s wall-frac)
      }) failed-suites)
      (printf "\n----------------------------------------------------------------------\n")
      (printf "FAILURE DETAILS:\n")
      (printf "----------------------------------------------------------------------\n")
      (map (\ {r} {
        (printf "\n--- %s ---\n" (plist/get r :name))
        (*print-capture* "stdout" (plist/get r :stdout))
        (*print-capture* "stderr" (plist/get r :stderr))
      }) failed-suites)}
    {true})

  (and (== (len failed-suites) 0)
       (and (== (len silent-failures) 0) (== (len empty-suites) 0)))
})

; start/end are 0-indexed [start, end); nth is 1-indexed.
(fun {*print-lines-from* lines start end} {
  (if (>= start end)
    {true}
    {do
      (printf "    %s\n" (nth (+ start 1) lines))
      (*print-lines-from* lines (+ start 1) end)})
})

(fun {*print-capture* label text} {
  (if (> (len text) 0)
    {do
      (= {lines} (str/split text "\n"))
      (= {n} (len lines))
      (= {show} (if (> n 50) {50} {n}))
      (printf "  %s (%ld lines, last %ld):\n" label n show)
      (*print-lines-from* lines (- n show) n)}
    {true})
})

; --- Main ---

(= {opts} (parse-args sys/argv))
(= {build-dir} (plist/get opts :build-dir))
(= {filter-pat} (plist/get opts :filter))
(= {only} (plist/get opts :only))
(= {sanitizer} (plist/get opts :sanitizer))

(if (not (file/exists? build-dir))
  {do
    (stderr/write (str "error: build directory '" build-dir "' does not exist\n"))
    (stderr/write "hint: run 'make build' first\n")
    (shutdown 1)}
  {true})

; Set up env vars
(env/set "VALK_TEST_JSON" "1")
(env/set "VALK_TEST_TIMEOUT_SECONDS" "30")

(if (== sanitizer "asan")
  {do
    (env/set "ASAN_OPTIONS" "detect_leaks=1:halt_on_error=1:abort_on_error=1")
    (= {lsan-opts} "verbosity=0:log_threads=1")
    (= {lsan-supp} (plist/get opts :lsan-suppressions))
    (if (> (len lsan-supp) 0)
      {(env/set "LSAN_OPTIONS" (str lsan-opts ":suppressions=" lsan-supp))}
      {(env/set "LSAN_OPTIONS" lsan-opts)})}
  {true})
(if (== sanitizer "tsan")
  {do
    (env/set "TSAN_OPTIONS" "halt_on_error=1:second_deadlock_stack=1")
    (env/set "VALK_TEST_NO_FORK" "1")}
  {true})

; Discover suites
(fun {discover-all-suites build-dir opts only uat-blocked} {
  (if (== (plist/get opts :stress-only) 1)
    {filter (\ {s} {(str/starts-with? (plist/get s :name) "stress/")})
            (discover-valk-tests build-dir 1)}
    {do
      (= {suites} {})
      (if (want-kind? only "c")
        {(= {suites} (join suites (discover-c-tests build-dir)))}
        {true})
      (if (want-kind? only "valk")
        {(= {suites} (join suites (discover-valk-tests build-dir (if (== (plist/get opts :no-stress) 1) {0} {1}))))}
        {true})
      (if (want-kind? only "uat")
        {(= {suites} (join suites (uat-suites build-dir uat-blocked)))}
        {true})
      (if (and (== (plist/get opts :examples) 1) (want-kind? only "example"))
        {(= {suites} (join suites (discover-examples build-dir)))}
        {true})
      suites})
})

(= {uat-blocked} (if (want-kind? only "uat") {(uat-blocked-reason build-dir)} {""}))
(= {suites} (discover-all-suites build-dir opts only uat-blocked))

; A UAT-only selection on a box with no nvim is a skip, not an error —
; otherwise `make uat` fails the build wherever the tooling is absent,
; which is exactly the case the skip exists to cover.
(if (== (len suites) 0)
  {if (!= uat-blocked "")
    {do (stderr/write "no suites to run (UAT skipped)\n") (shutdown 0)}
    {do (stderr/write "error: no test suites found\n") (shutdown 1)}}
  {true})

(= {suites} (filter-suites suites filter-pat))
(if (== (len suites) 0)
  {do (stderr/write (str "error: no suites match filter '" filter-pat "'\n")) (shutdown 1)}
  {true})

; Set up JUnit directory
(= {junit-dir} (plist/get opts :junit-dir))
(if (== junit-dir "")
  {do
    (= {ts} (str/trim (plist/get (exec "date" "+%Y-%m-%d_%H-%M-%S") :stdout)))
    (= {junit-dir} (str "test-report/" ts))}
  {true})
(mkdir-p junit-dir)
(mkdir-p "test-report")

; Determine concurrency
(= {ncpus-r} (exec "nproc"))
(= {ncpus} (if (== (plist/get ncpus-r :exit-code) 0)
  {(str->num (str/trim (plist/get ncpus-r :stdout)))}
  {4}))

; Print header
(= {c-count} (len (filter (\ {s} {(== (plist/get s :kind) "c")}) suites)))
(= {v-count} (len (filter (\ {s} {(== (plist/get s :kind) "valk")}) suites)))
(= {e-count} (len (filter (\ {s} {(== (plist/get s :kind) "example")}) suites)))
(= {u-count} (len (filter (\ {s} {(== (plist/get s :kind) "uat")}) suites)))
(= {parts} {})
(if (> c-count 0) {(= {parts} (join parts (list (str c-count " C"))))} {true})
(if (> v-count 0) {(= {parts} (join parts (list (str v-count " Valk"))))} {true})
(if (> e-count 0) {(= {parts} (join parts (list (str e-count " examples"))))} {true})
(if (> u-count 0) {(= {parts} (join parts (list (str u-count " UAT"))))} {true})

(= {san-label} (if (> (len sanitizer) 0) {(str " [" (str/upper sanitizer) "]")} {""}))
(printf "Running %ld suites (%s, %ld workers)%s\n" (len suites) (str/join parts ", ") ncpus san-label)
(printf "JUnit output: %s/\n\n" junit-dir)

; Tag suites with 1-based indices, continuing from `start`.
(fun {index-suites suites start} {
  (plist/get (foldl (\ {acc suite} {
    (= {i} (plist/get acc :i))
    (list :i (+ i 1) :out (join (plist/get acc :out) (list (join suite (list :idx (+ i 1))))))
  }) (list :i start :out {}) suites) :out)
})

(fun {run-and-report suite junit-dir total} {
  (= {result} (run-one-suite suite))
  (write-junit result junit-dir)
  (= {passed} (plist/get result :passed))
  (= {status} (if passed {"PASS"} {"FAIL"}))
  (= {wall-s} (/ (plist/get result :wall-us) 1000000))
  (= {wall-frac} (/ (mod (plist/get result :wall-us) 1000000) 100000))
  (printf "[%ld/%ld] %s: %s (%ld.%lds)\n"
    (plist/get suite :idx) total status (plist/get result :name) wall-s wall-frac)
  ; Return trimmed result: drop tests (JUnit already written).
  ; Keep stdout+stderr for failed suites (print-summary needs them: assert
  ; failure messages go to the suite's stdout) and for suites that produced
  ; no results at all — for those the output is the ONLY evidence of why,
  ; and it is usually a reader error the suite then exited 0 on.
  (= {keep-output} (or (not passed) (== (plist/get result :test-count) 0)))
  (list :name (plist/get result :name) :kind (plist/get result :kind)
        :passed passed :exit-code (plist/get result :exit-code)
        :wall-us (plist/get result :wall-us)
        :test-count (plist/get result :test-count)
        :test-passed (plist/get result :test-passed)
        :test-failed (plist/get result :test-failed)
        :test-skipped (plist/get result :test-skipped)
        :stdout (if keep-output {(plist/get result :stdout)} {""})
        :stderr (if keep-output {(plist/get result :stderr)} {""}))
})

; Two phases. Everything runs in parallel except suites that declare
; :exclusive, which run alone afterwards — they measure wall-clock budgets
; and a co-tenant would be measuring the machine, not the code.
(fun {run-all-suites suites junit-dir ncpus} {
  (= {total} (len suites))
  (= {parallel} (index-suites
    (filter (\ {s} {(!= (plist/get s :exclusive) 1)}) suites) 0))
  (= {exclusive} (index-suites
    (filter (\ {s} {(== (plist/get s :exclusive) 1)}) suites) (len parallel)))

  (= {results} {})
  (if (> (len parallel) 0)
    {do
      (= {aio} (aio/await (aio/start (list :num-threads ncpus))))
      (= {results} (aio/await (aio/pmap aio (\ {suite} {
        (run-and-report suite junit-dir total)
      }) parallel)))
      (aio/stop aio)}
    {true})

  (if (> (len exclusive) 0)
    {do
      (printf "\n-- %ld exclusive suite(s), running serially --\n" (len exclusive))
      (= {results} (join results (map (\ {suite} {
        (run-and-report suite junit-dir total)
      }) exclusive)))}
    {true})
  results
})

(= {start-us} (time-us {}))
(= {results} (run-all-suites suites junit-dir ncpus))

(= {end-us} (time-us {}))
(= {wall-us} (- end-us start-us))

; Create latest symlink
(= {latest-link} "test-report/latest")
(= {rel-target} (last (str/split junit-dir "/")))
(symlink rel-target latest-link)

; Prune old test report directories (keep max 10)
(fun {prune-old-dirs base-dir max-keep} {
  (if (not (file/exists? base-dir)) {}
    {do
      (= {r} (exec "sh" "-c"
        (str "find '" base-dir "' -maxdepth 1 -mindepth 1 -type d -printf '%T@ %f\\n' | sort -n | head -n -" (str max-keep) " | cut -d' ' -f2-")))
      (if (!= (plist/get r :exit-code) 0) {}
        {do
          (= {to-rm} (filter (\ {s} {(> (len s) 0)}) (str/split (plist/get r :stdout) "\n")))
          (map (\ {d} {(exec "rm" "-rf" (str base-dir "/" d))}) to-rm)})})
})

(prune-old-dirs "test-report" 10)

; Print summary and exit
(= {all-passed} (print-summary results wall-us junit-dir))
(if all-passed {(shutdown 0)} {(shutdown 1)})
