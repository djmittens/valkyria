; Typeclass law checkers for property-based testing
; ops plists supply the typeclass operations under test.

(load "testing/gen.valk")

(module laws)

; === Typeclass Law Checkers ===

; Functor laws
; ops: {:map (f -> fa -> fb) :mk (a -> fa) :eq (fa -> fb -> Bool)}

(fun {functor-identity ops gen-a} {do
  (= {fmap} ops:map)
  (= {mk}   ops:mk)
  (= {eq}   ops:eq)
  (= {a} (gen-a))
  (= {fa} (mk a))
  (eq (fmap id fa) fa)
})

(fun {functor-composition ops gen-a f g} {do
  (= {fmap} ops:map)
  (= {mk}   ops:mk)
  (= {eq}   ops:eq)
  (= {a} (gen-a))
  (= {fa} (mk a))
  (eq (fmap g (fmap f fa)) (fmap (comp g f) fa))
})

; Applicative laws
; ops: {:pure (a -> fa) :ap (f(a->b) -> fa -> fb) :eq (fa -> fb -> Bool)}

(fun {applicative-identity ops gen-a} {do
  (= {pure} ops:pure)
  (= {ap}   ops:ap)
  (= {eq}   ops:eq)
  (= {a} (gen-a))
  (= {v} (pure a))
  (eq (ap (pure id) v) v)
})

(fun {applicative-homomorphism ops gen-a f} {do
  (= {pure} ops:pure)
  (= {ap}   ops:ap)
  (= {eq}   ops:eq)
  (= {a} (gen-a))
  (eq (ap (pure f) (pure a)) (pure (f a)))
})

; Monad laws
; ops: {:pure (a -> ma) :flat-map (ma -> (a -> mb) -> mb) :eq (ma -> mb -> Bool)}

(fun {monad-left-identity ops gen-a f} {do
  (= {pure}     ops:pure)
  (= {flat-map} ops:flat-map)
  (= {eq}       ops:eq)
  (= {a} (gen-a))
  (eq (flat-map (pure a) f) (f a))
})

(fun {monad-right-identity ops gen-a} {do
  (= {pure}     ops:pure)
  (= {flat-map} ops:flat-map)
  (= {eq}       ops:eq)
  (= {a} (gen-a))
  (= {m} (pure a))
  (eq (flat-map m pure) m)
})

(fun {monad-associativity ops gen-a f g} {do
  (= {pure}     ops:pure)
  (= {flat-map} ops:flat-map)
  (= {eq}       ops:eq)
  (= {a} (gen-a))
  (= {m} (pure a))
  (eq (flat-map (flat-map m f) g)
      (flat-map m (\ {x} {(flat-map (f x) g)})))
})

; Semiring laws (for Num with + and *)
; ops: {:add add-fn :mul mul-fn :zero zero :one one :eq eq-fn}

(fun {semiring-additive-identity ops gen-a} {do
  (= {add}  ops:add)
  (= {zero} ops:zero)
  (= {eq}   ops:eq)
  (= {a} (gen-a))
  (and (eq (add a zero) a)
       (eq (add zero a) a))
})

(fun {semiring-multiplicative-identity ops gen-a} {do
  (= {mul} ops:mul)
  (= {one} ops:one)
  (= {eq}  ops:eq)
  (= {a} (gen-a))
  (and (eq (mul a one) a)
       (eq (mul one a) a))
})

(fun {semiring-additive-commutativity ops gen-a} {do
  (= {add} ops:add)
  (= {eq}  ops:eq)
  (= {a} (gen-a))
  (= {b} (gen-a))
  (eq (add a b) (add b a))
})

(fun {semiring-additive-associativity ops gen-a} {do
  (= {add} ops:add)
  (= {eq}  ops:eq)
  (= {a} (gen-a))
  (= {b} (gen-a))
  (= {c} (gen-a))
  (eq (add (add a b) c) (add a (add b c)))
})

(fun {semiring-multiplicative-associativity ops gen-a} {do
  (= {mul} ops:mul)
  (= {eq}  ops:eq)
  (= {a} (gen-a))
  (= {b} (gen-a))
  (= {c} (gen-a))
  (eq (mul (mul a b) c) (mul a (mul b c)))
})

(fun {semiring-distributivity ops gen-a} {do
  (= {add} ops:add)
  (= {mul} ops:mul)
  (= {eq}  ops:eq)
  (= {a} (gen-a))
  (= {b} (gen-a))
  (= {c} (gen-a))
  (and (eq (mul a (add b c)) (add (mul a b) (mul a c)))
       (eq (mul (add a b) c) (add (mul a c) (mul b c))))
})

; Bifunctor laws
; ops: {:bimap (p -> (a->c) -> (b->d) -> p') :mk (a -> b -> p) :eq (p -> p -> Bool)}

; bimap id id = id
(fun {bifunctor-identity ops gen-a gen-b} {do
  (= {bimap} ops:bimap)
  (= {mk}    ops:mk)
  (= {eq}    ops:eq)
  (= {a} (gen-a))
  (= {b} (gen-b))
  (= {p} (mk a b))
  (eq (bimap p id id) p)
})

; bimap (f . g) (h . k) = bimap f h . bimap g k
(fun {bifunctor-composition ops gen-a gen-b f g h k} {do
  (= {bimap} ops:bimap)
  (= {mk}    ops:mk)
  (= {eq}    ops:eq)
  (= {a} (gen-a))
  (= {b} (gen-b))
  (= {p} (mk a b))
  (eq (bimap p (comp f g) (comp h k))
      (bimap (bimap p g k) f h))
})

; Traversable laws (naturality is hard without polymorphism, test identity + composition)
; ops: {:traverse (list -> (a -> f b) -> f (list b)) :pure (a -> f a) :eq (fa -> fa -> Bool)}

; traverse list pure = pure list (identity law)
(fun {traversable-identity ops gen-a gen-list-size} {do
  (= {traverse} ops:traverse)
  (= {pure}     ops:pure)
  (= {eq}       ops:eq)
  (= {n} (gen-list-size))
  (= {l} (gen/list-of gen-a n))
  (eq (traverse l pure) (pure l))
})

(fun {semiring-annihilation ops gen-a} {do
  (= {mul}  ops:mul)
  (= {zero} ops:zero)
  (= {eq}   ops:eq)
  (= {a} (gen-a))
  (and (eq (mul a zero) zero)
       (eq (mul zero a) zero))
})
