; find-uncovered-branches.valk — list branches never taken for a given file
;
; Reads the same gcov/lcov data as check-coverage.valk (coverage.xml no
; longer carries per-line branch detail), so output matches the gate.
;
; Usage: build/valk coverage/find-uncovered-branches.valk -- <file> [--build-dir DIR]

(load "coverage/coverage_common.valk")

(= {argv} sys/argv)
(= {argc} (len argv))
(= {opts} (dict/new))
(dict/set! opts "build-dir" "build-coverage")
(dict/set! opts "target" "")

(fun {*parse-args* i} {
  (if (> i argc) {}
    {do
      (= {arg} (nth i argv))
      (select
        {(== arg "--build-dir")
         (do (dict/set! opts "build-dir" (nth (+ i 1) argv)) (*parse-args* (+ i 2)))}
        {(or (== arg "--") (str/ends-with? arg "find-uncovered-branches.valk"))
         (*parse-args* (+ i 1))}
        {(str/ends-with? arg "/valk")
         (*parse-args* (+ i 1))}
        {true (do (dict/set! opts "target" arg) (*parse-args* (+ i 1)))})})
})
(*parse-args* 1)

(= {target} (dict/get opts "target"))
(if (== target "")
  {do
    (printf "Usage: find-uncovered-branches.valk <filename> [--build-dir DIR]\n")
    (printf "Example: find-uncovered-branches.valk memory.c\n")
    (shutdown 1)}
  {true})

(= {build-dir} (realpath (dict/get opts "build-dir")))
(if (not (file/exists? build-dir))
  {do
    (printf "error: build dir %s not found (run 'make coverage' first)\n" build-dir)
    (shutdown 1)}
  {true})
(= {source-root} (realpath (str/join (init (str/split build-dir "/")) "/")))

(= {files} (cov/collect-coverage build-dir source-root))

; Group never-taken branches by line: line-no -> "miss-count/total-count"
(fun {*collect-lines* bkeys bd miss-d total-d} {
  (if (== bkeys nil) {}
    {do
      (= {bkey} (head bkeys))
      (= {taken} (dict/get bd bkey))
      (= {line-no} (nth 1 (str/split bkey ":")))
      (= {old-total} (dict/get total-d line-no))
      (dict/set! total-d line-no (if (== old-total nil) {1} {(+ old-total 1)}))
      (if (== taken 0)
        {do
          (= {old-miss} (dict/get miss-d line-no))
          (dict/set! miss-d line-no (if (== old-miss nil) {1} {(+ old-miss 1)}))}
        {})
      (*collect-lines* (tail bkeys) bd miss-d total-d)})
})

(fun {*print-lines* line-no max-line miss-d total-d src-lines n-src} {
  (if (> line-no max-line) {}
    {do
      (= {lkey} (str line-no))
      (= {miss} (dict/get miss-d lkey))
      (if (== miss nil) {}
        {do
          (= {total} (dict/get total-d lkey))
          (= {src} (if (and (> n-src 0) (<= line-no n-src))
            {(str/trim (nth line-no src-lines))}
            {""}))
          (printf "  Line %d: %d/%d branches never taken  %s\n" line-no miss total src)})
      (*print-lines* (+ line-no 1) max-line miss-d total-d src-lines n-src)})
})

(fun {*max-line* bkeys acc} {
  (if (== bkeys nil) {acc}
    {do
      (= {n} (str->num (nth 1 (str/split (head bkeys) ":"))))
      (*max-line* (tail bkeys) (if (> n acc) {n} {acc}))})
})

(fun {process-file filepath fc} {
  (printf "\nFile: %s\n" filepath)
  (printf "Line rate: %s\n" (cov/fmt-pct (cov/line-pct fc)))
  (printf "Branch rate: %s\n" (cov/fmt-pct (cov/branch-pct fc)))
  (printf "\nBranches never taken:\n")
  (printf "------------------------------------------------------------\n")
  (= {bd} (dict/get fc "branch-data"))
  (= {bkeys} (dict/keys bd))
  (= {miss-d} (dict/new))
  (= {total-d} (dict/new))
  (*collect-lines* bkeys bd miss-d total-d)
  (if (== (dict/count miss-d) 0)
    {(printf "  (none - all counted branches taken at least once)\n")}
    {do
      (= {src-lines} (if (file/exists? filepath)
        {(str/split (read-file filepath) "\n")}
        {nil}))
      (= {n-src} (if (== src-lines nil) {0} {(len src-lines)}))
      (*print-lines* 1 (*max-line* bkeys 0) miss-d total-d src-lines n-src)})
})

(fun {*scan-files* keys found} {
  (if (== keys nil) {found}
    {do
      (= {filepath} (head keys))
      (if (str/contains? filepath target)
        {do
          (process-file filepath (dict/get files filepath))
          (*scan-files* (tail keys) (+ found 1))}
        {(*scan-files* (tail keys) found)})})
})

(= {n-found} (*scan-files* (dict/keys files) 0))
(if (== n-found 0)
  {(printf "error: no coverage data for '%s'\n" target)}
  {true})
