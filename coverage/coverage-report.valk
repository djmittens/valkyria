; coverage-report.valk — Unified coverage report generator for Valkyria
;
; Generates aggregated HTML and XML (Cobertura) reports from:
; 1. C coverage data (gcov/llvm-cov format)
; 2. Valk coverage data (LCOV format)

(load "coverage/coverage_common.valk")



(def {MAX_COVERAGE_DIRS} 10)

; --- CLI ---

(= {argv} sys/argv)
(= {opts} (dict/new))
(dict/set! opts "build-dir" "build-coverage")
(dict/set! opts "source-root" ".")
(dict/set! opts "output-base" "coverage-report")
(dict/set! opts "valk-lcov" nil)
(dict/set! opts "gen-xml" 0)

(fun {*parse-args* i} {
  (= {argc} (len argv))
  (if (> i argc) {}
    {do
      (= {arg} (nth i argv))
      (= {has-next} (<= (+ i 1) argc))
      (select
        {(== arg "--build-dir")
         (if has-next {do (dict/set! opts "build-dir" (nth (+ i 1) argv)) (*parse-args* (+ i 2))} {(*parse-args* (+ i 1))})}
        {(== arg "--source-root")
         (if has-next {do (dict/set! opts "source-root" (nth (+ i 1) argv)) (*parse-args* (+ i 2))} {(*parse-args* (+ i 1))})}
        {(== arg "--output")
         (if has-next {do (dict/set! opts "output-base" (nth (+ i 1) argv)) (*parse-args* (+ i 2))} {(*parse-args* (+ i 1))})}
        {(== arg "--valk-lcov")
         (if has-next {do (dict/set! opts "valk-lcov" (nth (+ i 1) argv)) (*parse-args* (+ i 2))} {(*parse-args* (+ i 1))})}
        {(== arg "--xml")
         (do (dict/set! opts "gen-xml" 1) (*parse-args* (+ i 1)))}
        {true (*parse-args* (+ i 1))})})
})
(*parse-args* 1)

(= {build-dir} (dict/get opts "build-dir"))
(= {source-root} (dict/get opts "source-root"))
(= {output-base} (dict/get opts "output-base"))
(= {valk-lcov} (dict/get opts "valk-lcov"))
(= {gen-xml} (dict/get opts "gen-xml"))

; --- Resolve paths ---
(= {build-dir} (realpath build-dir))
(= {source-root} (realpath source-root))

; Create timestamped output directory
(= {ts} (str/trim (plist/get (exec "date" "+%Y-%m-%d_%H-%M-%S") :stdout)))
(= {output-dir} (str output-base "/" ts))
(mkdir-p output-dir)

(printf "Collecting coverage data...\n")
(printf "  Build dir:    %s\n" build-dir)
(printf "  Source root:  %s\n" source-root)
(printf "  Output:       %s\n" output-dir)

(print "\nCollecting coverage data...")
(= {files} (cov/collect-coverage build-dir source-root))
(= {file-keys} (dict/keys files))
(= {c-count} (len (filter (\ {k} {str/ends-with? k ".c"}) file-keys)))
(= {valk-count} (len (filter (\ {k} {str/ends-with? k ".valk"}) file-keys)))
(printf "  Found %d C files, %d Valk files\n" c-count valk-count)

; --- Coverage class ---
(fun {cov-class pct-tenths} {
  (if (>= pct-tenths 800) {"cov-high"}
    {(if (>= pct-tenths 500) {"cov-med"} {"cov-low"})})
})

(fun {cov-color pct-tenths} {
  (if (>= pct-tenths 800) {"#4caf50"}
    {(if (>= pct-tenths 500) {"#ff9800"} {"#f44336"})})
})

; --- Generate Cobertura XML ---

(fun {generate-cobertura-xml files output-path source-root} {
  (= {file-keys} (dict/keys files))
  (= {total-lf} (cov/sum-stat files cov/lines-found))
  (= {total-lh} (cov/sum-stat files cov/lines-hit))
  (= {total-bf} (cov/sum-stat files cov/branches-found))
  (= {total-bh} (cov/sum-stat files cov/branches-hit))
  (= {line-rate} (cov/pct-tenths total-lh total-lf))
  (= {branch-rate} (cov/pct-tenths total-bh total-bf))

  (= {fh} (file/open output-path "w"))
  (file/write fh (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
    "<coverage version=\"1.0\""
    " lines-valid=\"" total-lf "\""
    " lines-covered=\"" total-lh "\""
    " line-rate=\"" (cov/fmt-rate line-rate) "\""
    " branches-valid=\"" total-bf "\""
    " branches-covered=\"" total-bh "\""
    " branch-rate=\"" (cov/fmt-rate branch-rate) "\""
    " complexity=\"0\">\n"
    "  <sources>\n"
    "    <source>" (cov/xml-escape source-root) "</source>\n"
    "  </sources>\n"
    "  <packages>\n"))

  (file/write fh "    <package name=\"c\" line-rate=\"0\" branch-rate=\"0\" complexity=\"0\">\n      <classes>\n")
  (*cobertura-classes* fh file-keys files source-root 0)
  (file/write fh "      </classes>\n    </package>\n")

  (file/write fh "    <package name=\"valk\" line-rate=\"0\" branch-rate=\"0\" complexity=\"0\">\n      <classes>\n")
  (*cobertura-classes* fh file-keys files source-root 1)
  (file/write fh "      </classes>\n    </package>\n")

  (file/write fh "  </packages>\n</coverage>\n")
  (file/close fh)
})

(fun {*cobertura-classes* fh keys files source-root is-valk} {
  (if (== keys nil) {}
    {do
      (= {filepath} (head keys))
      (= {fc} (dict/get files filepath))
      (= {want-valk} (str/ends-with? filepath ".valk"))
      (if (!= (if is-valk {want-valk} {(not want-valk)}) 0)
        {do
          (= {rel} (if (str/starts-with? filepath source-root)
            {(str/slice filepath (+ (len source-root) 1) (len filepath))}
            {filepath}))
          (= {name} (last (str/split rel "/")))
          (= {lr} (cov/line-pct fc))
          (= {br} (cov/branch-pct fc))
          (file/write fh (str "        <class name=\"" (cov/xml-escape name)
            "\" filename=\"" (cov/xml-escape rel)
            "\" line-rate=\"" (cov/fmt-rate lr)
            "\" branch-rate=\"" (cov/fmt-rate br)
            "\" complexity=\"0\">\n"
            "          <methods/>\n"
            "          <lines>\n"))
          (*cobertura-lines* fh fc)
          (file/write fh "          </lines>\n        </class>\n")}
        {})
      (*cobertura-classes* fh (tail keys) files source-root is-valk)})
})

(fun {*cobertura-lines* fh fc} {
  (= {lines} (dict/get fc "lines"))
  (= {keys} (dict/keys lines))
  (*cobertura-lines-loop* fh keys lines)
})

(fun {*cobertura-lines-loop* fh keys lines} {
  (if (== keys nil) {}
    {do
      (= {line-no} (head keys))
      (= {lc} (dict/get lines line-no))
      (= {hit} (dict/get lc "hit"))
      (if (>= hit 0)
        {(file/write fh (str "            <line number=\"" line-no "\" hits=\"" (if (> hit 0) {hit} {0}) "\"/>\n"))}
        {})
      (*cobertura-lines-loop* fh (tail keys) lines)})
})

; --- Generate file HTML pages ---

(fun {generate-file-html fc output-dir source-root} {
  (= {filepath} (dict/get fc "filename"))
  (= {rel} (if (str/starts-with? filepath source-root)
    {(str/slice filepath (+ (len source-root) 1) (len filepath))}
    {filepath}))
  (= {safe-name} (str (str/replace (str/replace rel "/" "_") "." "_") ".html"))
  (= {is-valk} (str/ends-with? filepath ".valk"))

  ; Coverage stats
  (= {use-expr} (and is-valk (> (cov/exprs-found fc) 0)))
  (= {main-pct} (if use-expr {(cov/expr-pct fc)} {(cov/line-pct fc)}))
  (= {branch-pct} (cov/branch-pct fc))
  (= {main-label} (if use-expr {"Expression"} {"Line"}))
  (= {main-hit} (if use-expr {(cov/exprs-hit fc)} {(cov/lines-hit fc)}))
  (= {main-found} (if use-expr {(cov/exprs-found fc)} {(cov/lines-found fc)}))

  (= {fh} (file/open (str output-dir "/" safe-name) "w"))
  (file/write fh (str "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    "<meta charset=\"UTF-8\">\n"
    "<title>Coverage: " (cov/html-escape rel) "</title>\n"
    "<style>\n"
    ":root { --bg: #1a1a2e; --bg-alt: #16213e; --text: #eee; --text-muted: #888; --border: #333; --hit-bg: rgba(76, 175, 80, 0.15); --miss-bg: rgba(244, 67, 54, 0.25); --line-border: #444; }\n"
    "body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 20px; }\n"
    ".header { background: var(--bg-alt); padding: 20px; border-radius: 8px; margin-bottom: 20px; }\n"
    ".header h1 { margin: 0 0 10px 0; font-size: 1.5em; word-break: break-all; }\n"
    ".header a { color: #64b5f6; }\n"
    ".stats { display: flex; gap: 30px; margin-top: 15px; }\n"
    ".stat { text-align: center; }\n"
    ".stat-value { font-size: 2em; font-weight: bold; }\n"
    ".stat-label { font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; }\n"
    ".cov-high { color: #4caf50; } .cov-med { color: #ff9800; } .cov-low { color: #f44336; }\n"
    ".coverage-bar { height: 8px; background: #333; border-radius: 4px; margin-top: 10px; overflow: hidden; }\n"
    ".coverage-fill { height: 100%; border-radius: 4px; }\n"
    "table { width: 100%; border-collapse: collapse; font-family: \"SF Mono\", \"Consolas\", monospace; font-size: 13px; }\n"
    "tr { border-bottom: 1px solid var(--border); }\n"
    "td { padding: 0; vertical-align: top; }\n"
    ".line-no { width: 60px; text-align: right; padding: 2px 10px; color: var(--text-muted); background: var(--bg-alt); user-select: none; border-right: 1px solid var(--line-border); }\n"
    ".line-no a { color: inherit; text-decoration: none; } .line-no a:hover { color: var(--text); }\n"
    ".line-count { width: 60px; text-align: right; padding: 2px 10px; color: var(--text-muted); border-right: 1px solid var(--line-border); font-size: 11px; }\n"
    ".line-branch { width: 50px; text-align: center; padding: 2px 5px; border-right: 1px solid var(--line-border); font-size: 10px; }\n"
    ".line-src { padding: 2px 10px; }\n"
    ".line-src pre { margin: 0; white-space: pre-wrap; word-break: break-all; }\n"
    ".line-hit { background: var(--hit-bg); } .line-hit .line-count { color: #4caf50; font-weight: bold; }\n"
    ".line-miss { background: var(--miss-bg); } .line-miss .line-count { color: #f44336; font-weight: bold; }\n"
    ".branch-partial { color: #ff9800; font-weight: bold; } .branch-full { color: #4caf50; }\n"
    ":target { background: rgba(255, 235, 59, 0.3) !important; }\n"
    ".syn-keyword { color: #c792ea; font-weight: bold; } .syn-string { color: #c3e88d; } .syn-number { color: #f78c6c; } .syn-comment { color: #676e95; font-style: italic; }\n"
    "</style>\n</head>\n<body>\n"
    "<div class=\"header\">\n"
    "<a href=\"index.html\">&larr; Back to Coverage Report</a>\n"
    "<h1>" (cov/html-escape rel) "</h1>\n"
    "<div class=\"stats\">\n"
    "<div class=\"stat\"><div class=\"stat-value " (cov-class main-pct) "\">" (cov/fmt-pct main-pct) "</div><div class=\"stat-label\">" main-label " Coverage</div></div>\n"
    "<div class=\"stat\"><div class=\"stat-value " (cov-class branch-pct) "\">" (cov/fmt-pct branch-pct) "</div><div class=\"stat-label\">Branch Coverage</div></div>\n"
    "<div class=\"stat\"><div class=\"stat-value\">" main-hit "/" main-found "</div><div class=\"stat-label\">" (if use-expr {"Expressions"} {"Lines"}) "</div></div>\n"
    "<div class=\"stat\"><div class=\"stat-value\">" (cov/branches-hit fc) "/" (cov/branches-found fc) "</div><div class=\"stat-label\">Branches</div></div>\n"
    "</div>\n"
    "<div class=\"coverage-bar\"><div class=\"coverage-fill\" style=\"width:" (/ main-pct 10) "%;background:" (cov-color main-pct) "\"></div></div>\n"
    "</div>\n"
    "<table><tbody>\n"))

  ; Stream source lines via for-each-line (or from split if file missing)
  (= {cov-lines} (dict/get fc "lines"))
  (= {line-counter} (dict/new))
  (dict/set! line-counter "n" 1)
  (if (file/exists? filepath)
    {(for-each-line filepath (\ {source} {
      (= {line-no} (dict/get line-counter "n"))
      (*write-source-row* fh source cov-lines line-no)
      (dict/set! line-counter "n" (+ line-no 1))
    }))}
    {})

  (file/write fh "</tbody></table>\n</body></html>\n")
  (file/close fh)
  safe-name
})

(fun {*write-source-row* fh source cov-lines line-no} {
  (= {lc} (dict/get cov-lines (str line-no)))
  (= {hit} (if (== lc nil) {-1} {(dict/get lc "hit")}))
  (= {line-class}
    (select
      {(or (== lc nil) (== hit -1)) "line-none"}
      {(== hit 0) "line-miss"}
      {true "line-hit"}))
  (= {count-display} (select
    {(or (== lc nil) (== hit -1)) ""}
    {(== hit 0) "0"}
    {true (str hit)}))
  (file/write fh (str "<tr class=\"" line-class "\" id=\"L" line-no "\">"
    "<td class=\"line-no\"><a href=\"#L" line-no "\">" line-no "</a></td>"
    "<td class=\"line-count\">" count-display "</td>"
    "<td class=\"line-branch\"></td>"
    "<td class=\"line-src\"><pre>" (cov/html-escape source) "</pre></td>"
    "</tr>\n"))
})

; --- Generate index HTML ---

(fun {generate-index-html files output-dir source-root} {
  (= {file-keys} (dict/keys files))

  ; `=` binds in the innermost frame, so a nested helper cannot append to a
  ; list owned by this frame — the writes land in the helper's own scope and
  ; vanish on return. Accumulate through a dict, which is mutated in place.
  (= {acc} (dict/new))
  (dict/set! acc "c" {})
  (dict/set! acc "valk" {})

  ; Generate per-file pages and categorize
  (fun {*gen-files* keys} {
    (if (== keys nil) {}
      {do
        (= {filepath} (head keys))
        (= {fc} (dict/get files filepath))
        (if (== (cov/lines-found fc) 0)
          {(*gen-files* (tail keys))}
          {do
            (= {rel} (if (str/starts-with? filepath source-root)
              {(str/slice filepath (+ (len source-root) 1) (len filepath))}
              {filepath}))
            ; A leading "/" means the path never resolved under source-root:
            ; the transient scripts test_build writes to /tmp land here, and
            ; their sources are gone by the time the report is read.
            (if (or (or (or (or (or (or (str/starts-with? rel "runtime/test/")
                                        (str/starts-with? rel "lsp/test/"))
                                    (str/starts-with? rel "runtime/vendor/"))
                                (str/starts-with? rel "examples/"))
                            (str/starts-with? rel "scripts/"))
                        (str/ends-with? rel ".h"))
                    (str/starts-with? rel "/"))
              {(*gen-files* (tail keys))}
              {do
                (= {link} (generate-file-html fc output-dir source-root))
                (= {entry} (list :rel rel :fc fc :link link))
                (= {bucket} (if (str/ends-with? filepath ".valk") {"valk"} {"c"}))
                (dict/set! acc bucket (join (dict/get acc bucket) (list entry)))
                (*gen-files* (tail keys))})})})
  })
  (*gen-files* file-keys)
  (= {c-files} (dict/get acc "c"))
  (= {valk-files} (dict/get acc "valk"))

  ; Compute totals
  (= {c-lf} (*sum-entries* c-files cov/lines-found 0))
  (= {c-lh} (*sum-entries* c-files cov/lines-hit 0))
  (= {c-pct} (cov/pct-tenths c-lh c-lf))
  (= {c-bf} (*sum-entries* c-files cov/branches-found 0))
  (= {c-bh} (*sum-entries* c-files cov/branches-hit 0))
  (= {c-bpct} (cov/pct-tenths c-bh c-bf))

  (= {v-ef} (*sum-entries* valk-files cov/exprs-found 0))
  (= {v-eh} (*sum-entries* valk-files cov/exprs-hit 0))
  (= {v-pct} (cov/pct-tenths v-eh v-ef))
  (= {v-bf} (*sum-entries* valk-files cov/branches-found 0))
  (= {v-bh} (*sum-entries* valk-files cov/branches-hit 0))

  (= {total-bf} (+ c-bf v-bf))
  (= {total-bh} (+ c-bh v-bh))
  (= {total-bpct} (cov/pct-tenths total-bh total-bf))

  (= {c-count} (len c-files))
  (= {v-count} (len valk-files))

  (= {fh} (file/open (str output-dir "/index.html") "w"))
  (file/write fh (str "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    "<meta charset=\"UTF-8\">\n"
    "<title>Valkyria Coverage Report</title>\n"
    "<style>\n"
    ":root { --bg: #1a1a2e; --bg-alt: #16213e; --card-bg: #0f3460; --text: #eee; --text-muted: #888; --border: #333; }\n"
    "* { box-sizing: border-box; }\n"
    "body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 20px; }\n"
    ".container { max-width: 1400px; margin: 0 auto; }\n"
    "h1 { margin: 0 0 30px 0; font-size: 2em; }\n"
    ".summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 40px; }\n"
    ".card { background: var(--card-bg); border-radius: 12px; padding: 25px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }\n"
    ".card h2 { margin: 0 0 20px 0; font-size: 1.2em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }\n"
    ".big-stat { font-size: 3.5em; font-weight: bold; line-height: 1; }\n"
    ".stat-detail { color: var(--text-muted); margin-top: 10px; font-size: 0.9em; }\n"
    ".coverage-bar { height: 12px; background: #333; border-radius: 6px; margin-top: 15px; overflow: hidden; }\n"
    ".coverage-fill { height: 100%; border-radius: 6px; }\n"
    ".cov-high { color: #4caf50; } .cov-med { color: #ff9800; } .cov-low { color: #f44336; }\n"
    ".section { background: var(--bg-alt); border-radius: 12px; padding: 25px; margin-bottom: 30px; }\n"
    ".section h2 { margin: 0 0 20px 0; }\n"
    "table { width: 100%; border-collapse: collapse; }\n"
    "th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid var(--border); }\n"
    "th { color: var(--text-muted); font-weight: 600; font-size: 0.85em; text-transform: uppercase; }\n"
    "tr:hover { background: rgba(255,255,255,0.03); }\n"
    "a { color: #64b5f6; text-decoration: none; } a:hover { text-decoration: underline; }\n"
    ".mini-bar { width: 100px; height: 6px; background: #333; border-radius: 3px; overflow: hidden; }\n"
    ".mini-fill { height: 100%; border-radius: 3px; background: currentColor; }\n"
    ".timestamp { text-align: center; color: var(--text-muted); font-size: 0.85em; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border); }\n"
    ".empty { color: var(--text-muted); font-style: italic; padding: 40px; text-align: center; }\n"
    "</style>\n</head>\n<body>\n"
    "<div class=\"container\">\n"
    "<h1>Valkyria Coverage Report</h1>\n"
    "<div class=\"summary\">\n"))

  (file/write fh (str "<div class=\"card\"><h2>Runtime</h2>\n"
    "<div class=\"big-stat " (cov-class c-pct) "\">" (cov/fmt-pct c-pct) "</div>\n"
    "<div class=\"stat-detail\">" c-lh " / " c-lf " lines</div>\n"
    "<div class=\"coverage-bar\"><div class=\"coverage-fill\" style=\"width:" (/ c-pct 10) "%;background:" (cov-color c-pct) "\"></div></div>\n"
    "</div>\n"))

  (file/write fh (str "<div class=\"card\"><h2>Stdlib</h2>\n"
    "<div class=\"big-stat " (cov-class v-pct) "\">" (cov/fmt-pct v-pct) "</div>\n"
    "<div class=\"stat-detail\">" v-eh " / " v-ef " exprs</div>\n"
    "<div class=\"coverage-bar\"><div class=\"coverage-fill\" style=\"width:" (/ v-pct 10) "%;background:" (cov-color v-pct) "\"></div></div>\n"
    "</div>\n"))

  (file/write fh (str "<div class=\"card\"><h2>Branches</h2>\n"
    "<div class=\"big-stat " (cov-class total-bpct) "\">" (cov/fmt-pct total-bpct) "</div>\n"
    "<div class=\"stat-detail\">" total-bh " / " total-bf " branches</div>\n"
    "<div class=\"coverage-bar\"><div class=\"coverage-fill\" style=\"width:" (/ total-bpct 10) "%;background:" (cov-color total-bpct) "\"></div></div>\n"
    "</div>\n"))

  (file/write fh "</div>\n")

  ; Runtime files table
  (file/write fh (str "<div class=\"section\">\n<h2>Runtime Files (" c-count ")</h2>\n"))
  (if (> c-count 0)
    {do
      (file/write fh "<table><thead><tr><th>File</th><th>Lines</th><th>Branches</th><th>L Hit/Total</th><th>B Hit/Total</th><th></th></tr></thead><tbody>\n")
      (*file-table-rows* fh c-files 0)
      (file/write fh "</tbody></table>\n")}
    {(file/write fh "<div class=\"empty\">No Runtime coverage data available</div>\n")})
  (file/write fh "</div>\n")

  ; Stdlib files table
  (file/write fh (str "<div class=\"section\">\n<h2>Stdlib Files (" v-count ")</h2>\n"))
  (if (> v-count 0)
    {do
      (file/write fh "<table><thead><tr><th>File</th><th>Exprs</th><th>Branches</th><th>E Hit/Total</th><th>B Hit/Total</th><th></th></tr></thead><tbody>\n")
      (*file-table-rows* fh valk-files 1)
      (file/write fh "</tbody></table>\n")}
    {(file/write fh "<div class=\"empty\">No Stdlib coverage data available</div>\n")})
  (file/write fh "</div>\n")

  (file/write fh (str "<div class=\"timestamp\">Generated: " ts "</div>\n"
    "</div>\n</body></html>\n"))
  (file/close fh)
})

(fun {*sum-entries* entries stat-fn acc} {
  (if (== entries nil) {acc}
    {do
      (= {fc} (plist/get (head entries) :fc))
      (*sum-entries* (tail entries) stat-fn (+ acc (stat-fn fc)))})
})

(fun {*file-table-rows* fh entries is-valk} {
  (if (== entries nil) {}
    {do
      (= {entry} (head entries))
      (= {rel} (plist/get entry :rel))
      (= {fc} (plist/get entry :fc))
      (= {link} (plist/get entry :link))
      (= {pct} (if (and (== is-valk 1) (> (cov/exprs-found fc) 0))
        {(cov/expr-pct fc)}
        {(cov/line-pct fc)}))
      (= {bpct} (cov/branch-pct fc))
      (= {count-str} (if (and (== is-valk 1) (> (cov/exprs-found fc) 0))
        {(str (cov/exprs-hit fc) "/" (cov/exprs-found fc))}
        {(str (cov/lines-hit fc) "/" (cov/lines-found fc))}))
      (file/write fh (str "<tr>"
        "<td><a href=\"" link "\">" (cov/html-escape rel) "</a></td>"
        "<td class=\"" (cov-class pct) "\">" (cov/fmt-pct pct) "</td>"
        "<td class=\"" (cov-class bpct) "\">" (cov/fmt-pct bpct) "</td>"
        "<td>" count-str "</td>"
        "<td>" (cov/branches-hit fc) "/" (cov/branches-found fc) "</td>"
        "<td><div class=\"mini-bar\"><div class=\"mini-fill " (cov-class pct) "\" style=\"width:" (/ pct 10) "%\"></div></div></td>"
        "</tr>\n"))
      (*file-table-rows* fh (tail entries) is-valk)})
})

; --- Prune old runs ---

(fun {prune-old-runs base-dir max-keep} {
  (if (not (file/exists? base-dir)) {}
    {do
      (= {r} (exec "sh" "-c"
        (str "find '" base-dir "' -maxdepth 1 -mindepth 1 -type d -printf '%T@ %f\\n' | sort -n | head -n -" (str max-keep) " | cut -d' ' -f2-")))
      (if (!= (plist/get r :exit-code) 0) {}
        {do
          (= {to-rm} (filter (\ {s} {(> (len s) 0)}) (str/split (plist/get r :stdout) "\n")))
          (map (\ {d} {(exec "rm" "-rf" (str base-dir "/" d))}) to-rm)})})
})

; --- Main ---

(print "\nGenerating HTML report...")
(generate-index-html files output-dir source-root)
(printf "  HTML: %s/index.html\n" output-dir)

(if (== gen-xml 1)
  {do
    (= {xml-path} (str output-dir "/coverage.xml"))
    (print "\nGenerating Cobertura XML report...")
    (generate-cobertura-xml files xml-path source-root)
    (printf "  XML: %s\n" xml-path)}
  {})

; Symlink latest -> this run
(= {latest} (str output-base "/latest"))
(if (file/exists? latest) {(file/delete latest)} {})
(symlink ts latest)

; Prune old dirs
(prune-old-runs output-base MAX_COVERAGE_DIRS)

; Print summary
(= {rt} (cov/filter-runtime-files files source-root))
(= {sl} (cov/filter-stdlib-files files source-root))
(= {rt-lf} (cov/sum-stat rt cov/lines-found))
(= {rt-lh} (cov/sum-stat rt cov/lines-hit))
(= {sl-ef} (cov/sum-stat sl cov/exprs-found))
(= {sl-eh} (cov/sum-stat sl cov/exprs-hit))
(= {all-bf} (+ (cov/sum-stat rt cov/branches-found) (cov/sum-stat sl cov/branches-found)))
(= {all-bh} (+ (cov/sum-stat rt cov/branches-hit) (cov/sum-stat sl cov/branches-hit)))

(print "")
(print "============================================================")
(print "Coverage Summary:")
(printf "  Runtime:  %s lines (%d/%d)\n" (cov/fmt-pct (cov/pct-tenths rt-lh rt-lf)) rt-lh rt-lf)
(printf "  Stdlib:   %s exprs (%d/%d)\n" (cov/fmt-pct (cov/pct-tenths sl-eh sl-ef)) sl-eh sl-ef)
(printf "  Branches: %s (%d/%d)\n" (cov/fmt-pct (cov/pct-tenths all-bh all-bf)) all-bh all-bf)
(print "============================================================")
(printf "\nOpen %s/latest/index.html in a browser to view the report.\n" output-base)

; --- Coverage Gate Check ---

(def {REQ_LINE} 900)
(def {REQ_BRANCH} 850)
(def {REQ_EXPR} 900)

; Blocked-file exceptions live in coverage_common.valk (cov/KNOWN_BLOCKED),
; shared with check-coverage.valk.

(print "")
(print "================================================================================")
(print "COVERAGE GATE CHECK")
(print "================================================================================")
(printf "Runtime (src/*.c):    %s line, %s branch\n" (cov/fmt-pct REQ_LINE) (cov/fmt-pct REQ_BRANCH))
(printf "Stdlib (stdlib/*.valk):  %s expr, %s branch\n" (cov/fmt-pct REQ_EXPR) (cov/fmt-pct REQ_BRANCH))
(print "")

(= {gate-results} (dict/new))
(dict/set! gate-results "failures" {})
(dict/set! gate-results "passes" {})
(dict/set! gate-results "blocked" {})

(fun {gate-add! bucket line} {
  (dict/set! gate-results bucket (join (dict/get gate-results bucket) (list line)))
})

(fun {*check-runtime* keys} {
  (if (== keys nil) {}
    {do
      (= {rel} (head keys))
      (= {fc} (dict/get rt rel))
      (= {filename} (if (str/starts-with? rel "runtime/src/") {(str/slice rel 12 (len rel))} {rel}))
      (= {line-pct} (cov/line-pct fc))
      (= {branch-pct} (cov/branch-pct fc))
      (= {line-pass} (>= line-pct REQ_LINE))
      (= {branch-pass} (>= branch-pct REQ_BRANCH))
      (= {status} (if (and line-pass branch-pass) {"V"} {"X"}))
      (= {line} (str "  " filename " " status "  " (cov/fmt-pct line-pct) " line, " (cov/fmt-pct branch-pct) " branch"))
      (if (or (not line-pass) (not branch-pass))
        {do
          (= {gaps} "")
          (if (not line-pass)
            {(= {gaps} (str gaps (cov/fmt-pct (- REQ_LINE line-pct)) " line"))}
            {})
          (if (not branch-pass)
            {(= {gaps} (str gaps (if (> (len gaps) 0) {", "} {""}) (cov/fmt-pct (- REQ_BRANCH branch-pct)) " branch"))}
            {})
          (= {line} (str line "  (-" gaps ")"))
          (= {reason} (cov/is-blocked rel))
          (if (!= reason nil)
            {do
              (= {line} (str line "  [BLOCKED: " reason "]"))
              (gate-add! "blocked" line)}
            {(gate-add! "failures" line)})}
        {(gate-add! "passes" line)})
      (*check-runtime* (tail keys))})
})
(*check-runtime* (dict/keys rt))

(fun {*check-stdlib* keys} {
  (if (== keys nil) {}
    {do
      (= {rel} (head keys))
      (= {fc} (dict/get sl rel))
      (= {filename} rel)
      (= {expr-pct} (cov/expr-pct fc))
      (= {branch-pct} (cov/branch-pct fc))
      (= {expr-pass} (>= expr-pct REQ_EXPR))
      (= {branch-pass} (>= branch-pct REQ_BRANCH))
      (= {status} (if (and expr-pass branch-pass) {"V"} {"X"}))
      (= {line} (str "  " filename " " status "  " (cov/fmt-pct expr-pct) " expr, " (cov/fmt-pct branch-pct) " branch"))
      (if (or (not expr-pass) (not branch-pass))
        {do
          (= {gaps} "")
          (if (not expr-pass)
            {(= {gaps} (str gaps (cov/fmt-pct (- REQ_EXPR expr-pct)) " expr"))}
            {})
          (if (not branch-pass)
            {(= {gaps} (str gaps (if (> (len gaps) 0) {", "} {""}) (cov/fmt-pct (- REQ_BRANCH branch-pct)) " branch"))}
            {})
          (= {line} (str line "  (-" gaps ")"))
          (= {reason} (cov/is-blocked rel))
          (if (!= reason nil)
            {do
              (= {line} (str line "  [BLOCKED: " reason "]"))
              (gate-add! "blocked" line)}
            {(gate-add! "failures" line)})}
        {(gate-add! "passes" line)})
      (*check-stdlib* (tail keys))})
})
(*check-stdlib* (dict/keys sl))

(= {gate-failures} (dict/get gate-results "failures"))
(= {gate-passes} (dict/get gate-results "passes"))
(= {gate-blocked} (dict/get gate-results "blocked"))

(if (> (len gate-failures) 0)
  {do (print "FAILING FILES:")
      (map (\ {l} {println l}) gate-failures)
      (print "")}
  {})

(if (> (len gate-blocked) 0)
  {do (print "BLOCKED FILES (documented exceptions):")
      (map (\ {l} {println l}) gate-blocked)
      (print "")}
  {})

(print "================================================================================")
(= {blocked-msg} (if (> (len gate-blocked) 0) {(str ", " (len gate-blocked) " blocked")} {""}))
(printf "Results: %d passing, %d failing%s\n" (len gate-passes) (len gate-failures) blocked-msg)

(if (== (len gate-failures) 0)
  {(print "V ALL COVERAGE REQUIREMENTS MET")}
  {do
    (print "X COVERAGE REQUIREMENTS NOT MET")
    (printf "\nAll runtime code in src/ requires %s line, %s branch.\n" (cov/fmt-pct REQ_LINE) (cov/fmt-pct REQ_BRANCH))})
(print "================================================================================")

(if (> (len gate-failures) 0) {(exit 1)} {})
