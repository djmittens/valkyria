; valk-check — workspace diagnostics
;
; Usage: build/valk check/valk-check.valk -- [dir]
;        make check [DIR=path]
;
; Runs the full LSP validator on all tracked .valk files:
;   - Parse errors
;   - Undefined symbols/functions
;   - Arity mismatches (special forms + user functions)
;   - Argument type mismatches vs sig
;   - Constructor field validation
;   - Type accessor validation
;   - Unknown types in sig declarations
;   - Match pattern field count
;   - Division by literal zero

(load "symdb/symdb.valk")
(load "symdb/validate.valk")

(module check)

(fun {eprintln s} {stderr/write (str s "\n")})

; === Find .valk files via git ===

(fun {find-files dir} {do
  (= {r} (exec "git" "ls-files" "--full-name" "*.valk" "**/*.valk"))
  (if (!= r:exit-code 0)
    {do (eprintln (str "valk-check: git ls-files failed: " r:stderr))
        nil}
    {do
      (= {all} (filter (\ {f} {> (len f) 0}) (str/split r:stdout "\n")))
      (if (== dir ".")
        {all}
        {filter (\ {f} {str/starts-with? f dir}) all})})
})

; === Ignore list ===

(fun {load-ignore-list} {do
  (= {text} (read-file ".valkcheckignore"))
  (if (error? text) {(dict/new)}
    {dict/from-keys
      (filter (\ {l} {if (> (len l) 0) {not (== (str/slice l 0 1) "#")} {0}})
        (str/split text "\n"))})
})

(def {IGNORED} (load-ignore-list))

(fun {ignored? path} {dict/has? IGNORED path})

; === Diagnostic formatting ===

(fun {severity-str sev} {
  if (== sev 1) {"error"}
  {if (== sev 2) {"warning"}
    {"info"}}
})

(fun {print-diag path d} {
  eprintln (str path ":" d:line ":" d:col ": "
    (severity-str d:severity) ": " d:message)
})

(fun {print-diags path diags} {
  if (nil? diags) {nil}
  {do (print-diag path (head diags))
      (print-diags path (tail diags))}
})

(fun {count-severity diags sev} {
  if (nil? diags) {0}
  {if (error? diags) {0}
    {do
      (= {d} (head diags))
      (= {s} (if (error? d) {-1} {d:severity}))
      (= {s} (if (error? s) {-1} {s}))
      (+ (if (== s sev) {1} {0})
         (count-severity (tail diags) sev))}}
})

; === Phase 1: Sync all files into symdb (using compiler pipeline) ===

(fun {sync-light db uri text hash ast} {do
  (= {path} (symdb/uri->path uri))
  (sqlite/exec db
    "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
    path hash)
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (not (nil? file-id)) {lsp/index-ast db file-id ast text 1} {})
})

; 80 spaces — used to pad progress lines so partial \r overwrites don't leave
; tails of previous longer messages behind.
(def {SPACES80}
  "                                                                                ")

(fun {spaces n} {
  if (<= n 0) {""}
    {if (>= n 80) {SPACES80}
      {str/slice SPACES80 0 n}}
})

; Progress line. Pad to 80 chars so partial overwrites via \r don't leave
; tails of the previous longer message behind. Truncate long paths to fit.
(fun {progress label i total path} {do
  (= {short} (if (> (len path) 50) {str "…" (str/slice path (- (len path) 49) (len path))} {path}))
  (= {msg} (str "\r  [" i "/" total "] " label " " short))
  (= {pad} (- 80 (len msg)))
  (stderr/write (str msg (spaces pad)))
})

(fun {progress-clear} {do
  (stderr/write "\r")
  (stderr/write SPACES80)
  (stderr/write "\r")
})

; Returns the stored hash for a file, or nil if not present.
; sqlite/query-value raises on 0 rows; swallow that to nil.
(fun {stored-hash db path} {do
  (= {r} (sqlite/query-value db "SELECT hash FROM files WHERE path=?1" path))
  (if (error? r) {nil} {r})
})

; Drop a no-longer-existing file's rows so its stale symbols don't leak
; into validation of the remaining workspace.
(fun {remove-stale db path} {do
  (= {fid} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (error? fid) {nil}
    {symdb/remove-file db fid})
})

; Walk files; skip indexing work when fingerprint matches stored hash.
; Returns count of files that actually changed (needed re-indexing).
; Deleted-but-tracked files (git ls-files lists them until the deletion is
; staged) fingerprint as errors: purge them from the DB and continue —
; propagating the error here used to abort the walk and leave every
; remaining file stale, producing false diagnostics workspace-wide.
(fun {sync-walk db files total idx changed} {
  if (nil? files) {changed}
  {do
    (= {path} (head files))
    (progress "indexing" (+ idx 1) total path)
    (= {fp} (file/fingerprint path))
    (if (error? fp)
      {do
        (remove-stale db path)
        (sync-walk db (tail files) total (+ idx 1) changed)}
      {do
        (= {stored} (stored-hash db path))
        (if (and (not (nil? stored)) (== stored fp))
          {sync-walk db (tail files) total (+ idx 1) changed}
          {do
            (= {text} (read-file path))
            (if (not (error? text))
              {do
                ; compile/process derives the prefix from the file's own
                ; (module X) declaration during expansion.
                (= {ast} (compile/process text))
                (if (error? ast) {nil}
                  {do
                    (sqlite/exec db "BEGIN")
                    (sync-light db (str "file://" path) text fp ast)
                    (sqlite/exec db "COMMIT")})}
              {nil})
            (sync-walk db (tail files) total (+ idx 1) (+ changed 1))})})}
})

(fun {sync-all db files} {do
  (= {changed} (sync-walk db files (len files) 0 0))
  (progress-clear)
  changed
})

; === Phase 2: Validate all files ===

(fun {validate-all db files with-types} {do
  ; Preload db-derived caches once; reuse across all files.
  ; Without this, known-set (~26s) and arity-cache (~6s) re-query the symdb
  ; for every file — the bulk of phase-2 wall time on large workspaces.
  (= {cache} (vd/preload-caches db))
  (= {r} (validate-walk db files with-types cache (len files) 0 0 0 0))
  (progress-clear)
  r
})

; Collect HM type inference errors for a single file as warnings.
; The HM engine stores source positions as byte offsets; convert them to
; line/column using the source text before reporting.
(fun {hm-errors text ast} {do
  (= {result} (type/infer-file ast))
  (= {errors} (plist/get result :errors))
  (hm-errors-to-diags text errors)
})

(fun {hm-errors-to-diags text errors} {
  if (nil? errors) {nil}
  {do
    (= {e} (head errors))
    (= {offset} (plist/get e :line))
    (= {msg} (plist/get e :message))
    (= {pos} (if (or (nil? offset) (error? offset)) {list 0 0}
                {offset->line-col text offset}))
    (qcons (list :severity 2
                 :line (head pos)
                 :col (head (tail pos))
                 :message (str "type: " msg))
      (hm-errors-to-diags text (tail errors)))}
})

(fun {merge-diags a b} {
  if (nil? a) {b}
  {if (nil? b) {a}
    {join a b}}
})

; `parse` reports an unterminated form by returning an Error VALUE inside the
; form list, not by failing outright — the reader must stay tolerant of
; incomplete input because the LSP reparses on every keystroke. Only a
; whole-result error was being checked, so anything the reader could partially
; recover from validated clean: a truncated file from a bad merge or a partial
; write reported "all clear".
; Returns the message as a plain STRING, "" when the file is clean. It must
; not hand the error VALUE back: every ordinary builtin propagates an error
; argument, so `(nil? err)` at the call site would return the error, poison
; the enclosing `if`, and abort the walk mid-run.
(fun {first-parse-error forms} {
  (if (nil? forms) {""}
    {if (error? (head forms))
      {str (head forms)}
      {(first-parse-error (tail forms))}})
})

(fun {validate-walk db files with-types cache total idx total-lines total-errors total-warnings} {
  if (nil? files) {list :lines total-lines :errors total-errors
                        :warnings total-warnings}
  {do
    (= {path} (head files))
    (progress "validating" (+ idx 1) total path)
    (if (ignored? path)
      {validate-walk db (tail files) with-types cache total (+ idx 1)
        total-lines total-errors total-warnings}
      {do
        (= {text} (read-file path))
        (if (error? text)
          {validate-walk db (tail files) with-types cache total (+ idx 1)
            total-lines total-errors total-warnings}
          {do
            (= {lines} (+ 1 (len (str/split text "\n"))))
            (= {ast} (parse text))
            (= {perr} (if (error? ast) {(str ast)} {(first-parse-error ast)}))
            (if (> (len perr) 0)
              {do (progress-clear)
                  (eprintln (str path ":1:1: error: " perr))
                  (validate-walk db (tail files) with-types cache total (+ idx 1)
                    (+ total-lines lines) (+ total-errors 1) total-warnings)}
              {do
                (= {vd-diags} (vd/validate-cached db (symdb/canon-path path) ast text cache))
                (= {hm-diags} (if with-types {hm-errors text ast} {nil}))
                (= {diags} (if (error? vd-diags) {hm-diags}
                               {merge-diags vd-diags hm-diags}))
                (if (error? diags)
                  {do (progress-clear)
                      (eprintln (str path ": internal error: " diags))
                      (validate-walk db (tail files) with-types cache total (+ idx 1)
                        (+ total-lines lines) (+ total-errors 1) total-warnings)}
                  {do
                    (= {errs} (count-severity diags 1))
                    (= {warns} (count-severity diags 2))
                    (if (> (len diags) 0)
                      {do (progress-clear) (print-diags path diags)}
                      {nil})
                    (validate-walk db (tail files) with-types cache total (+ idx 1)
                      (+ total-lines lines) (+ total-errors errs) (+ total-warnings warns))})})})})}
})

; === Arg parsing ===
;
; Args after `--`: [--types] [dir]
;   --types  Also surface Hindley-Milner type inference warnings (opt-in;
;            HM currently has many false positives, so this is off by default)
;   dir      Directory to check (defaults to ".")

(fun {has-flag args flag} {
  if (nil? args) {0}
  {if (== (head args) flag) {1}
    {has-flag (tail args) flag}}
})

(fun {find-dir args} {
  if (nil? args) {"."}
  {if (== (head args) "--")
    {skip-flags (tail args)}
    {find-dir (tail args)}}
})

(fun {skip-flags args} {
  if (nil? args) {"."}
  {if (str/starts-with? (head args) "--")
    {skip-flags (tail args)}
    {head args}}
})

; === Main ===

(fun {main} {do
  (= {dir} (find-dir sys/argv))
  (= {with-types} (has-flag sys/argv "--types"))
  (= {files} (find-files dir))

  (if (nil? files)
    {do (eprintln "valk-check: no .valk files found") (exit 0)} {nil})

  (= {n} (len files))

  ; Phase 1: index workspace into symdb (for cross-file resolution)
  (= {db-path} ".valk/check.sqlite")
  (= {db} (symdb/init db-path))
  (eprintln (str "valk-check: indexing " n " files"))
  (= {p1-start} (time-us {}))
  (= {changed} (sync-all db files))
  (= {p1-ms} (/ (- (time-us {}) p1-start) 1000))
  (eprintln (str "  phase 1: " p1-ms " ms (" changed " changed)"))

  ; Phase 2: validate each file using full LSP checks.
  (eprintln (str "valk-check: validating " n " files"
    (if with-types {" (with HM type warnings)"} {""})))
  (= {p2-start} (time-us {}))
  (= {report} (validate-all db files with-types))
  (= {p2-ms} (/ (- (time-us {}) p2-start) 1000))
  (eprintln (str "  phase 2: " p2-ms " ms"))

  (symdb/close db)

  (eprintln "")
  (if (== report:errors 0)
    {if (== report:warnings 0)
      {eprintln (str "valk-check: " n " files, " report:lines " lines -- all clear")}
      {eprintln (str "valk-check: " n " files, " report:lines " lines, "
        report:warnings " warnings")}}
    {do
      (eprintln (str "valk-check: " n " files, " report:lines " lines, "
        report:errors " errors"
        (if (> report:warnings 0) {str ", " report:warnings " warnings"} {""})))
      (exit 1)})
})

(main)
