
; Exemptions are declared IN the file that needs them:
;
;   ; lint:allow-globals *foo* *bar*   reason
;
; anywhere in the file. Only the names listed are exempt, so a new global
; still fails even in a file that already has a marker.
;
; This used to be a table here, keyed on file path — which silently rotted
; the moment a file moved. test/test_lsp_handlers.valk was split into
; lsp/test/test_lsp_{helpers,handlers_core,handlers_db}.valk, the paths
; stopped matching, and 47 already-reviewed test spies became violations
; that failed CI. A marker in the file moves with the code, survives a
; split, and puts the justification next to what it justifies.
(fun {allow-marker lines} {
  (if (== (len lines) 0) {""}
    {do
      (= {t} (str/trim-left (head lines)))
      (if (str/starts-with? t "; lint:allow-globals")
        {t}
        {(allow-marker (tail lines))})})
})

; Space-padded so `*captured-error*` in the marker does not exempt some
; longer name that merely contains it.
(fun {marker-allows? marker var} {
  (if (== marker "") {false}
    {(str/contains? (str marker " ") (str " " var " "))})
})

; Check if line defines a global: (def {*name*} ...)
; Returns var name including stars, or "" if not a def-global pattern
(fun {extract-def-global line} {
  (= {trimmed} (str/trim-left line))
  (if (str/starts-with? trimmed ";") {""}
    {(if (not (str/contains? trimmed "(def {*")) {""}
      {do
        (= {idx} (*find-substr* trimmed "(def {*" 0))
        (if (< idx 0) {""}
          {do
            (= {start} (+ idx 6))
            (= {rest} (str/slice trimmed start (len trimmed)))
            (= {end} (*find-char* rest "}" 0))
            (if (< end 0) {""}
              {(str/slice rest 0 end)})})})})
})

(fun {*find-substr* s sub pos} {
  (if (> (+ pos (len sub)) (len s)) {-1}
    {(if (== (str/slice s pos (+ pos (len sub))) sub)
      {pos}
      {(*find-substr* s sub (+ pos 1))})})
})

(fun {*find-char* s ch pos} {
  (if (>= pos (len s)) {-1}
    {(if (== (str/slice s pos (+ pos 1)) ch)
      {pos}
      {(*find-char* s ch (+ pos 1))})})
})

; Recursively collect .valk files from a directory
(fun {collect-valk-files dir prefix} {
  (if (not (file/exists? dir)) {{}}
    {do
      (= {entries} (list-dir dir))
      (foldl (\ {acc entry} {
        (= {name} (plist/get entry :name))
        (= {type} (plist/get entry :type))
        (= {rel} (if (== prefix "") {name} {(str prefix "/" name)}))
        (= {full} (str dir "/" name))
        (if (== type "dir")
          {(join acc (collect-valk-files full rel))}
          {(if (str/contains? name ".valk")
            {(join acc (list (list :path full :rel rel)))}
            {acc})})
      }) {} entries)})
})

; Scan lines of one file for violations
(fun {scan-lines lines rel line-num marker violations} {
  (if (== (len lines) 0)
    {violations}
    {do
      (= {line} (head lines))
      (= {var-name} (extract-def-global line))
      (= {new-violations}
        (if (== var-name "")
          {violations}
          {(if (marker-allows? marker var-name)
            {violations}
            {(join violations
               (list (list :file rel :line line-num :var var-name :text line)))})}))
      (scan-lines (tail lines) rel (+ line-num 1) marker new-violations)})
})

; Scan one file
(fun {scan-file file-info} {
  (= {path} (plist/get file-info :path))
  (= {rel} (plist/get file-info :rel))
  (= {content} (read-file path))
  (if (error? content)
    {{}}
    {do
      (= {lines} (str/split content "\n"))
      (scan-lines lines rel 1 (allow-marker lines) {})})
})

; --- Main ---

(printf "================================================================================\n")
(printf "VALKYRIA GLOBAL MUTATION LINT\n")
(printf "================================================================================\n\n")

; stdlib is scanned too: it ships in every binary, so a global there is
; strictly worse than one in a test. The old allowlist already carried an
; entry for testing/test.valk even though nothing scanned stdlib —
; another symptom of the table drifting from reality.
; The linter cannot scan itself: its own pattern literals ("(def {*") are
; indistinguishable from real global defs to a line-based scanner.
(= {all-files} (filter
  (\ {f} {(!= (plist/get f :rel) "check/check-no-globals.valk")})
  (foldl (\ {acc dir} {(join acc (collect-valk-files dir dir))}) {}
    (list "runtime/src" "stdlib" "runtime/test" "testing" "symdb" "lsp"
          "quality" "coverage" "check"))))

(printf "Scanning %ld .valk files for global mutations...\n\n" (len all-files))

(= {all-violations} (foldl (\ {acc f} {(join acc (scan-file f))}) {} all-files))

(if (> (len all-violations) 0)
  {do
    (printf "VIOLATIONS FOUND:\n\n")
    (map (\ {v} {
      (printf "  %s:\n" (plist/get v :file))
      (printf "    Line %ld: %s\n" (plist/get v :line) (plist/get v :var))
      (= {text} (plist/get v :text))
      (= {show} (if (> (len text) 70) {(str (str/slice text 0 70) "...")} {text}))
      (printf "      %s\n\n" show)
    }) all-violations)
    (printf "================================================================================\n")
    (printf "FAILED: %ld global mutation(s)\n\n" (len all-violations))
    (printf "Global mutable state causes data races in concurrent code.\n")
    (printf "Pass the state explicitly, or keep it in a dict/ref owned by\n")
    (printf "one loop. If the global is genuinely safe (a spy in a\n")
    (printf "single-threaded test, say), declare it in the file itself:\n\n")
    (printf "  ; lint:allow-globals *name* *other-name*   why it is safe\n")
    (printf "================================================================================\n")
    (shutdown 1)}
  {do
    (printf "================================================================================\n")
    (printf "PASSED: No global mutation violations found in %ld files\n" (len all-files))
    (printf "================================================================================\n")
    (shutdown 0)})
