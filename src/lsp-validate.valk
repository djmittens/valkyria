; LSP Validate — Valk-native AST diagnostic validation
;
; Replaces the C `validate` builtin. Walks the AST with scope tracking,
; reports undefined symbols/functions and arity mismatches.
;
; Returns: list of plists {:line N :col N :end-col N :severity N :message S}
;
; Requires: prelude.valk, symdb.valk loaded. Needs a symdb db handle.

; ---------------------------------------------------------------------------
; Constants
; ---------------------------------------------------------------------------

(def {DIAG_ERROR}   1)
(def {DIAG_WARNING} 2)

(def {VALIDATE_SPECIAL_FORMS}
  (dict/from-keys {"=" "\\" "def" "fun" "if" "do" "select" "case" "quote"
   "load" "eval" "read" "let" "aio/let" "aio/do" "<-"
   "type" "match" "sig" "ctx/with" "ctx/with-deadline"}))

(def {VALIDATE_CONSTANTS}
  (dict/from-keys {"true" "false" "nil" "otherwise" "_"}))

; ---------------------------------------------------------------------------
; Pre-scan: collect global defs from AST (fun names, def names, type ctors)
; ---------------------------------------------------------------------------

(fun {vd/collect-globals ast} {
  vd/collect-globals-walk ast nil
})

(fun {vd/collect-globals-walk exprs acc} {
  if (nil? exprs) {acc}
  {vd/collect-globals-walk (tail exprs)
    (vd/collect-globals-one (head exprs) acc)}
})

(fun {vd/collect-globals-one expr acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {vd/collect-globals-dispatch (head expr) (tail expr) acc}}
})

(fun {vd/collect-globals-dispatch hd tl acc} {
  if (not (sym? hd)) {acc}
  {vd/collect-globals-by-form (str hd) tl acc}
})

(fun {vd/collect-globals-by-form name tl acc} {
  if (== name "fun") {vd/collect-fun-name tl acc}
  {if (== name "def") {vd/collect-def-names tl acc}
  {if (== name "type") {vd/collect-type-names tl acc}
  {if (== name "sig") {vd/collect-sig-name tl acc}
  {acc}}}}
})

(fun {vd/collect-fun-name tl acc} {
  if (nil? tl) {acc}
  {vd/collect-fun-formals (head tl) acc}
})

(fun {vd/collect-fun-formals formals acc} {
  if (not (list? formals)) {acc}
  {if (nil? formals) {acc}
  {vd/collect-fun-head (head formals) acc}}
})

(fun {vd/collect-fun-head fname acc} {
  if (sym? fname) {qcons (str fname) acc}
  {acc}
})

(fun {vd/collect-def-names tl acc} {
  if (nil? tl) {acc}
  {vd/collect-binding-names (head tl) acc}
})

(fun {vd/collect-binding-names binding acc} {
  if (list? binding) {vd/collect-binding-walk binding acc}
  {if (sym? binding) {qcons (str binding) acc}
  {acc}}
})

(fun {vd/collect-binding-walk vars acc} {
  if (nil? vars) {acc}
  {vd/collect-binding-walk (tail vars)
    (if (sym? (head vars)) {qcons (str (head vars)) acc} {acc})}
})

(fun {vd/collect-type-names tl acc} {
  if (nil? tl) {acc}
  {vd/collect-type-name-and-ctors (head tl) (tail tl) acc}
})

(fun {vd/collect-type-name-and-ctors type-name-q variants acc} {
  if (not (list? type-name-q)) {vd/collect-type-ctors variants acc}
  {if (nil? type-name-q) {vd/collect-type-ctors variants acc}
  {vd/collect-type-with-head (head type-name-q) variants acc}}
})

(fun {vd/collect-type-with-head tname variants acc} {
  if (not (sym? tname)) {vd/collect-type-ctors variants acc}
  {vd/collect-type-with-name (str tname) variants acc}
})

(fun {vd/collect-type-with-name tname-str variants acc} {
  vd/collect-type-ctors variants (qcons tname-str acc)
})

(fun {vd/collect-type-ctors variants acc} {
  if (nil? variants) {acc}
  {vd/collect-type-ctors (tail variants)
    (vd/collect-type-one-ctor (head variants) acc)}
})

(fun {vd/collect-type-one-ctor variant acc} {
  if (not (list? variant)) {acc}
  {if (nil? variant) {acc}
  {vd/collect-type-ctor-head (head variant) acc}}
})

(fun {vd/collect-type-ctor-head ctor acc} {
  if (sym? ctor) {qcons (str ctor) acc} {acc}
})

(fun {vd/collect-sig-name tl acc} {
  if (nil? tl) {acc}
  {vd/collect-sig-quoted (head tl) acc}
})

(fun {vd/collect-sig-quoted name-q acc} {
  if (list? name-q) {vd/collect-sig-inner (head name-q) acc}
  {if (sym? name-q) {qcons (str name-q) acc}
  {acc}}
})

(fun {vd/collect-sig-inner s acc} {
  if (sym? s) {qcons (str s) acc}
  {acc}
})

; ---------------------------------------------------------------------------
; Load all known symbol names from symdb (queried once, O(1) C-level lookup)
; ---------------------------------------------------------------------------

(fun {vd/load-known-set db} {
  if (nil? db) {(dict/new)}
  {do
    (= {rows} (sqlite/query db
      "SELECT DISTINCT name FROM symbols"))
    (= {d} (dict/new (len rows)))
    (vd/build-known-set rows d)}
})

(fun {vd/build-known-set rows d} {
  if (nil? rows) {d}
  {do
    (dict/put! d (plist/get (head rows) :name))
    (vd/build-known-set (tail rows) d)}
})

; ---------------------------------------------------------------------------
; Arity info from symdb
; ---------------------------------------------------------------------------

(fun {vd/lookup-arity db name} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT arity, sig FROM symbols WHERE name=?1 AND arity >= 0 LIMIT 1"
    name}
})

; ---------------------------------------------------------------------------
; Diagnostic builder
; ---------------------------------------------------------------------------

(fun {vd/make-diag text offset length severity message} {do
  (= {lc} (offset->line-col text offset))
  (= {line} (head lc))
  (= {col} (head (tail lc)))
  (list :line line :col col :end-col (+ col length)
        :severity severity :message message)
})

; ---------------------------------------------------------------------------
; Symbol checks
; ---------------------------------------------------------------------------

(fun {vd/is-accessor name} {
  if (< (len name) 2) {0}
  {vd/is-accessor-check (str/slice name 0 1) name}
})

(fun {vd/is-accessor-check first name} {
  if (< (ord first "A") 0) {0}
  {if (> (ord first "Z") 0) {0}
  {vd/has-field-colon name}}
})

(fun {vd/has-field-colon name} {do
  (= {idx} (str/index-of name ":"))
  (if (< idx 1) {0}
  {if (>= idx (- (len name) 1)) {0}
  {do
    (= {after} (str/slice name (+ idx 1) (+ idx 2)))
    (if (== after ":") {0} {1})}})
})

(fun {vd/in-scope? name scope-chain} {
  if (nil? scope-chain) {0}
  {if (dict/has? (head scope-chain) name) {1}
  {vd/in-scope? name (tail scope-chain)}}
})

(fun {vd/is-known name scope globals-set known-set} {
  if (dict/has? VALIDATE_CONSTANTS name) {1}
  {if (dict/has? VALIDATE_SPECIAL_FORMS name) {1}
  {if (vd/in-scope? name scope) {1}
  {if (dict/has? globals-set name) {1}
  {if (dict/has? known-set name) {1}
  {if (vd/is-accessor name) {1}
  {0}}}}}}
})

; ---------------------------------------------------------------------------
; Main walk dispatcher
; ---------------------------------------------------------------------------

(fun {vd/walk-body exprs ctx} {
  if (nil? exprs) {ctx}
  {vd/walk-body (tail exprs)
    (vd/walk-expr (head exprs) ctx)}
})

(fun {vd/walk-expr expr ctx} {
  if (nil? expr) {ctx}
  {if (num? expr) {ctx}
  {if (str? expr) {ctx}
  {if (sym? expr) {vd/check-sym expr ctx}
  {if (list? expr) {vd/walk-list expr ctx}
  {ctx}}}}}
})

(fun {vd/check-sym expr ctx} {
  vd/check-sym-name expr (str expr) ctx
})

(fun {vd/check-sym-name expr name ctx} {
  if (<= (len name) 0) {ctx}
  {if (== (str/slice name 0 1) ":") {ctx}
  {if (vd/is-known name (plist/get ctx :scope)
                    (plist/get ctx :globals)
                    (plist/get ctx :known)) {ctx}
  {vd/add-diag ctx expr name
    (str "Symbol '" name "' is not defined")}}}
})

(fun {vd/add-diag ctx expr name message} {
  plist/set ctx :diags
    (qcons (vd/make-diag (plist/get ctx :text)
                         (src-pos expr) (len name)
                         DIAG_ERROR message)
           (plist/get ctx :diags))
})

; ---------------------------------------------------------------------------
; List dispatch
; ---------------------------------------------------------------------------

(fun {vd/walk-list expr ctx} {
  if (nil? expr) {ctx}
  {vd/walk-list-head expr (head expr) (tail expr) ctx}
})

(fun {vd/walk-list-head expr hd tl ctx} {
  if (quoted? expr)
    {vd/walk-quoted expr hd tl ctx}
  {if (sym? hd)
    {vd/dispatch-call expr hd (str hd) tl ctx}
  {vd/walk-expr hd (vd/walk-body tl ctx)}}
})

(fun {vd/walk-quoted expr hd tl ctx} {
  if (sym? hd)
    {vd/walk-quoted-sym hd (str hd) tl ctx}
  {vd/walk-implicit-do expr ctx}
})

(fun {vd/walk-quoted-sym hd name tl ctx} {
  if (vd/is-known name (plist/get ctx :scope)
                  (plist/get ctx :globals)
                  (plist/get ctx :known))
    {vd/dispatch-call nil hd name tl ctx}
  {ctx}
})

(fun {vd/walk-implicit-do exprs ctx} {
  if (nil? exprs) {ctx}
  {vd/walk-implicit-do-next (head exprs) (tail exprs) ctx}
})

(fun {vd/walk-implicit-do-next expr rest ctx} {
  vd/walk-implicit-do rest
    (vd/maybe-thread-binding expr (vd/walk-expr expr ctx))
})

(fun {vd/maybe-thread-binding expr ctx} {
  if (not (list? expr)) {ctx}
  {if (nil? expr) {ctx}
  {vd/check-thread-head (head expr) (tail expr) ctx}}
})

(fun {vd/check-thread-head hd tl ctx} {
  if (not (sym? hd)) {ctx}
  {if (== (str hd) "=")
    {vd/thread-binding-names tl ctx}
    {ctx}}
})

(fun {vd/thread-binding-names tl ctx} {
  if (nil? tl) {ctx}
  {vd/thread-binding-vars (head tl) ctx}
})

(fun {vd/thread-binding-vars binding ctx} {
  if (not (list? binding)) {ctx}
  {do
    (vd/dict-add-names (head (plist/get ctx :scope))
      (vd/collect-binding-names-list binding nil))
    ctx}
})

(fun {vd/dispatch-call expr hd name tl ctx} {
  if (if (> (len name) 0) {== (str/slice name 0 1) ":"} {0}) {vd/walk-body tl ctx}
  {if (== name "fun")     {vd/walk-fun tl ctx}
  {if (== name "\\")     {vd/walk-lambda tl ctx}
  {if (== name "def")    {vd/walk-binding "def" tl ctx}
  {if (== name "=")      {vd/walk-binding "=" tl ctx}
  {if (== name "type")   {vd/walk-type tl ctx}
  {if (== name "sig")    {ctx}
  {if (== name "quote")  {ctx}
  {if (== name "match")  {vd/walk-match tl ctx}
  {if (== name "aio/do") {vd/walk-aio-do tl ctx}
  {if (== name "aio/let") {vd/walk-aio-let tl ctx}
  {if (dict/has? VALIDATE_SPECIAL_FORMS name)
    {vd/walk-body tl ctx}
  {vd/walk-call expr hd name tl ctx}}}}}}}}}}}}
})

; ---------------------------------------------------------------------------
; Function call — check defined + arity
; ---------------------------------------------------------------------------

(fun {vd/walk-call expr hd name tl ctx} {do
  (= {ctx2} (vd/walk-body tl ctx))
  (= {scope} (plist/get ctx2 :scope))
  (= {globals} (plist/get ctx2 :globals))
  (= {known} (plist/get ctx2 :known))
  (if (vd/is-known name scope globals known) {ctx2}
    {vd/add-diag ctx2 hd name
      (str "Function '" name "' is not defined")})
})

; ---------------------------------------------------------------------------
; (fun {name params...} {body...})
; ---------------------------------------------------------------------------

(fun {vd/walk-fun tl ctx} {
  if (< (len tl) 2) {vd/walk-body tl ctx}
  {vd/walk-fun-inner (head tl) (tail tl) ctx}
})

(fun {vd/walk-fun-inner formals body-rest ctx} {
  if (not (list? formals)) {vd/walk-body body-rest ctx}
  {if (nil? formals) {vd/walk-body body-rest ctx}
  {vd/walk-fun-parts (head formals) (tail formals) body-rest ctx}}
})

(fun {vd/walk-fun-parts fname params body-rest ctx} {do
  (= {ctx2} (if (sym? fname)
    {vd/add-global ctx (str fname)}
    {ctx}))
  (= {param-names} (vd/collect-param-names params nil))
  (= {saved-scope} (plist/get ctx2 :scope))
  (= {local-dict} (dict/from-keys param-names))
  (= {ctx3} (plist/set ctx2 :scope (qcons local-dict saved-scope)))
  (= {ctx4} (vd/walk-annotated-body params body-rest ctx3))
  (plist/set ctx4 :scope saved-scope)
})

(fun {vd/add-global ctx name} {do
  (dict/put! (plist/get ctx :globals) name)
  ctx
})

(fun {vd/dict-add-names d names} {
  if (nil? names) {d}
  {do
    (dict/put! d (head names))
    (vd/dict-add-names d (tail names))}
})

; ---------------------------------------------------------------------------
; (\ {params...} {body...})
; ---------------------------------------------------------------------------

(fun {vd/walk-lambda tl ctx} {
  if (< (len tl) 2) {vd/walk-body tl ctx}
  {vd/walk-lambda-inner (head tl) (tail tl) ctx}
})

(fun {vd/walk-lambda-inner formals body-rest ctx} {do
  (= {param-names} (if (list? formals)
    {vd/collect-param-names formals nil}
    {nil}))
  (= {saved-scope} (plist/get ctx :scope))
  (= {local-dict} (dict/from-keys param-names))
  (= {ctx2} (plist/set ctx :scope (qcons local-dict saved-scope)))
  (= {ctx3} (vd/walk-annotated-body formals body-rest ctx2))
  (plist/set ctx3 :scope saved-scope)
})

; Walk body, skipping :: and -> type annotations in formals
(fun {vd/walk-annotated-body formals body-rest ctx} {
  vd/walk-body body-rest ctx
})

; ---------------------------------------------------------------------------
; (def {vars} vals) / (= {vars} vals)
; ---------------------------------------------------------------------------

(fun {vd/walk-binding form tl ctx} {
  if (nil? tl) {ctx}
  {vd/walk-binding-inner form (head tl) (tail tl) ctx}
})

(fun {vd/walk-binding-inner form binding vals ctx} {do
  (= {names} (vd/collect-binding-names-list binding nil))
  (= {ctx2} (if (== form "def")
    {do (vd/dict-add-names (plist/get ctx :globals) names) ctx}
    {do (vd/dict-add-names (head (plist/get ctx :scope)) names) ctx}))
  (vd/walk-body vals ctx2)
})

(fun {vd/collect-binding-names-list binding acc} {
  if (not (list? binding)) {
    if (sym? binding) {qcons (str binding) acc} {acc}}
  {if (nil? binding) {acc}
  {vd/collect-binding-names-list (tail binding)
    (if (sym? (head binding)) {qcons (str (head binding)) acc} {acc})}}
})

; ---------------------------------------------------------------------------
; (type {Name params} {Ctor ...} ...)
; ---------------------------------------------------------------------------

(fun {vd/walk-type tl ctx} {
  if (nil? tl) {ctx}
  {vd/walk-type-add-globals tl ctx}
})

(fun {vd/walk-type-add-globals tl ctx} {do
  (= {names} (vd/collect-type-names tl nil))
  (vd/dict-add-names (plist/get ctx :globals) names)
  ctx
})

; ---------------------------------------------------------------------------
; (match scrutinee {pattern body...} ...)
; ---------------------------------------------------------------------------

(fun {vd/walk-match tl ctx} {
  if (nil? tl) {ctx}
  {vd/walk-match-inner (head tl) (tail tl) ctx}
})

(fun {vd/walk-match-inner scrutinee clauses ctx} {
  vd/walk-match-clauses clauses (vd/walk-expr scrutinee ctx)
})

(fun {vd/walk-match-clauses clauses ctx} {
  if (nil? clauses) {ctx}
  {vd/walk-match-clauses (tail clauses)
    (vd/walk-match-clause (head clauses) ctx)}
})

(fun {vd/walk-match-clause clause ctx} {
  if (not (list? clause)) {ctx}
  {if (< (len clause) 2) {ctx}
  {vd/walk-match-clause-inner (head clause) (tail clause) ctx}}
})

(fun {vd/walk-match-clause-inner pattern body ctx} {do
  (= {saved-scope} (plist/get ctx :scope))
  (= {pat-names} (vd/collect-pattern-names pattern nil))
  (= {local-dict} (dict/from-keys pat-names))
  (= {ctx2} (plist/set ctx :scope (qcons local-dict saved-scope)))
  (= {ctx3} (vd/walk-body body ctx2))
  (plist/set ctx3 :scope saved-scope)
})

(fun {vd/collect-pattern-names pattern acc} {
  if (sym? pattern)
    {vd/collect-pattern-sym (str pattern) acc}
  {if (list? pattern)
    {vd/collect-pattern-list pattern acc}
  {acc}}
})

(fun {vd/collect-pattern-sym name acc} {
  if (== name "_") {acc}
  {if (== (str/slice name 0 1) ":") {acc}
  {qcons name acc}}
})

(fun {vd/collect-pattern-list pattern acc} {
  if (nil? pattern) {acc}
  {vd/collect-pattern-list-inner (head pattern) (tail pattern) acc}
})

(fun {vd/collect-pattern-list-inner hd tl acc} {
  vd/collect-pattern-args tl acc
})

(fun {vd/collect-pattern-args args acc} {
  if (nil? args) {acc}
  {vd/collect-pattern-args (tail args)
    (vd/collect-pattern-names (head args) acc)}
})

; ---------------------------------------------------------------------------
; (aio/do {stmt...})
; ---------------------------------------------------------------------------

(fun {vd/walk-aio-do tl ctx} {
  if (nil? tl) {ctx}
  {vd/walk-aio-do-body (head tl) ctx}
})

(fun {vd/walk-aio-do-body body ctx} {
  if (not (list? body)) {vd/walk-expr body ctx}
  {do
    (= {saved-scope} (plist/get ctx :scope))
    (= {ctx2} (plist/set ctx :scope (qcons (dict/new) saved-scope)))
    (= {ctx3} (vd/walk-aio-do-stmts body ctx2))
    (plist/set ctx3 :scope saved-scope)}
})

(fun {vd/walk-aio-do-stmts stmts ctx} {
  if (nil? stmts) {ctx}
  {vd/walk-aio-do-stmts (tail stmts)
    (vd/walk-aio-do-stmt (head stmts) ctx)}
})

(fun {vd/walk-aio-do-stmt stmt ctx} {
  if (not (list? stmt)) {vd/walk-expr stmt ctx}
  {vd/walk-aio-do-check-bind stmt ctx}
})

(fun {vd/walk-aio-do-check-bind stmt ctx} {
  if (< (len stmt) 3) {vd/walk-expr stmt ctx}
  {vd/walk-aio-do-bind-check (head stmt) (head (tail stmt)) (tail (tail stmt)) ctx}
})

(fun {vd/walk-aio-do-bind-check var arrow rest ctx} {
  if (not (sym? var)) {vd/walk-expr var (vd/walk-expr arrow (vd/walk-body rest ctx))}
  {if (not (sym? arrow)) {vd/walk-expr var (vd/walk-expr arrow (vd/walk-body rest ctx))}
  {if (== (str arrow) "<-")
    {vd/walk-aio-do-bind (str var) rest ctx}
    {vd/walk-expr var (vd/walk-expr arrow (vd/walk-body rest ctx))}}}
})

(fun {vd/walk-aio-do-bind name rest ctx} {do
  (= {ctx2} (vd/walk-body rest ctx))
  (if (== name "_") {ctx2}
    {do (dict/put! (head (plist/get ctx2 :scope)) name) ctx2})
})

; ---------------------------------------------------------------------------
; (aio/let {bindings...} body...)
; ---------------------------------------------------------------------------

(fun {vd/walk-aio-let tl ctx} {
  if (nil? tl) {ctx}
  {vd/walk-aio-let-inner (head tl) (tail tl) ctx}
})

(fun {vd/walk-aio-let-inner bindings body-rest ctx} {
  if (not (list? bindings)) {vd/walk-body body-rest ctx}
  {do
    (= {saved-scope} (plist/get ctx :scope))
    (= {ctx2} (plist/set ctx :scope (qcons (dict/new) saved-scope)))
    (= {ctx3} (vd/walk-aio-let-bindings bindings ctx2))
    (= {ctx4} (vd/walk-body body-rest ctx3))
    (plist/set ctx4 :scope saved-scope)}
})

(fun {vd/walk-aio-let-bindings bindings ctx} {
  if (nil? bindings) {ctx}
  {vd/walk-aio-let-bindings (tail bindings)
    (vd/walk-aio-let-one (head bindings) ctx)}
})

(fun {vd/walk-aio-let-one item ctx} {
  if (sym? item)
    {if (== (str/slice (str item) 0 1) ":") {ctx} {ctx}}
  {if (list? item)
    {vd/walk-aio-let-pair item ctx}
  {ctx}}
})

(fun {vd/walk-aio-let-pair item ctx} {
  if (nil? item) {ctx}
  {vd/walk-aio-let-var (head item) (tail item) ctx}
})

(fun {vd/walk-aio-let-var var rest ctx} {
  if (not (sym? var)) {vd/walk-body rest ctx}
  {do
    (= {ctx2} (vd/walk-body rest ctx))
    (dict/put! (head (plist/get ctx2 :scope)) (str var))
    ctx2}
})

; ---------------------------------------------------------------------------
; Parameter name collection (handles & and :: annotations)
; ---------------------------------------------------------------------------

(fun {vd/collect-param-names params acc} {
  if (nil? params) {acc}
  {vd/collect-param-one (head params) (tail params) acc}
})

(fun {vd/collect-param-one p rest acc} {
  if (not (sym? p)) {vd/collect-param-names rest acc}
  {vd/collect-param-str (str p) rest acc}
})

(fun {vd/collect-param-str name rest acc} {
  if (== name "&") {vd/collect-param-names rest acc}
  {if (== name "::") {vd/skip-annotation rest acc}
  {if (== name "->") {vd/skip-annotation rest acc}
  {vd/collect-param-names rest (qcons name acc)}}}
})

(fun {vd/skip-annotation rest acc} {
  if (nil? rest) {acc}
  {vd/collect-param-names (tail rest) acc}
})

; ---------------------------------------------------------------------------
; Public entry point
; ---------------------------------------------------------------------------

(fun {vd/validate db ast text} {do
  (= {globals-set} (dict/from-keys (vd/collect-globals ast)))
  (= {known-set} (vd/load-known-set db))
  (= {ctx} (list :scope (list (dict/new))
                  :globals globals-set
                  :known known-set
                  :text text
                  :diags nil))
  (= {result} (vd/walk-body ast ctx))
  (reverse (plist/get result :diags))
})
