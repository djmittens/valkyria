; Valkyria Symbol Database — Valk library using sqlite/* builtins
; Assumes prelude.valk is already loaded.


(type {WordRange}
  {:word Str :start Num :end Num})

(type {SymInfo}
  {:name Str :kind Num :arity Num :doc Str :sig Str
   :path Str :line Num :col Num :formals Str})

; === Symbol kind constants ===
(def {SYMKIND_FUNCTION} 1)
(def {SYMKIND_VARIABLE} 2)
(def {SYMKIND_TYPE} 3)
(def {SYMKIND_CONSTRUCTOR} 4)

; === LSP SymbolKind values ===
(def {LSP_SK_FILE} 1)
(def {LSP_SK_CLASS} 5)
(def {LSP_SK_CONSTRUCTOR} 9)
(def {LSP_SK_FUNCTION} 12)
(def {LSP_SK_VARIABLE} 13)
(def {LSP_SK_CONSTANT} 14)

; === Schema ===
(def {symdb/schema-sql} "
PRAGMA journal_mode=WAL;
PRAGMA synchronous=NORMAL;

CREATE TABLE IF NOT EXISTS files (
  id INTEGER PRIMARY KEY,
  path TEXT UNIQUE NOT NULL,
  hash TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS symbols (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL,
  file_id INTEGER NOT NULL REFERENCES files(id),
  line INTEGER NOT NULL,
  col INTEGER NOT NULL,
  kind INTEGER NOT NULL,
  arity INTEGER NOT NULL DEFAULT -1,
  doc TEXT,
  sig TEXT,
  exported INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS refs (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL,
  file_id INTEGER NOT NULL REFERENCES files(id),
  line INTEGER NOT NULL,
  col INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_symbols_name ON symbols(name);
CREATE INDEX IF NOT EXISTS idx_symbols_file ON symbols(file_id);
CREATE INDEX IF NOT EXISTS idx_refs_name ON refs(name);
CREATE INDEX IF NOT EXISTS idx_refs_file ON refs(file_id);

CREATE TABLE IF NOT EXISTS nodes (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  end_pos INTEGER NOT NULL,
  type TEXT NOT NULL,
  name TEXT NOT NULL,
  context TEXT
);
CREATE INDEX IF NOT EXISTS idx_nodes_lookup ON nodes(file_id, pos, end_pos);

CREATE TABLE IF NOT EXISTS semantic_tokens (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  length INTEGER NOT NULL,
  token_type INTEGER NOT NULL,
  modifiers INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_semtok_file ON semantic_tokens(file_id, pos);

CREATE TABLE IF NOT EXISTS inlay_hints (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  label TEXT NOT NULL,
  kind INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_hints_file ON inlay_hints(file_id, pos);

CREATE TABLE IF NOT EXISTS scoped_refs (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  name TEXT NOT NULL,
  pos INTEGER NOT NULL,
  len INTEGER NOT NULL,
  scope_id INTEGER NOT NULL,
  is_def INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_scopedrefs_file ON scoped_refs(file_id, name);
CREATE INDEX IF NOT EXISTS idx_scopedrefs_scope ON scoped_refs(file_id, scope_id);

CREATE TABLE IF NOT EXISTS scopes (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  parent_pos INTEGER NOT NULL DEFAULT -1
);
CREATE INDEX IF NOT EXISTS idx_scopes_file ON scopes(file_id, pos);

CREATE TABLE IF NOT EXISTS diagnostics (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  line INTEGER NOT NULL,
  col INTEGER NOT NULL,
  end_col INTEGER NOT NULL,
  severity INTEGER NOT NULL,
  message TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_diags_file ON diagnostics(file_id);
")

; === Lifecycle ===

(def {SYMDB_VERSION} 2)

(sig 'symdb/init {-> Str Ref})
(fun {symdb/init path} {do
  (= {db} (sqlite/open path))
  (= {ver} (sqlite/query-value db "PRAGMA user_version"))
  (if (not (== ver SYMDB_VERSION))
    {do
      (sqlite/exec db "DROP TABLE IF EXISTS refs")
      (sqlite/exec db "DROP TABLE IF EXISTS symbols")
      (sqlite/exec db "DROP TABLE IF EXISTS files")
      (sqlite/exec db (str "PRAGMA user_version=" SYMDB_VERSION))}
    {})
  (sqlite/exec-script db symdb/schema-sql)
  db})

(sig 'symdb/close {-> Ref Nil})
(fun {symdb/close db} {sqlite/close db})

; === Helpers ===

(sig 'uri->path {-> Str Str})
(fun {uri->path uri} {
  if (< (len uri) 7) {uri}
    {if (== (str/slice uri 0 7) "file://")
      {str/slice uri 7 (len uri)}
      {uri}}
})

(sig 'clean-name {-> Str Str})
(fun {clean-name s} {
  str/replace (str/replace (str/replace s "}" "") ")" "") "(" ""
})

; === Doc comment extraction ===

(sig 'strip-leading-spaces {-> Str Str})
(fun {strip-leading-spaces s} {
  if (== (len s) 0) {s}
  {if (== (str/slice s 0 1) " ")
    {strip-leading-spaces (str/slice s 1 (len s))}
    {s}}
})

(sig 'strip-comment-prefix {-> Str Str})
(fun {strip-comment-prefix s} {
  if (< (len s) 2) {""}
  {if (== (str/slice s 0 2) "; ")
    {str/slice s 2 (len s)}
  {if (== (str/slice s 0 1) ";")
    {str/slice s 1 (len s)}
    {s}}}
})

(sig 'extract-doc-comment-walk {-> (List Str) Num (List Str) (List Str)})
(fun {extract-doc-comment-walk lines idx acc} {
  if (< idx 0) {acc}
  {do
    (= {line} (nth (+ idx 1) lines))
    (= {stripped} (strip-leading-spaces (str/replace line "\r" "")))
    (if (== (len stripped) 0) {acc}
    {if (== (str/slice stripped 0 1) ";")
      {extract-doc-comment-walk lines (- idx 1)
        (qcons (strip-comment-prefix stripped) acc)}
      {acc}})}
})

(sig 'extract-doc-comment {-> (List Str) Num Str})
(fun {extract-doc-comment lines def-line} {do
  (= {comments} (extract-doc-comment-walk lines (- def-line 1) nil))
  (if (nil? comments) {nil}
    {str/join comments "\n"})
})

(sig 'append-all {-> List List List})
(fun {append-all items acc} {
  if (nil? items) {acc}
    {append-all (tail items) (qcons (head items) acc)}
})



; === Position utilities ===

(sig 'pos-of-name {-> Str Str Num})
(fun {pos-of-name text name} {do
  (= {idx} (str/index-of text name))
  (if (< idx 0) {{:line 0 :col 0}}
    {do
      (= {before} (str/slice text 0 idx))
      (= {lines-before} (str/split before "\n"))
      (= {line} (- (len lines-before) 1))
      (= {last-line} (last lines-before))
      (= {col} (len last-line))
      (list :line line :col col)})
})

(sig 'is-delim {-> Str Num})
(fun {is-delim c} {
  if (== c " ") {1}
  {if (== c "(") {1}
  {if (== c ")") {1}
  {if (== c "{") {1}
  {if (== c "}") {1}
  {if (== c ";") {1}
  {if (== c "\t") {1}
  {if (== c "\n") {1}
  {if (== c "\r") {1}
  {if (== c "\"") {1}
  {if (== c "'") {1}
  {0}}}}}}}}}}}
})

(sig 'scan-word-start {-> Str Num Num})
(fun {scan-word-start s col} {
  if (<= col 0) {0}
    {do
      (= {c} (str/slice s (- col 1) col))
      (if (is-delim c) {col}
        {scan-word-start s (- col 1)})}
})

(sig 'scan-word-end {-> Str Num Num})
(fun {scan-word-end s col} {
  if (>= col (len s)) {col}
    {do
      (= {c} (str/slice s col (+ col 1)))
      (if (is-delim c) {col}
        {scan-word-end s (+ col 1)})}
})

(sig 'word-at-position {-> Str Num Num Str})
(fun {word-at-position text line col} {do
  (= {lines} (str/split text "\n"))
  (if (>= line (len lines)) {nil}
    {do
      (= {target} (nth (+ line 1) lines))
      (if (> col (len target)) {nil}
        {do
          (= {start} (scan-word-start target col))
          (= {end} (scan-word-end target col))
          (if (>= start end) {nil}
            {str/slice target start end})})})
})

(sig 'word-range-at-position {-> Str Num Num WordRange})
(fun {word-range-at-position text line col} {do
  (= {lines} (str/split text "\n"))
  (if (>= line (len lines)) {nil}
    {do
      (= {target} (nth (+ line 1) lines))
      (if (> col (len target)) {nil}
        {do
          (= {start} (scan-word-start target col))
          (= {end} (scan-word-end target col))
          (if (>= start end) {nil}
            {(WordRange :word (str/slice target start end) :start start :end end)})})})
})

; === Symbol extraction from AST ===

(sig 'symdb/extract-symbols {-> Str List})
(fun {symdb/extract-symbols text} {do
  (= {ast} (parse text))
  (if (error? ast) {nil}
    {symdb/extract-symbols-from-ast ast text})
})

(sig 'symdb/extract-symbols-from-ast {-> List Str List})
(fun {symdb/extract-symbols-from-ast ast text} {do
  (= {lines} (str/split text "\n"))
  (reverse (symdb/walk-exprs ast text lines nil))
})

(sig 'symdb/walk-exprs {-> List Str (List Str) List List})
(fun {symdb/walk-exprs exprs text lines acc} {
  if (nil? exprs) {acc}
    {do
      (= {syms} (symdb/extract-from-expr (head exprs) text lines))
      (symdb/walk-exprs (tail exprs) text lines
        (if (nil? syms) {acc} {append-all syms acc}))}
})

(sig 'symdb/extract-from-expr {-> Any Str (List Str) List})
(fun {symdb/extract-from-expr expr text lines} {do
  (if (not (list? expr)) {nil}
    {if (nil? expr) {nil}
      {do
        (= {form} (str (head expr)))
        (if (== form "fun") {symdb/extract-fun expr text lines}
        {if (== form "def") {symdb/extract-def expr text lines}
        {if (== form "type") {symdb/extract-type expr text lines}
        {if (== form "sig") {symdb/extract-sig expr text lines}
        {nil}}}})}})
})

(sig 'symdb/extract-fun {-> List Str (List Str) List})
(fun {symdb/extract-fun expr text lines} {do
  (= {binding} (head (tail expr)))
  (if (not (list? binding)) {nil}
    {do
      (= {name} (str (head binding)))
      (= {params} (tail binding))
      (= {arity} (symdb/count-params params 0))
      (= {lc} (offset->line-col text (src-pos expr)))
      (= {line} (head lc))
      (= {name-col} (+ (head (tail lc)) 6))
      (= {doc-comment} (extract-doc-comment lines line))
      (list (list :name name :line line :col name-col
                  :kind SYMKIND_FUNCTION :arity arity
                  :doc doc-comment
                  :sig (str "(fun " binding " ...)")))})
})

(sig 'symdb/count-params {-> List Num Num})
(fun {symdb/count-params params n} {
  if (nil? params) {n}
    {do
      (= {p} (str (head params)))
      (if (== p "&") {n}
      {if (== p "::") {n}
      {if (== p "->") {n}
        {symdb/count-params (tail params) (+ n 1)}}})}
})

(sig 'symdb/extract-def {-> List Str (List Str) List})
(fun {symdb/extract-def expr text lines} {do
  (= {binding} (head (tail expr)))
  (if (not (list? binding)) {nil}
    {do
      (= {name} (str (head binding)))
      (= {lc} (offset->line-col text (src-pos expr)))
      (= {line} (head lc))
      (= {name-col} (+ (head (tail lc)) 6))
      (= {doc-comment} (extract-doc-comment lines line))
      (list (list :name name :line line :col name-col
                  :kind SYMKIND_VARIABLE :arity -1
                  :doc doc-comment))})
})

(sig 'symdb/extract-type {-> List Str (List Str) List})
(fun {symdb/extract-type expr text lines} {do
  (= {type-binding} (head (tail expr)))
  (if (not (list? type-binding)) {nil}
    {do
      (= {type-name} (str (head type-binding)))
      (= {lc} (offset->line-col text (src-pos expr)))
      (= {line} (head lc))
      (= {name-col} (+ (head (tail lc)) 7))
      (= {doc-comment} (extract-doc-comment lines line))
      (= {type-sym} (list (list :name type-name :line line :col name-col
                                 :kind SYMKIND_TYPE :arity -1
                                 :doc doc-comment
                                 :sig (str "(type " type-binding " ...)"))))
      (= {ctors} (symdb/extract-ctors (tail (tail expr)) text type-name))
      (join type-sym ctors)})
})

(sig 'symdb/serialize-fields {-> List Str})
(fun {symdb/serialize-fields elems} {
  str/join (map str elems) " "
})

(sig 'symdb/extract-ctors {-> List Str Str List})
(fun {symdb/extract-ctors variants text type-name} {
  if (nil? variants) {nil}
    {do
      (= {ctor} (head variants))
      (if (not (list? ctor)) {symdb/extract-ctors (tail variants) text type-name}
        {do
          (= {first-str} (str (head ctor)))
          (= {is-product} (if (> (len first-str) 0)
            {== (str/slice first-str 0 1) ":"}
            {0}))
          (= {ctor-name} (if is-product {type-name} {first-str}))
          (= {fields} (if is-product {ctor} {(tail ctor)}))
          (= {fields-sig} (symdb/serialize-fields fields))
          (= {ctor-arity} (if is-product {(/ (len ctor) 2)} {(- (len ctor) 1)}))
          (= {lc} (offset->line-col text (src-pos (head ctor))))
          (= {line} (head lc))
          (= {col} (head (tail lc)))
          (= {sym} (list (list :name ctor-name :line line :col col
                                :kind SYMKIND_CONSTRUCTOR :arity ctor-arity
                                :doc (str type-name "::" ctor-name)
                                :sig fields-sig)))
          (join sym (symdb/extract-ctors (tail variants) text type-name))})}
})

(sig 'symdb/extract-sig {-> List Str (List Str) List})
(fun {symdb/extract-sig expr text lines} {do
  (= {name-q} (head (tail expr)))
  (= {name} (if (list? name-q) {str (head name-q)} {str name-q}))
  (= {type-q} (head (tail (tail expr))))
  (= {sig-str} (str type-q))
  (= {lc} (offset->line-col text (src-pos expr)))
  (= {line} (head lc))
  (= {col} (head (tail lc)))
  (= {doc-comment} (extract-doc-comment lines line))
  (list (list :name name :line line :col col :kind SYMKIND_FUNCTION :arity -1
              :doc doc-comment :sig sig-str :is-sig 1))
})

; === Reference extraction ===

(sig 'symdb/extract-refs {-> Str List})
(fun {symdb/extract-refs text} {do
  (= {ast} (parse text))
  (symdb/extract-refs-from-ast ast text)
})

(sig 'symdb/extract-refs-from-ast {-> List Str List})
(fun {symdb/extract-refs-from-ast ast text} {do
  (= {raw} (symdb/collect-raw-refs ast nil))
  (if (nil? raw) {nil}
    {do
      (= {refs} (reverse raw))
      (= {offsets} (map (\ {r} {r:offset}) refs))
      (= {lcs} (offsets->line-cols text offsets))
      (symdb/zip-refs-lcs refs lcs nil)})
})

(sig 'symdb/zip-refs-lcs {-> List List List List})
(fun {symdb/zip-refs-lcs refs lcs acc} {
  if (nil? refs) {reverse acc}
  {do
    (= {r} (head refs))
    (= {lc} (head lcs))
    (symdb/zip-refs-lcs (tail refs) (tail lcs)
      (qcons (list :name r:name
                   :line (head lc)
                   :col (head (tail lc))) acc))}
})

(sig 'symdb/collect-raw-refs {-> List List List})
(fun {symdb/collect-raw-refs exprs acc} {
  if (nil? exprs) {acc}
  {symdb/collect-raw-refs (tail exprs)
    (symdb/collect-raw-ref (head exprs) acc)}
})

(sig 'symdb/collect-raw-ref {-> Any List List})
(fun {symdb/collect-raw-ref expr acc} {
  if (not (list? expr)) {
    if (not (sym? expr)) {acc}
    {do
      (= {sp} (src-pos expr))
      (if (< sp 0) {acc}
        {do
          (= {name} (str expr))
          (= {c0} (str/slice name 0 1))
          (if (== c0 ":") {acc}
          {if (== name "nil") {acc}
          {if (== name "true") {acc}
          {if (== name "false") {acc}
          {if (== name "otherwise") {acc}
            {qcons (list :name name :offset sp) acc}}}}})})}
  }
  {if (nil? expr) {acc}
    {if (== (str (head expr)) "sig") {acc}
      {symdb/collect-raw-ref-children expr acc}}}
})

(sig 'symdb/collect-raw-ref-children {-> List List List})
(fun {symdb/collect-raw-ref-children expr acc} {
  if (nil? expr) {acc}
  {if (not (list? expr)) {acc}
    {symdb/collect-raw-ref-children (tail expr)
      (symdb/collect-raw-ref (head expr) acc)}}
})

; === Database operations ===

(sig 'symdb/sync-document {-> Ref Str Str Nil})
(fun {symdb/sync-document db uri text} {do
  (= {path} (uri->path uri))
  (= {mem-hash} (str "mem:" (len text)))
  (= {existing} (sqlite/query-maybe db
    "SELECT hash FROM files WHERE path=?1" path))
  (if (not (nil? existing))
    {if (== (plist/get existing :hash) mem-hash) {0}
      {do (sqlite/exec db "BEGIN")
          (symdb/sync-file-symbols db uri text mem-hash)
          (sqlite/exec db "COMMIT") 1}}
    {do (sqlite/exec db "BEGIN")
        (symdb/sync-file-symbols db uri text mem-hash)
        (sqlite/exec db "COMMIT") 1})
})

(sig 'symdb/node-span {-> Any Num})
(fun {symdb/node-span node} {
  if (sym? node) {len (str node)}
  {if (str? node) {+ (len (str node)) 2}
  {if (num? node) {len (str node)}
  {0}}}
})

(sig 'symdb/collect-nodes {-> List List List})
(fun {symdb/collect-nodes exprs acc} {
  if (nil? exprs) {acc}
  {symdb/collect-nodes (tail exprs)
    (symdb/collect-from-expr (head exprs) acc)}
})

(sig 'symdb/collect-from-expr {-> Any List List})
(fun {symdb/collect-from-expr expr acc} {
  if (not (list? expr))
    {symdb/maybe-add-node expr acc}
  {if (nil? expr) {acc}
  {symdb/collect-node-children expr acc}}
})

(sig 'symdb/collect-node-children {-> List List List})
(fun {symdb/collect-node-children expr acc} {
  if (nil? expr) {acc}
  {symdb/collect-node-children (tail expr)
    (symdb/collect-from-expr (head expr) acc)}
})

(sig 'symdb/maybe-add-node {-> Any List List})
(fun {symdb/maybe-add-node node acc} {
  if (< (src-pos node) 0) {acc}
  {do
    (= {start} (src-pos node))
    (= {nlen} (symdb/node-span node))
    (if (<= nlen 0) {acc}
      {do
        (= {ntype} (if (sym? node) {"sym"} {if (str? node) {"str"} {if (num? node) {"num"} {"?"}}}))
        (= {name} (str node))
        (qcons (list :pos start :end (+ start nlen) :type ntype :name name) acc)})}
})

(sig 'symdb/insert-nodes {-> Ref Num List Nil})
(fun {symdb/insert-nodes db file-id nodes} {
  if (nil? nodes) {nil}
  {do
    (= {n} (head nodes))
    (sqlite/exec db
      "INSERT INTO nodes (file_id, pos, end_pos, type, name) VALUES (?1, ?2, ?3, ?4, ?5)"
      file-id (plist/get n :pos) (plist/get n :end) (plist/get n :type) (plist/get n :name))
    (symdb/insert-nodes db file-id (tail nodes))}
})

(sig 'symdb/node-at-offset {-> Ref Str Num List})
(fun {symdb/node-at-offset db path offset} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT n.type, n.name, n.pos, n.end_pos, n.context FROM nodes n JOIN files f ON n.file_id=f.id WHERE f.path=?1 AND n.pos<=?2 AND n.end_pos>?2 LIMIT 1"
    path offset}
})


; ---------------------------------------------------------------------------
; Precomputed data: store semantic tokens, hints, scoped refs during indexing
; ---------------------------------------------------------------------------



(sig 'symdb/insert-semtok-batch {-> Ref Num List Nil})
(fun {symdb/insert-semtok-batch db file-id tokens} {
  if (nil? tokens) {nil}
  {if (< (len tokens) 4) {nil}
  {do
    (= {pos} (head tokens))
    (= {tlen} (nth 2 tokens))
    (= {ttype} (nth 3 tokens))
    (= {tmods} (nth 4 tokens))
    (sqlite/exec db
      "INSERT INTO semantic_tokens (file_id, pos, length, token_type, modifiers) VALUES (?1, ?2, ?3, ?4, ?5)"
      file-id pos tlen ttype tmods)
    (symdb/insert-semtok-batch db file-id (tail (tail (tail (tail tokens)))))}}
})



(sig 'symdb/insert-hint-batch {-> Ref Num List Nil})
(fun {symdb/insert-hint-batch db file-id hints} {
  if (nil? hints) {nil}
  {do
    (= {h} (head hints))
    (sqlite/exec db
      "INSERT INTO inlay_hints (file_id, pos, label, kind) VALUES (?1, ?2, ?3, ?4)"
      file-id h:offset h:label h:kind)
    (symdb/insert-hint-batch db file-id (tail hints))}
})



(sig 'symdb/insert-scoped-ref-batch {-> Ref Num List Nil})
(fun {symdb/insert-scoped-ref-batch db file-id refs} {
  if (nil? refs) {nil}
  {do
    (= {r} (head refs))
    (sqlite/exec db
      "INSERT INTO scoped_refs (file_id, name, pos, len, scope_id, is_def) VALUES (?1, ?2, ?3, ?4, ?5, ?6)"
      file-id r:name r:offset r:len r:scope-id r:is-def)
    (symdb/insert-scoped-ref-batch db file-id (tail refs))}
})

; ---------------------------------------------------------------------------
; Query functions for precomputed data
; ---------------------------------------------------------------------------

(sig 'symdb/get-semantic-tokens {-> Ref Str List})
(fun {symdb/get-semantic-tokens db path} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT pos, length, token_type, modifiers FROM semantic_tokens t JOIN files f ON t.file_id=f.id WHERE f.path=?1 ORDER BY t.pos"
    path}
})

(sig 'symdb/get-inlay-hints {-> Ref Str Num Num List})
(fun {symdb/get-inlay-hints db path start-line end-line} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT h.pos, h.label, h.kind FROM inlay_hints h JOIN files f ON h.file_id=f.id WHERE f.path=?1 ORDER BY h.pos"
    path}
})

(sig 'symdb/get-scoped-refs {-> Ref Str Str Num List})
(fun {symdb/get-scoped-refs db path name scope-id} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 AND r.scope_id=?3 ORDER BY r.pos"
    path name scope-id}
})

(sig 'symdb/get-ref-at-offset {-> Ref Str Num List})
(fun {symdb/get-ref-at-offset db path offset} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.pos<=?2 AND (r.pos+r.len)>?2 LIMIT 1"
    path offset}
})

(sig 'symdb/get-all-file-refs {-> Ref Str Str List})
(fun {symdb/get-all-file-refs db path name} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 ORDER BY r.pos"
    path name}
})

(sig 'symdb/find-scoped-def {-> Ref Str Str Num List})
(fun {symdb/find-scoped-def db path name scope-id} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 AND r.scope_id=?3 AND r.is_def=1 LIMIT 1"
    path name scope-id}
})

(sig 'symdb/insert-scopes {-> Ref Num List Nil})
(fun {symdb/insert-scopes db file-id scopes} {
  if (nil? scopes) {nil}
  {do
    (= {s} (head scopes))
    (sqlite/exec db
      "INSERT INTO scopes (file_id, pos, parent_pos) VALUES (?1, ?2, ?3)"
      file-id (plist/get s :pos) (plist/get s :parent))
    (symdb/insert-scopes db file-id (tail scopes))}
})

(sig 'symdb/find-def-in-scope-chain {-> Ref Str Str Num List})
(fun {symdb/find-def-in-scope-chain db path name scope-pos} {
  if (nil? db) {nil}
  {if (< scope-pos 0) {nil}
  {do
    (= {found} (sqlite/query-maybe db
      "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 AND r.scope_id=?3 AND r.is_def=1 LIMIT 1"
      path name scope-pos))
    (if (not (nil? found)) {found}
      {do
        (= {parent} (sqlite/query-maybe db
          "SELECT parent_pos FROM scopes s JOIN files f ON s.file_id=f.id WHERE f.path=?1 AND s.pos=?2 LIMIT 1"
          path scope-pos))
        (if (nil? parent) {nil}
          {symdb/find-def-in-scope-chain db path name (plist/get parent :parent_pos)})})}}
})

(sig 'symdb/find-field-definition {-> Ref Str Str List})
(fun {symdb/find-field-definition db field-name context} {
  if (nil? db) {nil}
  {do
    (= {ctor-name} (if (nil? context) {nil}
      {symdb/resolve-var-type db context}))
    (= {ctor} (if (nil? ctor-name)
      {sqlite/query-maybe db
        "SELECT s.name, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.kind=4 AND s.sig LIKE ?1 LIMIT 1"
        (str "%" field-name " %")}
      {sqlite/query-maybe db
        "SELECT s.name, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.kind=4 AND s.name=?1 AND s.sig LIKE ?2 LIMIT 1"
        ctor-name (str "%" field-name " %")}))
    (if (nil? ctor) {nil}
      {do
        (= {ctor-path} (plist/get ctor :path))
        (= {field-node} (sqlite/query-maybe db
          "SELECT n.pos, n.end_pos FROM nodes n JOIN files f ON n.file_id=f.id WHERE f.path=?1 AND n.type='sym' AND n.name=?2 AND n.context IS NULL LIMIT 1"
          ctor-path field-name))
        (if (nil? field-node) {nil}
          {list :pos (plist/get field-node :pos)
                :len (- (plist/get field-node :end_pos) (plist/get field-node :pos))
                :path ctor-path})})}
})

(sig 'symdb/resolve-var-type {-> Ref Str Str})
(fun {symdb/resolve-var-type db context} {
  if (nil? db) {nil}
  {if (nil? context) {nil}
  {do
    ; Check if context is directly a constructor name
    (= {direct} (sqlite/query-maybe db
      "SELECT name FROM symbols WHERE name=?1 AND kind=4 LIMIT 1"
      context))
    (if (not (nil? direct)) {context}
      {nil})}}
})




(sig 'symdb/sync-file-symbols {-> Ref Str Str Str Nil})
(fun {symdb/sync-file-symbols db uri text hash} {do
  (= {path} (uri->path uri))
  (= {ast} (parse text))
  (if (error? ast) {}
    {do
      (sqlite/exec db
        "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
        path hash)
      (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
      (sqlite/exec db "DELETE FROM symbols WHERE file_id=?1" file-id)
      (sqlite/exec db "DELETE FROM refs WHERE file_id=?1" file-id)
      (= {syms} (symdb/extract-symbols-from-ast ast text))
      (symdb/insert-symbols db file-id syms)
      (= {refs} (symdb/extract-refs-from-ast ast text))
      (symdb/insert-refs db file-id refs)
      (sqlite/exec db "DELETE FROM nodes WHERE file_id=?1" file-id)
      (= {nodes} (symdb/collect-nodes ast nil))
      (symdb/insert-nodes db file-id nodes)
      (sqlite/exec db "DELETE FROM semantic_tokens WHERE file_id=?1" file-id)
      (sqlite/exec db "DELETE FROM inlay_hints WHERE file_id=?1" file-id)
      (sqlite/exec db "DELETE FROM scoped_refs WHERE file_id=?1" file-id)})
})

(sig 'symdb/insert-symbols {-> Ref Num List Nil})
(fun {symdb/insert-symbols db file-id syms} {
  if (nil? syms) {nil}
    {do
      (= {s} (head syms))
      (= {is-sig} s:is-sig)
      (if (== is-sig 1)
        {do
          (= {existing} (sqlite/query-maybe db
            "SELECT id, doc FROM symbols WHERE file_id=?1 AND name=?2" file-id s:name))
          (if (nil? existing)
            {sqlite/exec db
              "INSERT INTO symbols (name, file_id, line, col, kind, arity, doc, sig) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)"
              s:name file-id s:line s:col
              s:kind s:arity s:doc s:sig}
            {do
              (= {new-doc} s:doc)
              (= {old-doc} existing:doc)
              (= {final-doc} (if (nil? new-doc) {old-doc} {new-doc}))
              (sqlite/exec db
                "UPDATE symbols SET sig=?1, doc=?2 WHERE id=?3"
                s:sig final-doc existing:id)})}
        {sqlite/exec db
          "INSERT INTO symbols (name, file_id, line, col, kind, arity, doc, sig) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)"
          s:name file-id s:line s:col
          s:kind s:arity s:doc s:sig})
      (symdb/insert-symbols db file-id (tail syms))}
})

(sig 'symdb/insert-refs {-> Ref Num List Nil})
(fun {symdb/insert-refs db file-id refs} {
  if (nil? refs) {nil}
    {do
      (= {stmt} (sqlite/prepare db "INSERT INTO refs (name, file_id, line, col) VALUES (?1, ?2, ?3, ?4)"))
      (symdb/insert-refs-step stmt file-id refs)
      (sqlite/finalize stmt)}
})

(sig 'symdb/insert-refs-step {-> Ref Num List Nil})
(fun {symdb/insert-refs-step stmt file-id refs} {
  if (nil? refs) {nil}
    {do
      (= {r} (head refs))
      (sqlite/bind stmt r:name file-id r:line r:col)
      (sqlite/step stmt)
      (symdb/insert-refs-step stmt file-id (tail refs))}
})

; === Query functions ===

(sig 'symdb/find-definition {-> Ref Str Any})
(fun {symdb/find-definition db name} {
  sqlite/query-maybe db
    "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND s.kind != 0 ORDER BY (CASE WHEN s.arity >= 0 THEN 0 ELSE 1 END), s.id LIMIT 1"
    name
})

(sig 'symdb/find-definitions {-> Ref Str List})
(fun {symdb/find-definitions db name} {
  sqlite/query db
    "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 ORDER BY s.id"
    name
})

(sig 'symdb/file-symbols {-> Ref Str List})
(fun {symdb/file-symbols db path} {
  sqlite/query db
    "SELECT s.name, s.line, s.col, s.kind, s.arity, s.doc FROM symbols s JOIN files f ON s.file_id=f.id WHERE f.path=?1 ORDER BY s.line, s.col"
    path
})

(sig 'symdb/search-symbols {-> Ref Str List})
(fun {symdb/search-symbols db query} {
  sqlite/query db
    "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name LIKE ?1 ORDER BY s.name LIMIT 50"
    (str "%" query "%")
})

(sig 'symdb/all-symbol-names {-> Ref List})
(fun {symdb/all-symbol-names db} {
  sqlite/query db
    "SELECT s.name, s.kind, s.doc, s.line, s.col, f.path FROM symbols s JOIN files f ON s.file_id=f.id GROUP BY s.name ORDER BY s.name LIMIT 200"
})

(sig 'symdb/completion-all {-> Ref List})
(fun {symdb/completion-all db} {
  sqlite/query db
    "SELECT name, kind, COALESCE(MAX(CASE WHEN sig LIKE '{->%' THEN sig END), MAX(sig)) as sig, MAX(doc) as doc FROM symbols GROUP BY name ORDER BY name LIMIT 200"
})

(sig 'symdb/completion-symbols {-> Ref Str List})
(fun {symdb/completion-symbols db prefix} {
  sqlite/query db
    "SELECT name, kind, COALESCE(MAX(CASE WHEN sig LIKE '{->%' THEN sig END), MAX(sig)) as sig, MAX(doc) as doc FROM symbols WHERE name LIKE ?1 GROUP BY name ORDER BY name LIMIT 100"
    (str prefix "%")
})

(sig 'symdb/find-refs {-> Ref Str List})
(fun {symdb/find-refs db name} {
  sqlite/query db
    "SELECT r.line, r.col, f.path FROM refs r JOIN files f ON r.file_id=f.id WHERE r.name=?1 ORDER BY f.path, r.line, r.col"
    name
})

(sig 'symdb/symbol-hover {-> Ref Str SymInfo})
(fun {symdb/symbol-hover db name} {do
  (= {def-row} (sqlite/query-maybe db
    "SELECT s.name, s.kind, s.arity, s.doc, s.sig, f.path, s.line, s.col FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND s.line > 0 ORDER BY s.id LIMIT 1"
    name))
  (= {sig-row} (sqlite/query-maybe db
    "SELECT s.sig, s.doc FROM symbols s WHERE s.name=?1 AND s.sig IS NOT NULL AND s.sig != '' AND s.sig LIKE '{->%' ORDER BY s.id LIMIT 1"
    name))
  (if (nil? def-row)
    {if (nil? sig-row) {nil}
      {do
        (= {fallback} (sqlite/query-maybe db
          "SELECT s.name, s.kind, s.arity, s.doc, s.sig, f.path, s.line, s.col FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 ORDER BY s.id LIMIT 1"
          name))
        (if (nil? fallback) {nil}
          {do
            (= {type-sig} (if (nil? sig-row) {nil} {sig-row:sig}))
            (= {sig-doc} (if (nil? sig-row) {nil} {sig-row:doc}))
            (= {fb-doc} fallback:doc)
            (= {final-doc} (if (nil? fb-doc) {sig-doc} {fb-doc}))
            (SymInfo fallback:name fallback:kind fallback:arity
              final-doc type-sig fallback:path fallback:line fallback:col nil)})}}
    {do
      (= {type-sig} (if (nil? sig-row) {nil} {sig-row:sig}))
      (= {formals} def-row:sig)
      (= {def-doc} def-row:doc)
      (= {sig-doc} (if (nil? sig-row) {nil} {sig-row:doc}))
      (= {final-doc} (if (nil? def-doc) {sig-doc} {def-doc}))
      (SymInfo def-row:name def-row:kind def-row:arity
        final-doc type-sig def-row:path def-row:line def-row:col formals)})
})

; === Reference counting ===

(sig 'symdb/ref-count {-> Ref Str Num})
(fun {symdb/ref-count db name} {
  sqlite/query-value db
    "SELECT COUNT(*) FROM refs WHERE name=?1" name
})

; === Stale file cleanup ===

(sig 'symdb/all-indexed-paths {-> Ref List})
(fun {symdb/all-indexed-paths db} {
  sqlite/query db "SELECT id, path FROM files"
})

(sig 'symdb/remove-file {-> Ref Num Nil})
(fun {symdb/remove-file db file-id} {do
  (sqlite/exec db "DELETE FROM symbols WHERE file_id=?1" file-id)
  (sqlite/exec db "DELETE FROM refs WHERE file_id=?1" file-id)
  (sqlite/exec db "DELETE FROM files WHERE id=?1" file-id)
})

; === LSP helpers ===

(sig 'symkind->lsp-kind {-> Num Num})
(fun {symkind->lsp-kind kind} {
  if (== kind SYMKIND_FUNCTION) {LSP_SK_FUNCTION}
  {if (== kind SYMKIND_VARIABLE) {LSP_SK_VARIABLE}
  {if (== kind SYMKIND_TYPE) {LSP_SK_CLASS}
  {if (== kind SYMKIND_CONSTRUCTOR) {LSP_SK_CONSTRUCTOR}
    {LSP_SK_VARIABLE}}}}
})
