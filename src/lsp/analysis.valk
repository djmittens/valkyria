; LSP Analysis — semantic tokens, AST walking
;
; IMPORTANT: AST nodes (parsed S-expressions) must NEVER be stored via = or def
; because those builtins call valk_resolve_symbol which resolves symbol values.
; Instead, pass AST nodes through function arguments (lambda binding is safe).
;
; Provides: sem/tokenize text -> flat integer list (LSP delta-encoded)

; ---------------------------------------------------------------------------
; Token type indices (must match legend in lsp.valk capabilities)
; ---------------------------------------------------------------------------
(def {SEM_KEYWORD}   0)
(def {SEM_FUNCTION}  1)
(def {SEM_PARAMETER} 2)
(def {SEM_VARIABLE}  3)
(def {SEM_NUMBER}    4)
(def {SEM_STRING}    5)
(def {SEM_TYPE}      6)
(def {SEM_OPERATOR}  7)
(def {SEM_PROPERTY}  8)

(def {MOD_NONE}        0)
(def {MOD_DECLARATION} 1)
(def {MOD_BUILTIN}     2)

; ---------------------------------------------------------------------------
; Classification helpers
; ---------------------------------------------------------------------------

(def {SEM_KEYWORD_SET}
  (dict/from-keys {"fun" "\\" "def" "=" "if" "match" "select" "case"
   "do" "let" "type" "sig" "load" "and" "or" "not"
   "quote" "quasiquote" "unquote" "unquote-splicing"}))

(def {SEM_OPERATOR_SET}
  (dict/from-keys {"+" "-" "*" "/" ">" "<" ">=" "<=" "==" "!=" "%" "ord"}))

; ---------------------------------------------------------------------------
; Token accumulation — flat list built with qcons (reversed)
; Each token: 4 values (offset, length, type, modifiers)
; ---------------------------------------------------------------------------

(sig 'sem/emit {-> Num Num Num Num List List})
(fun {sem/emit offset length tok-type mods acc} {
  qcons mods (qcons tok-type (qcons length (qcons offset acc)))
})

; ---------------------------------------------------------------------------
; Walk a list of expressions as code
; ---------------------------------------------------------------------------

(sig 'sem/walk-each {-> List List List List})
(fun {sem/walk-each exprs scope acc} {
  if (nil? exprs) {acc}
  {sem/walk-each (tail exprs) scope
    (sem/walk-code (head exprs) scope acc)}
})

; ---------------------------------------------------------------------------
; Core walker — walks an expression as code
; Dispatches on type. For lists, delegates to sem/walk-list.
; AST nodes are passed as function args to avoid = resolution.
; ---------------------------------------------------------------------------

(sig 'sem/walk-code {-> Any List List List})
(fun {sem/walk-code expr scope acc} {
  if (nil? expr) {acc}
  {if (num? expr)
    {sem/emit (src-pos expr) (len (str expr)) SEM_NUMBER MOD_NONE acc}
  {if (str? expr)
    {acc}
  {if (sym? expr)
    {sem/classify-sym expr scope acc}
  {if (list? expr)
    {sem/walk-list-head expr (head expr) (tail expr) scope acc}
  {acc}}}}}
})

; Classify a standalone symbol
(sig 'sem/classify-sym {-> Any List List List})
(fun {sem/classify-sym expr scope acc} {
  sem/classify-sym-str expr (str expr) scope acc
})

(sig 'sem/classify-sym-str {-> Any Str List List List})
(fun {sem/classify-sym-str expr name scope acc} {
  if (<= (len name) 0) {acc}
  {if (== (str/slice name 0 1) ":")
    {sem/emit (src-pos expr) (len name) SEM_PROPERTY MOD_NONE acc}
  {if (member? name scope)
    {sem/emit (src-pos expr) (len name) SEM_PARAMETER MOD_NONE acc}
  {sem/emit (src-pos expr) (len name) SEM_VARIABLE MOD_NONE acc}}}
})

; ---------------------------------------------------------------------------
; List dispatch — head is passed separately as a function arg
; ---------------------------------------------------------------------------

(sig 'sem/walk-list-head {-> Any Any List List List List})
(fun {sem/walk-list-head expr hd tl scope acc} {
  if (nil? tl)
    {sem/walk-code hd scope acc}
  {if (sym? hd)
    {sem/dispatch-sym-head hd (str hd) tl scope acc}
    {sem/walk-each expr scope acc}}
})

(sig 'sem/source-len {-> Str Num})
(fun {sem/source-len name} {
  if (== name "quote") {1}
  {if (== name "quasiquote") {1}
  {if (== name "unquote") {1}
  {if (== name "unquote-splicing") {2}
  {len name}}}}
})

(sig 'sem/dispatch-sym-head {-> Any Str List List List List})
(fun {sem/dispatch-sym-head hd name tl scope acc} {
  if (dict/has? SEM_KEYWORD_SET name)
    {sem/walk-keyword name hd tl scope acc}
  {if (dict/has? SEM_OPERATOR_SET name)
    {do
      (sem/walk-each tl scope
        (sem/emit (src-pos hd) (sem/source-len name) SEM_OPERATOR MOD_NONE acc))}
  {do
    (sem/walk-each tl scope
      (sem/emit (src-pos hd) (sem/source-len name) SEM_FUNCTION MOD_NONE acc))}}
})

; ---------------------------------------------------------------------------
; Keyword dispatch
; ---------------------------------------------------------------------------

(sig 'sem/walk-keyword {-> Str Any List List List List})
(fun {sem/walk-keyword name hd tl scope acc} {
  if (== name "fun")  {sem/walk-fun hd tl scope acc}
  {if (== name "\\") {sem/walk-lambda hd tl scope acc}
  {if (== name "def") {sem/walk-binding hd tl scope acc}
  {if (== name "=")   {sem/walk-binding hd tl scope acc}
  {if (== name "type") {sem/walk-type hd tl scope acc}
  {do
    (sem/walk-each tl scope
      (sem/emit (src-pos hd) (sem/source-len name) SEM_KEYWORD MOD_NONE acc))}}}}}
})

; ---------------------------------------------------------------------------
; (fun {name params...} {body})
; ---------------------------------------------------------------------------

(sig 'sem/walk-fun {-> Any List List List List})
(fun {sem/walk-fun kw args scope acc} {do
  (sem/walk-fun-with-kw kw args scope
    (sem/emit (src-pos kw) 3 SEM_KEYWORD MOD_NONE acc))
})

(sig 'sem/walk-fun-with-kw {-> Any List List List List})
(fun {sem/walk-fun-with-kw kw args scope acc} {
  if (< (len args) 2) {sem/walk-each args scope acc}
  {sem/walk-fun-formals (head args) (head (tail args)) scope acc}
})

(sig 'sem/walk-fun-formals {-> Any Any List List List})
(fun {sem/walk-fun-formals formals body scope acc} {
  if (nil? formals) {sem/walk-code body scope acc}
  {sem/walk-fun-name (head formals) (tail formals) body scope acc}
})

; Emit function name, then params, then walk body with new scope
(sig 'sem/walk-fun-name {-> Any List List List List List})
(fun {sem/walk-fun-name fname params body scope acc} {
  if (sym? fname)
    {sem/walk-fun-params params body scope
      (sem/collect-param-names params)
      (sem/emit (src-pos fname) (len (str fname)) SEM_FUNCTION MOD_DECLARATION acc)}
    {sem/walk-fun-params params body scope
      (sem/collect-param-names params) acc}
})

(sig 'sem/walk-fun-params {-> List List List List List List})
(fun {sem/walk-fun-params params body scope param-names acc} {
  sem/walk-code body (join scope param-names)
    (sem/emit-param-decls params acc)
})

; ---------------------------------------------------------------------------
; (\ {params...} {body})
; ---------------------------------------------------------------------------

(sig 'sem/walk-lambda {-> Any List List List List})
(fun {sem/walk-lambda kw args scope acc} {do
  (sem/walk-lambda-inner args scope
    (sem/emit (src-pos kw) 1 SEM_KEYWORD MOD_NONE acc))
})

(sig 'sem/walk-lambda-inner {-> List List List List})
(fun {sem/walk-lambda-inner args scope acc} {
  if (< (len args) 2) {sem/walk-each args scope acc}
  {sem/walk-lambda-body (head args) (head (tail args)) scope acc}
})

(sig 'sem/walk-lambda-body {-> List List List List List})
(fun {sem/walk-lambda-body formals body scope acc} {
  sem/walk-code body (join scope (sem/collect-param-names formals))
    (sem/emit-param-decls formals acc)
})

; ---------------------------------------------------------------------------
; (def {vars...} vals...) and (= {vars...} vals...)
; ---------------------------------------------------------------------------

(sig 'sem/walk-binding {-> Any List List List List})
(fun {sem/walk-binding kw args scope acc} {
  if (nil? args) {sem/emit (src-pos kw) (len (str kw)) SEM_KEYWORD MOD_NONE acc}
  {sem/walk-binding-inner (head args) (tail args) scope
    (sem/emit (src-pos kw) (len (str kw)) SEM_KEYWORD MOD_NONE acc)}
})

(sig 'sem/walk-binding-inner {-> List List List List List})
(fun {sem/walk-binding-inner vars vals scope acc} {
  sem/walk-each vals scope
    (sem/emit-var-decls vars acc)
})

; ---------------------------------------------------------------------------
; (type (TypeName (Ctor :field Type) ...))
; ---------------------------------------------------------------------------

(sig 'sem/walk-type {-> Any List List List List})
(fun {sem/walk-type kw args scope acc} {
  sem/walk-type-variants args
    (sem/emit (src-pos kw) 4 SEM_KEYWORD MOD_NONE acc)
})

(sig 'sem/walk-type-variants {-> List List List})
(fun {sem/walk-type-variants variants acc} {
  if (nil? variants) {acc}
  {sem/walk-type-variants (tail variants)
    (sem/walk-type-one (head variants) acc)}
})

(sig 'sem/walk-type-one {-> Any List List})
(fun {sem/walk-type-one variant acc} {
  if (list? variant)
    {sem/walk-type-inner variant acc}
  {if (sym? variant)
    {sem/emit (src-pos variant) (len (str variant)) SEM_TYPE MOD_DECLARATION acc}
  {acc}}
})

(sig 'sem/walk-type-inner {-> List List List})
(fun {sem/walk-type-inner variant acc} {
  if (nil? variant) {acc}
  {sem/walk-type-head (head variant) (tail variant) acc}
})

(sig 'sem/walk-type-head {-> Any List List List})
(fun {sem/walk-type-head hd rest acc} {
  if (sym? hd)
    {sem/walk-type-fields rest
      (sem/emit (src-pos hd) (len (str hd)) SEM_TYPE MOD_DECLARATION acc)}
    {sem/walk-type-fields rest acc}
})

(sig 'sem/walk-type-fields {-> List List List})
(fun {sem/walk-type-fields fields acc} {
  if (nil? fields) {acc}
  {sem/walk-type-fields (tail fields)
    (sem/walk-type-field (head fields) acc)}
})

(sig 'sem/walk-type-field {-> Any List List})
(fun {sem/walk-type-field f acc} {
  if (sym? f)
    {sem/walk-type-field-sym f (str f) acc}
  {if (list? f)
    {sem/walk-type-inner f acc}
    {acc}}
})

(sig 'sem/walk-type-field-sym {-> Any Str List List})
(fun {sem/walk-type-field-sym f name acc} {
  if (== (str/slice name 0 1) ":")
    {sem/emit (src-pos f) (len name) SEM_PROPERTY MOD_NONE acc}
    {sem/emit (src-pos f) (len name) SEM_TYPE MOD_NONE acc}
})

; ---------------------------------------------------------------------------
; Param/var emission helpers — walk formals lists
; ---------------------------------------------------------------------------

(sig 'sem/emit-param-decls {-> List List List})
(fun {sem/emit-param-decls params acc} {
  if (nil? params) {acc}
  {sem/emit-param-decls (tail params)
    (sem/emit-one-param (head params) acc)}
})

(sig 'sem/emit-one-param {-> Any List List})
(fun {sem/emit-one-param p acc} {
  if (sym? p)
    {sem/emit-one-param-str p (str p) acc}
    {acc}
})

(sig 'sem/emit-one-param-str {-> Any Str List List})
(fun {sem/emit-one-param-str p name acc} {
  if (== name "&") {acc}
  {sem/emit (src-pos p) (len name) SEM_PARAMETER MOD_DECLARATION acc}
})

(sig 'sem/collect-param-names {-> List List})
(fun {sem/collect-param-names params} {
  if (nil? params) {nil}
  {sem/collect-one-param (head params) (tail params)}
})

(sig 'sem/collect-one-param {-> Any List List})
(fun {sem/collect-one-param p rest} {
  if (sym? p)
    {sem/collect-one-param-str (str p) rest}
    {sem/collect-param-names rest}
})

(sig 'sem/collect-one-param-str {-> Str List List})
(fun {sem/collect-one-param-str name rest} {
  if (== name "&") {sem/collect-param-names rest}
  {qcons name (sem/collect-param-names rest)}
})

(sig 'sem/emit-var-decls {-> List List List})
(fun {sem/emit-var-decls vars acc} {
  if (nil? vars) {acc}
  {if (list? vars)
    {sem/emit-var-decls-inner vars acc}
    {acc}}
})

(sig 'sem/emit-var-decls-inner {-> List List List})
(fun {sem/emit-var-decls-inner vars acc} {
  if (nil? vars) {acc}
  {sem/emit-var-decls-inner (tail vars)
    (sem/emit-one-var (head vars) acc)}
})

(sig 'sem/emit-one-var {-> Any List List})
(fun {sem/emit-one-var v acc} {
  if (sym? v)
    {sem/emit (src-pos v) (len (str v)) SEM_VARIABLE MOD_DECLARATION acc}
    {acc}
})

; ---------------------------------------------------------------------------
; Delta encoding — provided by C builtin sem/encode-deltas
; Takes (text tokens) where tokens is list of 4-tuples (offset len type mods)
; Returns flat list of 5-tuples (deltaLine deltaCol len type mods)
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; Public API
; ---------------------------------------------------------------------------

(sig 'sem/tokenize {-> Str List})
(fun {sem/tokenize text} {do
  (sem/tokenize-ast (parse text) text)
})

(sig 'sem/tokenize-ast {-> List Str List})
(fun {sem/tokenize-ast ast text} {do
  (sem/encode-deltas text
    (list/group 4 (reverse (sem/walk-each ast nil nil))))
})

; ---------------------------------------------------------------------------
; Typed semantic token representation
; ---------------------------------------------------------------------------
; The C builtin sem/encode-deltas returns a flat integer list for the LSP wire
; format. These helpers convert between that flat encoding and typed records.

(type {SemToken}
  {:dl Num :dc Num :len Num :ttype Num :mods Num})

(sig 'sem/parse-flat {-> List List})
(fun {sem/parse-flat tokens} {
  if (nil? tokens) {nil}
  {if (< (len tokens) 5) {nil}
  {qcons (SemToken :dl    (nth 1 tokens)
                   :dc    (nth 2 tokens)
                   :len   (nth 3 tokens)
                   :ttype (nth 4 tokens)
                   :mods  (nth 5 tokens))
         (sem/parse-flat (drop 5 tokens))}}
})

(sig 'sem/flatten {-> List List})
(fun {sem/flatten tokens} {
  if (nil? tokens) {nil}
  {do
    (= {t} (head tokens))
    (qcons t:dl (qcons t:dc (qcons t:len (qcons t:ttype
      (qcons t:mods (sem/flatten (tail tokens)))))))}
})

; ---------------------------------------------------------------------------
; Scope-aware reference collection
; ---------------------------------------------------------------------------
;
; Each reference entry: {:name N :offset O :len L :scope-id S :is-def D}
; scope-id = -1 for global, or byte offset of enclosing fun/lambda for local
; Scope chain: list of {:id OFFSET :names {n1 n2 ...}}

(def {REF_KEYWORD_SET}
  (dict/from-keys {"fun" "\\" "def" "=" "if" "match" "select" "case"
   "do" "let" "and" "or" "not" "load" "sig" "type"
   "quote" "quasiquote" "unquote" "unquote-splicing"}))

(sig 'ref/resolve-scope {-> Str List Any})
(fun {ref/resolve-scope name scopes} {
  if (nil? scopes) {-1}
  {do
    (= {s} (head scopes))
    (if (member? name s:names)
      {s:id}
      {ref/resolve-scope name (tail scopes)})}
})

(sig 'ref/current-scope-id {-> List Num})
(fun {ref/current-scope-id scopes} {
  if (nil? scopes) {-1}
  {do (= {s} (head scopes)) s:id}
})

; --- Core walker ---

(sig 'ref/walk-exprs {-> List List List List})
(fun {ref/walk-exprs exprs scopes acc} {
  if (nil? exprs) {acc}
  {ref/walk-exprs (tail exprs) scopes
    (ref/walk-code (head exprs) scopes acc)}
})

(sig 'ref/walk-code {-> Any List List List})
(fun {ref/walk-code expr scopes acc} {
  if (nil? expr) {acc}
  {if (num? expr) {acc}
  {if (str? expr) {acc}
  {if (sym? expr) {ref/record-sym expr scopes acc}
  {if (list? expr) {ref/walk-list expr scopes acc}
  {acc}}}}}
})

(sig 'ref/record-sym {-> Any List List List})
(fun {ref/record-sym expr scopes acc} {
  ref/record-sym-name expr (str expr) scopes acc
})

(sig 'ref/record-sym-name {-> Any Str List List List})
(fun {ref/record-sym-name expr name scopes acc} {
  if (<= (len name) 0) {acc}
  {if (== (str/slice name 0 1) ":") {acc}
  {qcons (list :name name :offset (src-pos expr) :len (len name)
               :scope-id (ref/resolve-scope name scopes) :is-def 0) acc}}
})

(sig 'ref/walk-list {-> List List List List})
(fun {ref/walk-list expr scopes acc} {
  if (nil? expr) {acc}
  {ref/walk-list-head expr (head expr) (tail expr) scopes acc}
})

(sig 'ref/walk-list-head {-> List Any List List List List})
(fun {ref/walk-list-head expr hd tl scopes acc} {
  if (sym? hd)
    {ref/dispatch-form expr hd (str hd) tl scopes acc}
    {ref/walk-exprs expr scopes acc}
})

(sig 'ref/dispatch-form {-> List Any Str List List List List})
(fun {ref/dispatch-form expr hd name tl scopes acc} {
  if (== name "fun") {ref/walk-fun expr tl scopes acc}
  {if (== name "\\") {ref/walk-lambda expr tl scopes acc}
  {if (== name "def") {ref/walk-def tl scopes acc}
  {if (== name "=") {ref/walk-assign tl scopes acc}
  {if (== name "do") {ref/walk-do tl scopes acc}
  {if (== name "type") {ref/walk-type tl acc}
  {if (== name "sig") {acc}
   {if (dict/has? REF_KEYWORD_SET name)
    {ref/walk-exprs tl scopes acc}
    {ref/walk-exprs tl scopes
      (ref/record-sym-name hd name scopes acc)}}}}}}}}
})

; --- fun ---

(sig 'ref/walk-fun {-> List List List List List})
(fun {ref/walk-fun expr tl scopes acc} {
  if (< (len tl) 2) {ref/walk-exprs tl scopes acc}
  {ref/walk-fun-binding expr (head tl) (head (tail tl)) scopes acc}
})

(sig 'ref/walk-fun-binding {-> List Any Any List List List})
(fun {ref/walk-fun-binding expr formals body scopes acc} {
  if (nil? formals) {ref/walk-code body scopes acc}
  {ref/walk-fun-parts expr (head formals) (tail formals) body scopes acc}
})

(sig 'ref/walk-fun-parts {-> List Any List List List List List})
(fun {ref/walk-fun-parts expr fname params body scopes acc} {do
  (= {scope-id} (src-pos expr))
  (= {param-names} (ref/collect-param-names params))
  (= {new-scopes} (qcons (list :id scope-id :names param-names) scopes))
  (= {acc2} (if (sym? fname)
    {qcons (list :name (str fname) :offset (src-pos fname)
                 :len (len (str fname)) :scope-id -1 :is-def 1) acc}
    {acc}))
  (= {acc3} (ref/record-param-defs params scope-id acc2))
  (ref/walk-code body new-scopes acc3)
})

; --- lambda ---

(sig 'ref/walk-lambda {-> List List List List List})
(fun {ref/walk-lambda expr tl scopes acc} {
  if (< (len tl) 2) {ref/walk-exprs tl scopes acc}
  {ref/walk-lambda-inner expr (head tl) (head (tail tl)) scopes acc}
})

(sig 'ref/walk-lambda-inner {-> List List List List List List})
(fun {ref/walk-lambda-inner expr formals body scopes acc} {do
  (= {scope-id} (src-pos expr))
  (= {param-names} (ref/collect-param-names formals))
  (= {new-scopes} (qcons (list :id scope-id :names param-names) scopes))
  (= {acc2} (ref/record-param-defs formals scope-id acc))
  (ref/walk-code body new-scopes acc2)
})

; --- def (global) ---

(sig 'ref/walk-def {-> List List List List})
(fun {ref/walk-def tl scopes acc} {
  if (nil? tl) {acc}
  {ref/walk-def-inner (head tl) (tail tl) scopes acc}
})

(sig 'ref/walk-def-inner {-> Any List List List List})
(fun {ref/walk-def-inner binding vals scopes acc} {
  ref/walk-exprs vals scopes
    (ref/record-binding-defs binding -1 acc)
})

; --- = (local) ---

(sig 'ref/walk-assign {-> List List List List})
(fun {ref/walk-assign tl scopes acc} {
  if (nil? tl) {acc}
  {ref/walk-assign-inner (head tl) (tail tl) scopes acc}
})

(sig 'ref/walk-assign-inner {-> Any List List List List})
(fun {ref/walk-assign-inner binding vals scopes acc} {
  ref/walk-exprs vals scopes
    (ref/record-binding-defs binding (ref/current-scope-id scopes) acc)
})

; --- do (thread scope for = bindings) ---

(sig 'ref/walk-do {-> List List List List})
(fun {ref/walk-do tl scopes acc} {
  ref/walk-do-children tl scopes acc
})

(sig 'ref/walk-do-children {-> List List List List})
(fun {ref/walk-do-children exprs scopes acc} {
  if (nil? exprs) {acc}
  {ref/walk-do-one (head exprs) (tail exprs) scopes acc}
})

(sig 'ref/walk-do-one {-> Any List List List List})
(fun {ref/walk-do-one expr rest scopes acc} {do
  (= {acc2} (ref/walk-code expr scopes acc))
  (= {new-scopes} (ref/maybe-add-assign-names expr scopes))
  (ref/walk-do-children rest new-scopes acc2)
})

; --- type ---

(sig 'ref/walk-type {-> List List List})
(fun {ref/walk-type tl acc} {
  ref/walk-type-variants tl acc
})

(sig 'ref/walk-type-variants {-> List List List})
(fun {ref/walk-type-variants tl acc} {
  if (nil? tl) {acc}
  {ref/walk-type-variants (tail tl)
    (ref/walk-type-one (head tl) acc)}
})

(sig 'ref/walk-type-one {-> Any List List})
(fun {ref/walk-type-one variant acc} {
  if (list? variant)
    {ref/walk-type-list variant acc}
  {if (sym? variant)
    {qcons (list :name (str variant) :offset (src-pos variant)
                 :len (len (str variant)) :scope-id -1 :is-def 1) acc}
    {acc}}
})

(sig 'ref/walk-type-list {-> List List List})
(fun {ref/walk-type-list variant acc} {
  if (nil? variant) {acc}
  {ref/walk-type-head (head variant) acc}
})

(sig 'ref/walk-type-head {-> Any List List})
(fun {ref/walk-type-head hd acc} {
  if (sym? hd)
    {qcons (list :name (str hd) :offset (src-pos hd)
                 :len (len (str hd)) :scope-id -1 :is-def 1) acc}
    {acc}
})

; --- Parameter helpers ---

(sig 'ref/collect-param-names {-> List List})
(fun {ref/collect-param-names params} {
  if (nil? params) {nil}
  {ref/collect-one-param (head params) (tail params)}
})

(sig 'ref/collect-one-param {-> Any List List})
(fun {ref/collect-one-param p rest} {
  if (sym? p)
    {ref/collect-param-str (str p) rest}
    {ref/collect-param-names rest}
})

(sig 'ref/collect-param-str {-> Str List List})
(fun {ref/collect-param-str name rest} {
  if (== name "&") {ref/collect-param-names rest}
  {qcons name (ref/collect-param-names rest)}
})

(sig 'ref/record-param-defs {-> List Num List List})
(fun {ref/record-param-defs params scope-id acc} {
  if (nil? params) {acc}
  {ref/record-param-defs (tail params) scope-id
    (ref/record-one-param (head params) scope-id acc)}
})

(sig 'ref/record-one-param {-> Any Num List List})
(fun {ref/record-one-param p scope-id acc} {
  if (sym? p)
    {ref/record-param-str p (str p) scope-id acc}
    {acc}
})

(sig 'ref/record-param-str {-> Any Str Num List List})
(fun {ref/record-param-str p name scope-id acc} {
  if (== name "&") {acc}
  {qcons (list :name name :offset (src-pos p) :len (len name)
               :scope-id scope-id :is-def 1) acc}
})

; --- Binding helpers ---

(sig 'ref/record-binding-defs {-> Any Num List List})
(fun {ref/record-binding-defs binding scope-id acc} {
  if (not (list? binding)) {acc}
  {ref/record-binding-walk binding scope-id acc}
})

(sig 'ref/record-binding-walk {-> List Num List List})
(fun {ref/record-binding-walk vars scope-id acc} {
  if (nil? vars) {acc}
  {ref/record-binding-walk (tail vars) scope-id
    (ref/record-one-binding (head vars) scope-id acc)}
})

(sig 'ref/record-one-binding {-> Any Num List List})
(fun {ref/record-one-binding v scope-id acc} {
  if (sym? v)
    {qcons (list :name (str v) :offset (src-pos v) :len (len (str v))
                 :scope-id scope-id :is-def 1) acc}
    {acc}
})

; --- do block scope threading ---

(sig 'ref/maybe-add-assign-names {-> Any List List})
(fun {ref/maybe-add-assign-names expr scopes} {
  if (not (list? expr)) {scopes}
  {if (nil? expr) {scopes}
  {ref/check-assign-head expr (head expr) scopes}}
})

(sig 'ref/check-assign-head {-> List Any List List})
(fun {ref/check-assign-head expr hd scopes} {
  if (not (sym? hd)) {scopes}
  {if (== (str hd) "=")
    {ref/add-assign-names expr scopes}
    {scopes}}
})

(sig 'ref/add-assign-names {-> List List List})
(fun {ref/add-assign-names expr scopes} {
  if (< (len (tail expr)) 1) {scopes}
  {ref/add-binding-to-scope (head (tail expr)) scopes}
})

(sig 'ref/add-binding-to-scope {-> Any List List})
(fun {ref/add-binding-to-scope binding scopes} {
  if (not (list? binding)) {scopes}
  {ref/add-names-from-binding binding scopes}
})

(sig 'ref/add-names-from-binding {-> List List List})
(fun {ref/add-names-from-binding binding scopes} {
  if (nil? binding) {scopes}
  {ref/add-names-from-binding (tail binding)
    (if (sym? (head binding))
      {ref/add-name-to-scope (str (head binding)) scopes}
      {scopes})}
})

(sig 'ref/add-name-to-scope {-> Str List List})
(fun {ref/add-name-to-scope name scopes} {
  if (nil? scopes) {scopes}
  {do
    (= {s} (head scopes))
    (= {names} s:names)
    (qcons (plist/set s :names (qcons name names)) (tail scopes))}
})

; --- Position helpers ---

(sig 'line-col->offset {-> Str Num Num Num})
(fun {line-col->offset text line col} {
  lc-offset-walk (str/split text "\n") line col 0 0
})

(sig 'lc-offset-walk {-> (List Str) Num Num Num Num Num})
(fun {lc-offset-walk lines target-line target-col current-line offset} {
  if (>= current-line target-line) {+ offset target-col}
  {if (nil? lines) {offset}
    {lc-offset-walk (tail lines) target-line target-col
      (+ current-line 1)
      (+ offset (len (head lines)) 1)}}
})

; --- Public API ---

(sig 'ref/collect-refs {-> Str List})
(fun {ref/collect-refs text} {do
  (= {ast} (parse text))
  (if (error? ast) {nil}
    {ref/walk-exprs ast nil nil})
})

(sig 'ref/collect-refs-from-ast {-> List List})
(fun {ref/collect-refs-from-ast ast} {
  if (error? ast) {nil}
  {ref/walk-exprs ast nil nil}
})

(sig 'ref/collect-scopes-from-ast {-> List List})
(fun {ref/collect-scopes-from-ast ast} {
  if (error? ast) {nil}
  {ref/scope-walk ast nil nil}
})

(sig 'ref/scope-walk {-> List List List List})
(fun {ref/scope-walk exprs scopes acc} {
  if (nil? exprs) {acc}
  {ref/scope-walk (tail exprs) scopes
    (ref/scope-one (head exprs) scopes acc)}
})

(sig 'ref/scope-one {-> Any List List List})
(fun {ref/scope-one expr scopes acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {ref/scope-dispatch expr (head expr) (tail expr) scopes acc}}
})

(sig 'ref/scope-dispatch {-> List Any List List List List})
(fun {ref/scope-dispatch expr hd tl scopes acc} {
  if (not (sym? hd)) {ref/scope-walk expr scopes acc}
  {do
    (= {name} (str hd))
    (if (== name "fun") {ref/scope-fun expr tl scopes acc}
    {if (== name "\\") {ref/scope-lambda expr tl scopes acc}
    {if (== name "do") {ref/scope-walk tl scopes acc}
    {ref/scope-walk tl scopes acc}}})}
})

(sig 'ref/scope-fun {-> List List List List List})
(fun {ref/scope-fun expr tl scopes acc} {
  if (< (len tl) 2) {acc}
  {do
    (= {scope-id} (src-pos expr))
    (= {parent-id} (if (nil? scopes) {-1} {(plist/get (head scopes) :pos)}))
    (= {new-scope} (list :pos scope-id :parent parent-id))
    (= {new-scopes} (qcons new-scope scopes))
    (ref/scope-walk (tail tl) new-scopes (qcons new-scope acc))}
})

(sig 'ref/scope-lambda {-> List List List List List})
(fun {ref/scope-lambda expr tl scopes acc} {
  if (< (len tl) 2) {acc}
  {do
    (= {scope-id} (src-pos expr))
    (= {parent-id} (if (nil? scopes) {-1} {(plist/get (head scopes) :pos)}))
    (= {new-scope} (list :pos scope-id :parent parent-id))
    (= {new-scopes} (qcons new-scope scopes))
    (ref/scope-walk (tail tl) new-scopes (qcons new-scope acc))}
})


(sig 'ref/find-at-offset {-> List Num Any})
(fun {ref/find-at-offset refs offset} {
  if (nil? refs) {nil}
  {do
    (= {r} (head refs))
    (= {roff} r:offset)
    (= {rlen} r:len)
    (if (and (>= offset roff) (< offset (+ roff rlen)))
      {r}
      {ref/find-at-offset (tail refs) offset})}
})

(sig 'ref/matching-refs {-> List Str Num List List})
(fun {ref/matching-refs refs target-name target-scope acc} {
  if (nil? refs) {reverse acc}
  {do
    (= {r} (head refs))
    (if (and (== r:name target-name)
             (== r:scope-id target-scope))
      {ref/matching-refs (tail refs) target-name target-scope (qcons r acc)}
      {ref/matching-refs (tail refs) target-name target-scope acc})}
})

(sig 'ref/find-scoped-refs {-> Str Num Num List})
(fun {ref/find-scoped-refs text line col} {do
  (= {refs} (ref/collect-refs text))
  (if (nil? refs) {nil}
    {do
      (= {offset} (line-col->offset text line col))
      (= {target} (ref/find-at-offset refs offset))
      (if (nil? target) {nil}
        {do
          (= {scope-id} target:scope-id)
          (if (== scope-id -1) {nil}
            {ref/matching-refs refs target:name scope-id nil})})})
})

(sig 'ref/find-scoped-refs-from-ast {-> List Str Num Num List})
(fun {ref/find-scoped-refs-from-ast ast text line col} {do
  (= {refs} (ref/collect-refs-from-ast ast))
  (if (nil? refs) {nil}
    {do
      (= {offset} (line-col->offset text line col))
      (= {target} (ref/find-at-offset refs offset))
      (if (nil? target) {nil}
        {do
          (= {scope-id} target:scope-id)
          (if (== scope-id -1) {nil}
            {ref/matching-refs refs target:name scope-id nil})})})
})
