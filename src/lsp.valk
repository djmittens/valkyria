; Valkyria LSP Server — implemented in Valk
;
; JSON <-> Q-expression mapping:
;   JSON object  -> plist:  {"a":1} -> {:a 1}
;   JSON array   -> list:   [1,2]   -> {1 2}
;   true/false   -> 1/0    (use :true/:false for encoding)
;   null         -> (None) (Option type from prelude)
;   nil          -> []     (nil = empty list, always)

(load "src/prelude.valk")
(load "src/symdb.valk")
(load "src/lsp-analysis.valk")
(load "src/lsp-validate.valk")
(load "src/lsp-hints.valk")


; ---------------------------------------------------------------------------
; Typed contexts — replace ad-hoc plists with var:field access
; ---------------------------------------------------------------------------

(type {DocCtx}
  {:uri Str :text Str :ast List})

(type {TextPosCtx}
  {:uri Str :text Str :ast List :line Num :col Num})

(type {WordCtx}
  {:uri Str :text Str :ast List :line Num :col Num :word Str})

(type {FormSnippet}
  {:label Str :detail Str :snippet Str :sort Str})
; ---------------------------------------------------------------------------
; LSP I/O — Content-Length framing over uv_pipe_t
; ---------------------------------------------------------------------------

(def {lsp/sys} nil)
(def {lsp/out} nil)
(def {lsp/initialized} 0)

(sig 'lsp/write-message {-> Str Nil})
(fun {lsp/write-message json-body} {do
  (= {msg} (json/encode json-body))
  (pipe/write lsp/out (str "Content-Length: " (len msg) "\r\n\r\n" msg))})

(sig 'lsp/send-response {-> Num Any Nil})
(fun {lsp/send-response id result}
  {lsp/write-message (list :jsonrpc "2.0" :id id :result result)})

(sig 'lsp/send-error {-> Num Num Str Nil})
(fun {lsp/send-error id code message}
  {lsp/write-message
    (list :jsonrpc "2.0" :id id
          :error (list :code code :message message))})

(sig 'lsp/send-notification {-> Str List Nil})
(fun {lsp/send-notification method params}
  {lsp/write-message
    (list :jsonrpc "2.0" :method method :params params)})

; ---------------------------------------------------------------------------
; State
; ---------------------------------------------------------------------------

(def {lsp/documents} (dict/new))
(def {lsp/db} nil)
(def {lsp/root-path} nil)
(def {lsp/doc-version} 0)

(sig 'lsp/doc-store {-> Str Str Nil})
(fun {lsp/doc-store uri text}
  {dict/set! lsp/documents uri text})

(sig 'lsp/doc-get {-> Str Any})
(fun {lsp/doc-get uri}
  {dict/get lsp/documents uri})

(def {lsp/ast-cache} (dict/new))

(sig 'lsp/cache-ast {-> Str Str List})
(fun {lsp/cache-ast uri text} {do
  (= {ast} (parse text))
  (dict/set! lsp/ast-cache uri ast)
  ast})

(sig 'lsp/get-ast {-> Str Str List})
(fun {lsp/get-ast uri text} {do
  (= {cached} (dict/get lsp/ast-cache uri))
  (if (nil? cached) {parse text} {cached})})

(sig 'lsp/get-doc {-> List DocCtx})
(fun {lsp/get-doc params} {do
  (= {uri} params:textDocument:uri)
  (= {text} (lsp/doc-get uri))
  (if (nil? text) {nil}
    {(DocCtx :uri uri :text text :ast (lsp/get-ast uri text))})
})

(sig 'lsp/get-text-pos {-> List TextPosCtx})
(fun {lsp/get-text-pos params} {do
  (= {uri} params:textDocument:uri)
  (= {text} (lsp/doc-get uri))
  (if (nil? text) {nil}
    {(TextPosCtx :uri uri :text text :ast (lsp/get-ast uri text)
                 :line params:position:line :col params:position:character)})
})

(sig 'lsp/get-word-ctx {-> List WordCtx})
(fun {lsp/get-word-ctx params} {do
  (= {ctx} (lsp/get-text-pos params))
  (if (nil? ctx) {nil}
    {do
      (= {w} (word-at-position ctx:text ctx:line ctx:col))
      (if (nil? w) {nil}
        {(WordCtx :uri ctx:uri :text ctx:text :ast ctx:ast :line ctx:line :col ctx:col :word w)})})
})

; ---------------------------------------------------------------------------
; LSP Capabilities
; ---------------------------------------------------------------------------

(def {lsp/capabilities}
  {:capabilities
    {:positionEncoding "utf-8"
     :textDocumentSync
       {:openClose :true
        :change 1
        :save {:includeText :true}}
     :completionProvider
       {:triggerCharacters {"(" "/" ":"}
        :resolveProvider :false}
     :hoverProvider :true
     :definitionProvider :true
     :referencesProvider :true
     :renameProvider {:prepareProvider :true}
     :documentSymbolProvider :true
     :workspaceSymbolProvider :true
     :semanticTokensProvider
       {:legend
         {:tokenTypes {"keyword" "function" "parameter" "variable"
                       "number" "string" "type" "operator" "property"}
          :tokenModifiers {"declaration" "defaultLibrary"}}
        :full :true
        :range :true}
     :inlayHintProvider :true
     :signatureHelpProvider
       {:triggerCharacters {"(" " "}
        :retriggerCharacters {" "}}
     :documentHighlightProvider :true
     :documentLinkProvider {:resolveProvider :false}
     :foldingRangeProvider :true
     :selectionRangeProvider :true
     :codeLensProvider {:resolveProvider :false}
     :codeActionProvider {:codeActionKinds {"quickfix"}}}
   :serverInfo
     {:name "valk-lsp"}})

; ---------------------------------------------------------------------------
; Known-set cache — rebuilt only when symdb changes
; ---------------------------------------------------------------------------

(def {lsp/known-set-cache} nil)

(sig 'lsp/invalidate-known-set {-> Nil})
(fun {lsp/invalidate-known-set} {
  def {lsp/known-set-cache} nil
})

(sig 'lsp/get-known-set {-> List})
(fun {lsp/get-known-set} {
  if (nil? lsp/known-set-cache)
    {do (def {lsp/known-set-cache} (vd/load-known-set lsp/db))
        lsp/known-set-cache}
    {lsp/known-set-cache}
})

; ---------------------------------------------------------------------------
; Diagnostic publishing
; ---------------------------------------------------------------------------

(sig 'make-lsp-diag {-> List List})
(fun {make-lsp-diag d}
  {list :range
    (list :start (list :line d:line
                       :character d:col)
          :end   (list :line d:line
                       :character d:end-col))
    :severity d:severity
    :source "valk"
    :message d:message})

(sig 'lsp/ensure-loads-indexed {-> List Nil})
(fun {lsp/ensure-loads-indexed ast} {
  if (nil? lsp/db) {}
  {lsp/ensure-loads-walk ast}
})

(sig 'lsp/ensure-loads-walk {-> List Nil})
(fun {lsp/ensure-loads-walk exprs} {
  if (nil? exprs) {}
  {do
    (= {e} (head exprs))
    (if (list? e)
      {if (nil? e) {}
        {do
          (= {form} (str (head e)))
          (if (== form "load")
            {if (nil? (tail e)) {}
              {do
                (= {path} (str (head (tail e))))
                (lsp/seed-file lsp/db path)}}
            {})}}
      {})
    (lsp/ensure-loads-walk (tail exprs))}
})

(sig 'lsp/publish-diagnostics {-> Str Str Nil})
(fun {lsp/publish-diagnostics uri text} {do
  (= {ast} (lsp/get-ast uri text))
  (if (error? ast)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (list :range
          (list :start (list :line 0 :character 0)
                :end   (list :line 0 :character 1))
          :severity 1
          :source "valk"
          :message (str ast))))}
    {do
      (lsp/ensure-loads-indexed ast)
      (= {diags} (vd/validate-with-known lsp/db ast text (lsp/get-known-set)))
      (= {lsp-diags} (map make-lsp-diag diags))
      (lsp/send-notification "textDocument/publishDiagnostics"
        (list :uri uri :diagnostics lsp-diags))})})

(sig 'lsp/publish-diagnostics-fast {-> Str Str Nil})
(fun {lsp/publish-diagnostics-fast uri text} {do
  (= {ast} (lsp/get-ast uri text))
  (if (error? ast)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (list :range
          (list :start (list :line 0 :character 0)
                :end   (list :line 0 :character 1))
          :severity 1
          :source "valk"
          :message (str ast))))}
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics nil)})})

; ---------------------------------------------------------------------------
; Sync document to symdb
; ---------------------------------------------------------------------------

(sig 'lsp/sync-doc {-> Str Str Nil})
(fun {lsp/sync-doc uri text} {do
  (lsp/doc-store uri text)
  (if (nil? lsp/db) {}
    {do (= {changed} (symdb/sync-document lsp/db uri text))
        (if (> changed 0)
          {do
            (= {ast} (lsp/get-ast uri text))
            (if (not (error? ast))
              {do
                (= {path} (uri->path uri))
                (= {fid} (sqlite/query-value lsp/db "SELECT id FROM files WHERE path=?1" path))
                (if (not (nil? fid)) {lsp/index-ast lsp/db fid ast text} {})}
              {})
            (lsp/invalidate-known-set)}
          {})})})

(sig 'lsp/sync-doc-text {-> Str Str Nil})
(fun {lsp/sync-doc-text uri text} {do
  (if (nil? lsp/db) {}
    {do
      (= {hash} (str "mem:" (len text)))
      (= {path} (uri->path uri))
      (= {existing} (sqlite/query-maybe lsp/db
        "SELECT hash FROM files WHERE path=?1" path))
      (if (not (nil? existing))
        {if (== existing:hash hash) {}
          {do (sqlite/exec lsp/db "BEGIN")
              (symdb/sync-file-symbols lsp/db uri text hash)
              (= {ast} (lsp/get-ast uri text))
              (lsp/precompute-file-data lsp/db uri ast text)
              (sqlite/exec lsp/db "COMMIT")
              (lsp/invalidate-known-set)}}
        {do (sqlite/exec lsp/db "BEGIN")
            (symdb/sync-file-symbols lsp/db uri text hash)
            (= {ast} (lsp/get-ast uri text))
            (lsp/precompute-file-data lsp/db uri ast text)
            (sqlite/exec lsp/db "COMMIT")
            (lsp/invalidate-known-set)})})})

; ---------------------------------------------------------------------------
; Method handlers — notifications
; ---------------------------------------------------------------------------

(sig 'lsp/sync-file {-> Ref Str Num})
(fun {lsp/sync-file db path} {do
  (= {fp} (file/fingerprint path))
  (if (error? fp) {0}
    {do
      (= {fpath} (uri->path (str "file://" path)))
      (= {existing} (sqlite/query-maybe db
        "SELECT hash FROM files WHERE path=?1" fpath))
      (if (not (nil? existing))
        {if (== existing:hash fp) {0}
          {do
            (= {text} (read-file path))
            (if (error? text) {0}
              {do
                (= {uri} (str "file://" path))
                (symdb/sync-file-symbols db uri text fp)
                (= {ast} (parse text))
                (if (not (error? ast))
                  {do
                    (= {fid} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" (uri->path uri)))
                    (if (not (nil? fid)) {lsp/index-ast db fid ast text} {})}
                  {})
                1})}}
        {do
          (= {text} (read-file path))
          (if (error? text) {0}
            {do
              (= {uri} (str "file://" path))
              (symdb/sync-file-symbols db uri text fp)
              (= {ast} (parse text))
              (if (not (error? ast))
                {do
                  (= {fid} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" (uri->path uri)))
                  (if (not (nil? fid)) {lsp/index-ast db fid ast text} {})}
                {})
              1})})})
})

(sig 'lsp/seed-file {-> Ref Str Num})
(fun {lsp/seed-file db path} {do
  (= {path} (if (str/starts-with? path "/") {path}
               {str lsp/root-path "/" path}))
  (lsp/sync-file db path)
})

(sig 'lsp/seed-builtins {-> Ref Str Nil})
(fun {lsp/seed-builtins db root} {do
  (= {builtins-path} (str root "/src/builtins.valk"))
  (= {b} (lsp/seed-file db builtins-path))
  (= {prelude-path} (str root "/src/prelude.valk"))
  (= {p} (lsp/seed-file db prelude-path))
  (if (== (+ b p) 0)
    {stderr/write "[valk-lsp] builtins + prelude cached\n"}
    {stderr/write "[valk-lsp] seeded builtins + prelude\n"})})

; ---------------------------------------------------------------------------
; Workspace scanning — incremental background indexing
; ---------------------------------------------------------------------------

(def {lsp/skip-dirs} (list "build" "vendor" "node_modules" "coverage-report"
                           "test-report" ".valk" ".git"))

(sig 'lsp/skip-dir? {-> Str Num})
(fun {lsp/skip-dir? name} {
  if (nil? lsp/skip-dirs) {0}
    {lsp/skip-dir-check name lsp/skip-dirs}
})

(sig 'lsp/skip-dir-check {-> Str List Num})
(fun {lsp/skip-dir-check name dirs} {
  if (nil? dirs) {0}
    {if (== name (head dirs)) {1}
      {lsp/skip-dir-check name (tail dirs)}}
})

(sig 'lsp/scan-dir {-> Str List List})
(fun {lsp/scan-dir root acc} {do
  (= {entries} (list-dir root))
  (if (error? entries) {acc}
    {lsp/scan-entries root entries acc})
})

(sig 'lsp/scan-entries {-> Str List List List})
(fun {lsp/scan-entries root entries acc} {
  if (nil? entries) {acc}
    {do
      (= {entry} (head entries))
      (= {name} entry:name)
      (= {type} entry:type)
      (= {full} (str root "/" name))
      (= {acc} (if (== type "dir")
        {if (lsp/skip-dir? name) {acc}
          {lsp/scan-dir full acc}}
        {if (str/ends-with? name ".valk")
          {qcons full acc}
          {acc}}))
      (lsp/scan-entries root (tail entries) acc)}
})

(sig 'lsp/index-file {-> Ref Str Num})
(fun {lsp/index-file db path} {
  lsp/sync-file db path
})

(sig 'lsp/collect-workspace-files {-> Str List})
(fun {lsp/collect-workspace-files root} {do
  (stderr/write (str "[valk-lsp] collecting workspace files: " root "\n"))
  (= {files} (lsp/scan-dir root nil))
  (stderr/write (str "[valk-lsp] found " (len files) " .valk files\n"))
  files})

(sig 'lsp/scan-all-inner {-> Ref List Num Num})
(fun {lsp/scan-all-inner db files indexed} {
  if (nil? files) {indexed}
    {do
      (= {did} (lsp/index-file db (head files)))
      (lsp/scan-all-inner db (tail files) (+ indexed did))}
})

(sig 'lsp/scan-all {-> Ref List Num})
(fun {lsp/scan-all db files} {do
  (sqlite/exec db "BEGIN")
  (= {indexed} (lsp/scan-all-inner db files 0))
  (sqlite/exec db "COMMIT")
  indexed})

(sig 'handle-initialize {-> Num List Nil})
(fun {handle-initialize id params} {do
  (= {root-uri} params:rootUri)
  (stderr/write (str "[valk-lsp] root: " root-uri "\n"))
  (if (not (nil? root-uri))
    {do
      (def {lsp/root-path} (uri->path root-uri))
      (= {db-dir} (str lsp/root-path "/.valk"))
      (= {db-path} (str db-dir "/symdb.sqlite"))
      (def {lsp/db} (symdb/init db-path))
      (lsp/seed-builtins lsp/db lsp/root-path)}
    {})
  (lsp/send-response id lsp/capabilities)})

(def {lsp/noop-cb} (\ {_} {}))

(sig 'handle-did-open {-> List Nil})
(fun {handle-did-open params} {do
  (= {uri} params:textDocument:uri)
  (= {text} params:textDocument:text)
  (lsp/doc-store uri text)
  (aio/dispatch lsp/sys
    (\ {_} {do (lsp/cache-ast uri text)
               (lsp/sync-doc uri text)
               (lsp/publish-diagnostics uri text)
               nil})
    nil lsp/noop-cb)})

(sig 'handle-did-change {-> List Nil})
(fun {handle-did-change params} {do
  (= {uri} params:textDocument:uri)
  (= {changes} params:contentChanges)
  (if (nil? changes) {}
    {do
      (= {text} (plist/get (head changes) :text))
      (lsp/doc-store uri text)
      (dict/remove! lsp/ast-cache uri)
      (aio/dispatch lsp/sys
        (\ {_} {do (lsp/cache-ast uri text)
                   (lsp/sync-doc uri text)
                   (lsp/publish-diagnostics-fast uri text)
                   nil})
        nil lsp/noop-cb)})})

(sig 'handle-did-close {-> List Nil})
(fun {handle-did-close params} {do
  (= {uri} params:textDocument:uri)
  (dict/remove! lsp/documents uri)
  (dict/remove! lsp/ast-cache uri)
  (lsp/send-notification "textDocument/publishDiagnostics"
    (list :uri uri :diagnostics nil))})

(sig 'handle-did-save {-> List Nil})
(fun {handle-did-save params} {do
  (= {uri} params:textDocument:uri)
  (= {text} params:text)
  (= {save-text} (if (nil? text) {lsp/doc-get uri} {text}))
  (if (nil? save-text) {}
    {aio/dispatch lsp/sys
      (\ {_} {do (lsp/cache-ast uri save-text)
                 (lsp/sync-doc uri save-text)
                 (lsp/publish-diagnostics uri save-text)
                 nil})
      nil lsp/noop-cb})})

; ---------------------------------------------------------------------------
; Method handlers — requests
; ---------------------------------------------------------------------------

(sig 'hover/format-markdown {-> SymInfo Str Str})
(fun {hover/format-markdown info word} {do
  (= {name} info:name)
  (= {type-sig} info:sig)
  (= {formals} info:formals)
  (= {doc} info:doc)
  (= {path} info:path)
  (= {sym-line} info:line)
  (= {sections} nil)
  (= {sections} (if (not (nil? type-sig))
    {qcons (str "```valk\n" name " : " type-sig "\n```") sections}
    {sections}))
  (= {sections} (if (not (nil? formals))
    {qcons (str "```valk\n" formals "\n```") sections}
    {if (nil? type-sig)
      {qcons (str "```valk\n" word "\n```") sections}
      {sections}}))
  (= {sections} (if (not (nil? doc))
    {qcons doc sections}
    {sections}))
  (= {sections} (if (not (nil? path))
    {if (> sym-line 0)
      {qcons (str "*" path ":" (+ sym-line 1) "*") sections}
      {qcons (str "*" path "*") sections}}
    {sections}))
  (str/join (reverse sections) "\n\n---\n\n")
})

; ---------------------------------------------------------------------------
; Hover — AST-node-aware via symdb nodes table
; ---------------------------------------------------------------------------

(sig 'hover/describe {-> List Ref Str})
(fun {hover/describe info db} {
  if (nil? info) {nil}
  {do
    (= {ntype} (plist/get info :type))
    (= {name} (plist/get info :name))
    (if (== ntype "str") {str "```valk\n\"" name "\" :: Str\n```"}
    {if (== ntype "num") {str "```valk\n" name " :: Num\n```"}
    {if (== ntype "sym")
      {if (> (len name) 0)
        {if (== (str/slice name 0 1) ":")
          {str "```valk\n" name " :: Keyword\n```"}
          {hover/sym-describe name db}}
        {nil}}
    {nil}}})}
})

(sig 'hover/sym-describe {-> Str Ref Str})
(fun {hover/sym-describe name db} {
  if (nil? db) {str "```valk\n" name "\n```"}
  {do
    (= {info} (symdb/symbol-hover db name))
    (if (nil? info) {str "```valk\n" name "\n```"}
      {hover/format-markdown info name})}
})


; ---------------------------------------------------------------------------
; Precompute: store semantic tokens, hints, scoped refs during file sync
; Called after symdb/sync-file-symbols when all analysis modules are loaded
; ---------------------------------------------------------------------------

(sig 'lsp/precompute-file-data {-> Ref Str List Str Nil})
(fun {lsp/precompute-file-data db uri ast text} {do
  (= {path} (uri->path uri))
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (nil? file-id) {}
    {do
      (lsp/index-ast db file-id ast text)
      (= {local-params} (hint/collect-local-params ast))
      (= {hctx} (list :local local-params :db db))
      (= {raw-hints} (hint/walk-exprs ast hctx nil))
      (= {type-hints} (hint/collect-type-hints ast db))
      (= {field-hints} (hint/collect-field-hints ast db))
      (symdb/insert-hint-batch db file-id (join raw-hints (join type-hints field-hints)))})
})

(sig 'handle-hover {-> Num List Nil})
(fun {handle-hover id params} {do
  (= {ctx} (lsp/get-text-pos params))
  (if (nil? ctx) {lsp/send-response id (None)}
    {do
      (= {offset} (line-col->offset ctx:text ctx:line ctx:col))
      (= {path} (uri->path ctx:uri))
      (= {info} (if (nil? lsp/db) {nil}
        {symdb/node-at-offset lsp/db path offset}))
      (= {wr} (word-range-at-position ctx:text ctx:line ctx:col))
      (= {word} (if (nil? info)
        {if (nil? wr) {nil} {wr:word}}
        {plist/get info :name}))
      (if (nil? word) {lsp/send-response id (None)}
        {do
          (= {hover-str} (hover/describe info lsp/db))
          (= {hover-str} (if (nil? hover-str)
            {do
              (= {fallback-info} (if (nil? lsp/db) {nil}
                {symdb/symbol-hover lsp/db word}))
              (if (nil? fallback-info)
                {str "```valk\n" word "\n```"}
                {hover/format-markdown fallback-info word})}
            {hover-str}))
          (= {start-line} ctx:line)
          (= {start-col} (if (nil? wr) {ctx:col} {wr:start}))
          (= {ntype} (if (nil? info) {nil} {plist/get info :type}))
          (= {wlen} (if (nil? word) {0}
            {if (== ntype "str") {+ (len word) 2} {len word}}))
          (if (not (nil? info))
            {do
              (= {node-lc} (offset->line-col ctx:text (plist/get info :pos)))
              (= {start-line} (head node-lc))
              (= {start-col} (head (tail node-lc)))}
            {})
          (lsp/send-response id
            (list :contents
              (list :kind "markdown" :value hover-str)
              :range
              (list :start (list :line start-line :character start-col)
                    :end (list :line start-line :character (+ start-col wlen)))))})})
})

(sig 'handle-definition {-> Num List Nil})
(fun {handle-definition id params} {do
  (= {ctx} (lsp/get-word-ctx params))
  (if (nil? ctx) {lsp/send-response id (None)}
    {do
      (= {path} (uri->path ctx:uri))
      (= {offset} (line-col->offset ctx:text ctx:line ctx:col))
      (= {local-def} (lsp/find-local-def ctx:ast ctx:text ctx:line ctx:col ctx:word path offset))
      (if (not (nil? local-def))
        {lsp/respond-def-offset id ctx:uri ctx:text local-def}
        {do
          (= {defn} (if (nil? lsp/db) {nil} {symdb/find-definition lsp/db ctx:word}))
          (if (nil? defn) {lsp/send-response id (None)}
            {lsp/send-response id
              (list :uri (str "file://" (plist/get defn :path))
                    :range (list
                      :start (list :line (plist/get defn :line) :character (plist/get defn :col))
                      :end (list :line (plist/get defn :line) :character (+ (plist/get defn :col) (len ctx:word)))))})})}
  )
})

(sig 'lsp/find-local-def {-> List Str Num Num Str Str Num List})
(fun {lsp/find-local-def ast text line col word path offset} {do
  (= {db-def} (if (nil? lsp/db) {nil}
    {do
      (= {target} (symdb/get-ref-at-offset lsp/db path offset))
      (if (not (nil? target))
        {do
          (= {sid} (plist/get target :scope_id))
          (if (nil? sid) {nil}
            {if (< sid 0) {nil}
              {symdb/find-def-in-scope-chain lsp/db path (plist/get target :name) sid}})}
        {lsp/find-var-for-field lsp/db path offset word})}))
  (if (not (nil? db-def)) {db-def}
    {do
      (= {ast-local} (ref/find-scoped-refs-from-ast ast text line col))
      (if (nil? ast-local) {nil}
        {do
          (= {defs} (filter (\ {r} {== (plist/get r :is-def) 1}) ast-local))
          (if (nil? defs) {nil} {head defs})})})
})

(sig 'lsp/find-var-for-field {-> Ref Str Num Str List})
(fun {lsp/find-var-for-field db path offset word} {
  if (nil? db) {nil}
  {do
    (= {node} (symdb/node-at-offset db path offset))
    (if (nil? node) {nil}
      {do
        (= {ntype} (plist/get node :type))
        (= {nname} (plist/get node :name))
        (if (not (== ntype "sym")) {nil}
          {if (not (> (len nname) 0)) {nil}
          {if (not (== (str/slice nname 0 1) ":")) {nil}
            {do
              (= {field-def} (symdb/find-field-definition db nname))
              (if (not (nil? field-def)) {field-def}
                {do
                  (= {npos} (plist/get node :pos))
                  (= {var-ref} (symdb/get-ref-at-offset db path (- npos 1)))
                  var-ref})}}})})}
})

(sig 'lsp/respond-def-offset {-> Num Str Str List Nil})
(fun {lsp/respond-def-offset id uri text def-ref} {do
  (= {pos} (if (plist/get def-ref :pos) {plist/get def-ref :pos} {plist/get def-ref :offset}))
  (= {rlen} (plist/get def-ref :len))
  (= {def-path} (plist/get def-ref :path))
  (= {target-uri} (if (nil? def-path) {uri} {str "file://" def-path}))
  (= {target-text} (if (nil? def-path) {text} {read-file def-path}))
  (= {target-text} (if (error? target-text) {text} {target-text}))
  (= {dlc} (offset->line-col target-text pos))
  (lsp/send-response id
    (list :uri target-uri
          :range (list
            :start (list :line (head dlc) :character (head (tail dlc)))
            :end (list :line (head dlc) :character (+ (head (tail dlc)) (if (nil? rlen) {1} {rlen}))))))
})


(sig 'ref->lsp-location {-> Str Str List List})
(fun {ref->lsp-location uri text r} {do
  (= {lc} (offset->line-col text r:offset))
  (= {rname} r:name)
  (list :uri uri
        :range (list
          :start (list :line (head lc) :character (head (tail lc)))
          :end (list :line (head lc) :character (+ (head (tail lc)) (len rname)))))
})

(sig 'handle-references {-> Num List Nil})
(fun {handle-references id params} {do
  (= {ctx} (lsp/get-word-ctx params))
  (if (nil? ctx) {lsp/send-response id nil}
    {do
      (= {path} (uri->path ctx:uri))
      (= {offset} (line-col->offset ctx:text ctx:line ctx:col))
      (= {target} (if (nil? lsp/db) {nil}
        {symdb/get-ref-at-offset lsp/db path offset}))
      (= {local-refs} (if (nil? target) {nil}
        {do
          (= {sid} (plist/get target :scope_id))
          (if (== sid -1) {nil}
            {symdb/get-scoped-refs lsp/db path (plist/get target :name) sid})}))
      (if (not (nil? local-refs))
        {lsp/send-response id
          (map (\ {r} {do
            (= {rlc} (offset->line-col ctx:text (plist/get r :pos)))
            (list :uri ctx:uri :range (list
              :start (list :line (head rlc) :character (head (tail rlc)))
              :end (list :line (head rlc) :character (+ (head (tail rlc)) (plist/get r :len)))))
          }) local-refs)}
        {do
          (= {ast-refs} (ref/find-scoped-refs-from-ast ctx:ast ctx:text ctx:line ctx:col))
          (if (not (nil? ast-refs))
            {lsp/send-response id (map (\ {r} {ref->lsp-location ctx:uri ctx:text r}) ast-refs)}
            {if (nil? lsp/db) {lsp/send-response id nil}
              {do
                (= {refs} (symdb/find-refs lsp/db ctx:word))
                (lsp/send-response id (map (\ {r} {
                  list :uri (str "file://" (plist/get r :path))
                       :range (list
                         :start (list :line (plist/get r :line) :character (plist/get r :col))
                         :end (list :line (plist/get r :line) :character (+ (plist/get r :col) (len ctx:word))))
                }) refs))}})})})
})

; ---------------------------------------------------------------------------
; Completion — snippets and enriched symbol items
; ---------------------------------------------------------------------------

(def {lsp/form-snippets} (list
  (FormSnippet :label "fun" :detail "(fun {name} {body})"
        :snippet "fun {${1:name}} {$0}" :sort "00")
  (FormSnippet :label "if" :detail "(if cond {then} {else})"
        :snippet "if ${1:cond} {$2} {$0}" :sort "01")
  (FormSnippet :label "def" :detail "(def {name} value)"
        :snippet "def {${1:name}} $0" :sort "02")
  (FormSnippet :label "=" :detail "(= {name} value)"
        :snippet "= {${1:name}} $0" :sort "03")
  (FormSnippet :label "\\" :detail "(\\ {args} {body})"
        :snippet "\\ {${1:args}} {$0}" :sort "04")
  (FormSnippet :label "do" :detail "(do expr...)"
        :snippet "do $0" :sort "05")
  (FormSnippet :label "match" :detail "(match val {pat body}...)"
        :snippet "match ${1:val} {$0}" :sort "06")
  (FormSnippet :label "select" :detail "(select {cond body}...)"
        :snippet "select {${1:cond} $0}" :sort "07")
  (FormSnippet :label "case" :detail "(case val {pat body}...)"
        :snippet "case ${1:val} {$0}" :sort "08")
  (FormSnippet :label "type" :detail "(type {Name} {Ctor fields})"
        :snippet "type {${1:Name}} {$0}" :sort "09")
  (FormSnippet :label "load" :detail "(load \"path\")"
        :snippet "load \"$0\"" :sort "10")
  (FormSnippet :label "sig" :detail "(sig 'name {type})"
        :snippet "sig '${1:name} {$0}" :sort "11")
  (FormSnippet :label "let" :detail "(let {bindings} body)"
        :snippet "let {$1} $0" :sort "12")
))

(sig 'make-snippet-item {-> FormSnippet List})
(fun {make-snippet-item s} {
  list :label s:label
       :kind 15
       :detail s:detail
       :insertText s:snippet
       :insertTextFormat 2
       :sortText s:sort
})

(sig 'filter-snippets {-> Str List List})
(fun {filter-snippets prefix snippets} {
  if (nil? snippets) {nil}
  {do
    (= {s} (head snippets))
    (if (str/starts-with? (FormSnippet:label s) prefix)
      {qcons (make-snippet-item s) (filter-snippets prefix (tail snippets))}
      {filter-snippets prefix (tail snippets)})}
})

(sig 'symkind->completion-kind {-> Num Num})
(fun {symkind->completion-kind kind} {
  if (== kind SYMKIND_FUNCTION) {3}
  {if (== kind SYMKIND_VARIABLE) {6}
  {if (== kind SYMKIND_TYPE) {7}
  {if (== kind SYMKIND_CONSTRUCTOR) {4}
    {6}}}}
})

(type {CompletionRow} {:name Str :kind Num :sig Str :doc Str})

(sig 'make-sym-completion-item {-> CompletionRow List})
(fun {make-sym-completion-item s} {do
  (= {name} s:name)
  (= {kind} s:kind)
  (= {sig} s:sig)
  (= {doc} s:doc)
  (= {detail-str} (if (nil? sig) {""} {sig}))
  (= {item} (list :label name
                   :kind (symkind->completion-kind kind)
                   :detail detail-str
                   :sortText (str "1-" name)))
  (if (nil? doc) {item}
    {plist/set item :documentation (list :kind "markdown" :value doc)})
})

(sig 'row->completion-row {-> List CompletionRow})
(fun {row->completion-row r} {
  CompletionRow (plist/get r :name) (plist/get r :kind) (plist/get r :sig) (plist/get r :doc)
})

(sig 'handle-completion {-> Num List Nil})
(fun {handle-completion id params} {do
  (= {ctx} (lsp/get-text-pos params))
  (if (nil? ctx) {lsp/send-response id nil}
    {if (lsp/in-string? ctx:text ctx:line ctx:col)
      {lsp/send-response id (list :isIncomplete :false :items nil)}
      {do
        (= {word} (word-at-position ctx:text ctx:line ctx:col))
        (= {prefix} (if (nil? word) {""} {word}))
        (= {snippet-items} (if (str/starts-with? prefix ":")
          {nil}
          {if (== prefix "")
            {map make-snippet-item lsp/form-snippets}
            {filter-snippets prefix lsp/form-snippets}}))
        (= {sym-items} (if (nil? lsp/db) {nil}
          {do
            (= {syms} (if (== prefix "")
              {symdb/completion-all lsp/db}
              {symdb/completion-symbols lsp/db prefix}))
            (map make-sym-completion-item (map row->completion-row syms))}))
        (= {all-items} (join snippet-items (if (nil? sym-items) {nil} {sym-items})))
        (lsp/send-response id (list :isIncomplete :false :items all-items))}})
})

(sig 'handle-document-symbols {-> Num List Nil})
(fun {handle-document-symbols id params} {do
  (= {uri} params:textDocument:uri)
  (if (nil? lsp/db) {lsp/send-response id nil}
    {do
      (= {path} (uri->path uri))
      (= {syms} (symdb/file-symbols lsp/db path))
      (= {lsp-syms} (map (\ {s} {do
        (= {sym-line} s:line)
        (= {sym-col} s:col)
        (= {sym-name} s:name)
        (= {sym-kind} s:kind)
        (list :name sym-name
              :kind (symkind->lsp-kind sym-kind)
              :range (list
                :start (list :line sym-line :character sym-col)
                :end (list :line sym-line :character (+ sym-col (len sym-name))))
              :selectionRange (list
                :start (list :line sym-line :character sym-col)
                :end (list :line sym-line :character (+ sym-col (len sym-name)))))
      }) syms))
      (lsp/send-response id lsp-syms)})})

(sig 'handle-workspace-symbols {-> Num List Nil})
(fun {handle-workspace-symbols id params} {do
  (= {query} params:query)
  (if (nil? lsp/db) {lsp/send-response id nil}
    {do
      (= {syms} (if (nil? query) {symdb/all-symbol-names lsp/db}
        {if (== query "") {symdb/all-symbol-names lsp/db}
          {symdb/search-symbols lsp/db query}}))
      (= {lsp-syms} (map (\ {s} {do
        (= {sym-line} s:line)
        (= {sym-col} s:col)
        (= {sym-name} s:name)
        (= {sl} (if (nil? sym-line) {0} {sym-line}))
        (= {sc} (if (nil? sym-col) {0} {sym-col}))
        (list :name sym-name
             :kind (symkind->lsp-kind s:kind)
             :location (list
               :uri (str "file://" (if (nil? s:path)
                 {""} {s:path}))
               :range (list
                 :start (list :line sl :character sc)
                 :end (list :line sl :character (+ sc (len sym-name))))))
      }) syms))
      (lsp/send-response id lsp-syms)})})

(sig 'handle-semantic-tokens {-> Num List Nil})
(fun {handle-semantic-tokens id params} {do
  (= {ctx} (lsp/get-doc params))
  (if (nil? ctx) {lsp/send-response id (list :data nil)}
    {do
      (= {path} (uri->path ctx:uri))
      (= {rows} (if (nil? lsp/db) {nil} {symdb/get-semantic-tokens lsp/db path}))
      (= {data} (if (nil? rows)
        {sem/tokenize-ast ctx:ast ctx:text}
        {sem/encode-deltas ctx:text (symdb/rows-to-token-groups rows)}))
      (lsp/send-response id (list :data data))})
})

(sig 'symdb/rows-to-token-groups {-> List List})
(fun {symdb/rows-to-token-groups rows} {
  if (nil? rows) {nil}
  {do
    (= {r} (head rows))
    (qcons (list (plist/get r :pos) (plist/get r :length)
                 (plist/get r :token_type) (plist/get r :modifiers))
      (symdb/rows-to-token-groups (tail rows)))}
})

; ---------------------------------------------------------------------------
; Rename support
; ---------------------------------------------------------------------------

(sig 'handle-prepare-rename {-> Num List Nil})
(fun {handle-prepare-rename id params} {do
  (= {ctx} (lsp/get-text-pos params))
  (if (nil? ctx) {lsp/send-error id -32602 "Document not found"}
    {do
      (= {wr} (word-range-at-position ctx:text ctx:line ctx:col))
      (if (nil? wr) {lsp/send-error id -32602 "No symbol at cursor"}
        {lsp/send-response id
          (list :range (list
            :start (list :line ctx:line :character wr:start)
            :end (list :line ctx:line :character wr:end))
          :placeholder wr:word)})})
})

(sig 'ref->lsp-edit {-> Str List Str List})
(fun {ref->lsp-edit text r new-name} {do
  (= {lc} (offset->line-col text r:offset))
  (= {rlen} r:len)
  (list :range (list
    :start (list :line (head lc) :character (head (tail lc)))
    :end (list :line (head lc) :character (+ (head (tail lc)) rlen)))
  :newText new-name)
})

(sig 'db-ref->lsp-edit {-> List Num Str List})
(fun {db-ref->lsp-edit r word-len new-name} {
  list :range (list
    :start (list :line r:line :character r:col)
    :end (list :line r:line :character (+ r:col word-len)))
  :newText new-name
})

(sig 'rename/group-by-uri {-> List List List})
(fun {rename/group-by-uri locs acc} {
  if (nil? locs) {acc}
  {do
    (= {loc} (head locs))
    (= {uri} loc:uri)
    (= {edit} loc:edit)
    (= {existing} (plist/get acc uri))
    (= {new-edits} (if (nil? existing) {list edit} {qcons edit existing}))
    (rename/group-by-uri (tail locs) (plist/set acc uri new-edits))}
})

(sig 'rename/make-doc-changes {-> List List})
(fun {rename/make-doc-changes grouped} {
  rename/make-doc-changes-walk grouped nil
})

(sig 'rename/make-doc-changes-walk {-> List List List})
(fun {rename/make-doc-changes-walk pairs acc} {
  if (nil? pairs) {acc}
  {do
    (= {uri} (head pairs))
    (= {edits} (head (tail pairs)))
    (= {doc-edit} (list :textDocument (list :uri uri :version (None))
                        :edits edits))
    (rename/make-doc-changes-walk (tail (tail pairs)) (qcons doc-edit acc))}
})

(sig 'handle-rename {-> Num List Nil})
(fun {handle-rename id params} {do
  (= {new-name} params:newName)
  (= {ctx} (lsp/get-word-ctx params))
  (if (nil? ctx) {lsp/send-error id -32602 "Document not found"}
    {do
      (= {local-refs} (ref/find-scoped-refs-from-ast ctx:ast ctx:text ctx:line ctx:col))
      (if (not (nil? local-refs))
        {do
          (= {edits} (map (\ {r} {ref->lsp-edit ctx:text r new-name}) local-refs))
          (= {doc-edit} (list :textDocument (list :uri ctx:uri :version (None))
                              :edits edits))
          (lsp/send-response id (list :documentChanges (list doc-edit)))}
        {if (nil? lsp/db) {lsp/send-error id -32602 "No workspace"}
          {do
            (= {word-len} (len ctx:word))
            (= {db-refs} (symdb/find-refs lsp/db ctx:word))
            (= {db-defs} (symdb/find-definitions lsp/db ctx:word))
            (= {all-locs} (join
              (map (\ {r} {
                list :uri (str "file://" r:path)
                     :edit (db-ref->lsp-edit r word-len new-name)
              }) db-refs)
              (map (\ {d} {
                list :uri (str "file://" d:path)
                     :edit (db-ref->lsp-edit d word-len new-name)
              }) db-defs)))
            (= {grouped} (rename/group-by-uri all-locs nil))
            (= {doc-changes} (rename/make-doc-changes grouped))
            (lsp/send-response id (list :documentChanges doc-changes))}})})
})

; ---------------------------------------------------------------------------
; Inlay hints — parameter name hints for function calls
; ---------------------------------------------------------------------------

(sig 'handle-inlay-hints {-> Num List Nil})
(fun {handle-inlay-hints id params} {do
  (= {range} (plist/get params :range))
  (= {ctx} (lsp/get-doc params))
  (if (nil? ctx) {lsp/send-response id nil}
    {do
      (= {path} (uri->path ctx:uri))
      (= {rows} (if (nil? lsp/db) {nil}
        {symdb/get-inlay-hints lsp/db path 0 999999}))
      (= {hints} (if (nil? rows)
        {hint/collect-from-ast ctx:ast ctx:text lsp/db range}
        {hint/format-db-rows rows ctx:text range}))
      (lsp/send-response id hints)})
})

; ---------------------------------------------------------------------------
; Signature help — show function signature as user types arguments
; ---------------------------------------------------------------------------

(sig 'sig/scan-back {-> Str Num Num Num Any})
(fun {sig/scan-back text pos dp db} {
  if (< pos 0) {nil}
  {do
    (= {ch} (str/slice text pos (+ pos 1)))
    (if (== ch ")")
      {sig/scan-back text (- pos 1) (+ dp 1) db}
    {if (== ch "(")
      {if (== dp 0) {pos}
        {sig/scan-back text (- pos 1) (- dp 1) db}}
    {if (== ch "}")
      {sig/scan-back text (- pos 1) dp (+ db 1)}
    {if (== ch "{")
      {if (> db 0)
        {sig/scan-back text (- pos 1) dp (- db 1)}
        {sig/scan-back text (- pos 1) dp db}}
      {sig/scan-back text (- pos 1) dp db}}}})}
})

(sig 'sig/extract-name {-> Str Num Any})
(fun {sig/extract-name text open-pos} {do
  (= {start} (+ open-pos 1))
  (= {end} (scan-word-end text start))
  (if (>= start end) {nil}
    {str/slice text start end})
})

(sig 'sig/count-args {-> Str Num Num Num Num Num Num Num})
(fun {sig/count-args text start end dp db count in-word} {
  if (>= start end) {count}
  {do
    (= {ch} (str/slice text start (+ start 1)))
    (if (== ch "(") {sig/count-args text (+ start 1) end (+ dp 1) db count 0}
    {if (== ch ")") {sig/count-args text (+ start 1) end (- dp 1) db count 0}
    {if (== ch "{") {sig/count-args text (+ start 1) end dp (+ db 1) count 0}
    {if (== ch "}") {sig/count-args text (+ start 1) end dp (- db 1) count 0}
    {if (if (== dp 0) {== db 0} {0})
      {if (if (== ch " ") {1} {if (== ch "\n") {1} {if (== ch "\t") {1} {0}}})
        {sig/count-args text (+ start 1) end dp db count 0}
        {sig/count-args text (+ start 1) end dp db
          (if (== in-word 0) {+ count 1} {count}) 1}}
      {sig/count-args text (+ start 1) end dp db count in-word}}}}})}
})

(sig 'sig/lookup-params {-> Str List Any Any})
(fun {sig/lookup-params name ast db} {do
  (= {local} (hint/collect-local-params ast))
  (= {params} (plist/get local name))
  (if (not (nil? params)) {params}
    {hint/query-db-params db name})
})

(sig 'sig/lookup-params-db-first {-> Str Ref List Any})
(fun {sig/lookup-params-db-first name db ast} {do
  (= {db-params} (hint/query-db-params db name))
  (if (not (nil? db-params)) {db-params}
    {do
      (= {local} (hint/collect-local-params ast))
      (plist/get local name)})
})

(sig 'handle-signature-help {-> Num List Nil})
(fun {handle-signature-help id params} {do
  (= {ctx} (lsp/get-text-pos params))
  (if (nil? ctx) {lsp/send-response id (None)}
    {do
      (= {offset} (line-col->offset ctx:text ctx:line ctx:col))
      (= {open-pos} (sig/scan-back ctx:text (- offset 1) 0 0))
      (if (nil? open-pos) {lsp/send-response id (None)}
        {do
          (= {name} (sig/extract-name ctx:text open-pos))
          (if (nil? name) {lsp/send-response id (None)}
            {do
              (= {fn-params} (sig/lookup-params-db-first name lsp/db ctx:ast))
              (if (nil? fn-params) {lsp/send-response id (None)}
                {do
                  (= {name-end} (+ open-pos 1 (len name)))
                  (= {arg-idx} (sig/count-args ctx:text name-end offset 0 0 0 0))
                  (= {active} (if (>= arg-idx (len fn-params))
                    {- (len fn-params) 1} {arg-idx}))
                  (= {param-items} (map (\ {p} {list :label p}) fn-params))
                  (= {sig-label} (str "(" name " " (str/join fn-params " ") ")"))
                  (lsp/send-response id
                    (list :signatures
                      (list (list :label sig-label
                                  :parameters param-items
                                  :activeParameter (if (< active 0) {0} {active})))
                      :activeSignature 0
                      :activeParameter (if (< active 0) {0} {active})))})})})})
})

; ---------------------------------------------------------------------------
; Document highlight — highlight all occurrences of symbol under cursor
; ---------------------------------------------------------------------------

(sig 'ref->highlight {-> Str List List})
(fun {ref->highlight text r} {do
  (= {lc} (offset->line-col text r:offset))
  (= {rname} r:name)
  (= {kind} (if (== r:is-def 1) {3} {2}))
  (list :range (list
    :start (list :line (head lc) :character (head (tail lc)))
    :end (list :line (head lc) :character (+ (head (tail lc)) (len rname))))
  :kind kind)
})

(sig 'ref->highlight-db {-> Str List List})
(fun {ref->highlight-db text r} {do
  (= {rpos} (plist/get r :pos))
  (= {rname} (plist/get r :name))
  (= {rlen} (plist/get r :len))
  (= {rdef} (plist/get r :is_def))
  (= {lc} (offset->line-col text rpos))
  (= {kind} (if (== rdef 1) {3} {2}))
  (list :range (list
    :start (list :line (head lc) :character (head (tail lc)))
    :end (list :line (head lc) :character (+ (head (tail lc)) (if (nil? rlen) {(len rname)} {rlen}))))
  :kind kind)
})

(sig 'handle-document-highlight {-> Num List Nil})
(fun {handle-document-highlight id params} {do
  (= {ctx} (lsp/get-word-ctx params))
  (if (nil? ctx) {lsp/send-response id nil}
    {do
      (= {path} (uri->path ctx:uri))
      (= {offset} (line-col->offset ctx:text ctx:line ctx:col))
      (= {target} (if (nil? lsp/db) {nil}
        {symdb/get-ref-at-offset lsp/db path offset}))
      (= {db-refs} (if (nil? target) {nil}
        {do
          (= {sid} (plist/get target :scope_id))
          (= {tname} (plist/get target :name))
          (if (== sid -1)
            {symdb/get-all-file-refs lsp/db path tname}
            {symdb/get-scoped-refs lsp/db path tname sid})}))
      (= {refs} (if (not (nil? db-refs)) {db-refs}
        {do
          (= {ast-refs} (ref/find-scoped-refs-from-ast ctx:ast ctx:text ctx:line ctx:col))
          (if (not (nil? ast-refs)) {ast-refs}
            {do
              (= {all-refs} (ref/collect-refs-from-ast ctx:ast))
              (filter (\ {r} {== (plist/get r :name) ctx:word}) all-refs)})}))
      (lsp/send-response id (map (\ {r} {
        if (plist/get r :pos)
          {ref->highlight-db ctx:text r}
          {ref->highlight ctx:text r}
      }) refs))})
})


; ---------------------------------------------------------------------------
; Document links — make (load "path") clickable
; ---------------------------------------------------------------------------

(sig 'link/collect-loads {-> List Str Str List})
(fun {link/collect-loads ast text root} {
  link/walk-exprs ast text root nil
})

(sig 'link/walk-exprs {-> List Str Str List List})
(fun {link/walk-exprs exprs text root acc} {
  if (nil? exprs) {acc}
  {link/walk-exprs (tail exprs) text root
    (link/walk-one (head exprs) text root acc)}
})

(sig 'link/walk-one {-> Any Str Str List List})
(fun {link/walk-one expr text root acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {link/check-load expr (head expr) (tail expr) text root acc}}
})

(sig 'link/check-load {-> List Any List Str Str List List})
(fun {link/check-load expr hd tl text root acc} {
  if (not (sym? hd)) {acc}
  {if (not (== (str hd) "load")) {link/walk-exprs tl text root acc}
  {if (nil? tl) {acc}
  {link/extract-load-target (head tl) text root acc}}}
})

(sig 'link/extract-load-target {-> Any Str Str List List})
(fun {link/extract-load-target target text root acc} {
  if (not (str? target)) {acc}
  {do
    (= {path} (str target))
    (= {pos} (src-pos target))
    (if (< pos 0) {acc}
      {do
        (= {lc} (offset->line-col text pos))
        (= {line} (head lc))
        (= {col} (head (tail lc)))
        (= {full-path} (if (str/starts-with? path "/") {path}
          {str root "/" path}))
        (qcons (list :range (list
          :start (list :line line :character col)
          :end (list :line line :character (+ col (len path) 2)))
          :target (str "file://" full-path)) acc)})}
})

(sig 'handle-document-link {-> Num List Nil})
(fun {handle-document-link id params} {do
  (= {ctx} (lsp/get-doc params))
  (if (nil? ctx) {lsp/send-response id nil}
    {if (error? ctx:ast) {lsp/send-response id nil}
      {do
        (= {root} (if (nil? lsp/root-path) {"."} {lsp/root-path}))
        (lsp/send-response id (link/collect-loads ctx:ast ctx:text root))}})
})

; ---------------------------------------------------------------------------
; Folding ranges — fold fun, do, match, type, let blocks
; ---------------------------------------------------------------------------

(def {FOLD_FORMS}
  (dict/from-keys {"fun" "do" "match" "select" "case" "type" "let" "\\"
   "aio/do" "aio/let" "if" "ctx/with" "ctx/with-deadline"}))

(sig 'fold/collect {-> List Str List})
(fun {fold/collect ast text} {
  fold/walk-exprs ast text nil
})

(sig 'fold/walk-exprs {-> List Str List List})
(fun {fold/walk-exprs exprs text acc} {
  if (nil? exprs) {acc}
  {fold/walk-exprs (tail exprs) text
    (fold/walk-one (head exprs) text acc)}
})

(sig 'fold/walk-one {-> Any Str List List})
(fun {fold/walk-one expr text acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {fold/check-form expr (head expr) (tail expr) text acc}}
})

(sig 'fold/check-form {-> List Any List Str List List})
(fun {fold/check-form expr hd tl text acc} {do
  (= {acc2} (fold/walk-exprs tl text acc))
  (if (not (sym? hd)) {fold/walk-exprs tl text acc}
    {if (dict/has? FOLD_FORMS (str hd))
      {fold/emit-range expr text acc2}
      {fold/walk-exprs tl text acc}})
})

(sig 'fold/emit-range {-> List Str List List})
(fun {fold/emit-range expr text acc} {do
  (= {start-pos} (src-pos expr))
  (if (< start-pos 0) {acc}
    {do
      (= {start-lc} (offset->line-col text start-pos))
      (= {start-line} (head start-lc))
      (= {expr-str} (str expr))
      (= {end-offset} (+ start-pos (len expr-str)))
      (= {end-lc} (offset->line-col text end-offset))
      (= {end-line} (head end-lc))
      (if (<= end-line start-line) {acc}
        {qcons (list :startLine start-line
                     :endLine end-line
                     :kind "region") acc})})
})

(sig 'handle-folding-range {-> Num List Nil})
(fun {handle-folding-range id params} {do
  (= {ctx} (lsp/get-doc params))
  (if (nil? ctx) {lsp/send-response id nil}
    {if (error? ctx:ast) {lsp/send-response id nil}
      {lsp/send-response id (fold/collect ctx:ast ctx:text)}})
})

; ---------------------------------------------------------------------------
; Selection range — smart selection expansion using AST structure
; ---------------------------------------------------------------------------

(sig 'sel/find-ranges {-> Str List List List})
(fun {sel/find-ranges text ast positions} {
  map (\ {pos} {do
    (= {line} pos:line)
    (= {col} pos:character)
    (= {offset} (line-col->offset text line col))
    (if (error? ast)
      {list :range (list :start pos :end pos)}
      {do
        (= {ranges} (sel/collect-enclosing ast text offset nil))
        (sel/build-nested ranges)})
  }) positions
})

(sig 'sel/collect-enclosing {-> List Str Num List List})
(fun {sel/collect-enclosing exprs text offset acc} {
  if (nil? exprs) {acc}
  {sel/collect-enclosing (tail exprs) text offset
    (sel/check-one (head exprs) text offset acc)}
})

(sig 'sel/check-one {-> Any Str Num List List})
(fun {sel/check-one expr text offset acc} {
  if (not (list? expr)) {acc}
  {do
    (= {start} (src-pos expr))
    (if (< start 0) {acc}
      {do
        (= {expr-str} (str expr))
        (= {end} (+ start (len expr-str)))
        (if (if (>= offset start) {<= offset end} {0})
          {do
            (= {start-lc} (offset->line-col text start))
            (= {end-lc} (offset->line-col text end))
            (= {range} (list :start (list :line (head start-lc) :character (head (tail start-lc)))
                              :end (list :line (head end-lc) :character (head (tail end-lc)))))
            (sel/collect-enclosing expr text offset (qcons range acc))}
          {acc})})}
})

(sig 'sel/build-nested {-> List List})
(fun {sel/build-nested ranges} {
  if (nil? ranges) {list :range (list :start (list :line 0 :character 0)
                                       :end (list :line 0 :character 0))}
  {sel/build-nested-walk ranges}
})

(sig 'sel/build-nested-walk {-> List List})
(fun {sel/build-nested-walk ranges} {
  if (nil? ranges) {nil}
  {if (nil? (tail ranges))
    {list :range (head ranges)}
    {list :range (head ranges)
          :parent (sel/build-nested-walk (tail ranges))}}
})

(sig 'handle-selection-range {-> Num List Nil})
(fun {handle-selection-range id params} {do
  (= {positions} params:positions)
  (= {ctx} (lsp/get-doc params))
  (if (nil? ctx) {lsp/send-response id nil}
    {lsp/send-response id (sel/find-ranges ctx:text ctx:ast positions)})
})

; ---------------------------------------------------------------------------
; Code lens — show reference counts above function definitions
; ---------------------------------------------------------------------------

(sig 'handle-code-lens {-> Num List Nil})
(fun {handle-code-lens id params} {do
  (= {uri} params:textDocument:uri)
  (if (nil? lsp/db) {lsp/send-response id nil}
    {do
      (= {path} (uri->path uri))
      (= {syms} (symdb/file-symbols lsp/db path))
      (= {lenses} (lens/build-from-syms syms lsp/db))
      (lsp/send-response id lenses)})})

(sig 'lens/build-from-syms {-> List Ref List})
(fun {lens/build-from-syms syms db} {
  if (nil? syms) {nil}
  {do
    (= {s} (head syms))
    (= {kind} s:kind)
    (if (== kind SYMKIND_FUNCTION)
      {do
        (= {name} s:name)
        (= {count} (symdb/ref-count db name))
        (= {sym-line} s:line)
        (= {sym-col} s:col)
        (= {lens} (list :range (list
          :start (list :line sym-line :character sym-col)
          :end (list :line sym-line :character (+ sym-col (len name))))
          :command (list :title (str count " reference" (if (== count 1) {""} {"s"}))
                         :command "")))
        (qcons lens (lens/build-from-syms (tail syms) db))}
      {lens/build-from-syms (tail syms) db})}
})

; ---------------------------------------------------------------------------
; Code action — quick fixes for undefined symbols
; ---------------------------------------------------------------------------

(sig 'handle-code-action {-> Num List Nil})
(fun {handle-code-action id params} {do
  (= {uri} params:textDocument:uri)
  (= {context} params:context)
  (= {diagnostics} context:diagnostics)
  (if (nil? diagnostics) {lsp/send-response id nil}
    {do
      (= {actions} (ca/collect-actions diagnostics uri))
      (lsp/send-response id actions)})})

(sig 'ca/collect-actions {-> List Str List})
(fun {ca/collect-actions diags uri} {
  if (nil? diags) {nil}
  {do
    (= {d} (head diags))
    (= {msg} d:message)
    (= {actions} (if (nil? msg) {nil}
      {ca/check-undefined msg d uri}))
    (join actions (ca/collect-actions (tail diags) uri))}
})

(sig 'ca/check-undefined {-> Str List Str List})
(fun {ca/check-undefined msg d uri} {
  if (not (str/starts-with? msg "Symbol '")) {
    if (not (str/starts-with? msg "Function '")) {nil}
    {ca/suggest-similar msg d uri}}
  {ca/suggest-similar msg d uri}
})

(sig 'ca/extract-name-from-msg {-> Str Any})
(fun {ca/extract-name-from-msg msg} {do
  (= {parts} (str/split msg "'"))
  (if (< (len parts) 3) {nil}
    {nth 2 parts})
})

(sig 'ca/suggest-similar {-> Str List Str List})
(fun {ca/suggest-similar msg d uri} {
  if (nil? lsp/db) {nil}
  {do
    (= {name} (ca/extract-name-from-msg msg))
    (if (nil? name) {nil}
      {do
        (= {candidates} (symdb/search-symbols lsp/db name))
        (= {range} d:range)
        (ca/make-fix-actions candidates name range uri d)})}
})

(sig 'ca/make-fix-actions {-> List Str List Str List List})
(fun {ca/make-fix-actions candidates original range uri d} {
  if (nil? candidates) {nil}
  {do
    (= {c} (head candidates))
    (= {cname} c:name)
    (if (== cname original) {ca/make-fix-actions (tail candidates) original range uri d}
      {do
        (= {action} (list :title (str "Did you mean '" cname "'?")
                          :kind "quickfix"
                          :diagnostics (list d)
                          :edit (list :changes
                            (list uri (list (list :range range :newText cname))))))
        (qcons action (ca/make-fix-actions (tail candidates) original range uri d))})}
})

; ---------------------------------------------------------------------------
; Semantic tokens range — tokens for visible viewport only
; ---------------------------------------------------------------------------

(sig 'handle-semantic-tokens-range {-> Num List Nil})
(fun {handle-semantic-tokens-range id params} {do
  (= {range} (plist/get params :range))
  (= {ctx} (lsp/get-doc params))
  (if (nil? ctx) {lsp/send-response id (list :data nil)}
    {do
      (= {start-pos} (plist/get range :start))
      (= {end-pos} (plist/get range :end))
      (= {start-line} (plist/get start-pos :line))
      (= {end-line} (plist/get end-pos :line))
      (= {path} (uri->path ctx:uri))
      (= {rows} (if (nil? lsp/db) {nil} {symdb/get-semantic-tokens lsp/db path}))
      (= {data} (if (nil? rows)
        {sem/tokenize-ast ctx:ast ctx:text}
        {sem/encode-deltas ctx:text (symdb/rows-to-token-groups rows)}))
      (= {filtered} (sem/filter-range data start-line end-line 0 nil))
      (lsp/send-response id (list :data filtered))})
})

(sig 'sem/filter-range {-> List Num Num Num List List})
(fun {sem/filter-range tokens start-line end-line cur-line acc} {
  if (nil? tokens) {reverse acc}
  {if (< (len tokens) 5) {reverse acc}
  {do
    (= {dl} (head tokens))
    (= {dc} (head (tail tokens)))
    (= {tlen} (head (tail (tail tokens))))
    (= {ttype} (head (tail (tail (tail tokens)))))
    (= {tmods} (head (tail (tail (tail (tail tokens))))))
    (= {new-line} (+ cur-line dl))
    (= {rest} (tail (tail (tail (tail (tail tokens))))))
    (if (> new-line end-line) {reverse acc}
      {if (< new-line start-line)
        {sem/filter-range rest start-line end-line new-line acc}
        {sem/filter-range rest start-line end-line new-line
          (qcons tmods (qcons ttype (qcons tlen (qcons dc (qcons dl acc)))))}})}}
})

; ---------------------------------------------------------------------------
; Completion context filtering
; ---------------------------------------------------------------------------

(sig 'lsp/in-string? {-> Str Num Num Num})
(fun {lsp/in-string? text line col} {do
  (= {offset} (line-col->offset text line col))
  (lsp/count-quotes text offset 0 0)
})

(sig 'lsp/count-quotes {-> Str Num Num Num Num})
(fun {lsp/count-quotes text limit pos count} {
  if (>= pos limit) {== (mod count 2) 1}
  {do
    (= {ch} (str/slice text pos (+ pos 1)))
    (if (== ch "\"")
      {lsp/count-quotes text limit (+ pos 1) (+ count 1)}
    {if (== ch "\\")
      {lsp/count-quotes text limit (+ pos 2) count}
      {lsp/count-quotes text limit (+ pos 1) count}})}
})

; ---------------------------------------------------------------------------
; Stale file cleanup
; ---------------------------------------------------------------------------

(sig 'lsp/cleanup-stale-files {-> Nil})
(fun {lsp/cleanup-stale-files} {
  if (nil? lsp/db) {}
  {do
    (= {indexed} (symdb/all-indexed-paths lsp/db))
    (= {removed} (lsp/check-stale-files indexed 0))
    (if (> removed 0)
      {do (lsp/invalidate-known-set)
          (stderr/write (str "[valk-lsp] removed " removed " stale files\n"))}
      {})}
})

(sig 'lsp/check-stale-files {-> List Num Num})
(fun {lsp/check-stale-files files count} {
  if (nil? files) {count}
  {do
    (= {f} (head files))
    (= {path} f:path)
    (= {file-id} f:id)
    (= {fp} (file/fingerprint path))
    (if (error? fp)
      {do (symdb/remove-file lsp/db file-id)
          (lsp/check-stale-files (tail files) (+ count 1))}
      {lsp/check-stale-files (tail files) count})}
})

; ---------------------------------------------------------------------------
; Unified file sync helper
; ---------------------------------------------------------------------------



; ---------------------------------------------------------------------------
; Progress support
; ---------------------------------------------------------------------------

(def {lsp/progress-token} 0)

(sig 'lsp/next-progress-token {-> Num})
(fun {lsp/next-progress-token} {do
  (def {lsp/progress-token} (+ lsp/progress-token 1))
  lsp/progress-token
})

(sig 'lsp/progress-begin {-> Num Str Num Nil})
(fun {lsp/progress-begin token title total} {do
  (lsp/send-notification "$/progress"
    (list :token token
          :value (list :kind "begin"
                       :title title
                       :percentage 0)))
})

(sig 'lsp/progress-report {-> Num Str Num Nil})
(fun {lsp/progress-report token message pct} {do
  (lsp/send-notification "$/progress"
    (list :token token
          :value (list :kind "report"
                       :message message
                       :percentage pct)))
})

(sig 'lsp/progress-end {-> Num Str Nil})
(fun {lsp/progress-end token message} {do
  (lsp/send-notification "$/progress"
    (list :token token
          :value (list :kind "end"
                       :message message)))
})

; ---------------------------------------------------------------------------
; Dispatch
; ---------------------------------------------------------------------------

(def {lsp/sem-version} 0)
(def {lsp/comp-version} 0)
(def {lsp/hint-version} 0)

(sig 'lsp/dispatch-to-worker {-> Str Any List Nil})
(fun {lsp/dispatch-to-worker method id params} {
  aio/dispatch lsp/sys
    (\ {_} {do (lsp/handle-readonly method id params) nil})
    nil
    lsp/noop-cb
})

(sig 'lsp/dispatch-request {-> Str Any List Nil})
(fun {lsp/dispatch-request method id params} {
  match method
    {"textDocument/semanticTokens/full" (do
      (def {lsp/sem-version} (+ lsp/sem-version 1))
      (= {v} lsp/sem-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/sem-version v))
          {nil}
          {do (lsp/handle-readonly method id params) nil}})
        nil lsp/noop-cb))}
    {"textDocument/semanticTokens/range" (do
      (def {lsp/sem-version} (+ lsp/sem-version 1))
      (= {v} lsp/sem-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/sem-version v))
          {nil}
          {do (lsp/handle-readonly method id params) nil}})
        nil lsp/noop-cb))}
    {"textDocument/completion" (do
      (def {lsp/comp-version} (+ lsp/comp-version 1))
      (= {v} lsp/comp-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/comp-version v))
          {nil}
          {do (lsp/handle-readonly method id params) nil}})
        nil lsp/noop-cb))}
    {"textDocument/inlayHint" (do
      (def {lsp/hint-version} (+ lsp/hint-version 1))
      (= {v} lsp/hint-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/hint-version v))
          {nil}
          {do (lsp/handle-readonly method id params) nil}})
        nil lsp/noop-cb))}
    {_ (lsp/dispatch-to-worker method id params)}
})

(sig 'lsp/handle-readonly {-> Str Any List Nil})
(fun {lsp/handle-readonly method id params} {
  match method
    {"textDocument/hover" (handle-hover id params)}
    {"textDocument/definition" (handle-definition id params)}
    {"textDocument/references" (handle-references id params)}
    {"textDocument/completion" (handle-completion id params)}
    {"textDocument/documentSymbol" (handle-document-symbols id params)}
    {"workspace/symbol" (handle-workspace-symbols id params)}
    {"textDocument/semanticTokens/full" (handle-semantic-tokens id params)}
    {"textDocument/semanticTokens/range" (handle-semantic-tokens-range id params)}
    {"textDocument/prepareRename" (handle-prepare-rename id params)}
    {"textDocument/rename" (handle-rename id params)}
    {"textDocument/inlayHint" (handle-inlay-hints id params)}
    {"textDocument/signatureHelp" (handle-signature-help id params)}
    {"textDocument/documentHighlight" (handle-document-highlight id params)}
    {"textDocument/documentLink" (handle-document-link id params)}
    {"textDocument/foldingRange" (handle-folding-range id params)}
    {"textDocument/selectionRange" (handle-selection-range id params)}
    {"textDocument/codeLens" (handle-code-lens id params)}
    {"textDocument/codeAction" (handle-code-action id params)}
    {_ (if (num? id)
         {lsp/send-error id -32601 (str "Method not found: " method)} {})}
})

; ---------------------------------------------------------------------------
; Event-driven main loop — pipe/lsp-reader delivers parsed messages
; ---------------------------------------------------------------------------

(sig 'lsp/on-message {-> Str Nil})
(fun {lsp/on-message body} {do
  (= {msg} (json/parse body))
  (if (nil? msg) {}
    {do
      (= {method} msg:method)
      (= {id} msg:id)
      (= {params} msg:params)
      (if (nil? method) {}
        {match method
            {"initialize" (do (stderr/write (str "[valk-lsp] <- initialize\n"))
                              (handle-initialize id params)
                              (def {lsp/initialized} 1))}
            {"initialized" (do
              (if (not (nil? lsp/db))
                {do
                  (= {files} (lsp/collect-workspace-files lsp/root-path))
                  (= {tok} (lsp/next-progress-token))
                  (lsp/progress-begin tok "Indexing workspace" (len files))
                  (aio/dispatch lsp/sys
                    (\ {_} {lsp/scan-all lsp/db files})
                    nil
                    (\ {indexed} {do
                      (lsp/invalidate-known-set)
                      (lsp/progress-end tok (str "indexed " indexed " files"))
                      (stderr/write (str "[valk-lsp] scan complete: " indexed " indexed\n"))
                      (lsp/cleanup-stale-files)}))}
                {}))}
            {"shutdown" (lsp/send-response id (None))}
            {"exit" (aio/stop lsp/sys)}
            {_ (if (== lsp/initialized 0)
                 {if (num? id)
                   {lsp/send-error id -32002 "Server not initialized"} {}}
                 {match method
                   {"textDocument/didOpen" (handle-did-open params)}
                   {"textDocument/didChange" (handle-did-change params)}
                   {"textDocument/didClose" (handle-did-close params)}
                   {"textDocument/didSave" (handle-did-save params)}
                   {"$/cancelRequest" {}}
                   {_ (if (num? id)
                         {lsp/dispatch-request method id params}
                                                 {})}})}})})})

(sig 'lsp/start {-> Nil})
(fun {lsp/start} {do
  (stderr/write "[valk-lsp] starting (threaded)\n")
  (def {lsp/sys} (aio/await (aio/start {:num-threads 4})))
  (= {stdin-pipe} (pipe/stdin-open lsp/sys))
  (def {lsp/out} (pipe/stdout-open lsp/sys))
  (pipe/lsp-reader stdin-pipe (\ {body} {lsp/on-message body}))
  (aio/run lsp/sys)
  (if (not (nil? lsp/db)) {symdb/close lsp/db} {})
  (stderr/write "[valk-lsp] shutdown\n")})
