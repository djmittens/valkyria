; ide/debugger.valk — debug client + debugger pane (DESIGN.md 5.4).
; Attaches to any Valk process running (debug/serve sys port); polls
; /dbg/state on the machine tick and pulls stack + frame bindings while the
; target is paused. Continue/step are commands (SPC d namespace globally,
; single keys when the pane is focused).

(load "ide/machine.valk")

(module ide)

; --- pure tool core --------------------------------------------------------

(fun {dbg-init} {
  `{:target "" :attached 0 :paused 0
    :file "" :line 0 :expr ""
    :stack ,nil :binds ,nil :err ""}
})

(fun {dbg-update state event} {do
  (= {etype} (plist/get event :type))
  (select
    {(== etype "attach")
      (plist/set (plist/set (plist/set state
        :target (str (plist/get event :host) ":" (plist/get event :port)))
        :attached 1)
        :err "")}
    {(== etype "detach")
      (plist/set (plist/set (plist/set (plist/set state
        :attached 0) :paused 0) :stack nil) :binds nil)}
    {(== etype "dbg-state")
      (do
        (= {p} (plist/get event :paused))
        (= {ns} (plist/set (plist/set (plist/set (plist/set (plist/set state
          :paused p)
          :file (plist/get event :file))
          :line (plist/get event :line))
          :expr (plist/get event :expr))
          :err ""))
        (if (== p 1) {ns} {plist/set (plist/set ns :stack nil) :binds nil}))}
    {(== etype "dbg-stack") (plist/set state :stack (plist/get event :stack))}
    {(== etype "dbg-binds") (plist/set state :binds (plist/get event :binds))}
    {(== etype "dbg-err")
      (plist/set (plist/set state :err (plist/get event :err)) :paused 0)}
    {otherwise state})
})

(fun {dbg-short-file f} {do
  (= {parts} (str/split (if (str? f) {f} {""}) "/"))
  (if (nil? parts) {""} {last parts})
})

(fun {dbg-stack-rows stack} {
  map (\ {f} {
    list (plist/get f :kind)
         (plist/get f :fn)
         (str (dbg-short-file (plist/get f :file)) ":" (plist/get f :line))})
    (ide/take-safe 10 (if (nil? stack) {nil} {stack}))
})

(fun {dbg-bind-rows binds} {
  map (\ {b} {list (plist/get b :name) (plist/get b :preview)})
      (ide/take-safe 12 (if (nil? binds) {nil} {binds}))
})

(fun {dbg-status-runs state} {
  (select
    {(not (== (plist/get state :err) ""))
      `{{:t ,(plist/get state :err) :style :error}}}
    {(== (plist/get state :attached) 0)
      `{{:t "detached" :style :dim} {:t "  SPC d a attaches" :style :dim}}}
    {(== (plist/get state :paused) 1)
      `{{:t "PAUSED " :style :error :effect :blink}
        {:t ,(str (dbg-short-file (plist/get state :file)) ":"
                  (plist/get state :line) "  ") :style :string}
        {:t ,(plist/get state :expr) :style :symbol}}}
    {otherwise `{{:t "running" :style :ok :effect :pulse}}})
})

(fun {dbg-view state} {do
  (= {rows} (dbg-stack-rows (plist/get state :stack)))
  (= {brows} (dbg-bind-rows (plist/get state :binds)))
  `{:w :panel :id "debugger" :title "DEBUGGER"
    :children
    {{:w :text :runs {{:t ,(str "target " (plist/get state :target))
                      :style :dim}}}
     {:w :text :runs ,(dbg-status-runs state)}
     ,@(if (nil? rows) {nil}
       {list {:w :divider}
             `{:w :text :runs {{:t "stack" :style :keyword}}}
             `{:w :table :id "dbg-stack" :cols {"kind" "fn" "at"} :rows ,rows}})
     ,@(if (nil? brows) {nil}
       {list {:w :divider}
             `{:w :text :runs {{:t "frame 0" :style :keyword}}}
             `{:w :table :id "dbg-binds" :cols {"name" "value"} :rows ,brows}})}}
})

; --- wire client (impure; runs on ui-sys loop 0) ---------------------------

(fun {dbg-target} {dict/get ide/runtime "dbg-target" nil})

(fun {dbg-get path cb} {do
  (= {t} (dbg-target))
  (= {sys} (dict/get ide/runtime "ui-sys" nil))
  (if (or (nil? t) (nil? sys))
    {nil}
    {do
      (aio/then
        (http2/client-request sys (plist/get t :host) (plist/get t :port) path)
        (\ {resp} {do
          (if (error? resp)
            {ide/dispatch "debugger" {:type "dbg-err" :err "target unreachable"} 0}
            {cb (json/parse (http2/response-body resp))})
          nil}))
      nil})
})

(fun {dbg-post path body} {do
  (= {t} (dbg-target))
  (= {sys} (dict/get ide/runtime "ui-sys" nil))
  (if (or (nil? t) (nil? sys))
    {nil}
    {do
      (aio/then
        (http2/client-post sys (plist/get t :host) (plist/get t :port) path
                           (json/encode body))
        (\ {resp} {do (ide/dbg-poll) nil}))
      nil})
})

(fun {dbg-poll} {do
  (if (nil? (dbg-target))
    {nil}
    {dbg-get "/dbg/state" (\ {st} {do
      (ide/dispatch "debugger"
        `{:type "dbg-state"
          :paused ,(plist/get st :paused)
          :file ,(if (str? (plist/get st :file)) {plist/get st :file} {""})
          :line ,(if (num? (plist/get st :line)) {plist/get st :line} {0})
          :expr ,(if (str? (plist/get st :expr)) {plist/get st :expr} {""})} 0)
      (if (== (plist/get st :paused) 1)
        {do
          (ide/dbg-get "/dbg/stack" (\ {stack} {do
            (ide/dispatch "debugger" `{:type "dbg-stack" :stack ,stack} 0)
            nil}))
          (ide/dbg-get "/dbg/frame/0/bindings" (\ {binds} {do
            (ide/dispatch "debugger" `{:type "dbg-binds" :binds ,binds} 0)
            nil}))
          nil}
        {nil})
      nil})})
  nil
})

(fun {dbg-attach host port} {do
  (dict/set! ide/runtime "dbg-target" `{:host ,host :port ,port})
  (ide/dispatch "debugger" `{:type "attach" :host ,host :port ,port} 0)
  (dbg-poll)
  nil
})

(fun {dbg-detach} {do
  (dict/remove! ide/runtime "dbg-target")
  (ide/dispatch "debugger" {:type "detach"} 0)
  nil
})

; REPL-callable helper: (ide/dbg-break "path/to/file.valk" 42)
(fun {dbg-break file line} {do
  (dbg-post "/dbg/break" `{:file ,(realpath file) :line ,line})
  nil
})

(def {debugger-tool}
  `{:id "debugger" :title "DEBUGGER"
    :init ,dbg-init :update ,dbg-update :view ,dbg-view})

(ide/register-command `{:id "dbg/attach" :title "Attach debugger to target"
  :keys {"SPC d a"}
  :run ,(\ {cid} {do
    (= {t} (ide/config-get "debug-target" {:host "127.0.0.1" :port 7788}))
    (dbg-attach (plist/get t :host) (plist/get t :port))
    nil})})

(ide/register-command `{:id "dbg/detach" :title "Detach debugger"
  :keys {"SPC d q"}
  :run ,(\ {cid} {do (dbg-detach) nil})})

(ide/register-command `{:id "dbg/continue" :title "Continue target"
  :keys {"SPC d c" "c"} :pane "debugger"
  :run ,(\ {cid} {do (dbg-post "/dbg/continue" {:a 0}) nil})})

(ide/register-command `{:id "dbg/step" :title "Step in"
  :keys {"SPC d s" "s"} :pane "debugger"
  :run ,(\ {cid} {do (dbg-post "/dbg/step" {:mode "in"}) nil})})

(ide/register-command `{:id "dbg/step-over" :title "Step over"
  :keys {"SPC d n" "n"} :pane "debugger"
  :run ,(\ {cid} {do (dbg-post "/dbg/step" {:mode "over"}) nil})})

(ide/register-command `{:id "dbg/step-out" :title "Step out"
  :keys {"SPC d f" "f"} :pane "debugger"
  :run ,(\ {cid} {do (dbg-post "/dbg/step" {:mode "out"}) nil})})
