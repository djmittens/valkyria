; Valkyria LSP Server — diagnostics, document sync, workspace indexing, notification handlers
;
; === Indexing architecture ===
;
; ONE function indexes a file: lsp/index-file-full
;   1. Sync symbols + refs to DB (symdb/sync-file-symbols)
;   2. Run C indexer for scoped refs + nodes (lsp/index-ast)
;   Returns 1 if file changed, 0 if cached.
;
; Semantic tokens and inlay hints are NOT stored: they are positional data
; about a buffer the editor is holding, so they are computed from the text
; of the request that asks for them (nav.valk / features.valk).
;
; Callers:
;   - lsp/seed-from-disk: called by the workspace scan and by didSave
;     (text that is on disk)
;
; The editor's unsaved text never enters the on-disk index. It is indexed
; into an in-memory overlay attached to each connection that needs it
; (lsp/live-sync-doc), which shadows the on-disk rows for that path until
; the file is saved or closed.

(load "symdb/symdb.valk")
(load "symdb/validate.valk")
(load "lsp/io.valk")

(module lsp)

; ---------------------------------------------------------------------------
; Transaction helper
; ---------------------------------------------------------------------------
;
; Wraps a thunk in BEGIN/COMMIT, with ROLLBACK on error. The thunk MUST be
; fully synchronous — no aio/dispatch, no aio/await, no callback registration.
; Holding a transaction across an async boundary races with other handlers
; on the main loop and causes nested-BEGIN errors.
;
; Use this instead of bare (sqlite/exec db "BEGIN") / (sqlite/exec db "COMMIT")
; pairs so error handling is uniform across the codebase.

(sig 'with-tx {-> Ref Fun Any})
(fun {with-tx db thunk} {do
  (sqlite/exec db "BEGIN")
  (= {r} (thunk))
  (if (error? r)
    {do (sqlite/exec db "ROLLBACK") r}
    {do (sqlite/exec db "COMMIT") r})
})

; ---------------------------------------------------------------------------
; Core indexing — single function, does everything
; ---------------------------------------------------------------------------

; Returns 1 when the stored hash for `path` matches, 0 when the file is
; missing, changed, or the query itself failed (a closed/locked DB must
; not be treated as "up to date").
; Asks the on-disk index specifically: this decides whether a file needs
; re-indexing from disk, and the overlay's answer is about a buffer.
(sig 'hash-current? {-> Ref Str Str Num})
(fun {hash-current? db path hash} {do
  (= {existing} (sqlite/query-maybe db
    "SELECT hash FROM main.files WHERE path=?1" path))
  (if (nil? existing) {0}
    {if (error? existing) {0}
      {== existing:hash hash}})
})

(sig 'index-file-full {-> Ref Str Str Str Num})
(fun {index-file-full db uri text hash} {do
  (= {path} (symdb/uri->path uri))
  (if (hash-current? db path hash) {0}
    {do
      ; Single-parse path: get-ast hits the ast-cache for open documents,
      ; falls back to parse otherwise. Then sync-file-with-ast does
      ; strip-errors + file-insert + index-ast in one shot. Previously
      ; this function parsed twice and called index-ast twice — kept the
      ; main loop busy during workspace scan.
      (= {ast} (lsp/get-ast uri text))
      (if (error? ast) {0}
        {do (symdb/sync-file-with-ast db uri text hash ast) 1})})
})

; ---------------------------------------------------------------------------
; Disk seeding (workspace scan at startup)
; ---------------------------------------------------------------------------

; Check the stored hash BEFORE reading the file. This runs for every
; (load ...) target on every diagnostics publish (lsp/ensure-loads-indexed);
; unconditionally reading each dependency from disk cost a full read-file
; per dep per keystroke batch.
; Canonicalize first: the hash probe keys on files.path, which is always
; physical, so a symlinked input path would miss the row and re-index on
; every publish.
(sig 'seed-from-disk {-> Ref Str Num})
(fun {seed-from-disk db raw-path} {do
  (= {path} (symdb/canon-path raw-path))
  (= {fp} (file/fingerprint path))
  (if (error? fp) {0}
    {if (hash-current? db path fp) {0}
      {do
        (= {text} (read-file path))
        (if (error? text) {0}
          {with-tx db
            (\ {} {index-file-full db (str "file://" path) text fp})})}})
})

; Best-effort: index stdlib so go-to-def / hover on a builtin lands in
; source. This only finds files when the workspace IS the valkyria repo;
; for an arbitrary project the files are absent and we skip silently. The
; validator does NOT depend on this — it recognizes builtins/operators via
; (penv) in vd/load-known-set, so `+` etc. are never falsely flagged even
; when stdlib is not on disk.
(sig 'seed-builtins {-> Ref Str Nil})
(fun {seed-builtins db root} {do
  (= {builtins-path} (str root "/stdlib/builtins.valk"))
  (= {prelude-path} (str root "/stdlib/prelude.valk"))
  (= {b} (seed-from-disk db builtins-path))
  (= {p} (seed-from-disk db prelude-path))
  (if (== (+ b p) 0)
    {stderr/write "[valk-lsp] builtins + prelude not on disk (using env)\n"}
    {stderr/write "[valk-lsp] seeded builtins + prelude\n"})})

; ---------------------------------------------------------------------------
; Diagnostic publishing
; ---------------------------------------------------------------------------

(sig 'make-lsp-diag {-> List List})
(fun {make-lsp-diag d}
  {list :range
    (list :start (list :line d:line
                       :character d:col)
          :end   (list :line d:line
                       :character d:end-col))
    :severity d:severity
    :source "valk"
    :message d:message})

(sig 'ensure-loads-indexed {-> Ref Str List Nil})
(fun {ensure-loads-indexed db doc-path ast} {
  if (nil? db) {}
  {ensure-loads-walk db (parent-dir doc-path) ast}
})

(sig 'parent-dir {-> Str Str})
(fun {parent-dir p} {do
  (= {i} (str/last-index-of p "/"))
  (if (< i 1) {""} {str/slice p 0 i})
})

; Mirror the runtime's resolution order for a load written in this
; document: relative to the document's directory first, then the
; workspace root.
(sig 'resolve-load-target {-> Str Str Str})
(fun {resolve-load-target doc-dir path} {
  if (str/starts-with? path "/") {path}
  {do
    (= {local} (if (== (len doc-dir) 0) {""} {str doc-dir "/" path}))
    (if (and (> (len local) 0) (file/exists? local)) {local}
      {str lsp/root-path "/" path})}
})

(sig 'ensure-loads-walk {-> Ref Str List Nil})
(fun {ensure-loads-walk db doc-dir exprs} {
  if (nil? exprs) {}
  {do
    (= {e} (head exprs))
    (if (list? e)
      {if (nil? e) {}
        {do
          (= {form} (str (head e)))
          (if (== form "load")
            {if (nil? (tail e)) {}
              {do
                (= {path} (str (head (tail e))))
                (seed-from-disk db (resolve-load-target doc-dir path))}}
            {})}}
      {})
    (ensure-loads-walk db doc-dir (tail exprs))}
})

(sig 'republish-all-diagnostics {-> Nil})
(fun {republish-all-diagnostics} {do
  (= {uris} (dict/keys lsp/documents))
  (republish-loop uris)
})

(sig 'republish-loop {-> List Nil})
(fun {republish-loop uris} {
  if (nil? uris) {}
  {do
    (= {uri} (head uris))
    (= {text} (lsp/doc-get uri))
    (if (nil? text) {}
      {publish-diagnostics lsp/db uri text})
    (republish-loop (tail uris))}
})

; Extract the byte offset from a parse error message of the form
; "[offset: N] ...". Returns 0 if no offset is found.
(sig 'parse-error-offset {-> Str Num})
(fun {parse-error-offset err} {do
  (= {start} (str/index-of err "[offset: "))
  (if (< start 0) {0}
    {do
      (= {after} (str/slice err (+ start 9) (len err)))
      (= {end} (str/index-of after "]"))
      (if (< end 0) {0}
        {do (= {parsed} (parse (str/slice after 0 end)))
            (if (and (list? parsed) (and (> (len parsed) 0) (num? (head parsed))))
              {head parsed} {0})})})})

; Convert a parse error to an LSP Diagnostic, using the embedded byte offset
; to compute the line/column.
(sig 'parse-error->diag {-> Any Str List})
(fun {parse-error->diag err text} {do
  (= {offset} (parse-error-offset err))
  (= {pos} (offset->line-col text offset))
  (= {line} (head pos))
  (= {col} (head (tail pos)))
  (list :range
    (list :start (list :line line :character col)
          :end   (list :line line :character (+ col 1)))
    :severity 1
    :source "valk"
    :message (str err))
})

; Takes db as an arg so callers can route the DB work to lsp/idx-db on
; lsp/idx-sys (keeping lsp/sys loop-0 free to flush pipe writes). Parses
; text directly rather than consulting lsp/ast-cache because the cache
; is written by concurrent lsp/sys workers.
(sig 'publish-diagnostics {-> Ref Str Str Nil})
(fun {publish-diagnostics db uri text} {do
  (= {ast} (parse text))
  (= {parse-err} (lsp/ast-find-error ast))
  (if (error? parse-err)
    {lsp/send-notification "textDocument/publishDiagnostics"
      (list :uri uri :diagnostics
        (list (parse-error->diag (str parse-err) text)))}
    {do
      ; This connection has its own overlay: the buffer has to be in it
      ; before the known-symbol and arity checks run, or a function the
      ; user just typed reads as undefined and one whose parameter list
      ; they just changed reads as called with the wrong arity.
      (symdb/live-sync db uri text ast)
      (= {path} (symdb/uri->path uri))
      (ensure-loads-indexed db path ast)
      (= {known} (vd/load-known-set db))
      (= {diags} (vd/validate-with-known db path ast text known))
      (= {lsp-diags} (if (error? diags)
        {do (stderr/write (str "[lsp] validate error: " diags "\n")) nil}
        {map make-lsp-diag diags}))
      (lsp/send-notification "textDocument/publishDiagnostics"
        (list :uri uri :diagnostics (if (error? lsp-diags)
          {do (stderr/write (str "[lsp] diag map error: " lsp-diags "\n")) nil}
          {lsp-diags})))})})

; ---------------------------------------------------------------------------
; Sync document to symdb
; ---------------------------------------------------------------------------

; The editor's text never reaches the on-disk index. It is indexed into
; `live`, the in-memory overlay attached to the connection being used, which
; shadows the on-disk rows for that path until the file is saved or closed.
; Every connection that has to answer questions about the buffer keeps its
; own overlay: lsp/db for interactive requests, lsp/idx-db for diagnostics.
;
; Parses text directly rather than consulting lsp/ast-cache, because the
; cache is written by a concurrent lsp/sys worker and racy to read.
;
; A broken parse leaves the overlay on the last version that parsed: a
; half-typed form has no symbols worth recording, and positional data
; (tokens, hints) no longer comes from the database at all.
(sig 'live-sync-doc {-> Ref Str Str Nil})
(fun {live-sync-doc db uri text} {
  if (nil? db) {}
  {do
    (= {ast} (parse text))
    (if (lsp/ast-has-error ast) {}
      {symdb/live-sync db uri text ast})}})

; A save makes the buffer and the file identical, so the text goes into the
; on-disk index and the overlay entry for it is dropped.
(sig 'save-doc {-> Ref Str Str Nil})
(fun {save-doc db uri text} {
  if (nil? db) {}
  {do
    (= {path} (symdb/uri->path uri))
    (= {ast} (parse text))
    ; Store the file's fingerprint, not a marker: the text just written to
    ; disk IS the file, so a later workspace scan can skip it.
    (= {fp} (file/fingerprint path))
    (= {hash} (if (error? fp) {str "save:" (len text)} {fp}))
    (if (lsp/ast-has-error ast) {}
      {with-tx db
        (\ {} {symdb/sync-file-with-ast db uri text hash ast})})
    (symdb/live-drop db path)}})

; ---------------------------------------------------------------------------
; Method handlers — notifications
; ---------------------------------------------------------------------------

; The server reports every position as a byte offset into the line, so it
; can only serve a client that offers utf-8 in general.positionEncodings.
; Per spec a client that omits the capability supports utf-16 only.
(sig 'client-accepts-utf8 {-> List Num})
(fun {client-accepts-utf8 caps} {do
  (= {encodings} (plist/get (plist/get caps :general) :positionEncodings))
  (if (nil? encodings) {0} {list-has-utf8 encodings})})

(sig 'list-has-utf8 {-> List Num})
(fun {list-has-utf8 encodings} {
  if (nil? encodings) {0}
  {if (== (str (head encodings)) "utf-8") {1}
    {list-has-utf8 (tail encodings)}}})

(sig 'handle-initialize {-> Num InitParams Nil})
(fun {handle-initialize id params} {
  if (== (client-accepts-utf8 params:capabilities) 0)
    {do
      (stderr/write
        (str "[valk-lsp] client does not offer utf-8 in "
             "general.positionEncodings; refusing to initialize rather than "
             "reporting byte columns a utf-16 client would misread\n"))
      (lsp/send-init-error id
        (str "valk-lsp requires positionEncoding utf-8. This client offered "
             "only utf-16, which the server does not implement."))}
    {init-workspace id params}})

(sig 'init-workspace {-> Num InitParams Nil})
(fun {init-workspace id params} {do
  (= {root-uri} params:rootUri)
  (stderr/write (str "[valk-lsp] root: " root-uri "\n"))
  (if (not (nil? root-uri))
    {do
      (def {lsp/root-path} (symdb/uri->path root-uri))
      (= {db-dir} (str lsp/root-path "/.valk"))
      (= {db-path} (str db-dir "/symdb.sqlite"))
      ; Ensure .valk/ exists before sqlite tries to open the file —
      ; otherwise sqlite/open fails and we silently fall back to
      ; :memory: which loses all stdlib seeding.
      (mkdir-p db-dir)
      (def {lsp/db-path} db-path)
      (= {result} (symdb/init db-path))
      (if (error? result)
        {do (stderr/write (str "[valk-lsp] symdb file init failed, using :memory:\n"))
            (def {lsp/db} (symdb/init ":memory:"))
            (def {lsp/db-path} ":memory:")}
        {do (def {lsp/db} result)})
      ; lsp/db is read on lsp/sys by interactive features (hover/go-to-def);
      ; index stdlib into it here (same thread) for richer builtin navigation.
      ; Builtin *recognition* for diagnostics comes from (penv), not this.
      (seed-builtins lsp/db lsp/root-path)
      (symdb/attach-live lsp/db)}
    {do
      (def {lsp/root-path} "")
      (def {lsp/db} (symdb/init ":memory:"))
      (def {lsp/db-path} ":memory:")
      (seed-builtins lsp/db lsp/root-path)
      (symdb/attach-live lsp/db)})
  ; Only a completed handshake flips the flag: a rejected initialize must
  ; leave the server answering -32002, not serving requests.
  (def {lsp/initialized} 1)
  (lsp/send-response id lsp/capabilities)})

; Done-callback for fire-and-forget tasks (cache-ast/sync-doc/diagnostics).
; These have no request id to answer, but a silent failure means stale
; highlighting or diagnostics that never update — log it.
(def {noop-cb} (\ {r} {
  if (error? r)
    {stderr/write (str "[valk-lsp] task error: " r "\n")}
    {}}))

; Dispatches:
;   - lsp/sys worker: lsp/cache-ast to populate the in-process AST cache
;     (used by semantic-tokens workers on lsp/sys)
;   - lsp/sys worker: lsp/live-sync-doc to index the buffer into lsp/db's
;     in-memory overlay. The overlay belongs to the connection it is
;     attached to, so this has to run on the connection interactive
;     requests read from. It writes no disk pages and takes ~10ms.
;   - lsp/sys worker: publish-diagnostics (on a done-cb). This still reads
;     lsp/db from loop-0; worth investigating moving too.
;
; Known-set cache freshness: we invalidate synchronously here on loop-0
; before dispatching, so any subsequent get-known-set call reloads from
; the current DB state.
(sig 'handle-did-open {-> OpenParams Nil})
(fun {handle-did-open params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} td:text)
  (lsp/doc-store uri text)
  (dict/remove! lsp/ast-cache uri)
  (lsp/invalidate-known-set)
  (def {lsp/doc-version} (+ lsp/doc-version 1))
  (= {v} lsp/doc-version)
  ; No semanticTokens/refresh on didOpen: notifications and requests share
  ; one FIFO worker, so cache-ast completes before the client's own token
  ; request for the new buffer is processed — there is no stale initial
  ; paint left to upgrade. Refreshing here made every didOpen fan out into
  ; token re-requests for EVERY attached buffer; a 30-buffer open/close
  ; churn in a long session flooded the worker and queued hovers behind
  ; ~700ms of redundant token traffic. didChange/didSave still refresh.
  (aio/dispatch lsp/sys
    (\ {_} {if (not (== lsp/doc-version v)) {nil}
      {do (lsp/cache-ast uri text) nil}})
    nil
    noop-cb)
  (aio/dispatch lsp/sys
    (\ {_} {if (not (== lsp/doc-version v)) {nil}
      {do (live-sync-doc lsp/db uri text) nil}})
    nil
    noop-cb)
  ; Opening a file is the one moment we are told about a path the startup
  ; scan may never have seen — created by another tool, arrived with a
  ; branch switch, or living outside the workspace root. Index it FROM
  ; DISK (not from the buffer, which belongs in the overlay): the on-disk
  ; index is meant to describe the source tree, and without this a file
  ; that exists on disk stays missing from it until the next restart.
  ; No-ops when the fingerprint already matches, which is the usual case.
  (aio/dispatch lsp/idx-sys
    (\ {_} {do (seed-from-disk lsp/idx-db (symdb/uri->path uri)) nil})
    nil
    noop-cb)
  (schedule-publish-diagnostics uri)})

; Coalesce dispatches via "pending" flags. While a dispatched task is
; queued/running, suppress new dispatches of the same kind. The
; inflight task reads lsp/doc-get on entry so it always processes the
; latest text, even if many didChanges arrived after it was queued.
;
; Without this, every keystroke queues 3 tasks (cache-ast, sync-doc,
; publish-diagnostics). Even though version-gating makes earlier tasks
; return nil quickly, each queued task pays for closure evacuation,
; queue insertion / pop, and GC pressure. After ~100 keystrokes the
; worker loops have seconds of pending work to drain, and synchronous
; hover/completion requests queue behind it. Coalescing collapses 100
; keystrokes' worth of dispatches into a handful of actual runs,
; restoring sub-100ms p99 latency under typing load.
;
; Synchronization: the pending flag must be written from a single loop
; only (Valk globals across loops are a data race). cache-ast dispatches
; to lsp/sys, whose completion fires on lsp/sys loop 0 — the same loop
; as handle-did-change. For sync-doc / publish-diagnostics, the body
; runs on lsp/idx-sys but we want flag-clear on lsp/sys loop 0, so the
; lsp/idx-sys completion does a tiny bounce-back dispatch to lsp/sys
; whose completion clears the flag. One extra dispatch per coalesced
; batch is negligible vs the queue depth it saves.
; Coalescing state, keyed BY URI.
;
; Two bugs in the original single-global-flag version:
;
;   1. No trailing edge. `if pending == 0 { launch } ` alone drops any
;      didChange that arrives mid-flight and never reschedules, so the last
;      edit of a burst is silently lost: the user stops typing and keeps stale
;      squigglies and a stale symbol index until they type again.
;
;   2. Not per-URI. One global flag means an edit to A in flight causes an edit
;      to B to be dropped — and a naive trailing-edge relaunch would then
;      re-run A, never B. Editing two files in a session loses work in
;      whichever one loses the race.
;
; `inflight[uri]` = a job is running; `dirty[uri]` = newer text arrived that no
; running job has observed. Launch clears dirty and sets inflight; completion
; clears inflight and relaunches iff dirty was set again meanwhile.
;
; Synchronization is unchanged in spirit: every read/write below happens on
; lsp/sys loop 0 — handle-did-change runs there, and the lsp/idx-sys
; completions bounce back through a no-op dispatch before touching state.
(def {cache-ast-inflight} (dict/new))
(def {cache-ast-dirty} (dict/new))
(def {sync-doc-inflight} (dict/new))
(def {sync-doc-dirty} (dict/new))
(def {publish-diag-inflight} (dict/new))
(def {publish-diag-dirty} (dict/new))

(sig 'coalesce-busy? {-> Ref Str Num})
(fun {coalesce-busy? inflight uri}
  {== (dict/get inflight uri 0) 1})

; Returns 1 when the caller should launch a job for `uri`, 0 when one is
; already running (in which case the URI is left marked dirty so the running
; job's completion relaunches it).
(sig 'coalesce-claim {-> Ref Ref Str Num})
(fun {coalesce-claim inflight dirty uri} {
  if (coalesce-busy? inflight uri)
    {do (dict/set! dirty uri 1) 0}
    {do (dict/set! inflight uri 1) (dict/remove! dirty uri) 1}
})

; Returns 1 when newer text arrived while the job ran and it must relaunch.
(sig 'coalesce-release {-> Ref Ref Str Num})
(fun {coalesce-release inflight dirty uri} {do
  (dict/set! inflight uri 0)
  (if (== (dict/get dirty uri 0) 1)
    {do (dict/remove! dirty uri) 1}
    {0})
})

; Bounce a state update back to lsp/sys loop 0 via a no-op dispatch. Used as
; the completion callback of an lsp/idx-sys dispatch when we need to touch
; single-loop-owned state from a different aio system.
(sig 'clear-sync-doc-pending {-> Str Nil})
(fun {clear-sync-doc-pending uri} {
  aio/dispatch lsp/sys (\ {_} {}) nil
    (\ {_} {if (== (coalesce-release sync-doc-inflight
                                        sync-doc-dirty uri) 1)
      {schedule-sync-doc uri} {}})
})

(sig 'clear-publish-diag-pending {-> Str Nil})
(fun {clear-publish-diag-pending uri} {
  aio/dispatch lsp/sys (\ {_} {}) nil
    (\ {_} {if (== (coalesce-release publish-diag-inflight
                                         publish-diag-dirty uri) 1)
      {schedule-publish-diagnostics uri} {}})
})

; Coalesced schedulers. Each is safe to call on every didChange: the first call
; launches, calls while a job is in flight are absorbed, and the completion
; relaunches once if newer text arrived meanwhile. The job body always reads
; the LATEST doc, so an absorbed batch collapses into one pass.
(sig 'schedule-cache-ast {-> Str Nil})
(fun {schedule-cache-ast uri} {
  if (== (coalesce-claim cache-ast-inflight cache-ast-dirty uri) 0) {}
    {aio/dispatch lsp/sys
      (\ {_} {do
        (= {latest} (lsp/doc-get uri))
        (if (nil? latest) {nil} {do (lsp/cache-ast uri latest) nil})})
      nil
      (\ {_} {do
        (lsp/refresh-semantic-tokens)
        (if (== (coalesce-release cache-ast-inflight
                                      cache-ast-dirty uri) 1)
          {schedule-cache-ast uri} {})})}
})

(sig 'schedule-sync-doc {-> Str Nil})
(fun {schedule-sync-doc uri} {
  if (== (coalesce-claim sync-doc-inflight sync-doc-dirty uri) 0) {}
    {aio/dispatch lsp/sys
      (\ {_} {do
        (= {latest} (lsp/doc-get uri))
        (if (nil? latest) {nil} {do (live-sync-doc lsp/db uri latest) nil})})
      nil
      (\ {_} {clear-sync-doc-pending uri})}
})

(sig 'schedule-publish-diagnostics {-> Str Nil})
(fun {schedule-publish-diagnostics uri} {
  if (== (coalesce-claim publish-diag-inflight
                             publish-diag-dirty uri) 0) {}
    {aio/dispatch lsp/idx-sys
      (\ {_} {do
        (= {latest} (lsp/doc-get uri))
        (if (nil? latest) {nil} {do (publish-diagnostics lsp/idx-db uri latest) nil})})
      nil
      (\ {_} {clear-publish-diag-pending uri})}
})

(sig 'handle-did-change {-> ChangeParams Nil})
(fun {handle-did-change params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {changes} params:contentChanges)
  (if (nil? changes) {}
    {do
      (= {old-text} (lsp/doc-get uri))
      (= {text} (if (nil? old-text)
        {plist/get (head changes) :text}
        {lsp/apply-changes old-text changes}))
      (lsp/doc-store uri text)
      (dict/remove! lsp/ast-cache uri)
      (lsp/invalidate-known-set)
      (def {lsp/doc-version} (+ lsp/doc-version 1))
      (schedule-cache-ast uri)
      (schedule-sync-doc uri)
      (schedule-publish-diagnostics uri)})})

(sig 'handle-did-close {-> DocParams Nil})
(fun {handle-did-close params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (dict/remove! lsp/documents uri)
  (dict/remove! lsp/ast-cache uri)
  ; The buffer is gone: the file on disk is the truth again.
  (symdb/live-drop lsp/db (symdb/uri->path uri))
  (aio/dispatch lsp/idx-sys
    (\ {_} {do (symdb/live-drop lsp/idx-db (symdb/uri->path uri)) nil})
    nil noop-cb)
  (def {lsp/doc-version} (+ lsp/doc-version 1))
  (lsp/send-notification "textDocument/publishDiagnostics"
    (list :uri uri :diagnostics nil))})

(sig 'handle-did-save {-> SaveParams Nil})
(fun {handle-did-save params} {do
  (= {td} params:textDocument)
  (= {uri} td:uri)
  (= {text} params:text)
  (= {save-text} (if (nil? text) {lsp/doc-get uri} {text}))
  (if (nil? save-text) {}
    {do
      (lsp/doc-store uri save-text)
      (lsp/invalidate-known-set)
      (def {lsp/doc-version} (+ lsp/doc-version 1))
      (= {v} lsp/doc-version)
      (aio/dispatch lsp/sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (lsp/cache-ast uri save-text)
              (symdb/live-drop lsp/db (symdb/uri->path uri))
              nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (aio/dispatch lsp/idx-sys
        (\ {_} {if (not (== lsp/doc-version v)) {nil}
          {do (save-doc lsp/idx-db uri save-text) nil}})
        nil
        (\ {_} {if (not (== lsp/doc-version v)) {}
          {lsp/refresh-semantic-tokens}}))
      (schedule-publish-diagnostics uri)})})

