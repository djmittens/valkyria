  ; --- handle-code-action ---

  (test/case "handle-code-action-no-diags"
    {do
      (reset-state)
      (reset-captures)
      (features/handle-code-action 28
        (CodeActionParams :textDocument (LspTextDoc :uri "file:///ca.valk")
