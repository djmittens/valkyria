  ; --- handle-rename (no db, no doc) ---

  (test/case "handle-rename-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (nav/handle-rename 30
        (RenameParams :textDocument (LspTextDoc :uri "file:///nope")
              :position (LspPosition :line 0 :character 0)
              :newName "renamed"))
      (= {err} (last-error))
      (test/assert (not (nil? err)) "should send error")
    })

  ; --- handle-did-close ---

  (test/case "handle-did-close"
    {do
      (reset-state)
      (lsp/doc-store "file:///close.valk" "text")
      (reset-captures)
      (lsp/handle-did-close (DocParams :textDocument (LspTextDoc :uri "file:///close.valk")))
      (= {notif} (last-notification))
      (test/assert (not (nil? notif)) "should send notification")
      (test/assert-eq "textDocument/publishDiagnostics" notif:method "method")
      (= {params} notif:params)
      (test/assert-eq "file:///close.valk" params:uri "uri")
      (test/assert (nil? params:diagnostics) "diagnostics cleared")
    })

  ; --- lsp/on-message dispatch ---

  (test/case "dispatch-nil-method"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\"}")
      (test/assert (nil? (last-response)) "no method -> no response")
      (test/assert (nil? (last-error)) "no method -> no error")
    })

  (test/case "dispatch-shutdown"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}")
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (test/assert-eq 1 resp:id "response id=1")
      (test/assert-eq 0 *aio-stopped* "shutdown should not stop, exit does")
    })

  (test/case "dispatch-shutdown-result-is-json-null"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}")
      (= {resp} (last-response))
      (test/assert-eq "{\"result\":null}"
        (json/encode (list :result resp:result))
        "shutdown result must encode as JSON null")
      (test/assert-eq 1 lsp/shutdown-requested "shutdown records the request")
    })

  (test/case "dispatch-request-after-shutdown-is-invalid"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}")
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{}}")
      (= {err} (last-error))
      (test/assert (not (nil? err)) "post-shutdown request must be answered")
      (test/assert-eq -32600 err:code "error code -32600")
      (test/assert (nil? (last-response)) "post-shutdown request is not served")
    })

  (test/case "dispatch-notification-after-shutdown-is-silent"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}")
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{}}")
      (test/assert (nil? (last-error)) "notifications get no error response")
      (test/assert (nil? (last-response)) "notifications get no response")
    })

  (test/case "dispatch-exit"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
      (test/assert-eq 1 *aio-stopped* "exit should call aio/stop")
    })

  (test/case "dispatch-double-initialize-is-invalid"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"initialize\",\"params\":{}}")
      (= {err} (last-error))
      (test/assert (not (nil? err)) "second initialize must be rejected")
      (test/assert-eq -32600 err:code "error code -32600")
      (test/assert (nil? (last-response)) "no capabilities on re-initialize")
    })

  (test/case "dispatch-initialized"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}")
      (test/assert (nil? (last-error)) "initialized should not error")
    })

  (test/case "dispatch-not-initialized"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 0)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"textDocument/hover\",\"params\":{}}")
      (= {err} (last-error))
      (test/assert (not (nil? err)) "should send error")
      (test/assert-eq -32002 err:code "error code -32002")
    })

  (test/case "dispatch-not-initialized-string-id"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 0)
      ; JSON-RPC ids may be strings. Dropping those left the client
      ; waiting on an id that never gets answered.
      (lsp/on-message
        "{\"jsonrpc\":\"2.0\",\"id\":\"req-1\",\"method\":\"textDocument/hover\",\"params\":{}}")
      (= {err} (last-error))
      (test/assert (not (nil? err)) "string-id request must be answered")
      (test/assert-eq -32002 err:code "error code -32002")
      (test/assert-eq "req-1" err:id "error echoes the string id")
    })

  (test/case "position-encoding-utf8-offered"
    {do
      (test/assert-eq 1
        (lsp/client-accepts-utf8
          (list :general (list :positionEncodings (list "utf-16" "utf-8"))))
        "utf-8 anywhere in the list is accepted")
    })

  (test/case "position-encoding-utf8-absent"
    {do
      (test/assert-eq 0
        (lsp/client-accepts-utf8
          (list :general (list :positionEncodings (list "utf-16" "utf-32"))))
        "no utf-8 offered")
      (test/assert-eq 0 (lsp/client-accepts-utf8 (list :general (list)))
        "missing positionEncodings defaults to utf-16 only")
      (test/assert-eq 0 (lsp/client-accepts-utf8 nil)
        "missing capabilities defaults to utf-16 only")
    })

  (test/case "initialize-rejected-without-utf8"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 0)
      (lsp/on-message
        (str "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":"
             "{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-16\"]}}}}"))
      (= {err} (last-error))
      (test/assert (not (nil? err)) "utf-16-only client must be refused")
      (test/assert-eq -32602 err:code "error code -32602")
      (test/assert (nil? (last-response)) "no capabilities are advertised")
      (test/assert-eq 0 lsp/initialized
        "a refused handshake leaves the server uninitialized")
    })

  (test/case "dispatch-cancel-request"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{}}")
      (test/assert (nil? (last-response)) "cancel -> no response")
      (test/assert (nil? (last-error)) "cancel -> no error")
    })

  (test/case "dispatch-unknown-method-with-id"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"id\":42,\"method\":\"unknown/method\",\"params\":{}}")
      (= {err} (last-error))
      (test/assert (not (nil? err)) "should send error for unknown")
      (test/assert-eq -32601 err:code "error code -32601")
    })

  (test/case "dispatch-unknown-notification"
    {do
      (reset-state)
      (reset-captures)
      (def {lsp/initialized} 1)
      (lsp/on-message "{\"jsonrpc\":\"2.0\",\"method\":\"unknown/notif\",\"params\":{}}")
      (test/assert (nil? (last-response)) "unknown notif -> no response")
      (test/assert (nil? (last-error)) "unknown notif -> no error")
    })

  (test/case "on-message-malformed-json-sends-parse-error"
    {do
      (reset-state)
      (reset-captures)
      (lsp/on-message "{this is not json")
      (= {err} (last-error))
      (test/assert (not (nil? err)) "malformed JSON must be answered, not dropped")
      (test/assert-eq -32700 err:code "error code -32700")
    })

  ; Handler-error -> -32603 delivery is tested with a real aio system in
  ; test_lsp_dispatch_errors.valk: the stubbed aio/dispatch above cannot
  ; pass an error value into a Valk-level callback (only the C dispatch
  ; completion path can bind an error to a lambda parameter).

  ; --- handle-rename with scoped refs ---

  (test/case "handle-rename-scoped"
    {do
      (reset-state)
      (lsp/doc-store "file:///rn.valk" "(fun {f x}\n  (+ x 1))")
      (reset-captures)
      (nav/handle-rename 38
        (RenameParams :textDocument (LspTextDoc :uri "file:///rn.valk")
              :position (LspPosition :line 1 :character 5)
              :newName "y"))
      (= {resp} (last-response))
      (= {result} resp:result)
      (= {changes} result:documentChanges)
      (test/assert (not (nil? changes)) "should have document changes")
    })

  ; --- lsp/publish-diagnostics ---

  (test/case "publish-diagnostics-with-errors"
    {do
      (reset-state)
      (reset-captures)
      (lsp/publish-diagnostics nil "file:///err.valk" "(undefined-symbol-xyz 42)")
      (= {notif} (last-notification))
      (test/assert-eq "textDocument/publishDiagnostics" notif:method "method")
      (= {params} notif:params)
      (= {diags} params:diagnostics)
      (test/assert (not (nil? diags)) "should have diagnostics for undefined symbol")
    })

  (test/case "publish-diagnostics-valid"
    {do
      (reset-state)
      (reset-captures)
      (lsp/publish-diagnostics nil "file:///ok.valk" "(+ 1 2)")
      (= {notif} (last-notification))
      (test/assert-eq "textDocument/publishDiagnostics" notif:method "method")
    })

  ; --- progress helpers ---

  (test/case "progress-begin"
    {do
      (reset-state)
      (reset-captures)
      (lsp/progress-begin 1 "Indexing" 10)
      (= {notif} (last-notification))
      (test/assert-eq "$/progress" notif:method "method")
      (= {p} notif:params)
      (= {value} p:value)
      (test/assert-eq "begin" value:kind "kind=begin")
    })

  (test/case "progress-report"
    {do
      (reset-state)
      (reset-captures)
      (lsp/progress-report 1 "50 files" 50)
      (= {notif} (last-notification))
      (= {p} notif:params)
      (= {value} p:value)
      (test/assert-eq "report" value:kind "kind=report")
      (test/assert-eq 50 value:percentage "percentage=50")
    })

  (test/case "progress-end"
    {do
      (reset-state)
      (reset-captures)
      (lsp/progress-end 1 "Done")
      (= {notif} (last-notification))
      (= {p} notif:params)
      (= {value} p:value)
      (test/assert-eq "end" value:kind "kind=end")
    })

  ; --- lsp/capabilities structure ---

  (test/case "capabilities-structure"
    {do
      (= {caps} lsp/capabilities:capabilities)
      (test/assert-eq :true caps:hoverProvider "hover")
      (test/assert-eq :true caps:definitionProvider "definition")
      (test/assert-eq :true caps:referencesProvider "references")
    })

) {:suite-name "LSP Handlers Core" :debug 0})
