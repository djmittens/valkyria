  (test/case "handle-code-action-non-undefined"
    {do
      (reset-state)
      (reset-captures)
      (features/handle-code-action 29
        (CodeActionParams :textDocument (LspTextDoc :uri "file:///ca.valk")
              :range (LspRange :start (LspPosition :line 0 :character 0) :end (LspPosition :line 0 :character 5))
              :context (CodeActionContext :diagnostics
                (list (list :message "Some other error"
                            :range (list :start (list :line 0 :character 0)
                                         :end (list :line 0 :character 5)))))))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should respond")
