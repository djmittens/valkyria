  (test/case "handle-references-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///ref.valk" "(fun {f x}\n  (+ x 1))")
      (reset-captures)
      (nav/handle-references 23
        (TextDocPosParams :textDocument (LspTextDoc :uri "file:///ref.valk") :position (LspPosition :line 1 :character 5)))
      (= {resp} (last-response))
      (= {result} resp:result)
