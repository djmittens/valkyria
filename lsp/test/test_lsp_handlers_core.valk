(load "symdb/symdb.valk")
(load "lsp/analysis.valk")
(load "symdb/validate.valk")
(load "lsp/hints.valk")
(load "lsp/lsp.valk")
(load "testing/test.valk")

; lint:allow-globals *captured-responses* *captured-errors* *captured-notifications* *aio-stopped* *aio-dispatched*
;   Response-capture spies. This suite runs single-threaded against a
;   stubbed dispatch, so the handler under test and the assertions are
;   the same thread — there is no reader to race with.

; --- Response capture stubs ---

(def {*captured-responses*} nil)
(def {*captured-errors*} nil)
(def {*captured-notifications*} nil)
(def {*aio-stopped*} 0)
(def {*aio-dispatched*} nil)

(fun {lsp/send-response id result} {do
  (def {*captured-responses*}
    (qcons (list :id id :result result) *captured-responses*))
  nil
})

(fun {lsp/send-error id code message} {do
  (def {*captured-errors*}
    (qcons (list :id id :code code :message message) *captured-errors*))
  nil
})

(fun {lsp/send-notification method params} {do
  (def {*captured-notifications*}
    (qcons (list :method method :params params) *captured-notifications*))
  nil
})

(fun {lsp/send-init-error id message} {do
  (def {*captured-errors*}
    (qcons (list :id id :code -32602 :message message) *captured-errors*))
  nil
})

(fun {lsp/send-request id method params} {nil})
(fun {aio/stop sys} {def {*aio-stopped*} 1})
(fun {aio/dispatch sys fn arg cb} {do (= {r} (fn arg)) (cb r)})

(fun {reset-captures} {do
  (def {*captured-responses*} nil)
  (def {*captured-errors*} nil)
  (def {*captured-notifications*} nil)
  (def {*aio-stopped*} 0)
  (def {*aio-dispatched*} nil)
})

(fun {last-response} {
  if (nil? *captured-responses*) {nil}
  {head *captured-responses*}
})

(fun {last-error} {
  if (nil? *captured-errors*) {nil}
  {head *captured-errors*}
})

(fun {last-notification} {
  if (nil? *captured-notifications*) {nil}
  {head *captured-notifications*}
})

; --- State reset helper ---

(fun {reset-state} {do
  (def {lsp/initialized} 0)
  (def {lsp/shutdown-requested} 0)
  (def {lsp/documents} (dict/new))
  (def {lsp/db} nil)
  (def {lsp/idx-db} nil)
  (def {lsp/root-path} nil)
  (def {lsp/known-set-cache} nil)
  (def {lsp/progress-token} 0)
  (def {lsp/doc-version} 0)
  (def {lsp/ast-cache} (dict/new))
  (reset-captures)
})

(test/run (list

  ; =========================================================================
  ; Handler tests (with response capture)
  ; =========================================================================

  ; --- handle-hover ---

  (test/case "handle-hover-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (nav/handle-hover 1 (TextDocPosParams :textDocument (LspTextDoc :uri "file:///x") :position (LspPosition :line 0 :character 0)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (test/assert-eq 1 resp:id "id=1")
    })

  (test/case "handle-hover-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///h.valk" "hello world")
      (reset-captures)
      (nav/handle-hover 2 (TextDocPosParams :textDocument (LspTextDoc :uri "file:///h.valk") :position (LspPosition :line 0 :character 0)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should send response")
      (= {result} resp:result)
      (= {contents} result:contents)
      (test/assert-eq "markdown" contents:kind "markdown kind")
      (test/assert (not (== -1 (str/index-of contents:value "hello")))
        "hover contains word")
    })

  ; --- handle-completion ---

  (test/case "handle-completion-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (nav/handle-completion 3 (TextDocPosParams :textDocument (LspTextDoc :uri "file:///c") :position (LspPosition :line 0 :character 0)))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should respond")
    })

  (test/case "handle-completion-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///c.valk" "(fu")
      (reset-captures)
      (nav/handle-completion 4 (TextDocPosParams :textDocument (LspTextDoc :uri "file:///c.valk") :position (LspPosition :line 0 :character 3)))
      (= {resp} (last-response))
      (= {result} resp:result)
      (= {items} result:items)
      (test/assert (not (nil? items)) "should have completion items")
    })

  (test/case "handle-completion-in-string"
    {do
      (reset-state)
      (lsp/doc-store "file:///s.valk" "(print \"hello\")")
      (reset-captures)
      (nav/handle-completion 5 (TextDocPosParams :textDocument (LspTextDoc :uri "file:///s.valk") :position (LspPosition :line 0 :character 9)))
      (= {resp} (last-response))
      (= {result} resp:result)
      (= {items} result:items)
      (test/assert (nil? items) "no completions inside string")
    })

  ; --- handle-semantic-tokens ---

  (test/case "handle-semantic-tokens-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (nav/handle-semantic-tokens 6 (DocParams :textDocument (LspTextDoc :uri "file:///s")))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (nil? result:data) "no data for missing doc")
    })

  (test/case "handle-semantic-tokens-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///tok.valk" "(fun {f x} {+ x 1})")
      (reset-captures)
      (nav/handle-semantic-tokens 7 (DocParams :textDocument (LspTextDoc :uri "file:///tok.valk")))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result:data)) "should have token data")
    })

  ; --- handle-semantic-tokens-range ---

  (test/case "handle-semantic-tokens-range"
    {do
      (reset-state)
      (lsp/doc-store "file:///tr.valk" "(fun {f x}\n  (+ x 1))")
      (reset-captures)
      (lsp/handle-semantic-tokens-range 8
        (RangeParams :textDocument (LspTextDoc :uri "file:///tr.valk")
              :range (LspRange :start (LspPosition :line 0 :character 0) :end (LspPosition :line 0 :character 99))))
      (= {resp} (last-response))
      (test/assert (not (nil? resp)) "should respond")
    })

  ; --- handle-prepare-rename ---

  (test/case "handle-prepare-rename-found"
