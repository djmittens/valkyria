  ; --- handle-document-link ---

  (test/case "handle-document-link-with-loads"
    {do
      (reset-state)
      (def {lsp/root-path} "/project")
      (lsp/doc-store "file:///doc.valk" "(load \"src/prelude.valk\")")
      (reset-captures)
      (features/handle-document-link 11
        (DocParams :textDocument (LspTextDoc :uri "file:///doc.valk")))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should have links")
    })

  (test/case "handle-document-link-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (features/handle-document-link 12
        (DocParams :textDocument (LspTextDoc :uri "file:///nope")))
      (= {resp} (last-response))
      (test/assert (nil? resp:result) "no doc -> nil")
    })

  ; --- handle-folding-range ---

  (test/case "handle-folding-range-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///fold.valk" "(fun {f x}\n  (+ x 1))")
      (reset-captures)
      (features/handle-folding-range 13
        (DocParams :textDocument (LspTextDoc :uri "file:///fold.valk")))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should have folding ranges")
