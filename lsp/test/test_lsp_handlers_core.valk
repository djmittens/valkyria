  (test/case "handle-folding-range-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (features/handle-folding-range 14
        (DocParams :textDocument (LspTextDoc :uri "file:///nope")))
      (= {resp} (last-response))
      (test/assert (nil? resp:result) "no doc -> nil")
    })

  ; =========================================================================
  ; Incremental text sync
  ; =========================================================================

  (test/case "apply-one-change-full-replace"
    {do
      (= {result} (lsp/apply-one-change "hello world" (list :text "goodbye")))
      (test/assert-eq "goodbye" result "nil range = full replace")
    })

  (test/case "apply-one-change-insert"
    {do
      (= {result} (lsp/apply-one-change "hello world"
        (list :range (list :start (list :line 0 :character 5)
                           :end (list :line 0 :character 5))
              :text " beautiful")))
      (test/assert-eq "hello beautiful world" result "insert at position 5")
    })

  (test/case "apply-one-change-delete"
    {do
      (= {result} (lsp/apply-one-change "hello world"
        (list :range (list :start (list :line 0 :character 5)
                           :end (list :line 0 :character 11))
              :text "")))
      (test/assert-eq "hello" result "delete from pos 5 to end")
    })

  (test/case "apply-one-change-replace"
    {do
      (= {result} (lsp/apply-one-change "hello world"
        (list :range (list :start (list :line 0 :character 6)
                           :end (list :line 0 :character 11))
              :text "earth")))
      (test/assert-eq "hello earth" result "replace world with earth")
    })

  (test/case "apply-one-change-multiline"
    {do
      (= {result} (lsp/apply-one-change "line1\nline2\nline3"
        (list :range (list :start (list :line 0 :character 5)
                           :end (list :line 1 :character 5))
              :text "\nnew")))
      (test/assert-eq "line1\nnew\nline3" result "replace across lines")
    })

  ; The incremental splice turns the client's `character` into a byte
  ; offset directly. With positionEncoding utf-8 that is exactly right;
  ; if the encoding contract ever slips, an edit after multi-byte text
  ; lands mid-codepoint and corrupts the document.
  (test/case "apply-one-change-after-multibyte"
    {do
      (= {text} "héllo — wörld")
      ; Byte index of "wörld": "héllo" is 6 bytes, " — " is 5, so 11.
      (= {result} (lsp/apply-one-change text
        (list :range (list :start (list :line 0 :character 11)
                           :end (list :line 0 :character 17))
              :text "earth")))
      (test/assert-eq "héllo — earth" result
        "byte columns must cut cleanly around multi-byte text")
    })

  (test/case "apply-one-change-multibyte-first-line"
    {do
      (= {text} "; kommentar — ä\n(f x)")
      (= {result} (lsp/apply-one-change text
        (list :range (list :start (list :line 1 :character 3)
                           :end (list :line 1 :character 4))
              :text "y")))
      (test/assert-eq "; kommentar — ä\n(f y)" result
        "a multi-byte line above must not shift the edit below it")
    })

  (test/case "apply-changes-empty"
    {do
      (= {result} (lsp/apply-changes "unchanged" nil))
      (test/assert-eq "unchanged" result "empty changes = no change")
    })

  ; =========================================================================
  ; line:col -> offset conversion (str/lc->offset builtin)
  ; =========================================================================

  (test/case "lc-to-offset-basic"
    {do
      (test/assert-eq 0 (str/lc->offset "ab\ncd\nef" 0 0) "line 0 col 0")
      (test/assert-eq 1 (str/lc->offset "ab\ncd\nef" 0 1) "line 0 col 1")
      (test/assert-eq 3 (str/lc->offset "ab\ncd\nef" 1 0) "line 1 col 0")
      (test/assert-eq 7 (str/lc->offset "ab\ncd\nef" 2 1) "line 2 col 1")
    })

  (test/case "lc-to-offset-out-of-range"
    {do
      (test/assert-eq 0 (str/lc->offset "ab\ncd" 5 0) "line past end = 0")
      (test/assert-eq 0 (str/lc->offset "hello" 1 0) "no newline, line 1 = 0")
      (test/assert-eq 0 (str/lc->offset "ab" -1 0) "negative line = 0")
    })

  ; =========================================================================
  ; Incremental didChange flow
  ; =========================================================================

  (test/case "did-change-incremental-updates-text"
    {do
      (reset-state)
      (lsp/doc-store "file:///inc.valk" "(+ 1 2)")
      (reset-captures)
      (lsp/handle-did-change
        (ChangeParams
          :textDocument (LspTextDoc :uri "file:///inc.valk")
          :contentChanges (list
            (list :range (list :start (list :line 0 :character 3)
                               :end (list :line 0 :character 4))
                  :text "10"))))
      (= {stored} (lsp/doc-get "file:///inc.valk"))
      (test/assert-eq "(+ 10 2)" stored "text should be incrementally updated")
    })

  (test/case "did-change-full-fallback"
    {do
      (reset-state)
      (lsp/doc-store "file:///full.valk" "old")
      (reset-captures)
      (lsp/handle-did-change
        (ChangeParams
          :textDocument (LspTextDoc :uri "file:///full.valk")
          :contentChanges (list (list :text "new"))))
      (= {stored} (lsp/doc-get "file:///full.valk"))
      (test/assert-eq "new" stored "full replace when no range")
    })

  (test/case "did-change-bumps-version"
    {do
      (reset-state)
      (lsp/doc-store "file:///ver.valk" "x")
      (= {v1} lsp/doc-version)
      (lsp/handle-did-change
        (ChangeParams
          :textDocument (LspTextDoc :uri "file:///ver.valk")
          :contentChanges (list (list :text "y"))))
      (test/assert (> lsp/doc-version v1) "version should increment")
    })

  (test/case "did-open-bumps-version"
    {do
      (reset-state)
      (= {v1} lsp/doc-version)
      (lsp/handle-did-open
        (OpenParams :textDocument (LspTextDocText :uri "file:///op.valk" :text "hello")))
      (test/assert (> lsp/doc-version v1) "version should increment on open")
      (test/assert-eq "hello" (lsp/doc-get "file:///op.valk") "text stored")
    })

  (test/case "did-close-clears-caches"
    {do
      (reset-state)
      (lsp/doc-store "file:///cl.valk" "text")
      (lsp/cache-ast "file:///cl.valk" "text")
      (reset-captures)
      (lsp/handle-did-close (DocParams :textDocument (LspTextDoc :uri "file:///cl.valk")))
      (test/assert (nil? (lsp/doc-get "file:///cl.valk")) "doc removed")
      (test/assert (nil? (dict/get lsp/ast-cache "file:///cl.valk")) "ast cache removed")
    })

  ; --- handle-selection-range ---

  (test/case "handle-selection-range-with-doc"
    {do
      (reset-state)
      (lsp/doc-store "file:///sel.valk" "(fun {f x} (+ x 1))")
      (reset-captures)
      (features/handle-selection-range 15
        (SelectionParams :textDocument (LspTextDoc :uri "file:///sel.valk")
              :positions (list (list :line 0 :character 14))))
      (= {resp} (last-response))
      (= {result} resp:result)
      (test/assert (not (nil? result)) "should have selection ranges")
    })

