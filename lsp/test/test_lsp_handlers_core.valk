  (test/case "handle-signature-help-no-doc"
    {do
      (reset-state)
      (reset-captures)
      (features/handle-signature-help 20
        (TextDocPosParams :textDocument (LspTextDoc :uri "file:///nope") :position (LspPosition :line 0 :character 0)))
      (= {resp} (last-response))
