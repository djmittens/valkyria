(load "testing/test.valk")

(test/run (list
  (test/case "lsp-parses-without-errors"
    {do
    (= {text} (read-file "lsp/lsp.valk"))
    (test/assert (not (error? text)) "should read lsp.valk")
    (= {ast} (parse text))
    (test/assert (not (error? ast)) (str "lsp.valk should parse: " ast))
    true
  })
  (test/case "lsp-analysis-parses"
    {do
    (= {text} (read-file "lsp/analysis.valk"))
    (test/assert (not (error? text)) "should read lsp-analysis.valk")
    (= {ast} (parse text))
    (test/assert (not (error? ast)) (str "lsp-analysis.valk should parse: " ast))
    true
  })
  (test/case "lsp-validate-parses"
    {do
    (= {text} (read-file "symdb/validate.valk"))
    (test/assert (not (error? text)) "should read lsp-validate.valk")
    (= {ast} (parse text))
    (test/assert (not (error? ast)) (str "lsp-validate.valk should parse: " ast))
    true
  })
  (test/case "lsp-hints-parses"
    {do
    (= {text} (read-file "lsp/hints.valk"))
    (test/assert (not (error? text)) "should read lsp-hints.valk")
    (= {ast} (parse text))
    (test/assert (not (error? ast)) (str "lsp-hints.valk should parse: " ast))
    true
  })
  (test/case "lsp-loads-without-validation-errors"
    {do
    (load "lsp/lsp.valk")
    (test/assert (not (nil? lsp/start)) "lsp/start should be defined after load")
    true
  })
))
