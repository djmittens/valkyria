; LSP Inlay Hints — parameter name hints for function calls
;
; Walks the AST to find function calls and emits parameter name hints
; using known function signatures from local definitions and symdb.
;
; IMPORTANT: AST nodes must never be stored via = or def.
; Pass through function arguments only.

(load "symdb/symdb.valk")
(load "lsp/io.valk")

(module hint)

(def {HINT_SKIP_FORMS}
  (dict/from-keys {"fun" "\\" "def" "=" "if" "do" "match" "select" "case"
   "type" "sig" "load" "let" "and" "or" "not" "quote"
   "quasiquote" "unquote" "unquote-splicing"
   "aio/let" "aio/do" "ctx/with" "ctx/with-deadline"
   "eval" "read" "<-"}))

(def {HINT_OPERATOR_SET}
  (dict/from-keys {"+" "-" "*" "/" ">" "<" ">=" "<=" "==" "!=" "%" "ord"}))

; ---------------------------------------------------------------------------
; First pass: collect local fun params from AST
; Returns plist mapping function-name -> param-names-list
; ---------------------------------------------------------------------------

(sig 'collect-local-params {-> List List})
(fun {collect-local-params ast} {
  params-walk ast nil
})

(sig 'params-walk {-> List List List})
(fun {params-walk exprs params} {
  if (nil? exprs) {params}
  {do
    (= {h} (head exprs))
    (params-walk (tail exprs)
      (if (error? h) {params}
        {params-one h params}))}})

(sig 'params-one {-> Any List List})
(fun {params-one expr params} {
  if (not (list? expr)) {params}
  {if (nil? expr) {params}
  {do
    (= {name} (ast/head-name expr))
    (if (== name "") {params-walk (tail expr) params}
    {if (== name "fun") {params-from-fun (tail expr) params}
    {if (== name "\\") {params-walk-lambda (tail expr) params}
    {params-walk (tail expr) params}}})}}
})

(sig 'params-walk-lambda {-> List List List})
(fun {params-walk-lambda tl params} {
  if (< (len tl) 2) {params}
  {params-walk (tail tl) params}
})

(sig 'params-from-fun {-> List List List})
(fun {params-from-fun tl params} {
  if (< (len tl) 2) {params}
  {do
    (= {params2} (params-from-formals (head tl) params))
    (params-walk (tail tl) params2)}
})

(sig 'params-from-formals {-> List List List})
(fun {params-from-formals formals params} {
  if (not (list? formals)) {params}
  {if (nil? formals) {params}
  {params-extract (head formals) (tail formals) params}}
})

(sig 'params-extract {-> Str List List List})
(fun {params-extract fname rest params} {
  if (not (sym? fname)) {params}
  {plist/set params (str fname) (filter-formals rest nil)}
})

; ---------------------------------------------------------------------------
; Filter param list: extract names, stop at &, skip :: and -> annotations
; ---------------------------------------------------------------------------

(sig 'filter-formals {-> List List List})
(fun {filter-formals formals acc} {
  if (nil? formals) {reverse acc}
  {filter-one (head formals) (tail formals) acc}
})

(sig 'filter-one {-> Any List List List})
(fun {filter-one p rest acc} {
  if (not (sym? p)) {filter-formals rest acc}
  {filter-str (str p) rest acc}
})

(sig 'filter-str {-> Str List List List})
(fun {filter-str name rest acc} {
  if (== name "&") {reverse acc}
  {if (== name "::") {skip-ann rest acc}
  {if (== name "->") {skip-ann rest acc}
  {filter-formals rest (qcons name acc)}}}
})

(sig 'skip-ann {-> List List List})
(fun {skip-ann rest acc} {
  if (nil? rest) {reverse acc}
  {filter-formals (tail rest) acc}
})

; ---------------------------------------------------------------------------
; Parse params from symdb sig string
; sig format: "(fun {name p1 p2 ...} ...)"
; ---------------------------------------------------------------------------

(sig 'parse-sig-params {-> Str List})
(fun {parse-sig-params sig} {
  if (nil? sig) {nil}
  {do
    (= {brace-parts} (str/split sig "{"))
    (if (<= (len brace-parts) 1) {nil}
      {do
        (= {close-parts} (str/split (nth 2 brace-parts) "}"))
        (if (nil? close-parts) {nil}
          {do
            (= {words} (str/split (head close-parts) " "))
            (if (<= (len words) 1) {nil}
              {filter-sig-words (tail words) nil})})})}
})

(sig 'filter-sig-words {-> List List List})
(fun {filter-sig-words words acc} {
  if (nil? words) {reverse acc}
  {do
    (= {w} (head words))
    (if (== (len w) 0) {filter-sig-words (tail words) acc}
    {if (== w "&") {reverse acc}
    {if (== w "::") {skip-sig-ann (tail words) acc}
    {if (== w "->") {skip-sig-ann (tail words) acc}
    {if (== w "...") {reverse acc}
    {filter-sig-words (tail words) (qcons w acc)}}}}})}
})

(sig 'skip-sig-ann {-> List List List})
(fun {skip-sig-ann rest acc} {
  if (nil? rest) {reverse acc}
  {filter-sig-words (tail rest) acc}
})

; ---------------------------------------------------------------------------
; Combine param names with types from a "{-> T1 T2 R}" sig string
; ---------------------------------------------------------------------------

(sig 'scan-type-words {-> Str Num Num Num Num List})
(fun {scan-type-words text pos end depth wstart acc} {
  if (>= pos end)
    {reverse (if (< wstart pos) {qcons (str/slice text wstart pos) acc} {acc})}
  {do
    (= {ch} (str/slice text pos (+ pos 1)))
    (if (or (== ch "(") (== ch "{"))
      {scan-type-words text (+ pos 1) end (+ depth 1) wstart acc}
    {if (or (== ch ")") (== ch "}"))
      {scan-type-words text (+ pos 1) end (- depth 1) wstart acc}
    {if (if (== depth 0) {== ch " "} {0})
      {scan-type-words text (+ pos 1) end depth (+ pos 1)
        (if (< wstart pos) {qcons (str/slice text wstart pos) acc} {acc})}
      {scan-type-words text (+ pos 1) end depth wstart acc}}})}
})

(sig 'parse-sig-types {-> Str List})
(fun {parse-sig-types sig} {
  if (nil? sig) {nil}
  {if (< (len sig) 5) {nil}
  {if (not (str/starts-with? sig "{-> ")) {nil}
  {do
    (= {inner} (str/slice sig 4 (- (len sig) 1)))
    (scan-type-words inner 0 (len inner) 0 0 nil)}}}
})

(sig 'zip-typed-params {-> List List List})
(fun {zip-typed-params names types} {
  if (nil? names) {nil}
  {qcons (str (head names) " :: " (head types))
    (zip-typed-params (tail names) (tail types))}
})

(sig 'sig-typed-params {-> List Str Any})
(fun {sig-typed-params params sig-str} {do
  (= {types} (parse-sig-types sig-str))
  (if (nil? types) {nil}
  {if (nil? params) {nil}
  {if (not (== (len types) (+ (len params) 1))) {nil}
  {zip-typed-params params types}}})
})

(sig 'typed-sig-str {-> Str List Str Any})
(fun {typed-sig-str name params sig-str} {do
  (= {pairs} (sig-typed-params params sig-str))
  (if (nil? pairs) {nil}
    {do
      (= {types} (parse-sig-types sig-str))
      (str "(fun {" name " " (str/join pairs " ") " -> " (last types) "})")})
})

; ---------------------------------------------------------------------------
; Lazy per-name symdb lookup, memoized per indexing run
; ---------------------------------------------------------------------------
; A file with hundreds of call sites used to issue one query per call even
; when the same function repeated; the memo collapses that to one query per
; distinct name. Reset at the start of every collection run
; (hint/collect-from-ast) so entries never outlive one request and can't
; report a sig that another file's edit has since changed. Each entry
; stores (db result) so a hit is only valid for the same connection — ref
; equality is identity — which keeps callers with different DBs (tests,
; lsp/db vs lsp/idx-db) from seeing each other's rows. A nil result is
; still a valid entry ("queried, no row"), distinguished from a miss by the
; entry's presence.

(def {query-cache} (dict/new))

(sig 'reset-query-cache {-> Nil})
(fun {reset-query-cache} {do
  (def {hint/query-cache} (dict/new))
  nil})

; ---------------------------------------------------------------------------
; Module qualification — mirrors the indexer (lsp_index_emit.c valk_lspi_qualify)
; ---------------------------------------------------------------------------
; A file with `(module X)` has its top-level defs stored in symdb as `X/name`,
; matching the runtime rewrite. The AST still spells them bare, so a lookup by
; the bare name misses every module-local sig — that is why params of
; `(fun {handle-initialize id params} ...)` got no type hints while
; `lsp/sync-doc` (written pre-qualified) did. Try the qualified name first,
; since the module binding shadows any global of the same name.

(def {module-prefix} "")

; Canonical path of the document being hinted — set per request alongside
; the module prefix, so DB lookups resolve through its load closure.
(def {doc-path} "")

(sig 'set-doc-path {-> Str Nil})
(fun {set-doc-path p} {do
  (def {hint/doc-path} (if (nil? p) {""} {p}))
  nil})

(sig 'module-of-form {-> Any Str})
(fun {module-of-form form} {
  if (not (list? form)) {""}
  {if (< (len form) 2) {""}
  {if (not (== (ast/head-name form) "module")) {""}
  {do
    (= {m} (head (tail form)))
    (if (sym? m) {str m} {if (str? m) {m} {""}})}}}
})

(sig 'find-module-prefix {-> List Str})
(fun {find-module-prefix exprs} {
  if (nil? exprs) {""}
  {do
    ; `parse` keeps parse errors as LVAL_ERR elements of the top-level
    ; list, so a mid-edit document puts one in this walk. Under BYOL an
    ; error argument short-circuits the call itself, so the guard has to
    ; sit here rather than inside hint/module-of-form: without it the
    ; error becomes hint/module-prefix and poisons every hint and
    ; signature-help lookup until the document parses cleanly again.
    (= {form} (head exprs))
    (= {p} (if (error? form) {""} {module-of-form form}))
    (if (> (len p) 0) {p} {find-module-prefix (tail exprs)})}
})

(sig 'set-module-from-ast {-> List Nil})
(fun {set-module-from-ast ast} {do
  ; Nested def: names are not auto-qualified below top level.
  (def {hint/module-prefix}
    (if (error? ast) {""} {if (list? ast) {find-module-prefix ast} {""}}))
  nil})

(sig 'qualify {-> Str Str})
(fun {qualify name} {
  if (== (len module-prefix) 0) {name}
  {if (<= (len name) 0) {name}
  {if (>= (str/index-of name "/") 0) {name}
  {if (== (str/slice name 0 1) ":") {name}
  {str module-prefix "/" name}}}}
})

(sig 'cache-lookup {-> Ref Str Any})
(fun {cache-lookup db ck} {do
  (= {hit} (dict/get query-cache ck))
  (if (nil? hit) {nil}
    {if (== (head hit) db) {tail hit} {nil}})
})

(sig 'query-params-row {-> Ref Str Any})
(fun {query-params-row db name} {
  symdb/fun-sig-of db doc-path name
})

(sig 'query-db-params {-> Ref Str List})
(fun {query-db-params db name} {
  if (nil? db) {nil}
  {do
    (= {ck} (str "p:" name))
    (= {hit} (cache-lookup db ck))
    (if (not (nil? hit)) {head hit}
      {do
        (= {qname} (qualify name))
        (= {row} (if (== qname name) {nil} {query-params-row db qname}))
        (= {row} (if (nil? row) {query-params-row db name} {row}))
        (= {result} (if (nil? row) {nil} {parse-sig-params row:sig}))
        (dict/set! query-cache ck (list db result))
        result})}
})

; ---------------------------------------------------------------------------
; Walk AST and collect hints
; ---------------------------------------------------------------------------

; The guard belongs at the call site: an LVAL_ERR argument short-circuits
; the call it is passed to, so one broken top-level form would otherwise
; make every pass return that error and the document lose all its hints.
(sig 'walk-exprs {-> List List List List})
(fun {walk-exprs exprs ctx acc} {
  if (nil? exprs) {acc}
  {do
    (= {e} (head exprs))
    (walk-exprs (tail exprs) ctx
      (if (error? e) {acc} {walk-code e ctx acc}))}
})

(sig 'walk-code {-> Any List List List})
(fun {walk-code expr ctx acc} {
  if (nil? expr) {acc}
  {if (not (list? expr)) {acc}
  {do
    (= {name} (ast/head-name expr))
    (if (== name "")
      {walk-exprs (tail expr) ctx acc}
      {walk-dispatch name (tail expr) ctx acc})}}
})

(sig 'walk-dispatch {-> Str List List List List})
(fun {walk-dispatch name tl ctx acc} {
  if (dict/has? HINT_SKIP_FORMS name)
    {walk-special name tl ctx acc}
  {if (dict/has? HINT_OPERATOR_SET name)
    {walk-exprs tl ctx acc}
  {walk-call name tl ctx acc}}
})

; ---------------------------------------------------------------------------
; Special forms: walk sub-expressions but skip formals/bindings
; ---------------------------------------------------------------------------

(sig 'walk-special {-> Str List List List List})
(fun {walk-special name tl ctx acc} {
  if (== name "fun") {walk-fun-body tl ctx acc}
  {if (== name "\\") {walk-fun-body tl ctx acc}
  {if (== name "def") {walk-def-vals tl ctx acc}
  {if (== name "=") {walk-def-vals tl ctx acc}
  {if (== name "type") {acc}
  {if (== name "sig") {acc}
  {if (== name "load") {acc}
  {walk-exprs tl ctx acc}}}}}}}
})

(sig 'walk-fun-body {-> List List List List})
(fun {walk-fun-body tl ctx acc} {
  if (< (len tl) 2) {acc}
  {walk-code (head (tail tl)) ctx acc}
})

(sig 'walk-def-vals {-> List List List List})
(fun {walk-def-vals tl ctx acc} {
  if (nil? tl) {acc}
  {walk-exprs (tail tl) ctx acc}
})

; ---------------------------------------------------------------------------
; Function call: emit param hints + recurse into args
; ---------------------------------------------------------------------------

(sig 'walk-call {-> Str List List List List})
(fun {walk-call name args ctx acc} {do
  (= {params} (lookup-params name ctx))
  (= {acc2} (if (nil? params) {acc}
    {if (< (len args) 2) {acc}
    {emit-param-hints args params acc}}))
  (walk-exprs args ctx acc2)
})

(sig 'lookup-params {-> Str HintCtx List})
(fun {lookup-params name ctx} {do
  (= {local} (plist/get ctx:local name))
  (if (not (nil? local)) {local}
    {query-db-params ctx:db name})
})

; ---------------------------------------------------------------------------
; Emit parameter hints: match args to param names
; ---------------------------------------------------------------------------

(sig 'emit-param-hints {-> List List List List})
(fun {emit-param-hints args params acc} {
  if (nil? args) {acc}
  {if (nil? params) {acc}
  {emit-one (head args) (head params)
    (tail args) (tail params) acc}}
})

(sig 'emit-one {-> Any Str List List List List})
(fun {emit-one arg param-name rest-args rest-params acc} {
  emit-param-hints rest-args rest-params
    (if (skip-hint? arg param-name) {acc}
    {do
      (= {pos} (src-pos arg))
      (if (< pos 0) {acc}
        {qcons (list :offset pos :label (str param-name ":") :kind 2
                     :paddingRight :true) acc})})
})

(sig 'skip-hint? {-> Any Str Num})
(fun {skip-hint? arg param-name} {
  if (not (sym? arg)) {0}
  {do
    (= {name} (str arg))
    (if (<= (len name) 0) {0}
    {if (== (str/slice name 0 1) ":") {1}
    {== name param-name}})}
})

; ---------------------------------------------------------------------------
; Format hints for LSP response
; ---------------------------------------------------------------------------

(sig 'insert-sorted {-> List List List})
(fun {insert-sorted item sorted} {
  if (nil? sorted) {list item}
  {if (<= (plist/get item :offset) (plist/get (head sorted) :offset))
    {qcons item sorted}
    {qcons (head sorted) (insert-sorted item (tail sorted))}}
})

(sig 'sort-by-offset {-> List List List})
(fun {sort-by-offset hints acc} {
  if (nil? hints) {acc}
  {sort-by-offset (tail hints) (insert-sorted (head hints) acc)}
})

(sig 'format-hints {-> List Str List List})
(fun {format-hints raw-hints text range} {
  if (nil? raw-hints) {nil}
  {do
    (= {sorted} (sort-by-offset raw-hints nil))
    (= {offsets} (map (\ {h} {plist/get h :offset}) sorted))
    (= {lcs} (offsets->line-cols text offsets))
    (format-with-lcs sorted lcs text range nil)}
})

(sig 'format-with-lcs {-> List List Str List List List})
(fun {format-with-lcs hints lcs text range acc} {
  if (nil? hints) {acc}
  {if (nil? lcs) {acc}
  {do
    (= {h} (head hints))
    (= {lc} (head lcs))
    (= {line} (head lc))
    (= {col} (head (tail lc)))
    (= {padL} (plist/get h :paddingLeft))
    (= {padR} (plist/get h :paddingRight))
    (= {formatted} (list :position (list :line line :character col)
                         :label h:label
                         :kind h:kind))
    (= {formatted} (if (not (nil? padL))
      {plist/set formatted :paddingLeft padL} {formatted}))
    (= {formatted} (if (not (nil? padR))
      {plist/set formatted :paddingRight padR} {formatted}))
    (format-with-lcs (tail hints) (tail lcs) text range
      (if (in-range? line range)
        {qcons formatted acc}
        {acc}))}}
})

(sig 'format-db-rows {-> List Str List List})
(fun {format-db-rows rows text range} {
  format-db-loop rows text range nil
})

(sig 'format-db-loop {-> List Str List List List})
(fun {format-db-loop rows text range acc} {
  if (nil? rows) {acc}
  {do
    (= {r} (head rows))
    (= {pos} (plist/get r :pos))
    (= {label} (plist/get r :label))
    (= {kind} (plist/get r :kind))
    (= {pad} (plist/get r :padding))
    (= {pad} (if (nil? pad) {0} {pad}))
    (= {lc} (offset->line-col text pos))
    (= {line} (head lc))
    (= {col} (head (tail lc)))
    (= {formatted} (list :position (list :line line :character col)
                         :label label :kind kind))
    (= {formatted} (if (> (mod pad 2) 0)
      {plist/set formatted :paddingLeft :true} {formatted}))
    (= {formatted} (if (> (mod (/ pad 2) 2) 0)
      {plist/set formatted :paddingRight :true} {formatted}))
    (format-db-loop (tail rows) text range
      (if (in-range? line range)
        {qcons formatted acc}
        {acc}))}
})

(sig 'in-range? {-> Num List Num})
(fun {in-range? line range} {
  if (nil? range) {1}
  {do
    (= {start-pos} (plist/get range :start))
    (= {start-pos} (if (nil? start-pos) {nth 2 range} {start-pos}))
    (= {end-pos} (plist/get range :end))
    (= {end-pos} (if (nil? end-pos) {nth 3 range} {end-pos}))
    (= {start-line} (plist/get start-pos :line))
    (= {start-line} (if (nil? start-line) {nth 2 start-pos} {start-line}))
    (= {end-line} (plist/get end-pos :line))
    (= {end-line} (if (nil? end-line) {nth 2 end-pos} {end-line}))
    (and (>= line start-line) (<= line end-line))}
})

; ---------------------------------------------------------------------------
; Type hints — show types at definitions and bindings
; sig format in symdb: {-> ParamType1 ParamType2 ... ReturnType}
; ---------------------------------------------------------------------------

(sig 'count-char-loop {-> Str Str Num Num Num})
(fun {count-char-loop s ch pos count} {
  if (>= pos (len s)) {count}
  {count-char-loop s ch (+ pos 1)
    (if (== (str/slice s pos (+ pos 1)) ch) {+ count 1} {count})}
})

(sig 'count-char {-> Str Str Num})
(fun {count-char s ch} {
  count-char-loop s ch 0 0
})

(sig 'parse-sig-tokens {-> List Num Str List List})
(fun {parse-sig-tokens tokens depth current groups} {
  if (nil? tokens) {
    if (nil? current) {reverse groups}
    {reverse (qcons (str/join (reverse current) " ") groups)}}
  {do
    (= {tok} (head tokens))
    (= {rest} (tail tokens))
    (= {opens} (count-char tok "("))
    (= {closes} (count-char tok ")"))
    (= {new-depth} (+ (- (+ depth opens) closes) 0))
    (if (== new-depth 0)
      {if (nil? current)
        {parse-sig-tokens rest 0 nil (qcons tok groups)}
        {parse-sig-tokens rest 0 nil
          (qcons (str/join (reverse (qcons tok current)) " ") groups)}}
      {parse-sig-tokens rest new-depth (qcons tok current) groups})}
})

(sig 'parse-prefix-sig {-> Str List})
(fun {parse-prefix-sig sig-str} {
  if (nil? sig-str) {nil}
  {do
    (= {inner} (str/slice sig-str 1 (- (len sig-str) 1)))
    (= {tokens} (str/split inner " "))
    (if (< (len tokens) 2) {nil}
      {if (not (== (head tokens) "->")) {nil}
        {parse-sig-tokens (tail tokens) 0 nil nil}})}
})

(sig 'query-sig-row {-> Ref Str Any})
(fun {query-sig-row db name} {
  symdb/sig-of db doc-path name
})

(sig 'query-sig-types {-> Ref Str List})
(fun {query-sig-types db name} {
  if (nil? db) {nil}
  {do
    (= {ck} (str "s:" name))
    (= {hit} (cache-lookup db ck))
    (if (not (nil? hit)) {head hit}
      {do
        (= {qname} (qualify name))
        (= {row} (if (== qname name) {nil} {query-sig-row db qname}))
        (= {row} (if (nil? row) {query-sig-row db name} {row}))
        (= {result} (if (nil? row) {nil} {parse-prefix-sig row:sig}))
        (dict/set! query-cache ck (list db result))
        result})}
})

(sig 'infer-call-return-type {-> Str Ref Any})
(fun {infer-call-return-type name db} {
  if (nil? db) {nil}
  {do
    (= {sig-types} (query-sig-types db name))
    (if (nil? sig-types) {nil}
      {do
        (= {t} (last sig-types))
        (if (uninformative-type? t) {nil} {t})})}
})

; A declared `A` or `Any` says nothing about the value — `if` returns `A`
; and every `(= {x} (if ...))` was labelled `:: A`. Suppress it when the
; type is inferred; a sig that spells `A` still shows it on the param it
; was written for.
(sig 'uninformative-type? {-> Any Num})
(fun {uninformative-type? t} {
  if (nil? t) {1}
  {if (== t "Any") {1}
  {if (== (len t) 1) {is-ctor-name t}
  {0}}}
})

(sig 'skip-inline-ann {-> List List Num List List})
(fun {skip-inline-ann rest sig-types type-idx acc} {
  if (nil? rest) {acc}
  {emit-def-type-hints (tail rest) sig-types type-idx acc}
})

(sig 'emit-def-hint-sym {-> List Num List List Num List List})
(fun {emit-def-hint-sym ps pos rest sig-types type-idx acc} {
  if (== ps "::") {skip-inline-ann rest sig-types type-idx acc}
  {if (== ps "->") {acc}
  {if (== ps "&") {acc}
  {do
    (= {num-param-types} (- (len sig-types) 1))
    (= {type-str} (if (< type-idx num-param-types)
      {nth (+ type-idx 1) sig-types} {nil}))
    (= {acc2} (if (or (nil? type-str) (< pos 0)) {acc}
      {qcons (list :offset (+ pos (len ps)) :label (str ":: " type-str) :kind 1
                   :paddingLeft :true) acc}))
    (emit-def-type-hints rest sig-types (+ type-idx 1) acc2)}}}
})

(sig 'emit-def-hint-one {-> Any List List Num List List})
(fun {emit-def-hint-one p rest sig-types type-idx acc} {
  if (not (sym? p)) {emit-def-type-hints rest sig-types type-idx acc}
  {emit-def-hint-sym (str p) (src-pos p) rest sig-types type-idx acc}
})

(sig 'emit-def-type-hints {-> List List Num List List})
(fun {emit-def-type-hints params sig-types type-idx acc} {
  if (nil? params) {acc}
  {emit-def-hint-one (head params) (tail params) sig-types type-idx acc}
})

(sig 'infer-val-type {-> Any Ref Ref Any})
(fun {infer-val-type val db scope} {
  if (num? val) {"Num"}
  {if (str? val) {"Str"}
  {if (sym? val) {infer-sym-type (str val) db scope}
  {if (not (list? val)) {nil}
  {if (nil? val) {nil}
  {infer-from-head (head val) db}}}}}
})

; A bare symbol is a variable reference: its type is whatever the enclosing
; function's scope says. Without that, `(def {lsp/db-path} db-path)` got no
; hint while the `db-path` binding right above it did, which is the same
; type spelled two different ways.
(sig 'infer-sym-type {-> Str Ref Ref Any})
(fun {infer-sym-type name db scope} {do
  (= {local} (scope-lookup scope name))
  (if (not (nil? local)) {local}
    {infer-field-chain name db})
})

; Resolve chained field access like params:range:start:line
; by walking the type chain through symdb constructor sigs.
(sig 'infer-field-chain {-> Str Ref Any})
(fun {infer-field-chain name db} {do
  (= {colon} (str/index-of name ":"))
  (if (< colon 1) {nil}
    {if (nil? db) {nil}
      {do
        (= {resolved} (resolve-chain-fields
          (str ":" (str/slice name (+ colon 1) (len name))) db))
        (if (== resolved "Any") {nil} {resolved})}})
})

; Walk fields right-to-left: resolve the last field's type.
; For a:b:c — find any ctor with field :c, return its type.
; For a:b:c:d — find ctor with :d, but :d's context is the type of :c.
(sig 'resolve-chain-fields {-> Str Ref Any})
(fun {resolve-chain-fields fields db} {do
  (= {last-colon} (last-colon-pos fields 0 -1))
  (if (< last-colon 0) {nil}
    {do
      (= {field-key} (str/slice fields last-colon (len fields)))
      (= {prefix} (str/slice fields 0 last-colon))
      (= {parent-type} (if (== prefix "")
        {nil}
        {resolve-chain-fields prefix db}))
      (if (nil? parent-type)
        {lookup-any-field-type field-key db}
        {lookup-ctor-field-type parent-type field-key db})})
})

(sig 'last-colon-pos {-> Str Num Num Num})
(fun {last-colon-pos s i found} {
  if (>= i (len s)) {found}
  {last-colon-pos s (+ i 1)
    (if (== (str/slice s i (+ i 1)) ":") {i} {found})}
})

; Look up field type from a specific constructor
(sig 'lookup-ctor-field-type {-> Str Str Ref Any})
(fun {lookup-ctor-field-type ctor-name field-key db} {do
  (= {row} (symdb/ctor-sig-of db doc-path ctor-name))
  (if (nil? row) {nil}
    {extract-field-from-sig row:sig field-key})
})

; Look up field type from any constructor that has this field
(sig 'lookup-any-field-type {-> Str Ref Any})
(fun {lookup-any-field-type field-key db} {do
  (= {row} (symdb/ctor-sig-with-field db doc-path (str "%" field-key " %")))
  (if (nil? row) {nil}
    {extract-field-from-sig row:sig field-key})
})

; Extract field type from a sig like ":line Num :character Num"
(sig 'extract-field-from-sig {-> Str Str Any})
(fun {extract-field-from-sig sig field-key} {do
  (= {parts} (str/split sig " "))
  (find-field-in-parts parts field-key)
})

(sig 'find-field-in-parts {-> List Str Any})
(fun {find-field-in-parts parts field-key} {
  if (nil? parts) {nil}
  {if (< (len parts) 2) {nil}
  {if (== (head parts) field-key) {nth 2 parts}
    {find-field-in-parts (tail parts) field-key}}}
})

(sig 'infer-from-head {-> Any Ref Any})
(fun {infer-from-head hd db} {
  if (not (sym? hd)) {nil}
  {infer-by-name (str hd) db}
})

(sig 'infer-by-name {-> Str Ref Any})
(fun {infer-by-name n db} {
  if (== n "list") {"List"}
  {if (== n "dict/new") {"Dict"}
  {if (== n "dict/from-keys") {"Dict"}
  {if (== n "None") {"Option"}
  {if (== n "Some") {"Option"}
  {if (== n "\\") {"Fn"}
  {if (== n "fun") {"Fn"}
  {if (is-ctor-name n) {n}
  {infer-call-return-type n db}}}}}}}}
})

(sig 'is-ctor-name {-> Str Num})
(fun {is-ctor-name n} {
  if (<= (len n) 0) {0}
  {do
    (= {c} (str/slice n 0 1))
    (>= (str/index-of "ABCDEFGHIJKLMNOPQRSTUVWXYZ" c) 0)}
})

; ---------------------------------------------------------------------------
; Variable scope — name -> type for the bindings in view
; ---------------------------------------------------------------------------
; A mutable dict, filled by the same walk that emits the hints: each binding
; is inferred once, then recorded, so the next one can name it. That is what
; lets `(def {lsp/db-path} db-path)` say `:: Str` — the binding it copies is
; already in scope.
;
; A `fun` gets a child dict seeded with the enclosing scope and its own
; params (typed from its sig), so it can see closed-over names without its
; own bindings escaping. Lambdas deliberately share the enclosing dict: they
; are walked inline, and their bodies read the surrounding bindings.

(sig 'scope-child {-> List List Ref Ref})
(fun {scope-child params sig-types outer} {do
  (= {child} (dict/new))
  (scope-copy-entries (if (nil? outer) {nil} {dict/entries outer}) child)
  (scope-seed-params (filter-formals params nil) sig-types 0 child)
  child
})

(sig 'scope-copy-entries {-> List Ref Nil})
(fun {scope-copy-entries entries d} {
  if (nil? entries) {nil}
  {do
    (= {e} (head entries))
    (dict/set! d (head e) (head (tail e)))
    (scope-copy-entries (tail entries) d)}
})

(sig 'scope-seed-params {-> List List Num Ref Nil})
(fun {scope-seed-params names sig-types idx d} {
  if (nil? names) {nil}
  {if (>= idx (- (len sig-types) 1)) {nil}
  {do
    (dict/set! d (head names) (nth (+ idx 1) sig-types))
    (scope-seed-params (tail names) sig-types (+ idx 1) d)}}
})

(sig 'scope-lookup {-> Ref Str Any})
(fun {scope-lookup scope name} {
  if (nil? scope) {nil} {dict/get scope name}
})

(sig 'scope-put {-> Ref Str Str Nil})
(fun {scope-put scope name type-str} {
  if (nil? scope) {nil} {do (dict/set! scope name type-str) nil}
})

(sig 'emit-binding-hint {-> Any Any Str List List})
(fun {emit-binding-hint name-sym val type-str acc} {do
  ; Anchor the hint to the value expression so it lands BETWEEN the
  ; closing `}` of the formals and the value — "{name} :: Type val"
  ; rather than "{name :: Type} val", which looks like it's inside
  ; the identifier. Fall back to the end of the name-sym only if the
  ; value has no source position (synthesized AST).
  (= {vpos} (src-pos val))
  (= {npos} (src-pos name-sym))
  (= {ns} (str name-sym))
  (if (>= vpos 0)
    {qcons (list :offset vpos :label (str ":: " type-str) :kind 1
                 :paddingRight :true) acc}
    {if (< npos 0) {acc}
      {qcons (list :offset (+ npos (len ns)) :label (str ":: " type-str) :kind 1
                   :paddingLeft :true) acc}})
})

(sig 'type-from-fun {-> List Ref Ref List List})
(fun {type-from-fun tl db scope acc} {
  if (< (len tl) 2) {acc}
  {type-fun-with-parts (head tl) (head (tail tl)) db scope acc}
})

(sig 'type-fun-with-parts {-> List List Ref Ref List List})
(fun {type-fun-with-parts formals body db scope acc} {
  if (not (list? formals)) {acc}
  {if (nil? formals) {acc}
  {type-fun-extract (head formals) (tail formals) body db scope acc}}
})

(sig 'type-fun-extract {-> Str List List Ref Ref List List})
(fun {type-fun-extract fname params body db scope acc} {
  if (not (sym? fname)) {acc}
  {type-fun-emit (str fname) params body db scope acc}
})

(sig 'type-fun-emit {-> Str List List Ref Ref List List})
(fun {type-fun-emit name params body db scope acc} {do
  (= {sig-types} (query-sig-types db name))
  (= {acc2} (if (nil? sig-types) {acc}
    {emit-def-type-hints params sig-types 0 acc}))
  (= {ret-type} (if (or (nil? sig-types) (< (len sig-types) 2)) {nil}
    {last sig-types}))
  (= {acc3} (if (nil? ret-type) {acc2}
    {do
       (= {bpos} (src-pos body))
      (if (< bpos 0) {acc2}
        {qcons (list :offset bpos :label (str "-> " ret-type) :kind 1
                     :paddingRight :true) acc2})}))

  (type-one body db (scope-child params sig-types scope) acc3)
})

(sig 'type-from-def {-> List Ref Ref List List})
(fun {type-from-def tl db scope acc} {
  if (< (len tl) 2) {acc}
  {type-def-with-parts (head tl) (head (tail tl)) db scope acc}
})

(sig 'type-def-with-parts {-> List Any Ref Ref List List})
(fun {type-def-with-parts formals val db scope acc} {
  type-def-bind (binding-name formals) val db scope acc
})

(sig 'binding-name {-> Any Any})
(fun {binding-name formals} {
  if (not (list? formals)) {nil}
  {if (nil? formals) {nil}
  {do
    (= {h} (head formals))
    (if (sym? h) {h} {nil})}}
})

; The binding is recorded after its own hint is emitted and its value walked,
; so `(= {x} x)` still reads the outer x and a shadowing rebind only takes
; effect for the bindings that follow it.
(sig 'type-def-bind {-> Any Any Ref Ref List List})
(fun {type-def-bind name-sym val db scope acc} {
  if (nil? name-sym) {type-one val db scope acc}
  {do
    (= {type-str} (infer-val-type val db scope))
    (= {acc2} (if (nil? type-str) {acc}
      {emit-binding-hint name-sym val type-str acc}))
    (= {acc3} (type-one val db scope acc2))
    (if (nil? type-str) {acc3}
      {do (scope-put scope (str name-sym) type-str) acc3})}
})

(sig 'type-walk-body {-> List Ref Ref List List})
(fun {type-walk-body tl db scope acc} {
  if (< (len tl) 2) {acc}
  {type-one (head (tail tl)) db scope acc}
})

(sig 'type-one {-> Any Ref Ref List List})
(fun {type-one expr db scope acc} {
  if (not (list? expr)) {acc}
  {if (nil? expr) {acc}
  {type-dispatch (head expr) (tail expr) db scope acc}}
})

(sig 'type-dispatch {-> Any List Ref Ref List List})
(fun {type-dispatch hd tl db scope acc} {
  if (not (sym? hd)) {type-walk tl db scope acc}
  {type-by-name (str hd) tl db scope acc}
})

(sig 'type-by-name {-> Str List Ref Ref List List})
(fun {type-by-name n tl db scope acc} {
  if (== n "fun") {type-from-fun tl db scope acc}
  {if (== n "def") {type-from-def tl db scope acc}
  {if (== n "=") {type-from-def tl db scope acc}
  {if (== n "do") {type-walk tl db scope acc}
  {if (== n "\\") {type-walk-body tl db scope acc}
  {if (== n "if") {type-walk tl db scope acc}
  {if (== n "match") {type-walk tl db scope acc}
  {if (== n "let") {type-walk tl db scope acc}
  {type-walk tl db scope acc}}}}}}}}
})

(sig 'type-walk {-> List Ref Ref List List})
(fun {type-walk exprs db scope acc} {
  if (nil? exprs) {acc}
  {do
    (= {e} (head exprs))
    (type-walk (tail exprs) db scope
      (if (error? e) {acc} {type-one e db scope acc}))}
})

(sig 'collect-type-hints {-> List Ref List})
(fun {collect-type-hints ast db} {
  type-walk ast db (dict/new) nil
})

