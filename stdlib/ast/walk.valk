; ast/walk — generic AST walker with pluggable operations.
;
; C visitor (ast/visit) handles traversal, scope tracking, form recognition.
; Valk operations define what to DO with each node.
;
; Operations are plists of event handlers:
;   :on-sym (fn name pos len)        — symbol
;   :on-num (fn name pos)            — number
;   :on-str (fn name pos len)        — string
;   :on-call (fn name pos len)       — function call
;   :on-def (fn name pos is_global)  — binding
;   :on-fun (fn name params pos)     — function definition
;   :on-type (fn name fields pos)    — type definition
;   :on-sig (fn name sig_body pos)   — sig declaration
;   :on-param (fn name pos)          — parameter
;   :on-ref (fn name pos len scope)  — reference with scope

(module walk)

(sig 'ast/walk {-> List List Str Nil})
(fun {ast/walk ast ops text} {
  ast/visit ast ops
})
