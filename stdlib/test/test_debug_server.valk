; Debug wire protocol end-to-end: a target function pauses at a breakpoint
; set over HTTP; state/stack/bindings/eval are served while it is parked;
; continue resumes it.
; Run with: build/valk stdlib/test/test_debug_server.valk

(load "testing/test.valk")
(load "stdlib/aio/debug-server.valk")
(load "runtime/test/fixtures/debug_target.valk")

(def {fixture-path} (realpath "runtime/test/fixtures/debug_target.valk"))
(def {dbg-sys} (aio/await (aio/start {:num-threads 1})))
(def {work-sys} (aio/await (aio/start {:num-threads 2})))
(def {results} (dict/new))

(def {server} (debug/serve dbg-sys 0))
(def {dbg-port} (http2/server-port server))

(fun {sleep-ms ms} {aio/await (aio/schedule dbg-sys ms (\ {} {1}))})

(fun {get-json path} {do
  (= {resp} (aio/await (http2/client-request dbg-sys "127.0.0.1" dbg-port path)))
  (json/parse (http2/response-body resp))
})

(fun {post-json path body} {do
  (= {resp} (aio/await (http2/client-post dbg-sys "127.0.0.1" dbg-port path
                                          (json/encode body))))
  (json/parse (http2/response-body resp))
})

(fun {wait-paused-http tries} {
  (if (== tries 0)
    {0}
    {if (== (plist/get (get-json "/dbg/state") :paused) 1)
      {1}
      {do (sleep-ms 20) (wait-paused-http (- tries 1))}})
})

(fun {wait-paused-at-http line tries} {
  (if (== tries 0)
    {0}
    {do
      (= {st} (get-json "/dbg/state"))
      (if (and (== (plist/get st :paused) 1) (== (plist/get st :line) line))
        {1}
        {do (sleep-ms 20) (wait-paused-at-http line (- tries 1))})})
})

(fun {wait-threads-http n tries} {
  (if (== tries 0)
    {len (get-json "/dbg/threads")}
    {if (== (len (get-json "/dbg/threads")) n)
      {n}
      {do (sleep-ms 20) (wait-threads-http n (- tries 1))}})
})

; Busy work with source positions for the /dbg/pause case.
(fun {slow-busy n} {
  (if (== n 0)
    {42}
    {slow-busy (- n 1)})
})

(test/run (list

  (test/case "wire-breakpoint-lifecycle"
    {do
    (= {r} (post-json "/dbg/break" `{:file ,fixture-path :line 4}))
    (= {id} (plist/get r :id))
    (test/assert (> id 0) "breakpoint set over http")
    (= {bps} (get-json "/dbg/breakpoints"))
    (test/assert-eq 1 (len bps) "listed over http")
    (test/assert-eq 4 (plist/get (head bps) :line) "line served")
    (= {u} (post-json "/dbg/unbreak" `{:id ,id}))
    (test/assert-eq 1 (plist/get u :ok) "unbreak over http")
    (test/assert-eq 0 (len (get-json "/dbg/breakpoints")) "list empty")
    true
  })

  (test/case "wire-pause-inspect-eval-continue"
    {do
    (= {r} (post-json "/dbg/break" `{:file ,fixture-path :line 4}))
    (= {id} (plist/get r :id))

    (aio/dispatch work-sys
      (\ {_} {debug-target-fn 7})
      nil
      (\ {res} {do (dict/set! results "wire1" res) nil}))

    (test/assert-eq 1 (wait-paused-http 100) "paused visible over http")

    (= {st} (get-json "/dbg/state"))
    (test/assert-eq 4 (plist/get st :line) "line over http")
    (test/assert (str/contains? (plist/get st :file) "debug_target")
      "file over http")

    (= {stack} (get-json "/dbg/stack"))
    (test/assert (> (len stack) 0) "stack over http")
    (test/assert-eq "current" (plist/get (head stack) :kind) "frame 0 kind")

    (= {binds} (get-json "/dbg/frame/0/bindings"))
    (= {names} (map (\ {b} {plist/get b :name}) binds))
    (test/assert (exists "x" names) "argument in bindings")

    (= {ev} (post-json "/dbg/eval" {:frame 0 :expr "(+ x 100)"}))
    (test/assert-eq "107" (plist/get ev :result) "eval-in-frame over http")
    (test/assert-eq "ok" (plist/get ev :status) "eval status ok")

    (= {c} (post-json "/dbg/continue" {:frame 0}))
    (test/assert-eq 1 (plist/get c :ok) "continue over http")
    (sleep-ms 200)
    (test/assert-eq 24 (dict/get results "wire1" nil) "target completed: 8+16")
    (test/assert-eq 0 (plist/get (get-json "/dbg/state") :paused)
      "not paused after continue")
    (post-json "/dbg/unbreak" `{:id ,id})
    true
  })

  (test/case "wire-step-modes"
    {do
    (= {r} (post-json "/dbg/break" `{:file ,fixture-path :line 16}))
    (= {id} (plist/get r :id))
    (aio/dispatch work-sys
      (\ {_} {debug-nested-fn 5})
      nil
      (\ {res} {do (dict/set! results "wire-step" res) nil}))
    (test/assert-eq 1 (wait-paused-http 100) "paused at the call line")

    (= {bad} (post-json "/dbg/step" {:mode "sideways"}))
    (test/assert (not (nil? (plist/get bad :error))) "unknown mode rejected")

    (= {s} (post-json "/dbg/step" {:mode "over"}))
    (test/assert-eq 1 (plist/get s :ok) "step-over accepted over http")
    (test/assert-eq 1 (wait-paused-at-http 17 100)
      "paused at the next caller line, not inside the callee")

    (= {ev} (post-json "/dbg/eval" {:frame 0 :expr "n1"}))
    (test/assert-eq "18" (plist/get ev :result) "callee completed during step")

    (post-json "/dbg/continue" {:a 0})
    (sleep-ms 200)
    (test/assert-eq 37 (dict/get results "wire-step" nil) "completed: 18+19")
    (post-json "/dbg/unbreak" `{:id ,id})
    true
  })

  (test/case "wire-eval-error-and-bad-requests"
    {do
    (= {ev} (post-json "/dbg/eval" {:frame 0 :expr "(+ 1 1)"}))
    (test/assert (not (nil? (plist/get ev :error))) "eval without pause errors")
    (= {b} (post-json "/dbg/break" {:only "junk"}))
    (test/assert (not (nil? (plist/get b :error))) "bad break rejected")
    (= {nf} (get-json "/dbg/nope"))
    (test/assert (not (nil? (plist/get nf :error))) "unknown route 404s")
    true
  })

  (test/case "wire-threads-and-per-thread-routes"
    {do
    ; two workers pause at the same breakpoint (work-sys3 has 2 dispatch loops)
    (= {work-sys3} (aio/await (aio/start {:num-threads 3})))
    (= {r} (post-json "/dbg/break" `{:file ,fixture-path :line 4}))
    (= {id} (plist/get r :id))
    (aio/dispatch work-sys3
      (\ {_} {debug-target-fn 7})
      nil
      (\ {res} {do (dict/set! results "th1" res) nil}))
    (aio/dispatch work-sys3
      (\ {_} {debug-target-fn 8})
      nil
      (\ {res} {do (dict/set! results "th2" res) nil}))
    (test/assert-eq 2 (wait-threads-http 2 100) "two threads listed over http")

    (= {ths} (get-json "/dbg/threads"))
    (= {t1} (plist/get (head ths) :tid))
    (= {t2} (plist/get (head (tail ths)) :tid))
    (test/assert (not (== t1 t2)) "distinct tids over http")

    (= {st} (get-json (str "/dbg/state?thread=" t2)))
    (test/assert-eq t2 (plist/get st :tid) "state addressed by thread")
    (test/assert-eq 2 (plist/get st :threads) "paused-thread count served")

    (= {stack} (get-json (str "/dbg/stack?thread=" t2)))
    (test/assert-eq "current" (plist/get (head stack) :kind)
      "stack addressed by thread")

    (= {binds} (get-json (str "/dbg/frame/0/bindings?thread=" t2)))
    (test/assert (exists "x" (map (\ {b} {plist/get b :name}) binds))
      "bindings addressed by thread")

    (= {e1} (post-json "/dbg/eval" `{:frame 0 :expr "x" :thread ,t1}))
    (= {e2} (post-json "/dbg/eval" `{:frame 0 :expr "x" :thread ,t2}))
    (test/assert (not (== (plist/get e1 :result) (plist/get e2 :result)))
      "eval-in-frame sees per-thread arguments")

    (= {c1} (post-json "/dbg/continue" `{:thread ,t1}))
    (test/assert-eq 1 (plist/get c1 :ok) "continue by thread")
    (test/assert-eq 1 (wait-threads-http 1 100) "one thread remains")
    (= {c2} (post-json "/dbg/continue" `{:thread ,t2}))
    (test/assert-eq 1 (plist/get c2 :ok) "continue second thread")
    (test/assert-eq 0 (wait-threads-http 0 100) "none remain")
    (sleep-ms 100)
    (test/assert-eq 24 (dict/get results "th1" nil) "first completed")
    (test/assert-eq 27 (dict/get results "th2" nil) "second completed")
    (post-json "/dbg/unbreak" `{:id ,id})
    (aio/stop work-sys3)
    (aio/run work-sys3)
    true
  })

  (test/case "wire-pause-endpoint"
    {do
    (aio/dispatch work-sys
      (\ {_} {slow-busy 300000})
      nil
      (\ {res} {do (dict/set! results "pz" res) nil}))
    (sleep-ms 30)
    (= {p} (post-json "/dbg/pause" {:a 0}))
    (test/assert-eq 1 (plist/get p :ok) "pause accepted over http")
    (test/assert-eq 1 (wait-paused-http 100) "running thread paused on demand")
    (= {c} (post-json "/dbg/continue" {:a 0}))
    (test/assert-eq 1 (plist/get c :ok) "continue after pause")
    (fun {wait-pz tries} {
      (if (== tries 0) {nil}
        {if (== (dict/has? results "pz") 1) {dict/get results "pz" nil}
          {do (sleep-ms 20) (wait-pz (- tries 1))}})})
    (test/assert-eq 42 (wait-pz 200) "target ran to completion")
    true
  })

  (test/case "plist-request-routing-without-server"
    {do
    ; handle-request drives the same routes from a plain plist (unit tests
    ; and embedders without a live system)
    (= {resp} (debug/handle-request {:method "GET" :path "/dbg/state"}))
    (test/assert-eq "200" (plist/get resp :status) "plist request served")
    (= {st} (json/parse (plist/get resp :body)))
    (test/assert-eq 0 (plist/get st :paused) "state via plist request")
    (= {nf} (debug/handle-request {:method "GET" :path "/dbg/aio"}))
    (test/assert-eq "404" (plist/get nf :status)
      "system-backed route unavailable without a system")
    true
  })

  (test/case "wire-mem-and-aio-introspection"
    {do
    (= {m} (get-json "/dbg/mem"))
    (test/assert (> (plist/get m :heap-used) 0) "heap usage served")
    (test/assert (num? (plist/get (plist/get m :gc) :cycles))
      "gc metrics served")
    (= {resp} (aio/await (http2/client-request dbg-sys "127.0.0.1" dbg-port
                                               "/dbg/aio")))
    (test/assert-eq "200" (http2/response-status resp) "aio route serves")
    (test/assert (str/contains? (http2/response-body resp) "slabs")
      "aio diagnostics state served")
    (test/assert (str/contains? (http2/response-body resp) "counters")
      "aio metrics served")
    true
  })

  (test/case "wire-events-sse"
    {do
    (dict/set! results "sse-buf" "")
    (= {h} (http2/client-stream dbg-sys "127.0.0.1" dbg-port "/dbg/events"
      (\ {chunk} {do
        (dict/set! results "sse-buf"
          (str (dict/get results "sse-buf" "") chunk))
        nil})))
    (fun {wait-sse needle tries} {
      (if (== tries 0) {0}
        {if (str/contains? (dict/get results "sse-buf" "") needle)
          {1}
          {do (sleep-ms 20) (wait-sse needle (- tries 1))}})})
    (test/assert-eq 1 (wait-sse "event: state" 100) "initial state event")

    ; trigger a pause: the events stream must push a paused event
    (= {r} (post-json "/dbg/break" `{:file ,fixture-path :line 4}))
    (= {id} (plist/get r :id))
    (aio/dispatch work-sys
      (\ {_} {debug-target-fn 9})
      nil
      (\ {res} {do (dict/set! results "sse-run" res) nil}))
    (test/assert-eq 1 (wait-sse "event: paused" 200) "paused event pushed")
    (test/assert-eq 1 (wait-sse "debug_target" 100) "payload carries location")

    (post-json "/dbg/continue" {:a 0})
    (test/assert-eq 1 (wait-sse "event: resumed" 200) "resumed event pushed")
    (post-json "/dbg/unbreak" `{:id ,id})
    true
  }))

  {:suite-name "debug wire protocol"})

(debug/disable)
(aio/stop work-sys)
(aio/run work-sys)
(aio/stop dbg-sys)
(aio/run dbg-sys)
