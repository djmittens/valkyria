; Valkyria Symbol Database — Valk library using sqlite/* builtins
; Assumes prelude.valk is already loaded.

(module symdb)

(type {WordRange}
  {:word Str :start Num :end Num})

(type {SymInfo}
  {:name Str :kind Num :arity Num :doc Str :sig Str
   :path Str :line Num :col Num :formals Str})

; === Symbol kind constants ===
(def {SYMKIND_FUNCTION} 1)
(def {SYMKIND_VARIABLE} 2)
(def {SYMKIND_TYPE} 3)
(def {SYMKIND_CONSTRUCTOR} 4)

; === LSP SymbolKind values ===
(def {LSP_SK_CLASS} 5)
(def {LSP_SK_CONSTRUCTOR} 9)
(def {LSP_SK_FUNCTION} 12)
(def {LSP_SK_VARIABLE} 13)

; === Schema ===
(def {symdb/schema-sql} "
PRAGMA journal_mode=WAL;
PRAGMA synchronous=NORMAL;

CREATE TABLE IF NOT EXISTS files (
  id INTEGER PRIMARY KEY,
  path TEXT UNIQUE NOT NULL,
  hash TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS symbols (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL,
  file_id INTEGER NOT NULL REFERENCES files(id),
  line INTEGER NOT NULL,
  col INTEGER NOT NULL,
  kind INTEGER NOT NULL,
  arity INTEGER NOT NULL DEFAULT -1,
  doc TEXT,
  sig TEXT,
  inferred_type TEXT,
  exported INTEGER NOT NULL DEFAULT 1,
  module TEXT
);

CREATE TABLE IF NOT EXISTS refs (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL,
  file_id INTEGER NOT NULL REFERENCES files(id),
  line INTEGER NOT NULL,
  col INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_symbols_name ON symbols(name);
CREATE INDEX IF NOT EXISTS idx_symbols_file ON symbols(file_id);
CREATE INDEX IF NOT EXISTS idx_refs_name ON refs(name);
CREATE INDEX IF NOT EXISTS idx_refs_file ON refs(file_id);

CREATE TABLE IF NOT EXISTS nodes (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  end_pos INTEGER NOT NULL,
  type TEXT NOT NULL,
  name TEXT NOT NULL,
  context TEXT
);
CREATE INDEX IF NOT EXISTS idx_nodes_lookup ON nodes(file_id, pos, end_pos);

CREATE TABLE IF NOT EXISTS semantic_tokens (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  length INTEGER NOT NULL,
  token_type INTEGER NOT NULL,
  modifiers INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_semtok_file ON semantic_tokens(file_id, pos);

CREATE TABLE IF NOT EXISTS inlay_hints (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  label TEXT NOT NULL,
  kind INTEGER NOT NULL,
  padding INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_hints_file ON inlay_hints(file_id, pos);

CREATE TABLE IF NOT EXISTS scoped_refs (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  name TEXT NOT NULL,
  pos INTEGER NOT NULL,
  len INTEGER NOT NULL,
  scope_id INTEGER NOT NULL,
  is_def INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_scopedrefs_file ON scoped_refs(file_id, name);
CREATE INDEX IF NOT EXISTS idx_scopedrefs_scope ON scoped_refs(file_id, scope_id);

CREATE TABLE IF NOT EXISTS scopes (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  pos INTEGER NOT NULL,
  parent_pos INTEGER NOT NULL DEFAULT -1
);
CREATE INDEX IF NOT EXISTS idx_scopes_file ON scopes(file_id, pos);

CREATE TABLE IF NOT EXISTS diagnostics (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL REFERENCES files(id),
  line INTEGER NOT NULL,
  col INTEGER NOT NULL,
  end_col INTEGER NOT NULL,
  severity INTEGER NOT NULL,
  message TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_diags_file ON diagnostics(file_id);
")

; === Lifecycle ===

; v6: varargs functions store arity=-1 (indexer change in lsp_index.c)
; v7: symbols carry the module prefix; names are stored fully qualified
(def {SYMDB_VERSION} 7)

(sig 'symdb/init {-> Str Ref})
(fun {symdb/init path} {do
  (= {db} (sqlite/open path))
  (= {ver} (sqlite/query-value db "PRAGMA user_version"))
  (if (not (== ver SYMDB_VERSION))
    {do
      (sqlite/exec db "DROP TABLE IF EXISTS diagnostics")
      (sqlite/exec db "DROP TABLE IF EXISTS inlay_hints")
      (sqlite/exec db "DROP TABLE IF EXISTS semantic_tokens")
      (sqlite/exec db "DROP TABLE IF EXISTS scopes")
      (sqlite/exec db "DROP TABLE IF EXISTS nodes")
      (sqlite/exec db "DROP TABLE IF EXISTS refs")
      (sqlite/exec db "DROP TABLE IF EXISTS symbols")
      (sqlite/exec db "DROP TABLE IF EXISTS files")
      (sqlite/exec db (str "PRAGMA user_version=" SYMDB_VERSION))}
    {})
  (sqlite/exec-script db symdb/schema-sql)
  db})

(sig 'symdb/close {-> Ref Nil})
(fun {symdb/close db} {sqlite/close db})

; === Helpers ===

; `files.path` is the identity of a source file, so it MUST be a
; physical path. Editors are inconsistent about symlinks: neovim
; resolves them when opening a buffer but echoes root_uri verbatim, so a
; workspace under a symlinked directory (macOS /tmp and /var, home-dir
; symlinks, git worktrees) yields BOTH /var/x.valk and
; /private/var/x.valk. Two rows for one file means re-indexing one row
; leaves the other's symbols in the table forever — deleted definitions
; stay resolvable and undefined-symbol diagnostics never fire.
(def {symdb/canon-cache} (dict/new))

(sig 'canon-path {-> Str Str})
(fun {canon-path p} {do
  (= {hit} (dict/get symdb/canon-cache p))
  (if (not (nil? hit)) {hit}
    {do
      (= {out} (canon-resolve p))
      (dict/set! symdb/canon-cache p out)
      out})
})

; realpath(2) fails when the leaf doesn't exist yet (unsaved buffer), so
; fall back to canonicalizing the parent directory and re-attaching the
; basename. That yields the same answer the file would get once written.
(sig 'canon-resolve {-> Str Str})
(fun {canon-resolve p} {do
  (= {r} (realpath p))
  (if (not (error? r)) {r}
    {do
      (= {i} (str/last-index-of p "/"))
      (if (< i 1) {p}
        {do
          (= {dir} (realpath (str/slice p 0 i)))
          (if (error? dir) {p} {str dir (str/slice p i (len p))})})})
})

(sig 'uri->path {-> Str Str})
(fun {uri->path uri} {
  if (< (len uri) 7) {uri}
    {if (== (str/slice uri 0 7) "file://")
      {canon-path (str/slice uri 7 (len uri))}
      {uri}}
})

(sig 'clean-name {-> Str Str})
(fun {clean-name s} {
  str/replace (str/replace (str/replace s "}" "") ")" "") "(" ""
})

; === Doc comment extraction ===

(sig 'strip-leading-spaces {-> Str Str})
(fun {strip-leading-spaces s} {
  if (== (len s) 0) {s}
  {if (== (str/slice s 0 1) " ")
    {strip-leading-spaces (str/slice s 1 (len s))}
    {s}}
})

(sig 'strip-comment-prefix {-> Str Str})
(fun {strip-comment-prefix s} {
  if (< (len s) 2) {""}
  {if (== (str/slice s 0 2) "; ")
    {str/slice s 2 (len s)}
  {if (== (str/slice s 0 1) ";")
    {str/slice s 1 (len s)}
    {s}}}
})

(sig 'extract-doc-comment-walk {-> (List Str) Num (List Str) (List Str)})
(fun {extract-doc-comment-walk lines idx acc} {
  if (< idx 0) {acc}
  {do
    (= {line} (nth (+ idx 1) lines))
    (= {stripped} (strip-leading-spaces (str/replace line "\r" "")))
    (if (== (len stripped) 0) {acc}
    {if (== (str/slice stripped 0 1) ";")
      {extract-doc-comment-walk lines (- idx 1)
        (qcons (strip-comment-prefix stripped) acc)}
      {acc}})}
})

(sig 'extract-doc-comment {-> (List Str) Num Str})
(fun {extract-doc-comment lines def-line} {do
  (= {comments} (extract-doc-comment-walk lines (- def-line 1) nil))
  (if (nil? comments) {nil}
    {str/join comments "\n"})
})

(sig 'append-all {-> List List List})
(fun {append-all items acc} {
  if (nil? items) {acc}
    {append-all (tail items) (qcons (head items) acc)}
})



; === Position utilities ===

(sig 'pos-of-name {-> Str Str Num})
(fun {pos-of-name text name} {do
  (= {idx} (str/index-of text name))
  (if (< idx 0) {{:line 0 :col 0}}
    {do
      (= {before} (str/slice text 0 idx))
      (= {lines-before} (str/split before "\n"))
      (= {line} (- (len lines-before) 1))
      (= {last-line} (last lines-before))
      (= {col} (len last-line))
      (list :line line :col col)})
})

(sig 'is-delim {-> Str Num})
(fun {is-delim c} {
  if (== c " ") {1}
  {if (== c "(") {1}
  {if (== c ")") {1}
  {if (== c "{") {1}
  {if (== c "}") {1}
  {if (== c ";") {1}
  {if (== c "\t") {1}
  {if (== c "\n") {1}
  {if (== c "\r") {1}
  {if (== c "\"") {1}
  {if (== c "'") {1}
  {0}}}}}}}}}}}
})

; Public helpers — qualified at def site so they bind at top level
; (rewriter leaves names with `/` alone) and are reachable from sibling
; modules without depending on load order.
(sig 'symdb/scan-word-start {-> Str Num Num})
(fun {symdb/scan-word-start s col} {
  if (<= col 0) {0}
    {do
      (= {c} (str/slice s (- col 1) col))
      (if (is-delim c) {col}
        {symdb/scan-word-start s (- col 1)})}
})

(sig 'symdb/scan-word-end {-> Str Num Num})
(fun {symdb/scan-word-end s col} {
  if (>= col (len s)) {col}
    {do
      (= {c} (str/slice s col (+ col 1)))
      (if (is-delim c) {col}
        {symdb/scan-word-end s (+ col 1)})}
})

(sig 'word-at-position {-> Str Num Num Str})
(fun {word-at-position text line col} {do
  (= {lines} (str/split text "\n"))
  (if (>= line (len lines)) {nil}
    {do
      (= {target} (nth (+ line 1) lines))
      (if (> col (len target)) {nil}
        {do
          (= {start} (symdb/scan-word-start target col))
          (= {end} (symdb/scan-word-end target col))
          (if (>= start end) {nil}
            {str/slice target start end})})})
})

(sig 'word-range-at-position {-> Str Num Num WordRange})
(fun {word-range-at-position text line col} {do
  (= {lines} (str/split text "\n"))
  (if (>= line (len lines)) {nil}
    {do
      (= {target} (nth (+ line 1) lines))
      (if (> col (len target)) {nil}
        {do
          (= {start} (symdb/scan-word-start target col))
          (= {end} (symdb/scan-word-end target col))
          (if (>= start end) {nil}
            {(WordRange :word (str/slice target start end) :start start :end end)})})})
})

; === Database operations ===

(sig 'symdb/sync-document {-> Ref Str Str Nil})
(fun {symdb/sync-document db uri text} {do
  (= {path} (uri->path uri))
  (= {mem-hash} (str "mem:" (len text)))
  (= {existing} (sqlite/query-maybe db
    "SELECT hash FROM files WHERE path=?1" path))
  (if (not (nil? existing))
    {if (== (plist/get existing :hash) mem-hash) {0}
      {do (sqlite/exec db "BEGIN")
          (symdb/sync-file-symbols db uri text mem-hash)
          (sqlite/exec db "COMMIT") 1}}
    {do (sqlite/exec db "BEGIN")
        (symdb/sync-file-symbols db uri text mem-hash)
        (sqlite/exec db "COMMIT") 1})
})

(sig 'symdb/node-at-offset {-> Ref Str Num List})
(fun {symdb/node-at-offset db path offset} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT n.type, n.name, n.pos, n.end_pos, n.context FROM nodes n JOIN files f ON n.file_id=f.id WHERE f.path=?1 AND n.pos<=?2 AND n.end_pos>?2 LIMIT 1"
    path offset}
})


; ---------------------------------------------------------------------------
; Precomputed data: store semantic tokens, hints, scoped refs during indexing
; ---------------------------------------------------------------------------



(sig 'symdb/insert-semtok-batch {-> Ref Num List Nil})
(fun {symdb/insert-semtok-batch db file-id tokens} {
  if (nil? tokens) {nil}
  {if (< (len tokens) 4) {nil}
  {do
    (= {pos} (head tokens))
    (= {tlen} (nth 2 tokens))
    (= {ttype} (nth 3 tokens))
    (= {tmods} (nth 4 tokens))
    (sqlite/exec db
      "INSERT INTO semantic_tokens (file_id, pos, length, token_type, modifiers) VALUES (?1, ?2, ?3, ?4, ?5)"
      file-id pos tlen ttype tmods)
    (symdb/insert-semtok-batch db file-id (tail (tail (tail (tail tokens)))))}}
})



(sig 'symdb/hint-padding-bits {-> List Num})
(fun {symdb/hint-padding-bits h} {do
  (= {l} (plist/get h :paddingLeft))
  (= {r} (plist/get h :paddingRight))
  (+ (if (not (nil? l)) {1} {0})
     (if (not (nil? r)) {2} {0}))
})

(sig 'symdb/insert-hint-batch {-> Ref Num List Nil})
(fun {symdb/insert-hint-batch db file-id hints} {
  if (nil? hints) {nil}
  {do
    (= {h} (head hints))
    (sqlite/exec db
      "INSERT INTO inlay_hints (file_id, pos, label, kind, padding) VALUES (?1, ?2, ?3, ?4, ?5)"
      file-id h:offset h:label h:kind (symdb/hint-padding-bits h))
    (symdb/insert-hint-batch db file-id (tail hints))}
})



(sig 'symdb/insert-scoped-ref-batch {-> Ref Num List Nil})
(fun {symdb/insert-scoped-ref-batch db file-id refs} {
  if (nil? refs) {nil}
  {do
    (= {r} (head refs))
    (sqlite/exec db
      "INSERT INTO scoped_refs (file_id, name, pos, len, scope_id, is_def) VALUES (?1, ?2, ?3, ?4, ?5, ?6)"
      file-id r:name r:offset r:len r:scope-id r:is-def)
    (symdb/insert-scoped-ref-batch db file-id (tail refs))}
})

; === File sync ===

(sig 'symdb/strip-errors {-> List List})
(fun {symdb/strip-errors ast} {
  if (nil? ast) {nil}
  {do
    (= {h} (head ast))
    (if (error? h)
      {symdb/strip-errors (tail ast)}
      {qcons h (symdb/strip-errors (tail ast))})}
})

(sig 'symdb/sync-file-with-ast {-> Ref Str Str Str List Nil})
(fun {symdb/sync-file-with-ast db uri text hash ast} {do
  (= {path} (uri->path uri))
  (= {clean-ast} (symdb/strip-errors ast))
  (sqlite/exec db
    "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
    path hash)
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (not (nil? file-id)) {lsp/index-ast db file-id clean-ast text} {})
})

(sig 'symdb/sync-file-symbols {-> Ref Str Str Str Nil})
(fun {symdb/sync-file-symbols db uri text hash} {do
  (= {path} (uri->path uri))
  (= {raw-ast} (parse text))
  (= {ast} (symdb/strip-errors raw-ast))
  (sqlite/exec db
    "INSERT INTO files (path, hash) VALUES (?1, ?2) ON CONFLICT(path) DO UPDATE SET hash=?2"
    path hash)
  (= {file-id} (sqlite/query-value db "SELECT id FROM files WHERE path=?1" path))
  (if (not (nil? file-id)) {lsp/index-ast db file-id ast text} {})
  (if (and (not (nil? file-id)) (not (nil? ast)))
    {symdb/store-inferred-types db file-id ast} {})
})

(sig 'symdb/store-inferred-types {-> Ref Num List Nil})
(fun {symdb/store-inferred-types db file-id ast} {do
  (= {result} (type/infer-file ast))
  (= {types} (plist/get result :types))
  (symdb/update-inferred-from-types db file-id types)
})

(sig 'symdb/update-inferred-from-types {-> Ref Num List Nil})
(fun {symdb/update-inferred-from-types db file-id types} {
  if (nil? types) {nil}
  {do
    (= {entry} (head types))
    (= {name} (plist/get entry :var))
    (= {type-str} (plist/get entry :type))
    (if (and (not (nil? name)) (not (nil? type-str)))
      {sqlite/exec db
        "UPDATE symbols SET inferred_type=?3 WHERE file_id=?1 AND name=?2"
        file-id name type-str}
      {nil})
    (symdb/update-inferred-from-types db file-id (tail types))}
})

(sig 'symkind->lsp-kind {-> Num Num})
(fun {symkind->lsp-kind kind} {
  if (== kind SYMKIND_FUNCTION) {LSP_SK_FUNCTION}
  {if (== kind SYMKIND_VARIABLE) {LSP_SK_VARIABLE}
  {if (== kind SYMKIND_TYPE) {LSP_SK_CLASS}
  {if (== kind SYMKIND_CONSTRUCTOR) {LSP_SK_CONSTRUCTOR}
    {LSP_SK_VARIABLE}}}}
})

(load "stdlib/diag/symdb-query.valk")
