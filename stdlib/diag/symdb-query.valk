; Valkyria Symbol Database — query & display functions
; Loaded by symdb.valk; depends on types/constants defined there.

; ---------------------------------------------------------------------------
; Query functions for precomputed data
; ---------------------------------------------------------------------------

(sig 'symdb/get-semantic-tokens {-> Ref Str List})
(fun {symdb/get-semantic-tokens db path} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT pos, length, token_type, modifiers FROM semantic_tokens t JOIN files f ON t.file_id=f.id WHERE f.path=?1 ORDER BY t.pos"
    path}
})

; Range-filtered semantic tokens: only return tokens whose byte offset
; falls within [start-offset, end-offset).
(sig 'symdb/get-semantic-tokens-range {-> Ref Str Num Num List})
(fun {symdb/get-semantic-tokens-range db path start-offset end-offset} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT pos, length, token_type, modifiers FROM semantic_tokens t JOIN files f ON t.file_id=f.id WHERE f.path=?1 AND t.pos>=?2 AND t.pos<?3 ORDER BY t.pos"
    path start-offset end-offset}
})

(sig 'symdb/get-inlay-hints {-> Ref Str Num Num List})
(fun {symdb/get-inlay-hints db path start-line end-line} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT h.pos, h.label, h.kind, h.padding FROM inlay_hints h JOIN files f ON h.file_id=f.id WHERE f.path=?1 ORDER BY h.pos"
    path}
})

(sig 'symdb/get-scoped-refs {-> Ref Str Str Num List})
(fun {symdb/get-scoped-refs db path name scope-id} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 AND r.scope_id=?3 ORDER BY r.pos"
    path name scope-id}
})

(sig 'symdb/get-ref-at-offset {-> Ref Str Num List})
(fun {symdb/get-ref-at-offset db path offset} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.pos<=?2 AND (r.pos+r.len)>?2 LIMIT 1"
    path offset}
})

(sig 'symdb/get-all-file-refs {-> Ref Str Str List})
(fun {symdb/get-all-file-refs db path name} {
  if (nil? db) {nil}
  {sqlite/query db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 ORDER BY r.pos"
    path name}
})

(sig 'symdb/find-scoped-def {-> Ref Str Str Num List})
(fun {symdb/find-scoped-def db path name scope-id} {
  if (nil? db) {nil}
  {sqlite/query-maybe db
    "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 AND r.scope_id=?3 AND r.is_def=1 LIMIT 1"
    path name scope-id}
})

(sig 'symdb/find-def-in-scope-chain {-> Ref Str Str Num List})
(fun {symdb/find-def-in-scope-chain db path name scope-pos} {
  if (nil? db) {nil}
  {if (< scope-pos 0) {nil}
  {do
    (= {found} (sqlite/query-maybe db
      "SELECT name, pos, len, scope_id, is_def FROM scoped_refs r JOIN files f ON r.file_id=f.id WHERE f.path=?1 AND r.name=?2 AND r.scope_id=?3 AND r.is_def=1 LIMIT 1"
      path name scope-pos))
    (if (not (nil? found)) {found}
      {do
        (= {parent} (sqlite/query-maybe db
          "SELECT parent_pos FROM scopes s JOIN files f ON s.file_id=f.id WHERE f.path=?1 AND s.pos=?2 LIMIT 1"
          path scope-pos))
        (if (nil? parent) {nil}
          {symdb/find-def-in-scope-chain db path name (plist/get parent :parent_pos)})})}}
})

(sig 'symdb/find-field-definition {-> Ref Str Str List})
(fun {symdb/find-field-definition db field-name context} {
  if (nil? db) {nil}
  {do
    (= {ctor-name} (if (nil? context) {nil}
      {symdb/resolve-var-type db context}))
    (= {ctor} (if (nil? ctor-name)
      {sqlite/query-maybe db
        "SELECT s.name, f.path, n.pos FROM symbols s JOIN files f ON s.file_id=f.id LEFT JOIN nodes n ON n.file_id=s.file_id AND n.name=s.name AND n.type='sym' WHERE s.kind=4 AND s.sig LIKE ?1 LIMIT 1"
        (str "%" field-name " %")}
      {sqlite/query-maybe db
        "SELECT s.name, f.path, n.pos FROM symbols s JOIN files f ON s.file_id=f.id LEFT JOIN nodes n ON n.file_id=s.file_id AND n.name=s.name AND n.type='sym' WHERE s.kind=4 AND s.name=?1 AND s.sig LIKE ?2 LIMIT 1"
        ctor-name (str "%" field-name " %")}))
    (if (nil? ctor) {nil}
      {do
        (= {ctor-path} (plist/get ctor :path))
        (= {ctor-pos} (plist/get ctor :col))
        (= {ctor-line} (plist/get ctor :line))
        (= {field-node} (sqlite/query-maybe db
          "SELECT n.pos, n.end_pos FROM nodes n JOIN files f ON n.file_id=f.id WHERE f.path=?1 AND n.type='sym' AND n.name=?2 AND n.context IS NULL AND n.pos > ?3 ORDER BY n.pos LIMIT 1"
          ctor-path field-name (plist/get ctor :pos)))
        (if (nil? field-node) {nil}
          {list :pos (plist/get field-node :pos)
                :len (- (plist/get field-node :end_pos) (plist/get field-node :pos))
                :path ctor-path})})}
})

(sig 'symdb/resolve-var-type {-> Ref Str Str})
(fun {symdb/resolve-var-type db context} {
  if (nil? db) {nil}
  {if (nil? context) {nil}
  {do
    (= {direct} (sqlite/query-maybe db
      "SELECT name FROM symbols WHERE name=?1 AND kind=4 LIMIT 1"
      context))
    (if (not (nil? direct)) {context}
    {do
      (= {inferred} (sqlite/query-maybe db
        "SELECT inferred_type FROM symbols WHERE name=?1 AND inferred_type IS NOT NULL LIMIT 1"
        context))
      (if (not (nil? inferred)) {plist/get inferred :inferred_type}
      {do
        (= {def-ref} (sqlite/query-maybe db
          "SELECT scope_id FROM scoped_refs WHERE name=?1 AND is_def=1 LIMIT 1"
          context))
        (if (nil? def-ref) {nil}
          {do
            (= {scope-pos} (plist/get def-ref :scope_id))
            (= {fn-ref} (sqlite/query-maybe db
              "SELECT name FROM scoped_refs WHERE is_def=1 AND scope_id=-1 AND pos > ?1 AND pos < ?1 + 20 ORDER BY pos LIMIT 1"
              scope-pos))
            (if (nil? fn-ref) {nil}
              {do
                (= {fname} (plist/get fn-ref :name))
                (= {param-type} (symdb/resolve-param-type db fname context))
                param-type})})})})}}
})

(sig 'symdb/resolve-param-type {-> Ref Str Str Str})
(fun {symdb/resolve-param-type db fname param-name} {
  if (nil? db) {nil}
  {do
    ; Get the function sig
    (= {sig-row} (sqlite/query-maybe db
      "SELECT sig FROM symbols WHERE name=?1 AND sig LIKE '{->%' LIMIT 1"
      fname))
    (if (nil? sig-row) {nil}
      {do
        ; Get formals to find param position
        (= {formals-row} (sqlite/query-maybe db
          "SELECT sig FROM symbols WHERE name=?1 AND sig LIKE '(fun%' LIMIT 1"
          fname))
        (if (nil? formals-row) {nil}
          {do
            (= {sig-str} (plist/get sig-row :sig))
            (= {formals-str} (plist/get formals-row :sig))
            (= {param-idx} (symdb/find-param-index formals-str param-name))
            (if (< param-idx 0) {nil}
              {symdb/get-sig-type-at sig-str param-idx})})})}
})

(sig 'symdb/find-param-index {-> Str Str Num})
(fun {symdb/find-param-index formals-str param-name} {
  if (nil? formals-str) {-1}
  {do
    ; formals-str is like "(fun {fname p1 p2 p3} ...)"
    ; Extract params between first { and }
    (= {open} (str/index-of formals-str "{"))
    (= {close} (str/index-of formals-str "}"))
    (if (or (< open 0) (< close 0)) {-1}
      {do
        (= {inner} (str/slice formals-str (+ open 1) close))
        (= {parts} (str/split inner " "))
        ; Skip first (function name), find param-name in rest
        (symdb/find-in-parts (tail parts) param-name 0)})}
})

(sig 'symdb/find-in-parts {-> List Str Num Num})
(fun {symdb/find-in-parts parts name idx} {
  if (nil? parts) {-1}
  {if (== (head parts) name) {idx}
  {symdb/find-in-parts (tail parts) name (+ idx 1)}}
})

(sig 'symdb/get-sig-type-at {-> Str Num Str})
(fun {symdb/get-sig-type-at sig-str idx} {
  if (nil? sig-str) {nil}
  {if (< (len sig-str) 4) {nil}
  {do
    (= {inner} (str/slice sig-str 4 (- (len sig-str) 1)))
    (= {parts} (str/split inner " "))
    (= {parts} (filter (\ {p} {not (== p "&")}) parts))
    (if (>= idx (- (len parts) 1)) {nil}
      {nth (+ idx 1) parts})}}
})

; === Query functions ===

(sig 'symdb/find-definition {-> Ref Str Any})
(fun {symdb/find-definition db name} {
  symdb/find-definition-in db name nil})

(sig 'symdb/find-definition-in {-> Ref Str Str Any})
(fun {symdb/find-definition-in db name path} {do
  (= {local} (if (nil? path) {nil}
    {sqlite/query-maybe db
      "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND f.path=?2 AND s.kind != 0 ORDER BY (CASE WHEN s.arity >= 0 THEN 0 ELSE 1 END), s.id LIMIT 1"
      name path}))
  (if (nil? local)
    {sqlite/query-maybe db
      "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND s.kind != 0 ORDER BY (CASE WHEN s.arity >= 0 THEN 0 ELSE 1 END), s.id LIMIT 1"
      name}
    {local})})

(sig 'symdb/find-definitions {-> Ref Str List})
(fun {symdb/find-definitions db name} {
  sqlite/query db
    "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 ORDER BY s.id"
    name
})

(sig 'symdb/file-symbols {-> Ref Str List})
(fun {symdb/file-symbols db path} {
  sqlite/query db
    "SELECT s.name, s.line, s.col, s.kind, s.arity, s.doc FROM symbols s JOIN files f ON s.file_id=f.id WHERE f.path=?1 ORDER BY s.line, s.col"
    path
})

(sig 'symdb/search-symbols {-> Ref Str List})
(fun {symdb/search-symbols db query} {
  sqlite/query db
    "SELECT s.name, s.line, s.col, s.kind, s.doc, f.path FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name LIKE ?1 ORDER BY s.name LIMIT 50"
    (str "%" query "%")
})

(sig 'symdb/all-symbol-names {-> Ref List})
(fun {symdb/all-symbol-names db} {
  sqlite/query db
    "SELECT s.name, s.kind, s.doc, s.line, s.col, f.path FROM symbols s JOIN files f ON s.file_id=f.id GROUP BY s.name ORDER BY s.name LIMIT 200"
})

(sig 'symdb/completion-all {-> Ref List})
(fun {symdb/completion-all db} {
  sqlite/query db
    "SELECT name, kind, COALESCE(MAX(CASE WHEN sig LIKE '{->%' THEN sig END), MAX(sig)) as sig, MAX(doc) as doc FROM symbols GROUP BY name ORDER BY name LIMIT 200"
})

(sig 'symdb/completion-symbols {-> Ref Str List})
(fun {symdb/completion-symbols db prefix} {
  sqlite/query db
    "SELECT name, kind, COALESCE(MAX(CASE WHEN sig LIKE '{->%' THEN sig END), MAX(sig)) as sig, MAX(doc) as doc FROM symbols WHERE name LIKE ?1 GROUP BY name ORDER BY name LIMIT 100"
    (str prefix "%")
})

(sig 'symdb/find-refs {-> Ref Str List})
(fun {symdb/find-refs db name} {
  sqlite/query db
    "SELECT r.line, r.col, f.path FROM refs r JOIN files f ON r.file_id=f.id WHERE r.name=?1 ORDER BY f.path, r.line, r.col"
    name
})

(sig 'symdb/symbol-hover {-> Ref Str SymInfo})
(fun {symdb/symbol-hover db name} {
  symdb/symbol-hover-in db name nil})

(sig 'symdb/symbol-hover-in {-> Ref Str Str SymInfo})
(fun {symdb/symbol-hover-in db name path} {do
  (= {def-row} (if (nil? path)
    {sqlite/query-maybe db
      "SELECT s.name, s.kind, s.arity, s.doc, s.sig, s.inferred_type, f.path, s.line, s.col FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND s.line >= 0 ORDER BY s.id LIMIT 1"
      name}
    {do
      (= {local} (sqlite/query-maybe db
        "SELECT s.name, s.kind, s.arity, s.doc, s.sig, s.inferred_type, f.path, s.line, s.col FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND f.path=?2 AND s.line >= 0 ORDER BY s.id LIMIT 1"
        name path))
      (if (nil? local)
        {sqlite/query-maybe db
          "SELECT s.name, s.kind, s.arity, s.doc, s.sig, s.inferred_type, f.path, s.line, s.col FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 AND s.line >= 0 ORDER BY s.id LIMIT 1"
          name}
        {local})}))
  (= {sig-row} (sqlite/query-maybe db
    "SELECT s.sig, s.doc FROM symbols s WHERE s.name=?1 AND s.sig IS NOT NULL AND s.sig != '' AND s.sig LIKE '{->%' ORDER BY s.id LIMIT 1"
    name))
  (if (nil? def-row)
    {if (nil? sig-row) {nil}
      {do
        (= {fallback} (sqlite/query-maybe db
          "SELECT s.name, s.kind, s.arity, s.doc, s.sig, s.inferred_type, f.path, s.line, s.col FROM symbols s JOIN files f ON s.file_id=f.id WHERE s.name=?1 ORDER BY s.id LIMIT 1"
          name))
        (if (nil? fallback) {nil}
          {do
            (= {type-sig} (if (nil? sig-row) {nil} {sig-row:sig}))
            (= {type-sig} (if (nil? type-sig) {fallback:inferred_type} {type-sig}))
            (= {sig-doc} (if (nil? sig-row) {nil} {sig-row:doc}))
            (= {fb-doc} fallback:doc)
            (= {final-doc} (if (nil? fb-doc) {sig-doc} {fb-doc}))
            (SymInfo fallback:name fallback:kind fallback:arity
              final-doc type-sig fallback:path fallback:line fallback:col nil)})}}
    {do
      (= {type-sig} (if (nil? sig-row) {nil} {sig-row:sig}))
      (= {type-sig} (if (nil? type-sig) {def-row:inferred_type} {type-sig}))
      (= {formals} def-row:sig)
      (= {def-doc} def-row:doc)
      (= {sig-doc} (if (nil? sig-row) {nil} {sig-row:doc}))
      (= {final-doc} (if (nil? def-doc) {sig-doc} {def-doc}))
      (SymInfo def-row:name def-row:kind def-row:arity
        final-doc type-sig def-row:path def-row:line def-row:col formals)})
})

; === Reference counting ===

(sig 'symdb/ref-count {-> Ref Str Num})
(fun {symdb/ref-count db name} {
  sqlite/query-value db
    "SELECT COUNT(*) FROM refs WHERE name=?1" name
})

; === Stale file cleanup ===

(sig 'symdb/all-indexed-paths {-> Ref List})
(fun {symdb/all-indexed-paths db} {
  sqlite/query db "SELECT id, path FROM files"
})

(sig 'symdb/remove-file {-> Ref Num Nil})
(fun {symdb/remove-file db file-id} {do
  (sqlite/exec db "DELETE FROM symbols WHERE file_id=?1" file-id)
  (sqlite/exec db "DELETE FROM refs WHERE file_id=?1" file-id)
  (sqlite/exec db "DELETE FROM files WHERE id=?1" file-id)
})


