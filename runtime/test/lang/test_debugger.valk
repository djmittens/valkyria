; Debugger runtime primitives: breakpoints, GC-transparent pause, frame
; inspection, eval-in-frame, stepping, resume.
; Run with: build/valk runtime/test/lang/test_debugger.valk

(load "testing/test.valk")
(load "runtime/test/fixtures/debug_target.valk")

(def {fixture-path} (realpath "runtime/test/fixtures/debug_target.valk"))
(def {aio} (aio/await (aio/start {:num-threads 2})))
(def {results} (dict/new))

(fun {sleep-ms ms} {aio/await (aio/schedule aio ms (\ {} {1}))})

(fun {wait-paused tries} {
  (if (== tries 0)
    {0}
    {if (== (debug/paused?) 1)
      {1}
      {do (sleep-ms 20) (wait-paused (- tries 1))}})
})

(fun {wait-result key tries} {
  (if (== tries 0)
    {nil}
    {if (== (dict/has? results key) 1)
      {dict/get results key nil}
      {do (sleep-ms 20) (wait-result key (- tries 1))}})
})

; After a resume/step, paused? can still show the OLD pause until the thread
; wakes — poll for the target line instead.
(fun {wait-paused-at line tries} {
  (if (== tries 0)
    {0}
    {do
      (= {st} (debug/state))
      (if (and (not (nil? st)) (== (plist/get st :line) line))
        {1}
        {do (sleep-ms 20) (wait-paused-at line (- tries 1))})})
})

; Poll until paused somewhere OTHER than line; returns the new line, or 0.
(fun {wait-paused-not-at line tries} {
  (if (== tries 0)
    {0}
    {do
      (= {st} (debug/state))
      (if (and (not (nil? st)) (not (== (plist/get st :line) line)))
        {plist/get st :line}
        {do (sleep-ms 20) (wait-paused-not-at line (- tries 1))})})
})

(fun {wait-threads n tries} {
  (if (== tries 0)
    {len (debug/threads)}
    {if (== (len (debug/threads)) n)
      {n}
      {do (sleep-ms 20) (wait-threads n (- tries 1))}})
})

; Busy work with source positions so a pause request can land in it.
(fun {busy-countdown n} {
  (if (== n 0)
    {42}
    {busy-countdown (- n 1)})
})

(test/run (list

  (test/case "breakpoint-set-and-list"
    {do
    (debug/enable)
    (= {id} (debug/break fixture-path 4))
    (test/assert (> id 0) "breakpoint id returned")
    (= {bps} (debug/breakpoints))
    (test/assert-eq 1 (len bps) "one breakpoint listed")
    (test/assert-eq 4 (plist/get (head bps) :line) "line recorded")
    (test/assert-eq 1 (debug/unbreak id) "unbreak finds it")
    (test/assert-eq 0 (len (debug/breakpoints)) "list empty after unbreak")
    (test/assert-eq 0 (debug/unbreak 9999) "unknown id not found")
    true
  })

  (test/case "pause-inspect-eval-in-frame-resume"
    {do
    (debug/enable)
    (= {id} (debug/break fixture-path 4))
    (aio/dispatch aio
      (\ {_} {debug-target-fn 10})
      nil
      (\ {r} {do (dict/set! results "run1" r) nil}))
    (test/assert-eq 1 (wait-paused 100) "worker paused at breakpoint")

    (= {st} (debug/state))
    (test/assert-eq 4 (plist/get st :line) "paused on the breakpoint line")
    (test/assert (str/contains? (plist/get st :file) "debug_target.valk")
      "paused in the fixture file")

    (= {frames} (debug/frames))
    (test/assert (> (len frames) 0) "frames captured")
    (= {f0} (head frames))
    (test/assert-eq "current" (plist/get f0 :kind) "frame 0 is current expr")
    (test/assert-eq 4 (plist/get f0 :line) "frame 0 line")

    ; eval in the paused frame: the function argument is visible
    (= {fenv} (debug/frame-env 0))
    (test/assert (ref? fenv) "frame env is an env ref")
    (test/assert-eq 10 (env/eval fenv {eval x}) "argument visible in frame")
    (test/assert-eq 11 (env/eval fenv {+ x 1}) "eval-in-frame computes")

    ; GC while paused: parked thread participates, state stays valid
    (mem/gc/collect)
    (test/assert-eq 1 (debug/paused?) "still paused after gc")
    (test/assert-eq 10 (env/eval (debug/frame-env 0) {eval x})
      "frame env valid after gc")

    (test/assert-eq 1 (debug/continue) "resume accepted")
    (= {r} (wait-result "run1" 100))
    (test/assert-eq 33 r "function completed with correct result")
    (test/assert-eq 0 (debug/paused?) "not paused after completion")
    (debug/unbreak id)
    true
  })

  (test/case "step-advances-one-line"
    {do
    (debug/enable)
    (= {id} (debug/break fixture-path 4))
    (aio/dispatch aio
      (\ {_} {debug-target-fn 20})
      nil
      (\ {r} {do (dict/set! results "run2" r) nil}))
    (test/assert-eq 1 (wait-paused 100) "paused at line 4")
    (test/assert-eq 4 (plist/get (debug/state) :line) "at line 4")

    (test/assert-eq 1 (debug/step) "step accepted")
    (test/assert-eq 1 (wait-paused-at 5 100) "paused at line 5 after step")
    ; at line 5, a = x + 1 = 21 is bound
    (test/assert-eq 21 (env/eval (debug/frame-env 0) {eval a})
      "binding from previous line visible")

    (test/assert-eq 1 (debug/continue) "resume after step")
    (test/assert-eq 63 (wait-result "run2" 100) "completed: a=21 b=42 sum=63")
    (debug/unbreak id)
    (debug/disable)
    true
  })

  (test/case "step-in-enters-callee"
    {do
    (debug/enable)
    (= {id} (debug/break fixture-path 16))
    (aio/dispatch aio
      (\ {_} {debug-nested-fn 7})
      nil
      (\ {r} {do (dict/set! results "in1" r) nil}))
    (test/assert-eq 1 (wait-paused 100) "paused at the call line")
    (test/assert-eq 16 (plist/get (debug/state) :line) "at line 16")

    (test/assert-eq 1 (debug/step :in) "step-in accepted")
    (= {l} (wait-paused-not-at 16 100))
    (test/assert (and (> l 8) (< l 13)) "paused inside the callee")
    (test/assert-eq 7 (env/eval (debug/frame-env 0) {eval y})
      "callee argument visible")

    (test/assert-eq 1 (debug/continue) "resume")
    (test/assert-eq 49 (wait-result "in1" 100) "completed: 24+25")
    (debug/unbreak id)
    true
  })

  (test/case "step-over-skips-callee"
    {do
    (debug/enable)
    (= {id} (debug/break fixture-path 16))
    (aio/dispatch aio
      (\ {_} {debug-nested-fn 5})
      nil
      (\ {r} {do (dict/set! results "over1" r) nil}))
    (test/assert-eq 1 (wait-paused 100) "paused at the call line")
    (test/assert-eq 16 (plist/get (debug/state) :line) "at line 16")

    (test/assert-eq 1 (debug/step :over) "step-over accepted")
    (test/assert-eq 1 (wait-paused-at 17 100) "paused at line 17, not in callee")
    (test/assert-eq 18 (env/eval (debug/frame-env 0) {eval n1})
      "callee ran to completion during step-over")

    (test/assert-eq 1 (debug/continue) "resume")
    (test/assert-eq 37 (wait-result "over1" 100) "completed: 18+19")
    (debug/unbreak id)
    true
  })

  (test/case "step-out-returns-to-caller"
    {do
    (debug/enable)
    (= {id} (debug/break fixture-path 10))
    (aio/dispatch aio
      (\ {_} {debug-nested-fn 3})
      nil
      (\ {r} {do (dict/set! results "out1" r) nil}))
    (test/assert-eq 1 (wait-paused 100) "paused inside helper")
    (test/assert-eq 10 (plist/get (debug/state) :line) "at line 10")

    (test/assert-eq 1 (debug/step :out) "step-out accepted")
    (test/assert-eq 1 (wait-paused-at 17 100) "paused back in the caller")
    (test/assert-eq 12 (env/eval (debug/frame-env 0) {eval n1})
      "callee result bound in caller frame")

    (test/assert (error? (env/eval (debug/frame-env 0) {eval h1}))
      "callee locals gone after step-out")

    (test/assert-eq 1 (debug/continue) "resume")
    (test/assert-eq 25 (wait-result "out1" 100) "completed: 12+13")
    (debug/unbreak id)
    (debug/disable)
    true
  })

  (test/case "step-mode-validation"
    {do
    (test/assert (error? (debug/step :sideways)) "unknown mode rejected")
    (test/assert-eq 0 (debug/step :over) "step-over refused when not paused")
    (test/assert-eq 0 (debug/step :out) "step-out refused when not paused")
    true
  })

  (test/case "multi-thread-pause"
    {do
    ; two workers need two dispatch loops -> 3-thread system
    (= {aio3} (aio/await (aio/start {:num-threads 3})))
    (debug/enable)
    (= {id} (debug/break fixture-path 4))
    (aio/dispatch aio3
      (\ {_} {debug-target-fn 10})
      nil
      (\ {r} {do (dict/set! results "mt1" r) nil}))
    (aio/dispatch aio3
      (\ {_} {debug-target-fn 20})
      nil
      (\ {r} {do (dict/set! results "mt2" r) nil}))
    (test/assert-eq 2 (wait-threads 2 100) "two threads paused at once")

    (= {ths} (debug/threads))
    (= {t1} (plist/get (head ths) :tid))
    (= {t2} (plist/get (head (tail ths)) :tid))
    (test/assert (not (== t1 t2)) "distinct thread ids")
    (test/assert-eq 4 (plist/get (debug/state t1) :line) "thread 1 at line 4")
    (test/assert-eq 4 (plist/get (debug/state t2) :line) "thread 2 at line 4")

    ; per-thread frame envs see per-thread arguments
    (= {x1} (env/eval (debug/frame-env 0 t1) {eval x}))
    (= {x2} (env/eval (debug/frame-env 0 t2) {eval x}))
    (test/assert (or (and (== x1 10) (== x2 20))
                     (and (== x1 20) (== x2 10)))
      "each paused thread sees its own argument")

    ; per-thread frames
    (test/assert-eq "current" (plist/get (head (debug/frames t1)) :kind)
      "frames addressable by tid")

    ; resume one; the other stays paused
    (test/assert-eq 1 (debug/continue t1) "resume thread 1")
    (test/assert-eq 1 (wait-threads 1 100) "one thread still paused")
    (test/assert (not (nil? (debug/state t2))) "thread 2 still paused")
    (test/assert-eq 1 (debug/continue t2) "resume thread 2")
    (test/assert-eq 0 (wait-threads 0 100) "no threads paused")

    (= {r1} (wait-result "mt1" 100))
    (= {r2} (wait-result "mt2" 100))
    (test/assert-eq 33 r1 "first target completed")
    (test/assert-eq 63 r2 "second target completed")
    (debug/unbreak id)
    (debug/disable)
    (aio/stop aio3)
    (aio/run aio3)
    true
  })

  (test/case "pause-request-interrupts-running-thread"
    {do
    (debug/enable)
    (aio/dispatch aio
      (\ {_} {busy-countdown 500000})
      nil
      (\ {r} {do (dict/set! results "pr1" r) nil}))
    (sleep-ms 30)
    (test/assert-eq 1 (debug/pause) "pause request accepted")
    (test/assert-eq 1 (wait-paused 100) "running thread parked on request")
    (= {st} (debug/state))
    (test/assert (not (nil? st)) "state available while pause-parked")
    (test/assert (>= (plist/get st :tid) 0) "paused thread has a tid")
    (test/assert-eq 1 (debug/continue) "resume after pause")
    (test/assert-eq 42 (wait-result "pr1" 200) "target ran to completion")
    (debug/disable)
    true
  })

  (test/case "pause-request-not-consumed-by-requester"
    {do
    (debug/enable)
    (test/assert-eq 1 (debug/pause) "pause request accepted")
    ; this thread keeps evaluating: it must NOT consume its own request
    (= {acc} (foldl (\ {a b} {+ a b}) 0 (list 1 2 3 4 5)))
    (test/assert-eq 15 acc "requester kept running")
    (test/assert-eq 0 (debug/paused?) "requester never paused")
    (debug/disable)
    (test/assert-eq 0 (debug/paused?) "disable clears pending request")
    true
  })

  (test/case "no-pause-when-disabled"
    {do
    (debug/disable)
    (debug/enable)
    (= {id} (debug/break fixture-path 4))
    (debug/disable)
    (aio/dispatch aio
      (\ {_} {debug-target-fn 1})
      nil
      (\ {r} {do (dict/set! results "run3" r) nil}))
    (test/assert-eq 6 (wait-result "run3" 100) "runs through without pausing")
    (test/assert-eq 0 (debug/paused?) "never paused")
    (debug/enable)
    (debug/unbreak id)
    (debug/disable)
    true
  }))

  {:suite-name "debugger primitives"})

(aio/stop aio)
(aio/run aio)
