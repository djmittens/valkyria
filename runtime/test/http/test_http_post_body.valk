; POST request body collection tests
; Server-side bodies are buffered from DATA frames and exposed via req/body;
; the handler only runs once the request stream has ended.

(load "testing/test.valk")

(def {aio} (aio/await (aio/start)))

(def {server-handler}
  (\ {req} {
    (= {body} (req/body req))
    (if (nil? body)
      {{:status "200" :content-type "text/plain" :body "empty"}}
      {`{:status "200" :content-type "text/plain" :body ,(str "echo:" body)}})
  }))

(def {server} (http2/server-listen aio 0 server-handler))
(def {test-port} (http2/server-port server))

(test/run-async aio (list
  (test/case-async "post body reaches the handler" (\ {} {
    (aio/then (http2/client-post aio "127.0.0.1" test-port "/event" "hello-body")
      (\ {resp} {(if (error? resp) {false}
        {(== (http2/response-body resp) "echo:hello-body")})}))
  }))
  (test/case-async "post json body round-trips" (\ {} {
    (= {payload} "{\"client\":\"c1\",\"event\":{\"type\":\"key\",\"key\":\"j\"}}")
    (aio/then (http2/client-post aio "127.0.0.1" test-port "/event" payload)
      (\ {resp} {(if (error? resp) {false}
        {(== (http2/response-body resp) (str "echo:" payload))})}))
  }))
  (test/case-async "get without body still works" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/")
      (\ {resp} {(if (error? resp) {false}
        {(== (http2/response-body resp) "empty")})}))
  })))
  {:suite-name "HTTP POST body"})
