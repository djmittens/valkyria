; HTTP API Network Integration Tests
; Tests http_api.valk functions that require real network connections
; Starts a local server and tests the high-level fetch functions

(load "testing/test.valk")

(fun {reverse l} {
  (= {reverse-helper} (\ {acc remaining} {
    (if (== remaining nil)
      {acc}
      {(reverse-helper (join (list (head remaining)) acc) (tail remaining))})
  }))
  (reverse-helper nil l)
})

(load "stdlib/http/api.valk")

(def {aio} (aio/await (aio/start)))

(def {server-handler}
  (\ {req} {
    (= {path} (req/path req))
    (if (== path "/error")
      {`{:status "500" :body "Internal Server Error"}}
      {`{:status "200" :body "Hello from test server"}})
  }))

(def {server} (http2/server-listen aio 0 server-handler))
(def {test-port} (http2/server-port server))

(test/run-async aio (list
  (test/case-async "http2/client-request returns response" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/") (\ {resp} {
      (and (not (error? resp)) (== (http2/response-status resp) "200"))
    }))
  }))
  (test/case-async "http2/client-request returns body" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/") (\ {resp} {
      (not (error? (http2/response-body resp)))
    }))
  }))
  (test/case-async "http2/client-request status is 200 for good path" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/") (\ {resp} {
      (== (http2/response-status resp) "200")
    }))
  }))
  (test/case-async "http2/client-request status is 500 for error path" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/error") (\ {resp} {
      (== (http2/response-status resp) "500")
    }))
  }))
  (test/case-async "multiple sequential requests work" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/") (\ {resp1} {
      (= {status1} (http2/response-status resp1))
      (aio/then (http2/client-request aio "127.0.0.1" test-port "/") (\ {resp2} {
        (and (== status1 "200")
             (== (http2/response-status resp2) "200"))
      }))
    }))
  }))
  (test/case-async "aio/all collects multiple request results" (\ {} {
    (= {handles} (list
      (http2/client-request aio "127.0.0.1" test-port "/")
      (http2/client-request aio "127.0.0.1" test-port "/")))
    (aio/then (aio/all handles) (\ {responses} {
      (== (len responses) 2)
    }))
  }))
  (test/case-async "aio/retry with http2/client-request" (\ {} {
    (aio/then (aio/retry aio (\ {} {(http2/client-request aio "127.0.0.1" test-port "/")}) {:max-attempts 2}) (\ {resp} {
      (== (http2/response-status resp) "200")
    }))
  }))
  (test/case-async "http2/response-ok? returns 1 for 200" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/") (\ {resp} {
      (== (http2/response-ok? resp) 1)
    }))
  }))
  (test/case-async "http2/response-ok? returns 0 for 500" (\ {} {
    (aio/then (http2/client-request aio "127.0.0.1" test-port "/error") (\ {resp} {
      (== (http2/response-ok? resp) 0)
    }))
  }))
  (test/case-async "http2/fetch returns response" (\ {} {
    ((http2/fetch aio "127.0.0.1" test-port "/") (\ {resp} {
      (== (http2/response-status resp) "200")
    }))
  }))
  (test/case-async "http2/fetch-text extracts body" (\ {} {
    ((http2/fetch-text aio "127.0.0.1" test-port "/") (\ {body} {
      (== body "Hello from test server")
    }))
  }))
  (test/case-async "http2/fetch-ok? is true for 200" (\ {} {
    ((http2/fetch-ok? aio "127.0.0.1" test-port "/") (\ {ok} {
      (== ok 1)
    }))
  }))
  (test/case-async "http2/fetch-all collects responses" (\ {} {
    ((http2/fetch-all aio (list
        (list "127.0.0.1" test-port "/")
        (list "127.0.0.1" test-port "/error")))
     (\ {resps} {
       (and (== (len resps) 2)
            (== (http2/response-status (nth 1 resps)) "200")
            (== (http2/response-status (nth 2 resps)) "500"))
     }))
  }))
  (test/case-async "http2/fetch-all-text collects bodies" (\ {} {
    ((http2/fetch-all-text aio (list
        (list "127.0.0.1" test-port "/")
        (list "127.0.0.1" test-port "/")))
     (\ {bodies} {
       (and (== (len bodies) 2)
            (== (nth 1 bodies) "Hello from test server"))
     }))
  }))
  (test/case-async "http2/fetch-retry returns 200 response immediately" (\ {} {
    ((http2/fetch-retry aio "127.0.0.1" test-port "/" 2) (\ {resp} {
      (== (http2/response-status resp) "200")
    }))
  }))
  (test/case-async "http2/fetch-retry exhausts retries on 500" (\ {} {
    ((http2/fetch-retry aio "127.0.0.1" test-port "/error" 2) (\ {resp} {
      (== (http2/response-status resp) "500")
    }))
  }))
  (test/case-async "http2/sequential returns the last network result" (\ {} {
    ((http2/sequential (list
        (http2/fetch aio "127.0.0.1" test-port "/")
        (http2/fetch aio "127.0.0.1" test-port "/error")))
     (\ {last-resp} {
       (== (http2/response-status last-resp) "500")
     }))
  }))
  (test/case-async "http2/fan-out fetches extracted endpoints" (\ {} {
    ((http2/fan-out aio "127.0.0.1" test-port "/"
        (list (\ {resp} {(list "127.0.0.1" test-port "/")})))
     (\ {resps} {
       (and (== (len resps) 1)
            (== (http2/response-status (nth 1 resps)) "200"))
     }))
  }))
  (test/case-async "http2/aggregate combines responses" (\ {} {
    ((http2/aggregate aio (list
        (list "127.0.0.1" test-port "/")
        (list "127.0.0.1" test-port "/"))
        (\ {resps} {(len resps)}))
     (\ {n} {(== n 2)}))
  }))
  (test/case-async "http2/health-check is true for healthy endpoint" (\ {} {
    ((http2/health-check aio "127.0.0.1" test-port "/") (\ {ok} {
      (== ok 1)
    }))
  }))
  (test/case-async "http2/health-check-all checks each endpoint" (\ {} {
    ((http2/health-check-all aio (list
        (list "127.0.0.1" test-port "/")
        (list "127.0.0.1" test-port "/error")))
     (\ {oks} {
       (and (== (len oks) 2) (== (nth 1 oks) 1) (== (nth 2 oks) 0))
     }))
  })))
  {:suite-name "HTTP API Network Tests"
   :timeout-ms 5000
   :suite-timeout-ms 60000})
