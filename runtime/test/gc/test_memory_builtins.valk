; Memory and GC Builtin Tests
; Run with: ./build/valk test/test_memory_builtins.valk

(load "testing/test.valk")

; ============================================================================
; heap-usage tests
; ============================================================================

; ============================================================================
; gc-collect tests
; ============================================================================

; ============================================================================
; mem/heap/hard-limit tests
; ============================================================================

; ============================================================================
; stack-depth test
; ============================================================================

; ============================================================================
; time-us tests
; ============================================================================

; Run all tests
(test/run (list
  (test/case "heap-usage-returns-number"
    {do
    (= {usage} (mem/heap/usage))
    (test/assert (>= usage 0) "heap-usage should return non-negative number")
    true
  })
  (test/case "heap-usage-increases-with-allocation"
    {do
    (= {before} (mem/heap/usage))
    (= {big-list} (range 0 1000))
    (= {after} (mem/heap/usage))
    (test/assert (>= after before) "heap usage should not decrease after allocation")
    true
  })
  (test/case "gc-collect-runs"
    {do
    (= {result} (mem/gc/collect))
    (test/assert (>= result 0) "gc-collect should return non-negative bytes")
    true
  })
  (test/case "gc-collect-reclaims-garbage"
    {do
    (= {x} (range 0 100))
    (= {x} nil)
    (= {reclaimed} (mem/gc/collect))
    (test/assert (>= reclaimed 0) "gc-collect should return reclaimed bytes")
    true
  })
  (test/case "heap-hard-limit-returns-number"
    {do
    (= {limit} (mem/heap/hard-limit))
    (test/assert (> limit 0) "mem/heap/hard-limit should return positive number")
    true
  })
  (test/case "set-heap-hard-limit-basic"
    {do
    (= {original} (mem/heap/hard-limit))
    (= {new-limit} (+ original 1000000))
    (= {old} (mem/heap/set-hard-limit new-limit))
    (test/assert-eq original old "should return old limit")
    (test/assert-eq new-limit (mem/heap/hard-limit) "should set new limit")
    (mem/heap/set-hard-limit original)
    true
  })
  (test/case "stack-depth-returns-number"
    {do
    (= {depth} (stack-depth))
    (test/assert (>= depth 0) "stack-depth should return non-negative")
    true
  })
  (test/case "stack-depth-increases-in-recursion"
    {do
    (fun {check-depth n}
      {if (<= n 0)
        (stack-depth)
        (check-depth (- n 1))})
    (= {depth-0} (check-depth 0))
    (= {depth-5} (check-depth 5))
    (test/assert (> depth-5 depth-0) "depth should increase with recursion")
    true
  })
  (test/case "time-us-returns-number"
    {do
    (= {t} (time-us))
    (test/assert (> t 0) "time-us should return positive number")
    true
  })
  (test/case "time-us-monotonic"
    {do
    (= {t1} (time-us))
    (= {t2} (time-us))
    (test/assert (>= t2 t1) "time-us should be monotonic")
    true
  })
  (test/case "gc-metrics-returns-plist"
    {do
    (= {m} (mem/gc/metrics))
    (test/assert (list? m) "gc metrics should return a list")
    (test/assert (> (len m) 0) "gc metrics should have entries")
    true
  })
  (test/case "gc-metrics-has-expected-keys"
    {do
    (= {m} (mem/gc/metrics))
    (test/assert (num? m:cycles) "should have :cycles")
    (test/assert (num? m:heap-used) "should have :heap-used")
    (test/assert (num? m:heap-total) "should have :heap-total")
    true
  })
  (test/case "set-hard-limit-below-usage-errors"
    {do
    (= {result} (mem/heap/set-hard-limit 1))
    (test/assert (error? result) "setting hard limit below usage should error")
    true
  }))
  {:suite-name "Memory Builtin Tests"})
