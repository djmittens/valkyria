; Quality Snapshot — pure Valk implementation
; Produces JSON metrics compatible with quality/quality-diff.valk
;
; Usage: build/valk --quality-snapshot [dir]

(load "symdb/symdb.valk")

(module quality)

; === File discovery ===

(fun {find-valk-files dir} {do
  (= {entries} (list-dir dir))
  (if (error? entries) {nil}
    {collect-files entries dir nil})
})

(fun {collect-files entries dir acc} {
  if (nil? entries) {acc}
  {do
    (= {entry} (head entries))
    (= {name} entry:name)
    (= {etype} entry:type)
    (= {path} (str dir "/" name))
    (= {rest} (tail entries))
    (if (== etype "file")
      {if (str/ends-with? name ".valk")
        {if (str/ends-with? name ".test.valk")
          {collect-files rest dir acc}
          {collect-files rest dir (qcons path acc)}}
        {collect-files rest dir acc}}
      {if (== name ".valk")
        {collect-files rest dir acc}
      {if (== name "build")
        {collect-files rest dir acc}
      {if (== name "vendor")
        {collect-files rest dir acc}
      {if (== name ".git")
        {collect-files rest dir acc}
      {if (== name "node_modules")
        {collect-files rest dir acc}
        {collect-files rest dir
          (collect-files (list-dir path) path acc)}}}}}})}
})

; === Workspace sync ===

(fun {sync-all db files} {
  if (nil? files) {0}
  {do
    (= {path} (head files))
    (= {text} (read-file path))
    (if (error? text)
      {sync-all db (tail files)}
      {do
        (= {uri} (str "file://" path))
        (symdb/sync-document db uri text)
        (sync-all db (tail files))})}
})

; === JSON output helpers ===

(fun {json/str s} {
  str "\"" (str/replace (str/replace (str/replace (str/replace s "\\" "\\\\") "\"" "\\\"") "\n" "\\n") "\t" "\\t") "\""
})

(fun {json/num n} {str n})
(fun {json/bool b} {if b {"true"} {"false"}})

; === Query helpers ===

(fun {count-table db table} {
  sqlite/query-value db (str "SELECT COUNT(*) FROM " table)
})

(fun {dead-symbols db limit} {
  sqlite/query db
    "SELECT s.name, f.path, s.line FROM symbols s JOIN files f ON f.id = s.file_id WHERE s.exported = 1 AND NOT EXISTS (SELECT 1 FROM refs r WHERE r.name = s.name) ORDER BY f.path, s.line LIMIT ?1"
    limit
})

(fun {hotspots db limit} {
  sqlite/query db
    "SELECT s.name, f.path, s.line, (SELECT COUNT(*) FROM refs r WHERE r.name = s.name) as cnt FROM symbols s JOIN files f ON f.id = s.file_id WHERE s.kind = 1 GROUP BY s.name HAVING cnt > 0 ORDER BY cnt DESC LIMIT ?1"
    limit
})

(fun {high-fanout db limit} {
  sqlite/query db
    "SELECT s.name, f.path, s.line, (SELECT COUNT(DISTINCT r.name) FROM refs r WHERE r.file_id = s.file_id) as cnt FROM symbols s JOIN files f ON f.id = s.file_id WHERE s.kind = 1 GROUP BY s.name ORDER BY cnt DESC LIMIT ?1"
    limit
})

(fun {file-coupling db limit} {
  sqlite/query db
    "SELECT f1.path as source, f2.path as target, COUNT(r.id) as cnt FROM refs r JOIN files f1 ON f1.id = r.file_id JOIN symbols s ON s.name = r.name JOIN files f2 ON f2.id = s.file_id WHERE r.file_id != s.file_id GROUP BY r.file_id, s.file_id ORDER BY cnt DESC LIMIT ?1"
    limit
})

(fun {file-stats db} {
  sqlite/query db
    "SELECT f.path, (SELECT COUNT(*) FROM symbols s WHERE s.file_id = f.id) as sym_count, (SELECT COUNT(*) FROM symbols s WHERE s.file_id = f.id AND s.kind = 1) as fun_count, (SELECT COUNT(*) FROM symbols s WHERE s.file_id = f.id AND s.exported = 1 AND NOT EXISTS (SELECT 1 FROM refs r WHERE r.name = s.name)) as dead_count FROM files f ORDER BY f.path"
})

; === Per-file fan metrics ===

(fun {file-fan-in db} {
  sqlite/query db
    "SELECT f.path, COUNT(DISTINCT r.file_id) as fan_in FROM symbols s JOIN refs r ON r.name = s.name JOIN files f ON f.id = s.file_id WHERE r.file_id != s.file_id GROUP BY s.file_id"
})

(fun {file-fan-out db} {
  sqlite/query db
    "SELECT f.path, COUNT(DISTINCT s.file_id) as fan_out FROM refs r JOIN symbols s ON s.name = r.name JOIN files f ON f.id = r.file_id WHERE r.file_id != s.file_id GROUP BY r.file_id"
})

(fun {file-max-fan-out db} {
  sqlite/query db
    "SELECT f.path, COUNT(DISTINCT r.name) as max_fan_out FROM refs r JOIN files f ON f.id = r.file_id GROUP BY r.file_id"
})

(fun {lookup-by-path rows path key} {
  if (nil? rows) {0}
  {do
    (= {row} (head rows))
    (= {p} row:path)
    (if (== p path) {plist/get row key}
    {if (== p (str "file://" path)) {plist/get row key}
      {lookup-by-path (tail rows) path key}})}
})

; === Line counting ===

(fun {count-lines text} {
  if (== (len text) 0) {0}
  {+ 1 (len (str/split text "\n"))}
})

; === Strip workspace prefix ===

(fun {strip-prefix path root} {
  if (<= (len root) 0) {path}
  {if (== (str/slice path 0 (len root)) root)
    {if (> (len path) (+ (len root) 1))
      {str/slice path (+ (len root) 1) (len path)}
      {path}}
    {path}}
})

; === JSON emitters ===

(fun {emit-files file-stats fan-in-data fan-out-data max-fo-data files root} {do
  (= {parts} (emit-files-walk file-stats fan-in-data fan-out-data max-fo-data files root nil))
  (str/join (reverse parts) ",\n")
})

(fun {emit-files-walk file-stats fan-in-data fan-out-data max-fo-data files root acc} {
  if (nil? files) {acc}
  {do
    (= {path} (head files))
    (= {rel} (strip-prefix path root))
    (= {text} (read-file path))
    (= {lines} (if (error? text) {0} {count-lines text}))
    (= {stats} (find-file-stat file-stats path))
    (= {sym-count} (if (nil? stats) {0} {stats:sym_count}))
    (= {fun-count} (if (nil? stats) {0} {stats:fun_count}))
    (= {dead-count} (if (nil? stats) {0} {stats:dead_count}))
    (= {fi} (lookup-by-path fan-in-data path :fan_in))
    (= {fo} (lookup-by-path fan-out-data path :fan_out))
    (= {mfo} (lookup-by-path max-fo-data path :max_fan_out))
    (= {basename} (last (str/split rel "/")))
    (= {is-test} (if (< (len basename) 5) {0}
                   {== (str/slice basename 0 5) "test_"}))
    (= {entry} (str "    {\"path\": " (json/str rel)
                     ", \"lines\": " (json/num lines)
                     ", \"symbols\": " (json/num sym-count)
                     ", \"functions\": " (json/num fun-count)
                     ", \"dead\": " (json/num dead-count)
                     ", \"fan_in\": " (json/num fi)
                     ", \"fan_out\": " (json/num fo)
                     ", \"max_fan_out\": " (json/num mfo)
                     ", \"is_test\": " (json/bool is-test)
                     "}"))
    (emit-files-walk file-stats fan-in-data fan-out-data max-fo-data (tail files) root (qcons entry acc))}
})

(fun {find-file-stat file-stats path} {
  if (nil? file-stats) {nil}
  {do
    (= {row} (head file-stats))
    (= {db-path} row:path)
    (if (== db-path path) {row}
    {if (== db-path (str "file://" path)) {row}
      {find-file-stat (tail file-stats) path}})}
})

(fun {emit-dead dead root} {
  str/join (emit-dead-walk dead root nil) ",\n"
})

(fun {emit-dead-walk dead root acc} {
  if (nil? dead) {reverse acc}
  {do
    (= {d} (head dead))
    (= {entry} (str "    {\"name\": " (json/str d:name)
                    ", \"file\": " (json/str (strip-prefix d:path root))
                    ", \"line\": " (json/num d:line)
                    "}"))
    (emit-dead-walk (tail dead) root (qcons entry acc))}
})

(fun {emit-hotspots hotspots root} {
  str/join (emit-hotspots-walk hotspots root nil) ",\n"
})

(fun {emit-hotspots-walk hotspots root acc} {
  if (nil? hotspots) {reverse acc}
  {do
    (= {h} (head hotspots))
    (= {entry} (str "    {\"name\": " (json/str h:name)
                    ", \"file\": " (json/str (strip-prefix h:path root))
                    ", \"refs\": " (json/num h:cnt)
                    "}"))
    (emit-hotspots-walk (tail hotspots) root (qcons entry acc))}
})

(fun {emit-fanout fanout root} {
  str/join (emit-fanout-walk fanout root nil) ",\n"
})

(fun {emit-fanout-walk fanout root acc} {
  if (nil? fanout) {reverse acc}
  {do
    (= {f} (head fanout))
    (= {entry} (str "    {\"name\": " (json/str f:name)
                    ", \"file\": " (json/str (strip-prefix f:path root))
                    ", \"deps\": " (json/num f:cnt)
                    "}"))
    (emit-fanout-walk (tail fanout) root (qcons entry acc))}
})

(fun {emit-coupling coupling root} {
  str/join (emit-coupling-walk coupling root nil) ",\n"
})

(fun {emit-coupling-walk coupling root acc} {
  if (nil? coupling) {reverse acc}
  {do
    (= {c} (head coupling))
    (= {entry} (str "    {\"source\": " (json/str (strip-prefix c:source root))
                    ", \"target\": " (json/str (strip-prefix c:target root))
                    ", \"refs\": " (json/num c:cnt)
                    "}"))
    (emit-coupling-walk (tail coupling) root (qcons entry acc))}
})

; === Main ===

(fun {run dir} {do
  (= {root} dir)
  (mkdir-p (str root "/.valk"))
  (= {db-path} (str root "/.valk/symdb.sqlite"))

  (= {db} (symdb/init db-path))

  (= {files} (find-valk-files root))

  (sync-all db files)

  (= {dead} (dead-symbols db 500))
  (= {hotspots} (quality/hotspots db 20))
  (= {fanout} (high-fanout db 20))
  (= {coupling} (file-coupling db 50))
  (= {file-stats} (quality/file-stats db))
  (= {fan-in-data} (file-fan-in db))
  (= {fan-out-data} (file-fan-out db))
  (= {max-fo-data} (file-max-fan-out db))

  (= {n-files} (count-table db "files"))
  (= {n-syms} (count-table db "symbols"))
  (= {n-refs} (count-table db "refs"))
  (= {n-dead} (len dead))

  (print (str "{\n"
    "  \"summary\": {\n"
    "    \"files\": " (json/num n-files) ",\n"
    "    \"symbols\": " (json/num n-syms) ",\n"
    "    \"types\": 0,\n"
    "    \"references\": " (json/num n-refs) ",\n"
    "    \"scopes\": 0,\n"
    "    \"dead_symbols\": " (json/num n-dead) ",\n"
    "    \"testable_symbols\": 0,\n"
    "    \"tested_symbols\": 0,\n"
    "    \"test_coverage_pct\": 0\n"
    "  },\n"
    "  \"files\": [\n"
    (emit-files file-stats fan-in-data fan-out-data max-fo-data files root)
    "\n  ],\n"
    "  \"dead_symbols\": [\n"
    (emit-dead dead root)
    "\n  ],\n"
    "  \"hotspots\": [\n"
    (emit-hotspots hotspots root)
    "\n  ],\n"
    "  \"high_fan_out\": [\n"
    (emit-fanout fanout root)
    "\n  ],\n"
    "  \"file_coupling\": [\n"
    (emit-coupling coupling root)
    "\n  ]\n"
    "}"))

  (symdb/close db)
})

; VALK_QUALITY_DIR is injected by the C-side `--quality-snapshot` flag
; (see repl/main.c). The sig declaration is here purely so static
; analysis (valk-check) can see the symbol; the actual binding happens
; before this script is loaded.
(sig 'VALK_QUALITY_DIR Str)
(run VALK_QUALITY_DIR)
